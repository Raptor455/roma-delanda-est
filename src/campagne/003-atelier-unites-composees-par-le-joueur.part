    elephant:{n:'Éléphant',m:{},need:d=>d.shield!=='aucun'},moon:{n:'Disque et croissant',m:{},need:d=>d.shield!=='aucun'},soleil:{n:'Soleil',m:{},need:d=>d.shield!=='aucun'},etoile:{n:'Étoile',m:{},need:d=>d.shield!=='aucun'},
    rings:{n:'Rosace',m:{},need:d=>d.shield!=='aucun'},triskel:{n:'Triskèle',m:{},need:d=>d.shield!=='aucun'},sanglier:{n:'Sanglier',m:{},need:d=>d.shield!=='aucun'},loup:{n:'Loup',m:{},need:d=>d.shield!=='aucun'},
    foudre:{n:'Foudre ailé',m:{},need:d=>d.shield!=='aucun'},chouette:{n:'Chouette',m:{},need:d=>d.shield!=='aucun'},serpent:{n:'Serpent d\'Asclépios',m:{},need:d=>d.shield!=='aucun'},aigle:{n:'Aigle',m:{},need:d=>d.shield!=='aucun'},gorgone:{n:'Gorgone',m:{},need:d=>d.shield!=='aucun'},bandes:{n:'Bandes',m:{},need:d=>d.shield!=='aucun'},uni:{n:'Uni',m:{},need:d=>d.shield!=='aucun'}}},
  teinte:{n:'Couleur du bouclier',look:1,sh:1,o:{
    pourpre:{n:'Pourpre',m:{}},rouge:{n:'Rouge',m:{}},noir:{n:'Noir',m:{}},blanc:{n:'Blanc',m:{}},ocre:{n:'Ocre',m:{}},bleu:{n:'Bleu',m:{}},vert:{n:'Vert',m:{}},bronze:{n:'Bronze poli',m:{}},jaune:{n:'Jaune',m:{}}}},
  tenue:{n:'Couleur de la tenue',look:1,o:{
    peuple:{n:'Celle du peuple',m:{}},pourpre:{n:'Pourpre',m:{}},rouge:{n:'Rouge',m:{}},blanc:{n:'Blanc',m:{}},ecru:{n:'Écru',m:{}},bleu:{n:'Bleu',m:{}},vert:{n:'Vert',m:{}},ocre:{n:'Ocre',m:{}},jaune:{n:'Jaune',m:{}},noir:{n:'Noir',m:{}}}},
  manteau:{n:'Manteau',look:1,o:{
    aucun:{n:'Aucun',m:{}},rouge:{n:'Rouge',m:{}},pourpre:{n:'Pourpre',m:{}},blanc:{n:'Blanc',m:{}},bleu:{n:'Bleu',m:{}},vert:{n:'Vert',m:{}},ocre:{n:'Ocre',m:{}},jaune:{n:'Jaune',m:{}},noir:{n:'Noir',m:{}}}},
