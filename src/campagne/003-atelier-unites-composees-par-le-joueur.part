    epee:{n:'Épée courte (falcata)',m:{atk:1.1,chg:.1,cost:4}},
    glaive:{n:'Glaive (gladius)',m:{atk:1.2,chg:.1,cost:5}},
    kopis:{n:'Kopis (sabre courbe)',m:{atk:1.15,chg:.2,cost:5}},
    xyston:{n:'Xyston (longue lance de cavalerie)',m:{atk:.3,def:.02,chg:.6,cost:5},k:['cav']},
    longue:{n:'Épée longue',m:{atk:.8,chg:.3,cost:5},k:['inf','cav']},
    hache:{n:'Hache de guerre',m:{atk:1.3,def:-.03,chg:.2,cost:4},k:['inf','cav']},
    dague:{n:'Dague',m:{},k:['skirm']}}},
  jet:{n:'Arme de jet',o:{
    aucune:{n:'Aucune',m:{},k:['inf','cav','lcav']},
    javelots:{n:'Javelots',m:{chg:.3,cost:4},mk:{skirm:{ranged:{range:150,dmg:6,cd:2},cost:6},cav:{chg:.2,cost:4},lcav:{ranged:{range:130,dmg:3,cd:2.2},cost:6}}},
    pilum:{n:'Pilum (deux par homme)',m:{chg:.55,atk:.2,cost:7},k:['inf']},
    soliferrum:{n:'Soliferrum (tout en fer)',m:{chg:.45,cost:6},mk:{cav:{chg:.3,cost:6}},k:['inf','cav']},
    fronde:{n:'Fronde',m:{ranged:{range:200,dmg:6,cd:1.6},cost:8},k:['skirm']},
    arc:{n:'Arc',m:{ranged:{range:220,dmg:5,cd:1.9},cost:9},k:['skirm']}}},
  train:{n:'Entraînement',o:{
    levee:{n:'Levée',m:{mor:-10,atk:-.5},cm:.7,tm:.6},
