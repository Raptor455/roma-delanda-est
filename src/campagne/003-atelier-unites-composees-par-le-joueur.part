/* ================= ATELIER : unités composées par le joueur ================= */
// Un modèle = un corps de troupe (figurines, effectif, villes où l'on recrute) + un équipement choisi pièce par pièce, puis un nom.
// Le régiment garde t = type de base (marche, carrés, figurines 3D) et porte d = id du modèle (S.designs).
const CORPS={
  lib:{n:'Libyens',adj:'libyens',k:'inf',skin:'#8c6244',m:{mor:8,def:.03,atk:.3},txt:'Discipline et ténacité.'},
  iber:{n:'Ibères',adj:'ibères',k:'inf',skin:'#c39872',m:{chg:.15,spd:.6},txt:'Agiles, charge vive.'},
  gaul:{n:'Gaulois',adj:'gaulois',adjP:{per:'galates'},k:'inf',skin:'#d9b290',m:{chg:.3,atk:.4,mor:-8},cm:.85,txt:'Charge furieuse, moral fragile, bon marché.'},
  sling:{n:'Tirailleurs',adj:'',k:'skirm',skin:'#b98d68',m:{},txt:'Troupe légère de harcèlement.'},
  hcav:{n:'Cavaliers',adj:'',k:'cav',skin:'#c39872',m:{},txt:'Cavalerie de choc.'},
  ncav:{n:'Numides',adj:'numides',k:'lcav',skin:'#74503a',m:{spd:2,mor:-4},txt:'Montés à cru, insaisissables.'},
  legion:{n:'Légionnaires',adj:'romains',k:'inf',m:{atk:.5,mor:8,def:.03},txt:'Citoyens de Rome : discipline des manipules, pilum puis glaive.'},
  velites:{n:'Vélites',adj:'romains',k:'skirm',m:{mor:4},cm:.9,txt:'Jeunes citoyens pauvres, javelots et peau de loup.'},
  rcav:{n:'Chevaliers',adj:'romains',k:'cav',m:{mor:5},txt:'Les equites, fils des familles aisées de Rome.'},
  acav:{n:'Cavaliers alliés',adj:'italiens',k:'cav',m:{},cm:.9,txt:'Cavalerie des alliés italiens, nombreuse et bon marché.'},
  phalange:{n:'Phalange',adj:'macédoniens',k:'inf',m:{def:.06,mor:6},txt:'Un hérisson de sarisses, imprenable de face.'},
  hypasp:{n:'Hypaspistes',adj:'royaux',k:'inf',m:{atk:.8,mor:14,def:.04},cm:1.25,txt:"Garde d'élite du roi, à l'aise partout."},
  peltaste:{n:'Thraces',adj:'thraces',k:'skirm',m:{atk:.8,chg:.15},txt:'Javeliniers capables de tenir au corps à corps.'},
  cretois:{n:'Crétois',adj:'crétois',k:'skirm',m:{mor:4},cm:1.1,txt:'Les meilleurs archers du monde grec.'},
  compagnons:{n:'Compagnons',adj:'macédoniens',k:'cav',m:{atk:1,mor:14,chg:.3},cm:1.3,txt:'La cavalerie royale, en coin, à la tête de la charge.'},
  thessal:{n:'Thessaliens',adj:'thessaliens',k:'cav',m:{mor:6,chg:.2},txt:'Cavaliers des plaines, en losange.'},
  athoplites:{n:'Hoplites',adj:'grecs',adjP:{syr:'syracusains',ath:'athéniens',per:'pergaméniens'},k:'inf',m:{def:.05,mor:6},txt:'Citoyens-soldats en phalange, lance et grand bouclier.'},
  thureo:{n:'Thuréophores',adj:'mercenaires',k:'inf',m:{spd:.5,chg:.1},cm:.95,txt:"Mercenaires au bouclier ovale, bons partout."},
  athpelt:{n:'Peltastes grecs',adj:'grecs',k:'skirm',m:{atk:.6},txt:'Infanterie légère : javelots et pelte.'},
  hippeis:{n:'Hippeis',adj:'grecs',adjP:{syr:'syracusains',ath:'athéniens',per:'pergaméniens'},k:'cav',m:{mor:4},txt:'Cavalerie des citoyens les plus riches.'},
  scythes:{n:'Scythes',adj:'scythes',k:'skirm',m:{},txt:"Archers des steppes au service d'Athènes."}
};
// équipement de départ de chaque corps (un nouveau modèle part de là)
const BDEF={legion:{helm:'bronze',crest:'plumes',armor:'pect',jamb:'une',shield:'scutum',arm:'glaive',jet:'pilum',teinte:'rouge'},
  velites:{helm:'cuir',armor:'tunique',shield:'parma',arm:'glaive',jet:'javelots',teinte:'rouge'},
  rcav:{helm:'attique',crest:'crete',armor:'pect',shield:'parma',arm:'lance',teinte:'rouge'},
  acav:{helm:'bronze',armor:'lin',shield:'rond',arm:'lance',jet:'javelots',teinte:'vert'},
  phalange:{helm:'thrace',armor:'lin',jamb:'cnemides',shield:'macedonien',arm:'sarisse',teinte:'bronze'},
  hypasp:{helm:'attique',crest:'crin',armor:'lin',jamb:'cnemides',shield:'hoplon',arm:'lance',teinte:'bronze'},
  peltaste:{helm:'phrygien',armor:'tunique',shield:'pelte',arm:'kopis',jet:'javelots',manteau:'ocre'},
  cretois:{helm:'nu',armor:'tunique',shield:'pelte',arm:'dague',jet:'arc'},
  compagnons:{helm:'beotien',armor:'lin',shield:'aucun',arm:'xyston',manteau:'pourpre'},
  thessal:{helm:'petase',armor:'cuir',shield:'aucun',arm:'xyston',jet:'javelots',manteau:'pourpre'},
  athoplites:{helm:'corinthien',crest:'crin',armor:'lin',jamb:'cnemides',shield:'hoplon',arm:'lance',teinte:'bronze'},
  thureo:{helm:'pilos',armor:'lin',shield:'ovale',arm:'lance',jet:'javelots',teinte:'blanc'},
  athpelt:{helm:'pilos',armor:'tunique',shield:'pelte',arm:'epee',jet:'javelots'},
  hippeis:{helm:'petase',armor:'cuir',shield:'aucun',arm:'lance',jet:'javelots',manteau:'bleu'},
  scythes:{helm:'phrygien',armor:'tunique',shield:'aucun',arm:'dague',jet:'arc'}};
// couleurs par défaut des peuples qui recrutent les corps de Carthage
const PEO_LOOK={num:{tenue:'blanc',teinte:'ocre'},mae:{tenue:'ocre',teinte:'ocre'},ins:{tenue:'vert',teinte:'vert'},per:{tenue:'bleu',teinte:'bleu'}};
// corps que le peuple joué peut lever quelque part
function wsPool(){const p=new Set();for(const v of Object.values(POOL_CAR))for(const t of v)if(CORPS[t])p.add(t);return [...p]}
// « tunique, tête nue, sans bouclier » par catégorie (mêmes grandeurs que la bataille 3D ; spd en m/s, cost en or)
const DBASE={inf:{atk:8,def:.62,mor:88,chg:1.1,spd:14,cost:34},skirm:{atk:2.6,def:.5,mor:66,chg:1,spd:20,cost:18},
  cav:{atk:8.4,def:.68,mor:88,chg:1.9,spd:36,cost:46},lcav:{atk:5.6,def:.6,mor:80,chg:1.5,spd:48,cost:40}};
