// vous rompez : la parole trahie se paie partout
function trBreak(T,why){if(!S.tr.includes(T))return;const f=T.f,F=S.fac[f];trEnd(T,'rupture');if(!F)return;F.car-=20;F.why=F.why||{};F.why['traité rompu']=(F.why['traité rompu']||0)-20;S.dv.rep=dvClamp(S.dv.rep-10,0,100);
