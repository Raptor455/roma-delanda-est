  const r=_rT.apply(this,arguments);try{trFicheAdd()}catch(e){console.error(e)}return r}}
{const _bT=dvBadge;dvBadge=function(){const r=_bT.apply(this,arguments);try{const b=$('bDip');if(b&&S&&(S.trq||S.trc)){let s=b.querySelector('.dv-badge');if(!s){s=document.createElement('span');s.className='dv-badge';b.appendChild(s);s.textContent='1'}}}catch(e){}return r}}
window.__traites={get S(){return S},TR_C,trEval,trCounter,trApply,trSign,trArrive:e=>trArrive(e),trTable,trNewOffer,trDaily,trPropose,trOpenQ,trAcceptQ,trAcceptC,trRat,trBreak,trTheyBreak,trDenounce,trMercs,trAvail,trFig,DVS,dvRender:()=>dvRender(),daily:d=>daily(d),declareWar:(s,f)=>declareWar(s,f)};
/* ================= FIN TRAITÉS ================= */
