/* ---- les figures : le dessin de vase du jeu, sans médaillon ---- */
const TR_FIG={};
function trDes(who,chief){let base,gear,teinte,cloak;
  try{if(who==='me'||who==='rom'){const peo=who==='me'?depPeo('car'):'rom',R=DEP_R[peo]||DEP_R.car;base=Object.keys(R).find(t=>UT[t]&&UT[t].k==='inf')||Object.keys(R)[0];gear=R[base][0][1];teinte=DEP_T[peo]||'ocre';cloak=peo==='rom'?'rouge':'pourpre'}
    else{const R=iacRos(who),e=(R.inf&&R.inf[0])||(R.skirm&&R.skirm[0])||(R.cav&&R.cav[0]);base=e[0];gear=e[3]||{};teinte=iacTeinte(who);cloak='ocre'}}catch(e){base='lib';gear={};teinte='ocre';cloak='ocre'}
  const d=Object.assign({id:null,base,name:'',helm:'bronze',crest:'rien',armor:'lin',jamb:'aucune',shield:'rond',motif:'peuple',teinte,tenue:'peuple',manteau:'aucun',arm:'lance',jet:'aucune',train:'reg'},(typeof BDEF!=='undefined'&&BDEF[base])||{},{teinte},gear||{});
  if(chief)Object.assign(d,{crest:d.crest==='rien'?'crin':d.crest,manteau:cloak,shield:'aucun',armor:d.armor==='tunique'||d.armor==='lin'?'cuir':d.armor});
  try{dFix(d)}catch(e){}d.base=base;return d}
function trFig(who,chief){const key=who+(chief?':c':':g')+':'+(who==='me'?(S.mirror?'r':'')+(S.peo||''):'');if(TR_FIG[key]!=null)return TR_FIG[key];let h='';
  try{const t=document.createElement('div');t.innerHTML=vaseSVG(trDes(who,chief),false);const s=t.querySelector('svg');if(s){[...s.children].forEach((c,i)=>{if(i!==2)c.remove()});if(s.firstElementChild)s.firstElementChild.removeAttribute('clip-path');
      s.setAttribute('viewBox','40 2 135 192');s.removeAttribute('width');s.removeAttribute('height');s.setAttribute('preserveAspectRatio','xMidYMax meet');s.style.cssText='height:100%;width:auto;display:block';h=s.outerHTML}}catch(e){console.error(e)}
  return TR_FIG[key]=h}
/* ---- la table de négociation ---- */
{const st=document.createElement('style');st.textContent=`
#mcard.tr-win{max-width:1160px!important;width:min(1160px,97vw)}
.tr-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}.tr-head h2{margin:0}
.tr-chip{border:1px solid var(--line,#4a3a26);border-radius:4px;padding:6px 10px;background:rgba(0,0,0,.25);font-size:13px}
.tr-frise{position:relative;height:236px;border-radius:6px;overflow:hidden;background:radial-gradient(ellipse at 50% 35%,#e6a76c 0%,#cf8348 60%,#b96a34 100%);border-top:10px solid #1d130c;border-bottom:10px solid #1d130c;box-sizing:border-box}
.tr-frise:before,.tr-frise:after{content:'';position:absolute;left:0;right:0;height:4px;background:repeating-linear-gradient(90deg,#c8763d 0 14px,#1d130c 14px 22px)}.tr-frise:before{top:0}.tr-frise:after{bottom:0}
.tr-sol{position:absolute;left:0;right:0;bottom:12px;height:2px;background:#1d130c}
.tr-fg{position:absolute;bottom:12px}.tr-fg.r{transform:scaleX(-1)}
.tr-mot{position:absolute;left:50%;top:16px;transform:translateX(-50%);width:min(250px,26%);text-align:center;color:#1d130c}.tr-mot b{display:block;font-family:Marcellus,Georgia,serif;font-weight:400;font-size:18px;letter-spacing:.08em;margin-bottom:5px}.tr-mot span{font-size:12.5px;font-weight:500;line-height:1.35;display:block}
.tr-tab{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);width:92px;height:52px}.tr-tab:before{content:'';position:absolute;left:0;right:0;top:0;height:8px;background:#1d130c;border-radius:2px}.tr-tab:after{content:'';position:absolute;left:11px;right:11px;top:8px;bottom:0;border-left:6px solid #1d130c;border-right:6px solid #1d130c}
.tr-roll{position:absolute;left:50%;bottom:68px;transform:translateX(-50%) rotate(-4deg);width:54px;height:16px;background:#efe4cc;border:2px solid #1d130c;border-radius:3px}
.tr-pl{display:grid;grid-template-columns:minmax(0,270px) 1fr minmax(0,270px);gap:12px;margin-top:10px}@media (max-width:900px){.tr-pl{grid-template-columns:1fr}.tr-frise{height:180px}}
.tr-who{background:rgba(0,0,0,.25);border:1px solid var(--line,#4a3a26);border-radius:6px;padding:9px 12px;display:flex;align-items:center;gap:10px}.tr-who.r{flex-direction:row-reverse;text-align:right;border-right:3px solid #c98a4e}.tr-who.l{border-left:3px solid #9a6fd6}
.tr-who img,.tr-who .av{width:48px;height:48px;border-radius:50%;border:2px solid var(--bz,#8a6a3c);object-fit:cover;flex:none;display:flex;align-items:center;justify-content:center;font-family:Marcellus,Georgia,serif;font-size:20px;background:#17110b;color:#c98a4e}
.tr-who .nm{font-family:Marcellus,Georgia,serif;font-size:16px;line-height:1.2}
.tr-ga{background:rgba(0,0,0,.25);border:1px solid var(--line,#4a3a26);border-radius:6px;padding:9px 14px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:center;font-size:13px}
.tr-ga .t{display:flex;justify-content:space-between;gap:6px;white-space:nowrap}.tr-ga .b{height:8px;background:#17110b;border-radius:4px;margin:4px 0;position:relative;overflow:hidden}.tr-ga .b i{position:absolute;left:0;top:0;bottom:0;border-radius:4px}.tr-ga small{color:var(--mu2,#c4b393);font-size:11.5px;display:block;line-height:1.25}
.tr-cols{display:grid;grid-template-columns:minmax(0,1fr) 270px minmax(0,1fr);gap:12px;margin-top:10px;align-items:stretch}@media (max-width:900px){.tr-cols{grid-template-columns:1fr}}
.tr-col{background:rgba(0,0,0,.25);border:1px solid var(--line,#4a3a26);border-radius:6px;padding:11px 13px;display:flex;flex-direction:column;gap:6px;min-width:0}.tr-col.mid{border-color:var(--bz,#8a6a3c);text-align:center}
.tr-col .ti{font-family:Marcellus,Georgia,serif;font-size:16px;color:var(--bzL,#d2ae6c)}
.tr-cl{display:grid;grid-template-columns:1fr auto auto;gap:2px 8px;align-items:center;border-bottom:1px solid var(--line,#4a3a26);padding-bottom:6px;font-size:13px}.tr-cl small{grid-column:1/-1;color:var(--mu2,#c4b393);font-size:12px;line-height:1.3}
.tr-cl select{max-width:150px}.tr-cl .x{width:26px;height:26px;padding:0;line-height:1}.tr-cl .du{color:var(--mu2,#c4b393);font-size:12px;white-space:nowrap}
.tr-add{margin-top:auto}.tr-add select{width:100%;min-height:36px;background:#17110b;color:inherit;border:1px dashed var(--bz,#8a6a3c);border-radius:4px;padding:4px 8px}
.tr-col select{background:#17110b;color:inherit;border:1px solid var(--line,#4a3a26);border-radius:4px;padding:2px 4px}
.tr-bal{height:10px;background:#17110b;border-radius:5px;position:relative}.tr-bal i{position:absolute;left:0;top:0;bottom:0;border-radius:5px}.tr-bal u{position:absolute;left:50%;top:-3px;width:2px;height:16px;background:var(--tx,#efe4cc)}
.tr-com{margin-top:10px;background:rgba(0,0,0,.25);border:1px solid var(--line,#4a3a26);border-radius:6px;padding:9px 13px;display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center}
.tr-com label{display:flex;gap:6px;align-items:center;font-size:13px}.tr-ban{border:1px solid #e0b458;background:rgba(224,180,88,.1);border-radius:6px;padding:9px 13px;margin-bottom:10px}
.tr-det{font-size:12px;text-align:left;list-style:none;margin:0;padding:0}.tr-det li{display:flex;justify-content:space-between;gap:8px}
.tr-ok{color:#8fd08f}.tr-mid{color:#e0b458}.tr-no{color:#f0a08a}`;document.head.appendChild(st)}
function trMe(){let nm='',por=null;try{const a=S.armies.filter(a=>a.side==='car'&&!a.dead&&!a.g&&!a.ship&&a.reinf==null).sort((a,b)=>armyMen(b)-armyMen(a))[0];if(a){nm=a.name;if(typeof porGenURL==='function')por=porGenURL(genOf(a)||{name:a.name,side:'car'})}}catch(e){}
  return {nm:nm||dvMe(),por}}
function trQuote(f,e,k,o){const t=dvP(f).t,F=S.fac[f];if(o.ult)return t==='fier'?'« On ne parle pas ainsi à un homme libre. »':'« Vous venez avec des menaces. Pesez bien ce que vous faites. »';
  if(!Object.keys(o.cl).length)return F.car>=30?'« Soyez le bienvenu. Que nous apportez-vous ? »':F.car<-10?'« Parlez vite. Nous n’avons pas oublié. »':'« Nous vous écoutons. »';
  if(k==='ok')return e.score>=15?'« Voilà une parole d’ami. Scellons cela. »':t==='cupide'?'« Le compte y est. »':'« Cela peut se faire. »';
  if(k==='mid')return t==='prudent'?'« Nous voudrions des garanties. »':t==='cupide'?'« Un peu plus d’or lèverait nos doutes. »':'« Vous n’êtes pas loin du compte. »';
  return t==='fier'?'« Vous demandez beaucoup et donnez peu. »':t==='belliqueux'?'« Des mots. Montrez-nous des victoires. »':'« Ce traité ne nous apporte rien. »'}
function trTable(f){trInit();const F=S.fac[f],o=DVS.offer&&DVS.offer.tr?DVS.offer:(DVS.offer=trNewOffer()),P=dvP(f),T=dvTr(f);trClean(f,o);
