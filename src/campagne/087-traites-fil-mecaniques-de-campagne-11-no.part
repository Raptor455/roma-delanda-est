/* ================= TRAITÉS (fil « Mécaniques de campagne », 11 nov. 2026, lot B) =================
   Source : /mnt/project-files/senat/traites.js, injecté juste après le bloc SÉNAT par senat/patch.py (relançable, remplace le bloc sur place).
   Des traités à clauses par-dessus la DIPLOMATIE VIVANTE (dipl.js) : ce que vous offrez, ce que vous demandez, les engagements communs,
   une durée (1, 2 ou 5 ans), une contre-proposition du peuple, la ratification par le Sénat (S.sen.rat), l'ultimatum,
   la rupture (motif de guerre S.cb[f]) et les propositions qui viennent des peuples (S.trq).
   La table de négociation remplace l'ancien volet « Négocier » : deux chefs face à face avec leurs gardes (figures vaseSVG du jeu).
   État : S.tr=[{id,f,d0,until,cl:{clé:paramètre}}] traités en vigueur ; S.trw=[{id,f,o,cost,dm,until}] en attente de ratification ;
   S.trc={f,o,cost,dm,until,ch:[]} contre-proposition en attente ; S.trq={f,o,until} proposition d'un peuple ; S.cb={f:jour} motifs de guerre.
   Enveloppe sans les réécrire : dvRender, dvArrive, senRatDone, declareWar, capture, daily, afterLoad. */
const TR_DUR=[[360,'1 an',.75],[720,'2 ans',1],[1800,'5 ans',1.4]];
const trDurK=o=>(TR_DUR.find(x=>x[0]===o.dur)||TR_DUR[1])[2];
const trDurT=o=>(TR_DUR.find(x=>x[0]===o.dur)||TR_DUR[1])[1];
const trYears=o=>o.dur/360;
function trInit(){if(!S)return;S.tr=S.tr||[];S.trw=S.trw||[];S.cb=S.cb||{};if(S.truid==null)S.truid=1;dvInit()}
const trOf=f=>(S.tr||[]).filter(t=>t.f===f);
const trHas=(f,k)=>trOf(f).some(t=>t.cl[k]!=null);
const trThreat=f=>dvNear(f,'rom',260)>0;
const trWants=(f,k)=>dvP(f).w.some(w=>w[0]===k);
const trCapN=f=>dvTowns(f).sort((a,b)=>b.size-a.size)[0];
function trTakeTown(id,f){const i=NI[id];if(i==null||ownerN(i)!==f)return false;const n=N[i];S.own[id]='car';delete S.siege[id];
  for(const a of S.armies)if(a.side===f&&a.g&&a.at===i){a.side='car';a.name='Garnison '+deN(n.n)}
  territoryDirty=true;try{if(typeof garFill==='function')garFill(n)}catch(e){}return true}
function trAllies(f,k,name){const Tn=trCapN(f);if(!Tn)return null;const t=poolOf(f),units=Array.from({length:k},()=>({t,men:UT[t].men}));
  const a={id:S.uid++,side:'car',name:name||('Alliés '+FAC[f].n.toLowerCase()),x:Tn.x,y:Tn.y,at:Tn.i,legs:[],units,scout:0,cool:0,mor:65,food:12};S.armies.push(a);
  try{for(const u of units)if(typeof depOne==='function')depOne(a,u,{})}catch(e){}try{syncGens()}catch(e){}return a}
/* ---- les clauses. s : 'o' vous offrez, 'd' vous demandez, 'm' engagement commun. dur : clause datée (elle court le temps du traité).
   v(f,F,p,o) = ce qu'elle vaut pour eux (positif : ça leur plaît). now = effet à la signature, mon = chaque mois, end = à l'échéance. ---- */
const TR_C={
  or:{s:'o',n:'Un présent en or',d:p=>`${p} or, versés à la signature.`,par:()=>[25,50,75,100,150,200,300,400].filter(v=>v<=S.gold.car),ok:()=>S.gold.car>=25,
    v:(f,F,p)=>p/8*dvTr(f).gold,now:(f,F,p)=>{F.dvg=(F.dvg||0)+p;return p+' or'}},
  sub:{s:'o',dur:1,n:'Des subsides',d:p=>`${p} or par mois pendant toute la durée du traité.`,par:()=>[10,20,40],ok:()=>true,aff:[.1,-.5,-.2],rat:p=>p>=20,
    v:(f,F,p,o)=>Math.min(45,p*o.dur/30/8*dvTr(f).gold*.5*S.dv.rep/60),lab:p=>`${p} or par mois`,
    mon:(f,F,p,T)=>{if(S.gold.car>=p){S.gold.car-=p;F.dvg=(F.dvg||0)+p;return}trBreak(T,'les subsides promis ne sont plus versés')}},
  ville:{s:'o',n:'Céder une ville',d:p=>`${N[NI[p]]?N[NI[p]].n:'La ville'} passe sous leur autorité.`,par:f=>dvTownsFor(f).map(x=>x.n.id),parT:(f,p)=>N[NI[p]].n+(dvTownsFor(f).some(x=>x.n.id===p&&x.want)?' ★':''),ok:f=>dvTownsFor(f).length>0,aff:[-.6,-.2,.2],rat:()=>true,
    v:(f,F,p)=>{const n=N[NI[p]],w=dvTownsFor(f).find(x=>x.n.id===p);return n?(10+n.size*8)*(w&&w.want?2:1)*dvTr(f).town:0},now:(f,F,p)=>dvGiveTown(p,f)?N[NI[p]].n:''},
  otages:{s:'o',n:'Livrer des otages',d:()=>'Des fils de grande famille partent chez eux, gage de votre parole.',ok:(f,F)=>!F.ot,v:()=>12,now:(f,F)=>{F.ot=1;return 'des otages'}},
  mariage:{s:'o',n:'Un mariage royal',d:()=>'Une fille de grande famille épouse leur roi.',ok:f=>['num','mae'].includes(f)&&!S.mar,v:f=>trWants(f,'mariage')?28:18,now:(f,F)=>{S.mar=f;F.rom-=10;return 'un mariage royal'}},
  garantie:{s:'o',dur:1,n:'Garantie de défense',d:()=>'S’ils sont attaqués, une de vos armées doit venir dans les 45 jours.',ok:f=>!dvActive(f).some(p=>p.k==='def'),
    v:(f,F,p,o)=>(trThreat(f)?18:8)*(trWants(f,'protect')?1.3:1)*S.dv.rep/60*dvTr(f).prom,now:(f,F,p,T,o)=>{dvPromise({f,k:'def',until:Math.floor(S.day)+o.dur});return 'votre garantie'}},
  frapper:{s:'o',n:'Frapper leurs rivaux',d:p=>`Vous promettez de prendre une ville ${FAC[p]?dvDes(p):''} d'ici un an.`,par:f=>dvRivalsFor(f),parT:(f,p)=>dvC(dvLes(p)),ok:f=>dvRivalsFor(f).length>0&&!dvActive(f).some(p=>p.k==='riv'),
    v:(f,F,p)=>((trWants(f,'guerre')&&dvP(f).w.some(w=>w[0]==='guerre'&&w[1]===p))||dvP(f).r.includes(p)?18:6)*S.dv.rep/60*dvTr(f).prom,now:(f,F,p)=>{dvPromise({f,k:'riv',r:p,until:Math.floor(S.day)+360});return `la promesse de frapper ${dvLes(p)}`}},
  ceder:{s:'o',n:'Leur promettre une ville à prendre',d:p=>`Dès que vous prendrez ${N[NI[p]]?N[NI[p]].n:'la ville'}, elle sera pour eux.`,par:f=>dvCovet(f),parT:(f,p)=>N[NI[p]].n,ok:f=>dvCovet(f).length>0&&!dvActive(f).some(p=>p.k==='cede'),
    v:f=>12*S.dv.rep/60*dvTr(f).prom*dvTr(f).town,now:(f,F,p)=>{dvPromise({f,k:'cede',t:p,until:Math.floor(S.day)+1080});return `la promesse de ${N[NI[p]].n}`}},
  rendre:{s:'o',n:'Rendre leurs otages',d:()=>'Leurs fils rentrent chez eux : ils retrouvent leur liberté d’alliance.',ok:(f,F)=>!!F.otD,v:f=>16*dvTr(f).prom,now:(f,F)=>{F.otD=0;return 'leurs otages rendus'}},
  remise:{s:'o',n:'Remettre le tribut',d:()=>'Ils cessent de payer tribut et deviennent vos amis par traité.',ok:(f,F)=>F.st==='tribut_car',aff:[-.4,-.3,.3],rat:()=>true,v:()=>25,now:(f,F)=>{F.st='pacte_car';territoryDirty=true;return 'la remise du tribut'}},
  butin:{s:'o',dur:1,n:'Une part du butin',d:()=>'À chaque ville que vous prenez, 30 or leur reviennent.',ok:()=>true,v:(f,F,p,o)=>(trWants(f,'butin')?12:6)*dvTr(f).vic*S.dv.rep/60},

  nonag:{s:'m',dur:1,n:'Pacte de non-agression',d:()=>`Ni vous ni eux ne prenez les armes l'un contre l'autre ; ils ne s'allient pas à ${dvEnemy()}.`,ok:(f,F)=>F.st==='neutre'&&!trHas(f,'nonag'),
    v:(f,F)=>{const K=dvFear(f).v,t=dvP(f).t;return (K>10||t==='prudent'?6:2)-(t==='belliqueux'&&F.car<0?5:0)-Math.max(0,F.rom)*.12},now:(f,F,p,T,o)=>{F.neu=Math.max(F.neu||0,Math.floor(S.day)+o.dur);return 'un pacte de non-agression'},
    mon:(f,F)=>{F.car=Math.min(100,F.car+.5)}},
  commerce:{s:'m',dur:1,n:'Traité de commerce',d:f=>`Vos marchands et les leurs circulent librement : environ ${trComm(f)} or par mois pour vous.`,ok:(f,F)=>['neutre','pacte_car','tribut_car'].includes(F.st)&&!trHas(f,'commerce'),aff:[0,.6,.1],
    v:f=>(trWants(f,'commerce')?14:6)*dvTr(f).gold,now:()=>'un traité de commerce',mon:(f,F)=>{S.gold.car+=trComm(f);F.car=Math.min(100,F.car+.5)}},
  defa:{s:'m',dur:1,n:'Alliance défensive',d:()=>`Si ${dvEnemy()} assiège une de vos villes, ils envoient un corps de secours ; s'ils sont attaqués, vous devez venir.`,ok:(f,F)=>['neutre','pacte_car'].includes(F.st)&&!trHas(f,'defa'),aff:[.5,.2,-.5],rat:()=>true,
    v:(f,F)=>(trThreat(f)?15:-8)+(F.car<20?-15:0)+(trWants(f,'protect')?6:0),now:(f,F,p,T,o)=>{const u=Math.floor(S.day)+o.dur;if(!dvActive(f).some(x=>x.k==='def'))dvPromise({f,k:'def',until:u});F.neu=Math.max(F.neu||0,u);return 'une alliance défensive'}},

  pass:{s:'d',dur:1,n:'Droit de passage',d:()=>'Vos armées et vos convois traversent leurs terres.',ok:(f,F)=>F.st==='neutre'&&!F.pass,v:f=>-(8+(trThreat(f)?10:0)),now:(f,F)=>{F.pass=1;return 'le droit de passage'},end:(f,F)=>{if(F.st==='neutre')F.pass=0}},
  portes:{s:'d',dur:1,n:`Fermer leurs portes à l'ennemi`,d:()=>`Ils renvoient les émissaires de ${dvEnemy()} sans les entendre.`,ok:(f,F)=>F.st==='neutre'&&!(F.noR>S.day),v:(f,F)=>-(10+Math.max(0,F.rom)*.3),now:(f,F,p,T,o)=>{F.noR=Math.floor(S.day)+o.dur;return 'leurs portes fermées à l’ennemi'}},
  vivres:{s:'d',dur:1,n:'Fournitures de vivres',d:()=>'Chaque mois, vos armées à moins de 300 km de leurs villes reçoivent dix jours de vivres.',ok:(f,F)=>['neutre','pacte_car','tribut_car'].includes(F.st)&&!trHas(f,'vivres'),v:()=>-8,now:()=>'des vivres',
    mon:f=>{const T=dvTowns(f);for(const a of S.armies)if(a.side==='car'&&!a.dead&&!a.g&&!a.ship&&T.some(n=>Math.hypot(a.x-n.x,a.y-n.y)<300))a.food=(a.food||0)+10}},
  mercs:{s:'d',dur:1,n:'Droit de lever des mercenaires',d:()=>'Tous les trois mois, vous pouvez enrôler chez eux deux régiments pour 90 or (depuis leur fiche).',ok:(f,F)=>['neutre','pacte_car','tribut_car'].includes(F.st)&&!trHas(f,'mercs'),v:f=>dvP(f).t==='cupide'?3:-6,now:()=>'le droit de lever des mercenaires'},
  troupes:{s:'d',n:'Un contingent',d:()=>'Deux ou trois régiments de leur peuple vous rejoignent tout de suite.',ok:(f,F)=>F.st==='pacte_car'||F.st==='tribut_car',v:()=>-15,
    now:f=>{const t=poolOf(f),a=trAllies(f,t==='ncav'||t==='sling'?3:2);return a?`${a.units.length} régiments (à ${N[a.at].n})`:''}},
  annuel:{s:'d',dur:1,n:'Un contingent chaque printemps',d:()=>'Deux régiments de leur peuple vous rejoignent à chaque printemps du traité.',ok:(f,F)=>(F.st==='pacte_car'||F.st==='tribut_car')&&!trHas(f,'annuel'),v:(f,F,p,o)=>-10*trYears(o)/trDurK(o),now:()=>'un contingent annuel'},
  otagesD:{s:'d',n:'Des otages',d:()=>`Leurs fils de chefs chez vous : ils ne pourront plus s'allier à ${dvEnemy()}.`,ok:(f,F)=>['neutre','pacte_car','tribut_car'].includes(F.st)&&!F.otD,v:()=>-18,now:(f,F)=>{F.otD=1;return 'des otages'}},
  orD:{s:'d',n:'Un versement d’or',d:p=>`Ils vous versent ${p} or à la signature.`,par:()=>[50,100,200],ok:(f,F)=>F.st!=='guerre_car',v:(f,F,p)=>-p/6*dvTr(f).gold,now:(f,F,p)=>{S.gold.car+=p;return p+' or'}},
  amitie:{s:'d',n:'Traité d’amitié',d:()=>'Ils gardent leurs villes, ouvrent leurs routes et peuvent vous prêter des troupes. Sans limite de durée.',ok:(f,F)=>F.st==='neutre',v:(f,F)=>-(25+Math.max(0,F.rom)*.15),now:(f,F)=>{F.st='pacte_car';F.pass=1;territoryDirty=true;return 'un traité d’amitié'}},
  tribut:{s:'d',n:'Tribut',d:()=>'Ils deviennent vos tributaires et paient la moitié du revenu de leurs villes. Seule la crainte les y décide.',ok:(f,F)=>F.st==='neutre',v:f=>-45-(dvFear(f).v<15?25:0),now:(f,F)=>{F.st='tribut_car';F.fid=55;F.pass=1;territoryDirty=true;return 'un tribut'}},
  ville_d:{s:'d',n:'Qu’ils vous cèdent une ville',d:p=>`${N[NI[p]]?N[NI[p]].n:'La ville'} passe sous votre autorité.`,par:f=>{const c=trCapN(f);return dvTowns(f).filter(n=>n!==c).map(n=>n.id)},parT:(f,p)=>N[NI[p]].n,ok:f=>dvTowns(f).length>1,
    v:(f,F,p)=>{const n=N[NI[p]];return -((30+(n?n.size:1)*15)*dvTr(f).town+(dvFear(f).v<20?20:0))},now:(f,F,p)=>trTakeTown(p,f)?N[NI[p]].n:''},
  alliance:{s:'d',n:'Alliance de guerre',d:()=>'Ils rejoignent votre camp avec leurs villes et leurs troupes, jusqu’à la fin de la guerre.',ok:(f,F)=>['neutre','pacte_car','tribut_car'].includes(F.st),aff:[.8,.3,-.6],rat:()=>true,
    v:(f,F)=>-(F.st==='tribut_car'?35:55+Math.max(0,F.rom)*.3),now:f=>{joinAlliance(f,'car');return 'leur alliance'}},
  paix:{s:'d',n:'La paix',d:()=>'Fin de la guerre : ils redeviennent neutres.',ok:(f,F)=>F.st==='guerre_car',aff:[-.5,.4,.8],rat:()=>true,v:()=>-20,now:(f,F)=>{F.st='neutre';F.car=Math.max(F.car,-20);territoryDirty=true;return 'la paix'}},
  indemn:{s:'d',n:'Une indemnité de guerre',d:p=>`Ils paient ${p} or pour prix de la paix.`,par:()=>[100,200,300],ok:(f,F)=>F.st==='guerre_car',v:(f,F,p)=>-p/5*dvTr(f).gold-(dvFear(f).v<15?15:0),now:(f,F,p)=>{S.gold.car+=p;return p+' or d’indemnité'}}
};
function trComm(f){let s=0;for(const n of dvTowns(f))s+=1+n.size+(n.port?1:0);return Math.max(4,Math.min(30,Math.round(s*1.5)))}
function trNewOffer(){return {tr:1,dur:720,cl:{},ult:0}}
function trAvail(f,s){trInit();const F=S.fac[f];return Object.keys(TR_C).filter(k=>TR_C[k].s===s&&TR_C[k].ok(f,F)&&(!TR_C[k].par||TR_C[k].par(f).length))}
function trVal(f,k,p,o){const C=TR_C[k],F=S.fac[f];let v=C.v(f,F,p,o);if(C.dur&&k!=='sub'&&k!=='annuel')v*=trDurK(o);return v}
function trEval(f,o){trInit();const D=dvDisp(f),G=[],M=[],F=S.fac[f];
  for(const k in o.cl){const C=TR_C[k];if(!C||!C.ok(f,F))continue;const v=trVal(f,k,o.cl[k],o),lab=C.n+(C.par?' · '+(C.lab?C.lab(o.cl[k]):C.parT?C.parT(f,o.cl[k]):o.cl[k]+' or'):'');(v>=0?G:M).push([lab,v,k])}
  if(o.cl.alliance&&o.cl.amitie)M.push(['Demander à la fois amitié et alliance n’a pas de sens',-5]);
  if(o.ult){const K=dvFear(f).v,T=dvTr(f);G.push(['Ultimatum : la peur parle',Math.max(0,K)*T.fear*1.2-(T.ins?10:0)-4])}
  const gv=G.reduce((s,x)=>s+x[1],0),mv=M.reduce((s,x)=>s+x[1],0),pure=!Object.keys(o.cl).some(k=>TR_C[k]&&TR_C[k].s!=='o');
  return {D,G,M,gv,mv,score:D.v+gv+mv,pure}}
function trVerdict(e){if(e.pure)return e.gv>0?['ok','Ils accepteront vos présents avec plaisir.']:['no','Rien sur la table.'];
  const s=e.score;return s>=8?['ok','Ils accepteraient.']:s>=0?['ok','Ils accepteraient · marge faible.']:s>=-8?['mid','Ils hésitent : tout se jouera à peu de chose.']:['no','Ils refuseraient.']}
// leur contre-proposition : ils ajoutent ce qu'ils désirent, demandent de l'or, puis retirent votre plus grosse demande
function trCounter(f,o,e){if(e.pure||e.score>=2)return null;const F=S.fac[f],o2=JSON.parse(JSON.stringify(o)),ch=[];let E=e;const ok=()=>E.score>=3;
  const add=(k,p,t)=>{if(ok()||o2.cl[k]!=null||!TR_C[k].ok(f,F))return;if(TR_C[k].par){const L=TR_C[k].par(f);if(!L.length)return;if(p==null||!L.includes(p))p=L[0]}else p=1;
    o2.cl[k]=p;const E2=trEval(f,o2);if(E2.score<=E.score+.5){delete o2.cl[k];return}E=E2;ch.push('+ '+t(p))};
  if(trThreat(f))add('garantie',null,()=>'votre garantie de défense');
  if(trWants(f,'commerce'))add('commerce',null,()=>'un traité de commerce');
  const want=dvTownsFor(f).find(x=>x.want);if(want)add('ville',want.n.id,p=>`la ville de ${N[NI[p]].n}`);
  if(dvCovet(f).length)add('ceder',null,p=>`la promesse de ${N[NI[p]].n}`);
  if(dvRivalsFor(f).length)add('frapper',null,p=>`votre promesse de frapper ${dvLes(p)}`);
  if(trWants(f,'butin'))add('butin',null,()=>'une part du butin');
  if(S.fac[f].otD)add('rendre',null,()=>'leurs otages rendus');
  if(!ok()){const T=dvTr(f),need=Math.ceil((3-E.score)*8/T.gold/25)*25,cur=o2.cl.or||0,max=Math.floor(Math.min(400,S.gold.car)/25)*25;
    if(need>0&&cur+need<=max){o2.cl.or=cur+need;E=trEval(f,o2);ch.push(`+ ${need} or`)}}
  let guard=0;while(!ok()&&guard++<4){const big=E.M.filter(x=>x[2]).sort((a,b)=>a[1]-b[1])[0];if(!big||E.M.filter(x=>x[2]).length<2)break;delete o2.cl[big[2]];E=trEval(f,o2);ch.push('− '+big[0].toLowerCase())}
  if(!ok()||!ch.length)return null;return {o:o2,ch,e:E}}
// ratification : les clauses lourdes passent devant le Sénat
function trRat(o){let need=false;const aff=[0,0,0];for(const k in o.cl){const C=TR_C[k];if(!C||!C.aff)continue;if(C.rat&&C.rat(o.cl[k]))need=true;for(let i=0;i<3;i++)aff[i]+=C.aff[i]}
  if(!need||!S.sen||typeof senVotes!=='function')return null;return aff.map(v=>dvClamp(v,-1,1))}
function trSummary(f,o){const a=[],b=[],m=[];for(const k in o.cl){const C=TR_C[k];if(!C)continue;const t=C.n.toLowerCase()+(C.par?` (${C.lab?C.lab(o.cl[k]):C.parT?C.parT(f,o.cl[k]):o.cl[k]+' or'})`:'');(C.s==='o'?a:C.s==='d'?b:m).push(t)}
  return [m.length?m.join(', '):'',b.length?'vous obtenez : '+b.join(', '):'',a.length?'vous donnez : '+a.join(', '):''].filter(Boolean).join(' ; ')}
function trCost(o){return o.cl.or||0}
/* ---- envoi, arrivée, signature ---- */
function trSend(f){trInit();const F=S.fac[f],o=DVS.offer;if(!o||!o.tr||F.cd>0)return;if(!Object.keys(o.cl).length)return;
  if((S.env||[]).some(x=>x.f===f&&x.kind!=='s'))return;const cost=trCost(o);if(S.gold.car<cost)return;const t=dvTarget(f);if(!t)return;const og=envOrigin(t);if(!og)return;
  S.gold.car-=cost;F.cd=1;S.env=S.env||[];const days=Math.max(1,Math.round(Math.hypot(t.x-og[0],t.y-og[1])/ENV_KMD));
  S.env.push({kind:'n',key:'neg',f,x:og[0],y:og[1],tx:t.x,ty:t.y,tn:t.n,cost,o:JSON.parse(JSON.stringify(o)),dm:dvDm()});
  log(`Ambassade partie vers ${t.n} (${FAC[f].n}) avec votre projet de traité${o.ult?' — un ultimatum':''} : ≈ ${days} jour${days>1?'s':''}.`);
  DVS.view='fiche';DVS.offer=null;renderAll();openDip(f)}
function trClean(f,o){const F=S.fac[f];for(const k in o.cl){const C=TR_C[k];if(!C||!C.ok(f,F)){delete o.cl[k];continue}if(C.par&&!C.par(f).includes(o.cl[k])&&k!=='or')delete o.cl[k]}return o}
let trArrive=function(e){trInit();const f=e.f,F=S.fac[f];if(!F)return;F.cd=1;const o=trClean(f,e.o);
  const refund=()=>{if(e.cost)dvWith(e.dm,()=>{S.gold.car+=e.cost})};
  if(!Object.keys(o.cl).length){refund();log(`Votre projet de traité avec ${dvLes(f)} n'a plus d'objet.`);return}
  const ev=trEval(f,o),T=dvTr(f),jit=o.ult?0:(Math.random()-.5)*8,ok=ev.pure?ev.gv>0:ev.score+jit>=0;
  if(ok){if(o.ult){F.car-=8;F.why=F.why||{};F.why['votre ultimatum']=(F.why['votre ultimatum']||0)-8}return trSign(f,o,e.cost,e.dm)}
  if(o.ult){refund();F.car-=20;F.rom=Math.min(100,F.rom+12);F.why=F.why||{};F.why['votre ultimatum']=(F.why['votre ultimatum']||0)-20;
    const t=`${dvC(dvLes(f))} rejettent votre ultimatum (confiance −20) et se tournent vers ${dvEnemy()}.`;log(t);dvCard(`Réponse ${dvDes(f)}`,t,true);return}
  const c=trCounter(f,o,ev);
  if(c){S.trc={f,o:c.o,cost:e.cost,dm:e.dm,until:Math.floor(S.day)+20,ch:c.ch};const t=`${dvC(dvLes(f))} ne signent pas tel quel, mais font une contre-proposition : ${c.ch.join(', ')}.`;log(t+' (20 jours pour répondre)');
    if(!S.auto)S.paused=true;if($('modal').hidden&&!S.cur&&!S.over){DVS.f=f;DVS.view='neg';DVS.offer=JSON.parse(JSON.stringify(c.o));DVS.offer.ctr=1;dvRender()}return}
  refund();let t=`${dvC(dvLes(f))} repoussent votre projet de traité.`;const why=[...ev.D.L,...ev.M].filter(x=>x[1]<-3).sort((a,b)=>a[1]-b[1]).slice(0,2).map(x=>x[0].toLowerCase());
