  if(S.trq&&S.trq.f===f)L.push(`<div class="dv-req"><b>Ils vous proposent un traité</b> <span class="sub">(${Math.max(0,S.trq.until-D)} jours pour répondre)</span><br>${esc(dvC(trSummary(f,S.trq.o)))}.<div class="row"><button type="button" class="go" id="trSeeQ">Voir la proposition</button></div></div>`);
  if(S.trc&&S.trc.f===f)L.push(`<div class="dv-req"><b>Leur contre-proposition</b> <span class="sub">(${Math.max(0,S.trc.until-D)} jours pour répondre)</span><br>${esc(S.trc.ch.join(', '))}.<div class="row"><button type="button" class="go" id="trSeeC">Voir</button></div></div>`);
  for(const W of S.trw.filter(x=>x.f===f))L.push(`<div class="dv-req"><b>Traité en attente de ratification</b> <span class="sub">(${Math.max(0,W.until-D)} jours)</span><br>${esc(dvC(trSummary(f,W.o)))}.<div class="row"><button type="button" class="go" data-trsen="1">Aller au Sénat</button></div></div>`);
  if(S.cb[f]>D)L.push(`<div class="dv-req"><b>Motif de guerre légitime</b> : ils ont dénoncé un traité. Jusqu'à ${dvDate(S.cb[f])}, leur déclarer la guerre ne ternira pas votre réputation.</div>`);
  const T=trOf(f);if(T.length)L.push(`<div class="dv-sec"><b>Traités en vigueur</b><ul class="dv-w">${T.map(t=>`<li><span>⚖</span><span>${esc(dvC(Object.keys(t.cl).map(k=>TR_C[k]?TR_C[k].n.toLowerCase()+(TR_C[k].lab?' ('+TR_C[k].lab(t.cl[k])+')':''):k).join(', ')))}</span><small>jusqu'à ${dvDate(t.until)} (${Math.max(0,Math.ceil((t.until-D)/30))} mois)${t.cl.mercs!=null?` <button type="button" data-trmerc="${f}" ${S.gold.car<90||(t.mc||0)>S.day?'disabled':''}>Lever 2 régiments (90 or)</button>`:''} <button type="button" data-trden="${t.id}" title="Confiance −12, réputation −5">Dénoncer</button></small></li>`).join('')}</ul></div>`);
