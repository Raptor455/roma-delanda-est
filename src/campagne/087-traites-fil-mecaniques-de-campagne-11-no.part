function trDenounce(id){const T=S.tr.find(x=>x.id===id);if(!T)return;const f=T.f,F=S.fac[f];trEnd(T,'rupture');F.car-=12;F.why=F.why||{};F.why['traité dénoncé']=(F.why['traité dénoncé']||0)-12;S.dv.rep=dvClamp(S.dv.rep-5,0,100);
  log(`Vous dénoncez le traité avec ${dvLes(f)} (confiance −12, réputation −5).`);renderAll();openDip(f)}
