    if(!S.auto)S.paused=true;if($('modal').hidden&&!S.cur&&!S.over)trOpenQ();return}}
function trOpenQ(){const q=S.trq;if(!q||!S.fac[q.f])return;DVS.f=q.f;DVS.tab='peu';DVS.view='neg';DVS.offer=JSON.parse(JSON.stringify(q.o));DVS.offer.from=1;dvRender()}
function trAcceptQ(){const q=S.trq;if(!q)return;const o=trClean(q.f,q.o),c=trCost(o);if(S.gold.car<c)return;S.gold.car-=c;S.trq=null;DVS.view='fiche';DVS.offer=null;closeModal();trSign(q.f,o,c,dvDm());renderAll()}
