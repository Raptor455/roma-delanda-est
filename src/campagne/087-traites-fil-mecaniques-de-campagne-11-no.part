    S.sen.rat.push({id,n:`le traité avec ${dvLes(f)}`,d:dvC(trSummary(f,o))+`. Durée : ${trDurT(o)}. À ratifier sous 60 jours.`,aff,tr:id});
    const t=`Accord trouvé avec ${dvLes(f)} ! Reste à faire ratifier le traité par ${typeof senProf==='function'?senProf().sub.replace(/^Le |^La |^Les /,m=>m.toLowerCase()):'le Sénat'} (60 jours).`;log(t);
    if($('modal').hidden&&!S.cur&&!S.over){modal(`<h2>Réponse ${esc(dvDes(f))}</h2><p>${esc(t)}</p><div class="row" style="justify-content:flex-end"><button type="button" class="go" id="trGoS">Aller au Sénat</button><button id="mClose" type="button">Plus tard</button></div>`);$('mClose').onclick=closeModal;$('trGoS').onclick=()=>{try{SEN_UI.tab='mo';SEN_UI.cat='t'}catch(e){}openPol()}}
