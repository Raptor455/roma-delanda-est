{const _da=dvArrive;dvArrive=function(e){if(e&&e.o&&e.o.tr){try{return trArrive(e)}catch(x){console.error(x)}return}return _da.apply(this,arguments)}}
if(typeof senRatDone==='function'){const _rd=senRatDone;senRatDone=function(R,ok){if(R&&R.tr!=null){S.sen.rat=(S.sen.rat||[]).filter(x=>x.id!==R.id);return trRatified(R.tr,ok)}return _rd.apply(this,arguments)}}
function trRatified(id,ok){const W=(S.trw||[]).find(x=>x.id===id);if(!W)return 'Le traité n’est plus d’actualité.';S.trw=S.trw.filter(x=>x!==W);const F=S.fac[W.f];if(!F)return '';
