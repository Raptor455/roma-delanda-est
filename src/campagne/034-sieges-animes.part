/* ================= SIÈGES ANIMÉS ================= */
// l'armée qui assiège encercle la ville : régiments en anneau, palissade, catapultes qui tirent, tours qui s'approchent des murs
const hsh=(x)=>{const v=Math.sin(x*127.1+311.7)*43758.5453;return v-Math.floor(v)};
function siegeFormation(a,s,sg){
  const n=N[a.at],g=cityGeom(n),c=FAC[a.side].c,dark='rgba(26,18,10,.95)',q=UNIT_KM*s,T=S.day*DAY_S,f=Math.min(1,sg.d/sg.need);
  const SX=x=>view.ox+x*s,SY=y=>view.oy+y*s;
  const R=g.wall.map(w=>{const ang=Math.atan2(w[1]-g.cy,w[0]-g.cx),rr=Math.hypot(w[0]-g.cx,w[1]-g.cy);return {ang,rr}});
  const at=(r,d)=>[g.cx+Math.cos(r.ang)*(r.rr+d),g.cy+Math.sin(r.ang)*(r.rr+d)];
  const ok=R.map(r=>{const p=at(r,.6);return landFast(p[0],p[1])});
  const cand=R.map((r,k)=>k).filter(k=>ok[k]);if(!cand.length){_formation(a,s);return}
  ctx.save();
  // palissade de contrevallation
  const lw=Math.max(1.2,.04*s);ctx.lineCap='round';
  for(const pass of [0,1]){ctx.beginPath();let open=false;
    for(let k=0;k<=R.length;k++){const kk=k%R.length;if(!ok[kk]){open=false;continue}const p=at(R[kk],1);if(open)ctx.lineTo(SX(p[0]),SY(p[1]));else{ctx.moveTo(SX(p[0]),SY(p[1]));open=true}}
    if(pass===0){ctx.strokeStyle='rgba(60,40,20,.45)';ctx.lineWidth=lw*3;ctx.setLineDash([])}else{ctx.strokeStyle='#7a5632';ctx.lineWidth=lw;ctx.setLineDash([lw*1.5,lw*1.5])}ctx.stroke()}
  ctx.setLineDash([]);
  // régiments en anneau
  const U=a.units.slice().sort((p,r)=>MARCH[UT[p.t].k]-MARCH[UT[r.t].k]),pts=[];
  U.forEach((u,i)=>{const k=cand[Math.floor((i+.5)*cand.length/U.length)],p=at(R[k],.55);pts.push([SX(p[0]),SY(p[1])])});
  if(sel&&sel.a===a){ctx.fillStyle='rgba(255,243,196,.35)';pts.forEach(([x,y])=>{ctx.beginPath();ctx.arc(x,y,q*.9,0,7);ctx.fill()})}
  U.forEach((u,i)=>unitSq(pts[i][0],pts[i][1],q,u,c,dark));
  // fumées dans la ville, de plus en plus nombreuses
  const nf=Math.floor(f*(2+n.size*1.5));
  for(let j=0;j<nf;j++){const an=hsh(j+n.i)*6.283,rd=g.r*.55*hsh(j*3+n.i),x=SX(g.cx+Math.cos(an)*rd),y=SY(g.cy+Math.sin(an)*rd);
    for(let p=0;p<4;p++){const ph=((T*.25+p/4+hsh(j))%1),r0=Math.max(3,.07*s)*(1+ph*2.5);ctx.fillStyle=`rgba(60,55,50,${.55*(1-ph)})`;ctx.beginPath();ctx.arc(x+ph*r0*.8,y-ph*Math.max(10,.5*s),r0,0,7);ctx.fill()}
    ctx.fillStyle=`rgba(255,${140+Math.floor(60*hsh(j+T|0))},40,.8)`;ctx.beginPath();ctx.arc(x,y,Math.max(2.5,.045*s),0,7);ctx.fill()}
  // catapultes
  const GV=typeof genSV==='function',E=Math.max(8,.24*s),ne0=Math.min(cand.length,2+n.size),ne=GV?ne0*genSV(sg,'cat'):ne0;
  for(let j=0;j<ne;j++){const k=cand[Math.floor((j+.0)*cand.length/ne)],r=R[k],p=at(r,.82),x=SX(p[0]),y=SY(p[1]),P=4+(j%3)*.9,cyc=(T+j*1.7)/P,ph=cyc-Math.floor(cyc);
    const dir=r.ang+Math.PI; // vers la ville
    ctx.save();ctx.translate(x,y);
    ctx.fillStyle='#6b4a2a';ctx.strokeStyle='#2b1c0e';ctx.lineWidth=Math.max(1,E*.12);ctx.fillRect(-E*.5,-E*.18,E,E*.36);ctx.strokeRect(-E*.5,-E*.18,E,E*.36);
    ctx.fillStyle='#2b1c0e';for(const wx of [-.35,.35])for(const wy of [-.22,.22]){ctx.beginPath();ctx.arc(wx*E,wy*E,E*.09,0,7);ctx.fill()}
    // bras : se rabat d'un coup au tir, puis se retend lentement
    const back=-.95,fwd=.65,armA=ph<.1?back+(fwd-back)*(ph/.1):fwd+(back-fwd)*Math.min(1,(ph-.1)/.6);
    const ux=Math.cos(dir)>=0?1:-1,L=E*1.05,tipx=ux*Math.sin(armA)*L,tipy=-E*.1-Math.cos(armA)*L;
    ctx.strokeStyle='#4a3218';ctx.lineWidth=Math.max(1.2,E*.14);ctx.beginPath();ctx.moveTo(0,-E*.1);ctx.lineTo(tipx,tipy);ctx.stroke();
    ctx.fillStyle='#3a2a1a';ctx.beginPath();ctx.arc(tipx,tipy,E*.13,0,7);ctx.fill();
    ctx.restore();
    // projectile puis impact
    const shot=Math.floor(cyc),ta=hsh(shot*7.3+j)*6.283,tr=g.r*(.2+.6*hsh(shot*3.1+j)),tx=g.cx+Math.cos(ta)*tr*.6+Math.cos(r.ang)*g.r*.35,ty=g.cy+Math.sin(ta)*tr*.6+Math.sin(r.ang)*g.r*.35;
    const X2=SX(tx),Y2=SY(ty);
    if(ph>.1&&ph<.55){const t=(ph-.1)/.45,bx=x+(X2-x)*t,by=y+(Y2-y)*t-Math.sin(t*Math.PI)*Math.max(14,Math.hypot(X2-x,Y2-y)*.45);
      ctx.fillStyle='rgba(0,0,0,.25)';ctx.beginPath();ctx.arc(x+(X2-x)*t,y+(Y2-y)*t,Math.max(1.2,E*.08),0,7);ctx.fill();
      ctx.fillStyle='#2e241a';ctx.beginPath();ctx.arc(bx,by,Math.max(1.8,E*.13),0,7);ctx.fill()}
    else if(ph>=.55&&ph<.95){const t=(ph-.55)/.4;ctx.fillStyle=`rgba(190,170,140,${.7*(1-t)})`;ctx.beginPath();ctx.arc(X2,Y2,Math.max(3,E*.5)*(.4+t*1.4),0,7);ctx.fill();
      if(t<.35){ctx.fillStyle=`rgba(255,170,60,${.9*(1-t/.35)})`;ctx.beginPath();ctx.arc(X2,Y2,Math.max(2,E*.25),0,7);ctx.fill()}}
  }
  // tours de siège : elles s'approchent des murs à mesure que le siège avance
  if(GV?genSV(sg,'tow'):f>.2){const nt=n.size>=2?2:1;
    for(let j=0;j<nt;j++){const k=cand[Math.floor((j+.5)*cand.length/nt+cand.length/(2*ne0))%cand.length],r=R[k],adv=Math.max(0,Math.min(1,(f-.2)/.65)),p=at(r,.75-.65*adv),x=SX(p[0]),y=SY(p[1]);
      const w=Math.max(7,.17*s),h=w*1.9,wob=adv<1?Math.sin(T*3+j)*w*.03:0;
      ctx.save();ctx.translate(x+wob,y);
      ctx.fillStyle='rgba(0,0,0,.3)';ctx.beginPath();ctx.ellipse(w*.2,0,w*.7,w*.25,0,0,7);ctx.fill();
      ctx.fillStyle='#8a6438';ctx.strokeStyle='#2b1c0e';ctx.lineWidth=Math.max(1,w*.08);ctx.fillRect(-w/2,-h,w,h);ctx.strokeRect(-w/2,-h,w,h);
      ctx.strokeStyle='rgba(43,28,14,.7)';for(let l=1;l<4;l++){ctx.beginPath();ctx.moveTo(-w/2,-h*l/4);ctx.lineTo(w/2,-h*l/4);ctx.stroke()}
      ctx.fillStyle='#5b3f22';for(let m=0;m<3;m++)ctx.fillRect(-w/2+m*w*.4,-h-w*.22,w*.22,w*.22);
      ctx.fillStyle=`rgb(${c[0]},${c[1]},${c[2]})`;ctx.fillRect(-w*.05,-h-w*.75,w*.4,w*.25);ctx.fillStyle='#2b1c0e';ctx.fillRect(-w*.05,-h-w*.75,w*.06,w*.55);
      ctx.restore()}}
  ctx.restore();
  a._sq=pts;
  if(s>1.4){const lx=SX(a.x)+14,ly=SY(a.y)-30;ctx.font='600 11px Barlow Semi Condensed, Arial Narrow, sans-serif';const t=a.name,tw=ctx.measureText(t).width;
    ctx.fillStyle='rgba(238,226,196,.92)';ctx.strokeStyle='rgba(60,40,20,.8)';ctx.lineWidth=1;ctx.beginPath();ctx.rect(lx,ly-7,tw+10,14);ctx.fill();ctx.stroke();ctx.fillStyle='#2b2115';ctx.textAlign='left';ctx.textBaseline='middle';ctx.fillText(t,lx+5,ly)}
}
// camp fortifié dessiné autour des régiments : palissade carrée, tentes
function drawCamp(a,s){
  const P=a._sq;if(!P||!P.length)return;const q=UNIT_KM*s;let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;for(const [x,y] of P){x0=Math.min(x0,x);y0=Math.min(y0,y);x1=Math.max(x1,x);y1=Math.max(y1,y)}
  const pad=q*1.4;x0-=pad;y0-=pad;x1+=pad;y1+=pad;ctx.save();const lw=Math.max(1.2,.04*s);
  ctx.strokeStyle='rgba(60,40,20,.5)';ctx.lineWidth=lw*3;ctx.strokeRect(x0,y0,x1-x0,y1-y0);
  ctx.strokeStyle='#7a5632';ctx.lineWidth=lw;ctx.setLineDash(a.camp.ok?[lw*1.5,lw*1.5]:[lw*1.5,lw*6]);ctx.strokeRect(x0,y0,x1-x0,y1-y0);ctx.setLineDash([]);
  if(a.camp.ok){const tw=Math.max(6,q*.5);for(const [tx,ty] of [[x0+tw,y0+tw],[x1-tw,y0+tw],[x0+tw,y1-tw],[x1-tw,y1-tw],[(x0+x1)/2,y0+tw]]){ctx.fillStyle='#ece2c6';ctx.strokeStyle='#5b4a30';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(tx-tw*.6,ty+tw*.4);ctx.lineTo(tx,ty-tw*.5);ctx.lineTo(tx+tw*.6,ty+tw*.4);ctx.closePath();ctx.fill();ctx.stroke()}}
  ctx.restore()}
const _formation=formation;
formation=function(a,s){
  const sg=a.at!=null&&!a.legs.length&&!N[a.at].col&&S.siege[N[a.at].id];
  if(sg&&sg.a===a.id&&!a.inG){siegeFormation(a,s,sg);return}
  if(a.decamp){decampFormation(a,s);return}
  if(a.camp&&!a.legs.length){campFormation(a,s);return}
  _formation(a,s);
};

