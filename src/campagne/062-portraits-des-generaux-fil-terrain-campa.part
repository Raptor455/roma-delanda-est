/* ================= PORTRAITS DES GÉNÉRAUX (fil « Terrain Campagne ») ================= */
// Bustes, statues et monnaies réels (Wikimedia Commons, licences libres), teintés aux couleurs du camp.
// Médaillon de la carte (genCard → emblem) et médaillon du panneau (.ui-med). Jamais pour une armée ennemie mal vue.
const POR_IMG={"02": "data:image/jpeg;base64,", "03": "data:image/jpeg;base64,", "11": "data:image/jpeg;base64,", "01": "data:image/jpeg;base64,", "16": "data:image/jpeg;base64,", "07": "data:image/jpeg;base64,", "14": "data:image/jpeg;base64,", "17": "data:image/jpeg;base64,", "09": "data:image/jpeg;base64,", "06": "data:image/jpeg;base64,", "20": "data:image/jpeg;base64,", "18": "data:image/jpeg;base64,", "19": "data:image/jpeg;base64,", "10": "data:image/jpeg;base64,"};
const POR_SRC={"02": "Buste de Capoue dit d'Hannibal (Naples) · photo Fratelli Alinari, domaine public", "03": "Shekel barcide attribué à Hasdrubal · photo The Ogre, domaine public", "11": "Quart de shekel de Carthage en Ibérie, 237-209 av. J.-C. · CNG, domaine public", "01": "Shekel barcide de Nova Carthago (tête attribuée à Hannibal ou Hamilcar) · CC BY-SA 3.0", "16": "Masque de Baal, Musée national de Carthage · Pradigue, CC BY-SA 3.0", "07": "Buste dit de Scipion l'Africain · CC BY-SA 4.0", "14": "Le « général de Tivoli », Palazzo Massimo, Rome · Miguel Hermoso Cuesta, CC BY-SA 4.0", "17": "Le « patricien Torlonia » · domaine public", "09": "Buste de Scipion à Carthagène · P4K1T0, CC BY-SA 4.0", "06": "Fabius Cunctator, statue du parc de Schönbrunn (XVIIIe s.) · Herzi Pinki, CC BY-SA 4.0", "20": "Denier de P. Cornelius Lentulus Marcellinus (50 av. J.-C.) au portrait de Marcellus · domaine public", "18": "Le « vieil homme d'Otricoli », vers 50 av. J.-C. · Sailko, CC BY 3.0", "19": "Portrait d'un Romain de la République, Ny Carlsberg Glyptotek 570 · domaine public", "10": "Portrait d'un vieil homme, 50-25 av. J.-C. · CC BY-SA 4.0"};
const POR_GEN={"car": {"Hannibal": "02", "Hasdrubal": "03", "Hamilcar": "01", "Magon": "11", "Giscon": "16"}, "rom": {"P. Cornelius Scipio": "07", "Cn. Cornelius Scipio": "09", "Q. Fabius Maximus": "06", "M. Claudius Marcellus": "20", "Ti. Sempronius Longus": "14", "C. Flaminius": "17", "L. Aemilius Paullus": "18", "C. Terentius Varro": "19", "M. Minucius Rufus": "10"}},POR_CYC={"car": ["11", "16", "01", "03"], "rom": ["14", "17", "18", "19", "10"]};
const POR_C={};let POR_CUR=null;
function porKey(a){if(!a||!POR_GEN[a.side]||a.g||a.conv||a.par||a.reinf)return null;const nm=String(a.name||'').replace(/ II+$/,'');
  if(/^(Garnison|Renforts|Armée|Détachement)/.test(nm))return null;const m=POR_GEN[a.side];if(m[nm])return m[nm];
  let h=0;for(const ch of nm)h=(h*31+ch.charCodeAt(0))|0;const L=POR_CYC[a.side];return L[Math.abs(h)%L.length]}
function porCanvas(k,side){const id=k+side;if(id in POR_C)return POR_C[id];POR_C[id]=null;const im=new Image();
  im.onload=()=>{const c=document.createElement('canvas');c.width=c.height=96;const g=c.getContext('2d');g.drawImage(im,0,0,96,96);const d=g.getImageData(0,0,96,96),D=d.data,col=(FAC[side]||FAC.car).c;
    const dk=col.map(v=>v*.22+8),lt=col.map(v=>v*.3+255*.7);
    for(let i=0;i<D.length;i+=4){const l=Math.pow(D[i]/255,.9);for(let j=0;j<3;j++)D[i+j]=dk[j]+(lt[j]-dk[j])*l}
    g.putImageData(d,0,0);POR_C[id]=c;try{renderSide()}catch(e){}};
  im.src=POR_IMG[k];return null}
// portrait générique des généraux carthaginois sans portrait propre (signe de Tanit fourni par Baptiste), gardé dans ses couleurs
POR_IMG.gc="data:image/png;base64,";POR_SRC.gc="Signe de Tanit · portrait générique carthaginois";
// image d'un général (objet g) pour les fenêtres : portrait connu teinté, sinon générique (Carthage) ou portrait tiré au sort (Rome)
function porGenURL(g){if(!g)return null;const nm=String(g.name||'').replace(/ II+$/,''),m=POR_GEN[g.side]||{};let k=m[nm];
  if(!k){if(g.side!=='rom')return POR_IMG.gc;let h=0;for(const ch of nm)h=(h*31+ch.charCodeAt(0))|0;const L=POR_CYC.rom;k=L[Math.abs(h)%L.length]}
  const c=porCanvas(k,g.side==='rom'?'rom':'car');return c?c.toDataURL('image/jpeg',.9):POR_IMG[k]}
const _porEmblem=emblem;
emblem=function(side,r){const a=POR_CUR;if(a){const k=porKey(a),c=k&&porCanvas(k,a.side);
  if(c){ctx.save();ctx.beginPath();ctx.arc(0,0,r-.5,0,7);ctx.clip();ctx.drawImage(c,-r,-r,2*r,2*r);ctx.restore();return}}return _porEmblem.apply(this,arguments)};
const _porGenCard=genCard;
genCard=function(a){POR_CUR=a;try{return _porGenCard.apply(this,arguments)}finally{POR_CUR=null}};
function porPanel(){const a=sel&&sel.a;if(!a)return;if(a.side!=='car'&&typeof visOfArmy==='function'&&visOfArmy(a)<2)return;
  const k=porKey(a);if(!k)return;const c=porCanvas(k,a.side);if(!c)return;const m=document.querySelector('#side .ui-head .ui-med');if(!m||m.dataset.por===k)return;
  m.dataset.por=k;m.innerHTML=`<img src="${c.toDataURL('image/jpeg',.9)}" alt="" style="width:100%;height:100%;border-radius:50%;object-fit:cover;display:block">`;m.title='Portrait : '+POR_SRC[k];m.style.overflow='hidden';m.style.padding='0'}
const _porSide=renderSide;
renderSide=function(){const r=_porSide.apply(this,arguments);queueMicrotask(porPanel);return r};
/* ================= FIN PORTRAITS ================= */
