/* ================= EMBLÈMES ================= */
const PEO_IMG={"car": "data:image/jpeg;base64,", "rom": "data:image/jpeg;base64,", "mac": "data:image/jpeg;base64,", "syr": "data:image/jpeg;base64,", "ath": "data:image/jpeg;base64,", "num": "data:image/jpeg;base64,", "ins": "data:image/jpeg;base64,", "per": "data:image/jpeg;base64,", "mas": "data:image/jpeg;base64,"};
const PEO_MOT={"tanit": "data:image/png;base64,", "aigle": "data:image/png;base64,", "soleil": "data:image/png;base64,", "triskel": "data:image/png;base64,", "chouette": "data:image/png;base64,", "cheval": "data:image/png;base64,", "sanglier": "data:image/png;base64,", "serpent": "data:image/png;base64,", "lion": "data:image/png;base64,"};
/* ---------- EMBLÈMES DES PEUPLES (fil Interface, v180) ---------- */
// Médaillon de bronze, champ à la couleur du peuple, emblème tiré des monnaies et enseignes antiques.
// PEO_EMB(k, taille) -> chaîne SVG. Remplace les lettres de l'écran « Votre pays » et décore les choix de camp.
const PEO_EMB_D=(()=>{
  const rays=(n,r0,r1,w)=>{let d='';for(let i=0;i<n;i++){const a=i/n*Math.PI*2-Math.PI/2,h=Math.PI/n*w;
    const p=(ang,r)=>(50+Math.cos(ang)*r).toFixed(1)+' '+(52+Math.sin(ang)*r).toFixed(1);
    d+=`M${p(a-h,r0)} L${p(a,r1)} L${p(a+h,r0)} Z `}return d};
  const leg='M6 -7 L30 -10 Q36 -9 36 -3 L38 14 L47 15 Q50 18 47 21 L34 21 Q30 20 30 16 L28.5 0 L6 3 Z';
  return {
    // Carthage : signe de Tanit sous le croissant et le disque
    car:`<path d="M34 15 A16 16 0 0 0 66 15 A16 12 0 0 1 34 15 Z"/><circle cx="50" cy="35" r="8"/>
      <path d="M27 42 h5 v5 h36 v-5 h5 v10 h-46 Z"/><path d="M50 49 L71 84 H29 Z"/>`,
    // Rome : l'aigle des légions sur son foudre
    rom:`<path d="M46 45 C38 41 31 35 26 21 L23 30 L18 23 L17 34 L12 29 L13 41 L8 39 L14 50 C22 57 36 58 46 56 Z"/>
      <path transform="translate(100 0) scale(-1 1)" d="M46 45 C38 41 31 35 26 21 L23 30 L18 23 L17 34 L12 29 L13 41 L8 39 L14 50 C22 57 36 58 46 56 Z"/>
      <ellipse cx="50" cy="54" rx="8.5" ry="13"/><circle cx="50" cy="34" r="6.5"/><path d="M55 31 L63 35 L55 38 Z"/>
      <path d="M43 63 L38 76 L45 73 L50 79 L55 73 L62 76 L57 63 Z"/>
      <rect x="27" y="80" width="46" height="5" rx="2.5"/><path d="M30 82.5 L22 78 L25 82.5 L22 87 Z M70 82.5 L78 78 L75 82.5 L78 87 Z"/>`,
    // Macédoine : le soleil de Vergina
    mac:`<path d="${rays(16,12,39,.85)}"/><circle cx="50" cy="52" r="10.5"/><circle cx="50" cy="52" r="6" class="peH"/><circle cx="50" cy="52" r="3.4"/>`,
    // Syracuse : la triskèle sicilienne autour de la Gorgone
    syr:`<g transform="translate(50 52)">${[0,120,240].map(r=>`<path transform="rotate(${r-90}) scale(.84)" d="${leg}"/>`).join('')}</g>
      <circle cx="50" cy="52" r="11"/><circle cx="50" cy="52" r="7" fill="none" stroke-width="1.8" class="peHs"/><circle cx="50" cy="52" r="3"/>`,
    // Athènes : la chouette d'Athéna et le rameau d'olivier
    ath:`<path d="M35 31 L38 19 L45 27 Q50 25.5 55 27 L62 19 L65 31 Q71 45 66 62 Q62 77 50 81 Q38 77 34 62 Q29 45 35 31 Z"/>
      <circle cx="43" cy="38" r="6.2" class="peH"/><circle cx="57" cy="38" r="6.2" class="peH"/><circle cx="43" cy="38" r="2.6"/><circle cx="57" cy="38" r="2.6"/>
      <path d="M50 43 L47.5 48.5 L52.5 48.5 Z" class="peH"/>
      <path d="M40 56 q5 5 10 0 q5 5 10 0 M42 63 q4 4 8 0 q4 4 8 0 M45 70 q5 4 10 0" fill="none" stroke-width="1.8" class="peHs"/>
      <path d="M44 80 v5 M50 81 v5 M56 80 v5" stroke-width="2.2" class="peFs"/>
      <path d="M17 74 Q19 58 27 46" fill="none" stroke-width="2" class="peFs"/>
      <ellipse cx="14.5" cy="64" rx="2.3" ry="5.5" transform="rotate(35 14.5 64)"/><ellipse cx="23.5" cy="62" rx="2.3" ry="5.5" transform="rotate(-35 23.5 62)"/><ellipse cx="18" cy="54" rx="2.3" ry="5.5" transform="rotate(40 18 54)"/><ellipse cx="26.5" cy="52" rx="2.2" ry="5" transform="rotate(-30 26.5 52)"/><ellipse cx="27" cy="43" rx="2.1" ry="4.6" transform="rotate(20 27 43)"/>`,
    // Numidie : le cheval cabré des monnaies de Massinissa
    num:`<path d="M28 46 Q40 41 55 42 L61 33 Q65 24 71 19 L73 13 L76 19 Q82 22 86 30 Q87 34 83 34 Q77 32 72 33 Q69 39 67 46 Q67 52 63 56
      L70 61 L75 68 L71 71 L65 64 L58 61 L57 67 L60 82 L55 82 L52 67 Q44 65 38 63 L37 71 L42 82 L37 82 L32 71
      L30 63 L26 72 L29 82 L24 82 L21 71 L25 58 Q22 54 23 50 Q15 54 11 64 Q12 50 21 44 Q25 43 28 46 Z"/>
      <path d="M62 32 Q64 25 70 21" fill="none" stroke-width="1.6" class="peHs"/><circle cx="77" cy="24" r="1.4" class="peH"/>`,
    // Gaulois cisalpins : le sanglier des enseignes celtes
    ins:`<path d="M17 60 Q15 48 23 42 L27 37 L30 41 L33 34 L36 39 L39 32 L42 38 L45 31 L48 37 L51 31 L54 37 Q64 36 70 42 L72 36 L76 43
      Q81 47 87 53 L89 60 L82 61 Q80 64 77 63 Q74 66 70 66 L68 77 L63 77 L62 68 L58 68 L57 77 L52 77 L51 67 Q42 70 32 67
      L31 77 L26 77 L25 66 L22 65 L21 75 L16 75 Z"/>
      <path d="M79 62 Q85 58 82 52" fill="none" stroke-width="2.6" stroke-linecap="round" class="peHs"/><circle cx="76" cy="49" r="1.6" class="peH"/>
      <path d="M18 50 Q9 49 11 42 Q13 38 16 41" fill="none" stroke-width="2.4" class="peFs"/>`,
    // Pergame : le bâton d'Asclépios
    per:`<rect x="46.5" y="18" width="7" height="70" rx="3.5"/>
      <path d="M38 82 C22 75 72 71 61 62 C51 55 29 57 38 46 C46 38 68 42 62 32 C58 25 48 28 53 22" fill="none" stroke-width="9" class="peHs"/>
      <path d="M38 82 C22 75 72 71 61 62 C51 55 29 57 38 46 C46 38 68 42 62 32 C58 25 48 28 53 22" fill="none" stroke-width="5.5" class="peFs" stroke-linecap="round"/>
      <ellipse cx="57" cy="20" rx="7.2" ry="5" transform="rotate(-20 57 20)" class="peH"/><ellipse cx="57" cy="20" rx="5.6" ry="3.4" transform="rotate(-20 57 20)"/><path d="M62.5 17.5 L67 14.5 M63 18.5 L67.5 19" stroke-width="1.2" class="peFs"/>`
  }})();
function PEO_EMB(k,sz){const P=(typeof START_PEO!=='undefined'&&START_PEO.find(p=>p.k===k))||{c:'#7a6a50'};const c=P.c,d=PEO_EMB_D[k];sz=sz||48;
  const hasI=typeof PEO_IMG!=='undefined'&&PEO_IMG[k];if(!d&&!hasI)return `<span style="display:inline-block;width:${sz}px;height:${sz}px;border-radius:50%;background:${c}"></span>`;
  const id='pe'+k;
  const dd=d||'';const fr=dd.replace(/class="peH"/g,`style="fill:${c};stroke:none"`).replace(/class="peHs"/g,`style="stroke:${c};fill:none"`).replace(/class="peFs"/g,'style="stroke:#f6ecd0;fill:none"');
  const sh=dd.replace(/class="peH"/g,'style="fill:none"').replace(/class="peHs"/g,'style="stroke:none;fill:none"').replace(/class="peFs"/g,'style="stroke:rgba(10,6,2,.6);fill:none"');
  return `<svg class="peEmb" viewBox="0 0 100 100" width="${sz}" height="${sz}" aria-hidden="true" style="flex:none;display:block;overflow:visible">
  <defs><radialGradient id="${id}F" cx=".42" cy=".36" r=".75"><stop offset="0" stop-color="${c}" stop-opacity=".95"/><stop offset=".7" stop-color="${c}"/><stop offset="1" stop-color="#1a120a"/></radialGradient>
  <linearGradient id="${id}B" x1="0" y1="0" x2=".3" y2="1"><stop offset="0" stop-color="#f6dfa4"/><stop offset=".45" stop-color="#c79a4e"/><stop offset="1" stop-color="#6b4a1e"/></linearGradient>
  <linearGradient id="${id}E" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff6dc"/><stop offset="1" stop-color="#e3cc96"/></linearGradient>
  <radialGradient id="${id}V" cx=".5" cy=".45" r=".55"><stop offset=".72" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".45"/></radialGradient><clipPath id="${id}C"><circle cx="50" cy="50" r="40"/></clipPath></defs>
  <circle cx="50" cy="51.5" r="49" fill="rgba(0,0,0,.45)"/>
  <circle cx="50" cy="50" r="48" fill="url(#${id}B)"/>
  <circle cx="50" cy="50" r="48" fill="none" stroke="#3a2610" stroke-width="1.2"/>
  <circle cx="50" cy="50" r="44.5" fill="none" stroke="#fbe9bd" stroke-opacity=".55" stroke-width="1.2" stroke-dasharray="2.2 2.4"/>
  <circle cx="50" cy="50" r="41" fill="url(#${id}F)" stroke="#2a1a0a" stroke-width="2"/>
  ${typeof PEO_IMG!=='undefined'&&PEO_IMG[k]?`<image href="${PEO_IMG[k]}" x="9" y="9" width="82" height="82" preserveAspectRatio="xMidYMid slice" clip-path="url(#${id}C)"/>
  <circle cx="50" cy="50" r="41" fill="url(#${id}V)"/>`:`<g clip-path="url(#${id}C)"><g transform="translate(50 50) scale(.86) translate(-50 -52)">
   <g transform="translate(0 2.6)" fill="rgba(10,6,2,.6)" stroke="none">${sh}</g>
   <g fill="url(#${id}E)" stroke="none">${fr}</g>
  </g></g>`}
  <circle cx="50" cy="50" r="41" fill="none" stroke="#2a1a0a" stroke-width="2"/>
  </svg>`}
// Motifs des boucliers, enseignes et fanions (atelier, cartes, écrans de chargement) : silhouettes tirées des drapeaux de Baptiste.
// PEO_MOT (injecté par patch_emblemes.py) : masque PNG par motif ; les autres motifs gardent leur dessin.
let PEO_MOTN=0;
if(typeof embSVG==='function'&&typeof PEO_MOT!=='undefined'){const _eS=embSVG;embSVG=function(m,cx,cy,r,col){const u=PEO_MOT[m];if(!u)return _eS.apply(this,arguments);
  const id='pm'+(++PEO_MOTN)+'_'+m,s=r*2.15,x=cx-s/2,y=cy-s/2;
  return `<g><mask id="${id}" maskUnits="userSpaceOnUse" x="${x}" y="${y}" width="${s}" height="${s}"><image href="${u}" x="${x}" y="${y}" width="${s}" height="${s}"/></mask><rect x="${x}" y="${y}" width="${s}" height="${s}" fill="${col}" mask="url(#${id})"/></g>`}}
// COULEURS (Baptiste, 10 nov.) : Pergame rouge pourpre, Athènes le bleu de Pergame, Gaulois en vert, Macédoine violet foncé
try{const C={mac:'#4b2a6b',ath:'#4a56a8',ins:'#3f7a2e',per:'#8e1f3c'};START_PEO.forEach(p=>{if(C[p.k])p.c=C[p.k]})}catch(e){}
/* ---------- MENU ÉCHAP ET MÉDAILLONS DU PEUPLE (fil Interface, v180) ---------- */
// Échap : ferme la fenêtre ouverte ; sinon désélectionne ; sinon ouvre le menu « Partie » (le jeu est en pause tant qu'il est ouvert).
const peoCur=()=>{try{return S&&(S.peo&&(PEO_EMB_D[S.peo]||PEO_IMG[S.peo])?S.peo:S.mirror?'rom':'car')||'car'}catch(e){return 'car'}};
{let escBusy=false;
  // phase de capture : on note l'état AVANT que les autres écouteurs (fermeture de fenêtre, désélection…) ne le changent
  window.addEventListener('keydown',e=>{if(e.key!=='Escape')return;escBusy=true;try{
    const t=e.target,typing=t&&(t.tagName==='INPUT'||t.tagName==='TEXTAREA'||t.tagName==='SELECT'||t.isContentEditable);
    escBusy=typing||e.repeat||!$('modal').hidden||!!$('chg')||!!$('rgCard')||!!$('battle3d')||(typeof mkMode!=='undefined'&&mkMode)||
      !!(S&&(S.cur||S.over))||!!(typeof sel!=='undefined'&&sel)||!!(typeof nvOpen!=='undefined'&&nvOpen)}catch(err){escBusy=true}},true);
  window.addEventListener('keydown',e=>{if(e.key!=='Escape'||escBusy)return;escBusy=true;
    try{openMenu()}catch(err){console.error(err)}});
}
// le menu : médaillon du peuple, rappel de la pause, « Comment jouer » et « Écran de départ »
{const _omE=openMenu;openMenu=function(){const r=_omE.apply(this,arguments);try{
  const h=document.querySelector('#mcard h2');
  if(h&&h.textContent.trim()==='Partie'){let c='';try{const d=cal(S.day);c=`${d.season} ${d.year} av. J.-C.`}catch(e){}
    h.style.cssText+=';display:flex;align-items:center;gap:12px';
    h.innerHTML=`${PEO_EMB(peoCur(),46)}<span style="display:flex;flex-direction:column;line-height:1.2">Partie en pause<span class="sub" style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin-top:2px">${typeof startCamp==='function'?startCamp():''}${c?' · '+c:''}</span></span>`}
  const close=$('mClose');if(close&&!$('mHelpE')){
    const hb=document.createElement('button');hb.type='button';hb.id='mHelpE';hb.textContent='Comment jouer';hb.onclick=openHelp;close.parentNode.insertBefore(hb,close);
    if(typeof openStart==='function'){const sb=document.createElement('button');sb.type='button';sb.id='mStartE';sb.textContent='Écran de départ';sb.title='Choisir un autre pays, une autre date ou la difficulté';sb.onclick=()=>openStart();close.parentNode.insertBefore(sb,close)}
    close.title='Reprendre la partie (Échap)'}
  const p=document.querySelector('#mcard > p');if(p&&!p.dataset.esc){p.dataset.esc='1';p.insertAdjacentHTML('beforeend',' <span class="sub">Appuyez sur <kbd>Échap</kbd> pour ouvrir ou fermer ce menu.</span>')}
}catch(e){console.error(e)}return r}}
// médaillon du peuple dans la barre du haut et dans la tablette (quand rien n'est sélectionné)
function peoMedFix(){try{if(!S)return;const k=peoCur();
  const top=document.querySelector('.ui-fac .ui-med');if(top&&top.dataset.emb!==k){top.dataset.emb=k;top.dataset.mir='1';top.classList.add('peMed');top.innerHTML=PEO_EMB(k,44)}
  const sd=(typeof sel==='undefined'||!sel)&&document.querySelector('#side .ui-head .ui-med');
  if(sd&&!sd.querySelector('img,canvas')&&sd.dataset.emb!==k){sd.dataset.emb=k;sd.dataset.mir='1';sd.classList.add('peMed');sd.innerHTML=PEO_EMB(k,50)}}catch(e){}}
{const st=document.createElement('style');st.textContent=`.ui-med.peMed{background:none!important;border:0!important;box-shadow:none!important;overflow:visible}
.ui-med.peMed>svg{width:100%!important;height:100%!important}
#stPeo .peEmb{transition:transform .15s}#stPeo button:hover .peEmb{transform:scale(1.07)}`;document.head.appendChild(st)}
if(typeof renderTop==='function'){const _rtE=renderTop;renderTop=function(){const r=_rtE.apply(this,arguments);peoMedFix();return r}}
if(typeof renderSide==='function'){const _rsE=renderSide;renderSide=function(){const r=_rsE.apply(this,arguments);peoMedFix();return r}}
setInterval(peoMedFix,800);
// choix du camp de « Nouvelle campagne » (menu Partie) : petit médaillon devant chaque nom ; openScen se redessine à chaque clic
function scenDeco(){const M={sdC:'car',sdR:'rom',sdM:'mac',sdS:'syr'};for(const id in M){const b=$(id);if(b&&!b.querySelector('.peEmb')){b.style.cssText+=';display:inline-flex;align-items:center;gap:7px';b.insertAdjacentHTML('afterbegin',PEO_EMB(M[id],22))}}}
if(typeof openScen==='function'){const _osE=openScen;openScen=function(){const r=_osE.apply(this,arguments);scenDeco();return r}}
document.addEventListener('click',()=>{if($('sdC'))setTimeout(scenDeco,0)},true);
// écrans de chargement des batailles : la pastille de chaque camp devient le médaillon du drapeau
if(typeof chgBataille==='function'){const _cbE=chgBataille;chgBataille=function(o){const r=_cbE.apply(this,arguments);try{
  const M={gau:'ins'},ks=[o&&o.pp,o&&o.ep].map(k=>M[k]||k),cs=document.querySelectorAll('#chgB .chgB-c > i');
  cs.forEach((el,i)=>{const k=ks[i];if(k&&(PEO_EMB_D[k]||PEO_IMG[k])){el.classList.add('peMed');el.innerHTML=PEO_EMB(k,48)}})}catch(e){}return r}}
{const st=document.createElement('style');st.textContent='.chgB-c i.peMed{background:none!important;border:0!important;box-shadow:none!important;width:52px!important;height:52px!important}.chgB-c i.peMed svg{padding:0!important;width:100%;height:100%}';document.head.appendChild(st)}
// portrait générique des généraux : le signe de Tanit ne vaut que pour Carthage ; les autres peuples ont le médaillon de leur drapeau
// (bannières et bandeau de la bataille, corps d'armée, conseil de guerre). Peuple sans drapeau : étoile sur sa couleur.
const peoOfSide=s=>{try{if(s==='car')return peoCur();if(s==='pun')return 'car';if(s==='rom'&&S&&S.mirror)return 'car';return {gau:'ins'}[s]||s}catch(e){return s}};
const PEO_GEN={};
function peoGenURL(side){const k=peoOfSide(side);if(k==='car')return null;if(PEO_IMG[k])return PEO_IMG[k];if(PEO_GEN[side])return PEO_GEN[side];
  const c=(typeof FAC!=='undefined'&&FAC[side]&&FAC[side].c)||[120,110,90],f=m=>'rgb('+c.map(v=>Math.round(v*m)).join(',')+')';
  return PEO_GEN[side]='data:image/svg+xml;utf8,'+encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><defs><radialGradient id="g" cx=".4" cy=".32" r=".85"><stop offset="0" stop-color="${f(1)}"/><stop offset="1" stop-color="${f(.35)}"/></radialGradient></defs><circle cx="32" cy="32" r="32" fill="url(#g)"/><circle cx="32" cy="32" r="25" fill="none" stroke="#f3e6c4" stroke-width="1.6" opacity=".7"/><path d="M32 13l4.6 12.300l13.100 .600l-10.300 8.200l3.500 12.700L32 39.500l-10.900 7.300l3.500 -12.700l-10.300 -8.200l13.100 -.600Z" fill="#f3e6c4"/></svg>`)}
if(typeof porGenURL==='function'&&typeof POR_IMG!=='undefined'){const _pgE=porGenURL;porGenURL=function(g){const r=_pgE.apply(this,arguments);
  try{if(g&&r&&r===POR_IMG.gc){const u=peoGenURL(g.side);if(u)return u}}catch(e){}return r}}
window.__peoEmb=sz=>{try{return PEO_EMB(peoCur(),sz||34)}catch(e){return ''}};
/* ---------- MENUS SIMPLIFIÉS (fil Interface, 11 nov.) ----------
   1. barre du haut : les boutons d'origine (.ui-menu) restent dans la page mais sont cachés ; cinq boutons nommés les regroupent.
      Tout bouton ajouté plus tard à .ui-menu par un autre fil apparaît tout seul dans « Partie » (ou dans NV_G si on l'y range).
   2. liste « À faire » (#nvTodo) : ce qui demande l'attention du joueur, un clic mène au bon endroit.
   3. fiche de ville à onglets (townTabs) : Ville / Recruter / Construire / Marine / Intendance.
   4. fenêtres : même en-tête (à quoi ça sert) et bandeau d'onglets vers les fenêtres voisines du même groupe. */
const NV_G=[
  {k:'roy',n:'Royaume',d:'Villes, argent, commerce, Sénat',ids:['bEco','bSea','bHub','bPol']},
  {k:'dip',n:'Diplomatie',d:'Peuples, traités, agents',ids:['bDip','bAg']},
  {k:'arm',n:'Armées',d:'Généraux, unités, repères',ids:['bGen','bWork','bMark']},
  {k:'chr',n:'Chroniques',d:'Le récit de votre guerre',ids:['bChr']},
  {k:'par',n:'Partie',d:'Pause, options, aide, amis',ids:['bMenu','mpTag','sonBtn','bHelp']}];
const NV_I={
  bEco:['Économie et villes','Revenus, impôts, ordre public et bâtiments de toutes vos villes.','Économie et villes'],
  bSea:['Mer et commerce','Routes marchandes, blocus, pirates et guerre de course.','Mer et commerce'],
  bHub:['Logistique','Affiche sur la carte vos bases, dépôts et lignes de ravitaillement.'],
  bPol:['Politique','L\'appui du Sénat, les renforts et la paix.','Politique'],
  bDip:['Diplomatie','Ce que veut chaque peuple, et comment s\'en faire un allié.','Diplomatie'],
  bAg:['Agents','Espions et saboteurs en mission.','Agents'],
  bGen:['Généraux','Vos chefs, leur loyauté, leurs talents ; les chefs ennemis connus.','Généraux'],
  bWork:['Atelier des unités','Composer, équiper et nommer vos propres régiments.','Atelier des unités'],
  bMark:['Poser un repère','Marquer un point de la carte, visible par vos alliés (ou Alt+clic).'],
  bChr:['Chroniques','Le récit de votre guerre, jour après jour.','Chroniques de la guerre'],
  bMenu:['Menu de la partie','Pause, nouvelle campagne, difficulté, affichage.','Partie en pause'],
  mpTag:['Jouer à plusieurs','Héberger une partie ou rejoindre des amis.','Jouer à plusieurs'],
  sonBtn:['Sons et musique','Volume et réglages du son.'],
  bHelp:['Comment jouer','Commandes, règles et légende de la carte.','Comment jouer']};
const nvBtn=id=>document.getElementById(id);
const nvName=id=>NV_I[id]?NV_I[id][0]:(nvBtn(id)&&(nvBtn(id).textContent.trim()||nvBtn(id).title))||id;
const nvDesc=id=>NV_I[id]?NV_I[id][1]:(nvBtn(id)&&nvBtn(id).title)||'';
const nvIco=(id,sz)=>{const b=nvBtn(id),s=b&&b.querySelector('svg');if(!s)return `<span class="nvI0" style="width:${sz}px;height:${sz}px"></span>`;const c=s.cloneNode(true);c.setAttribute('width',sz);c.setAttribute('height',sz);c.removeAttribute('style');return c.outerHTML};
function nvGroups(){const menu=document.querySelector('.ui-menu');const known=new Set(NV_G.flatMap(g=>g.ids));
  const extra=menu?[...menu.querySelectorAll(':scope > button[id]')].map(b=>b.id).filter(id=>!known.has(id)):[];
  return NV_G.map(g=>({k:g.k,n:g.n,d:g.d,ids:(g.k==='par'?g.ids.concat(extra):g.ids).filter(id=>{const b=nvBtn(id);return b&&!b.hidden&&b.style.display!=='none'})})).filter(g=>g.ids.length)}
let nvOpen=null;
function nvClose(){nvOpen=null;const d=document.getElementById('nvDrop');if(d)d.hidden=true;document.querySelectorAll('#nvBar .nvB').forEach(b=>b.classList.remove('on'))}
function nvGo(id){nvClose();const b=nvBtn(id);if(b)b.click()}
function nvShow(k){const G=nvGroups().find(g=>g.k===k),bar=document.getElementById('nvBar');if(!G||!bar)return;
  if(G.ids.length===1){nvGo(G.ids[0]);return}
  let d=document.getElementById('nvDrop');if(!d){d=document.createElement('div');d.id='nvDrop';d.setAttribute('role','menu');document.body.appendChild(d)}
  if(nvOpen===k&&!d.hidden){nvClose();return}
  nvOpen=k;d.innerHTML=`<div class="nvDh">${esc(G.n)}</div>`+G.ids.map((id,i)=>`<button type="button" role="menuitem" data-nv="${id}">${nvIco(id,22)}<span><b>${esc(nvName(id))}</b><small>${esc(nvDesc(id))}</small></span></button>`).join('');
  d.querySelectorAll('[data-nv]').forEach(b=>b.onclick=()=>nvGo(b.dataset.nv));
  d.hidden=false;const bt=bar.querySelector(`[data-g="${k}"]`),r=bt.getBoundingClientRect();
  bar.querySelectorAll('.nvB').forEach(b=>b.classList.toggle('on',b===bt));
  d.style.top=(r.bottom+6)+'px';d.style.left=Math.max(8,Math.min(innerWidth-d.offsetWidth-8,r.left+r.width/2-d.offsetWidth/2))+'px'}
function nvBuild(){const menu=document.querySelector('.ui-menu');if(!menu||!menu.parentNode)return;
  let bar=document.getElementById('nvBar');const G=nvGroups(),sig=G.map(g=>g.k+':'+g.ids.join(',')).join('|');
  if(bar&&bar.dataset.sig===sig&&bar.previousElementSibling===menu)return;
  if(!bar){bar=document.createElement('div');bar.id='nvBar';bar.setAttribute('role','menubar')}
  menu.classList.add('nvHid');menu.parentNode.insertBefore(bar,menu.nextSibling);bar.dataset.sig=sig;
  bar.innerHTML=G.map((g,i)=>`<button type="button" class="nvB" data-g="${g.k}" aria-haspopup="${g.ids.length>1}" data-tt-nv="${esc(g.d)}">${nvIco(g.ids[0],20)}<span>${esc(g.n)}</span><kbd>${i+1}</kbd></button>`).join('');
  bar.querySelectorAll('.nvB').forEach(b=>{b.onclick=e=>{e.stopPropagation();nvShow(b.dataset.g)};
    b.onmouseenter=()=>{if(nvOpen&&nvOpen!==b.dataset.g)nvShow(b.dataset.g)}})}
document.addEventListener('click',e=>{if(nvOpen&&!e.target.closest('#nvDrop'))nvClose()});
window.addEventListener('keydown',e=>{const t=e.target;if(t&&(t.tagName==='INPUT'||t.tagName==='TEXTAREA'||t.tagName==='SELECT'||t.isContentEditable))return;
  if(e.key==='Escape'&&nvOpen){nvClose();return}
  if(e.ctrlKey||e.metaKey||e.altKey||!/^Digit[1-9]$/.test(e.code||''))return;
  try{if(!$('modal').hidden||$('chg')||$('chgB')||(S&&(S.cur||S.over)))return}catch(err){return}
  const g=nvGroups()[+e.code.slice(5)-1];if(g){e.preventDefault();nvShow(g.k)}});

/* ----- 4. fenêtres : à quoi ça sert + onglets vers les fenêtres voisines ----- */
function nvWinDeco(){try{const mc=$('mcard');if(!mc||$('modal').hidden)return;const h=mc.querySelector(':scope > h2');if(!h)return;
  const t=h.textContent.replace(/\s+/g,' ').trim();let id=null;for(const k in NV_I)if(NV_I[k][2]&&t.startsWith(NV_I[k][2])){id=k;break}
  const old=mc.querySelector(':scope > .nvTabs');
  if(!id||!nvBtn(id)){if(old)old.remove();return}
  const G=nvGroups().find(g=>g.ids.includes(id));if(!G)return;
  const wins=G.ids.filter(x=>NV_I[x]&&NV_I[x][2]);
  if(!old||old.dataset.id!==id){if(old)old.remove();
    const bar=document.createElement('div');bar.className='nvTabs';bar.dataset.id=id;
    bar.innerHTML=`<span class="nvTg">${esc(G.n)}</span>`+wins.map(x=>`<button type="button" class="${x===id?'on':''}" data-nvw="${x}">${nvIco(x,16)}${esc(nvName(x))}</button>`).join('');
    bar.querySelectorAll('[data-nvw]').forEach(b=>b.onclick=()=>{if(b.dataset.nvw!==id){closeModal();nvGo(b.dataset.nvw)}});
    mc.insertBefore(bar,mc.firstChild)}
  if(!mc.querySelector(':scope > .nvWhy')&&id!=='bMenu'){const p=document.createElement('p');p.className='nvWhy';p.textContent=nvDesc(id);h.insertAdjacentElement('afterend',p)}
}catch(e){}}
{let q=false;const run=()=>{q=false;nvWinDeco()};
  const mo=new MutationObserver(()=>{if(!q){q=true;setTimeout(run,0)}});
  setTimeout(()=>{try{mo.observe($('mcard'),{childList:true});mo.observe($('modal'),{attributes:true,attributeFilter:['hidden']})}catch(e){}},600)}

/* ----- 3. fiche de ville à onglets ----- */
const NV_TT=[['vil','Ville'],['rec','Recruter'],['bat','Construire'],['mar','Marine'],['int','Dépôt']];
let nvTownTab='vil',nvTownBusy=false;
const nvTownKind=t=>/abri des murs|Patrouille/i.test(t)?'vil':/Recrut|Recrues/i.test(t)?'rec':/Gouvernement/i.test(t)?'bat':/Chantier naval/i.test(t)?'mar':'int';
function townTabs(){const el=$('side');if(!el||nvTownBusy)return;
  const on=!!(typeof sel!=='undefined'&&sel&&sel.n!=null&&!sel.a&&!sel.f);
  if(!on){el.classList.remove('nvTown');return}
  let i=sel.n;try{if(ownerN(i)!=='car'||N[i].col){el.classList.remove('nvTown');return}}catch(e){return}
  nvTownBusy=true;try{
    let bar=el.querySelector(':scope > .nvTT'),body=el.querySelector(':scope > .nvTB');
    const loose=[...el.childNodes].filter(c=>c!==bar&&c!==body&&!(c.nodeType===1&&(c.classList.contains('ui-x')||c.classList.contains('ui-head')||c.classList.contains('nvKeep'))));
    if(bar&&body&&!loose.length){nvTownShow(el);return}
    if(!loose.some(c=>c.nodeType===1&&c.tagName==='H3')&&!body)return;
    if(!bar){bar=document.createElement('div');bar.className='nvTT ua-tabs';bar.setAttribute('role','tablist');body=document.createElement('div');body.className='nvTB';
      NV_TT.forEach(([k])=>{const p=document.createElement('div');p.className='nvTP';p.dataset.k=k;body.appendChild(p)})}
    let cur='vil';for(const c of loose){if(c.nodeType===1&&c.tagName==='H3')cur=nvTownKind(c.textContent);body.querySelector(`.nvTP[data-k="${cur}"]`).appendChild(c)}
    el.appendChild(bar);el.appendChild(body);el.classList.add('nvTown');
    const have=NV_TT.filter(([k])=>body.querySelector(`.nvTP[data-k="${k}"]`).children.length);
    bar.innerHTML=have.map(([k,n])=>`<button type="button" role="tab" data-k="${k}">${n}</button>`).join('');
    bar.querySelectorAll('button').forEach(b=>b.onclick=()=>{nvTownTab=b.dataset.k;nvTownShow(el)});
    nvTownShow(el)}finally{nvTownBusy=false}}
function nvTownShow(el){const bar=el.querySelector(':scope > .nvTT'),body=el.querySelector(':scope > .nvTB');if(!bar||!body)return;
  const ks=[...bar.querySelectorAll('button')].map(b=>b.dataset.k);if(!ks.includes(nvTownTab))nvTownTab=ks[0]||'vil';
  bar.querySelectorAll('button').forEach(b=>b.classList.toggle('on',b.dataset.k===nvTownTab));
  body.querySelectorAll(':scope > .nvTP').forEach(p=>p.hidden=p.dataset.k!==nvTownTab)}

/* ----- 2. liste « À faire » ----- */
let nvTodoOpen=true,nvTodoSig='',nvDipCache={t:0,L:[]};
try{nvTodoOpen=localStorage.getItem('bellum.nvTodo')!=='0'}catch(e){}
const nvSelArmy=a=>{sel={a};centerOn(a.x,a.y,Math.max(view.s,1.2));renderAll()};
const nvSelTown=i=>{sel={n:i};centerOn(N[i].x,N[i].y,Math.max(view.s,1.2));renderAll()};
function nvTodoList(){const L=[],add=(lv,ic,t,s,go,ok)=>L.push({lv,ic,t,s,go,ok});if(!S||S.over)return L;
  const mine=S.armies.filter(a=>{try{return isMine(a)&&!a.dead}catch(e){return false}});
  const sieger={};for(const id in (S.siege||{})){const sg=S.siege[id];if(sg&&sg.a!=null)sieger[sg.a]=id}
  try{for(const id in (S.siege||{})){const sg=S.siege[id],i=NI[id];if(i==null)continue;
    if(sg.side!=='car'&&ownerN(i)==='car')add(0,'!',`${N[i].n} est assiégée`,`${Math.floor(sg.d)} jours sur ${sg.need} avant la chute`,()=>nvSelTown(i));
    else if(sg.side==='car'){const a=mine.find(x=>x.id===sg.a);if(a)add(3,'⚔',`Siège ${deN(N[i].n)}`,`${esc(a.name)} · ${Math.floor(sg.d)} jours sur ${sg.need}`,()=>nvSelArmy(a))}}}catch(e){}
  try{for(const a of mine){if(a.g||a.inG)continue;const fd=foodDays(a);if(fd<=5)add(1,'!',`${a.name} : ${fd} jour${fd>1?'s':''} de vivres`,'Rejoignez une ville amie, un dépôt ou un village',()=>nvSelArmy(a))}}catch(e){}
  try{for(const a of mine){if(a.legs.length)delete a.nvOk;if(a.g||a.inG||a.ship||a.legs.length||sieger[a.id]||a.nvOk)continue;
    add(2,'➤',`${a.name} attend vos ordres`,where(a),()=>nvSelArmy(a),()=>{a.nvOk=1})}}catch(e){}
  try{for(const id in (S.ord||{})){const i=NI[id];if(i==null||ownerN(i)!=='car')continue;const o=S.ord[id];if(o!=null&&o<25)add(1,'!',`Ordre public bas à ${N[i].n}`,`${Math.round(o)} sur 100 : la ville peut se révolter`,()=>{nvSelTown(i);nvTownTab='bat'})}}catch(e){}
  try{const {inc,up}=income('car'),net=inc-up,g=Math.round(S.gold.car);
    if(net<0)add(1,'!',`Vous perdez ${-net} or par mois`,'Voir les revenus et les dépenses',()=>nvGo('bEco'));
    else if(g>=250)add(4,'●',`${g} or à dépenser`,'Recruter, construire ou acheter des appuis',()=>nvGo('bEco'))}catch(e){}
  try{for(const g of (S.gens||[])){if(g.side!=='car'||g.dead||g.loy==null||g.loy>=25)continue;add(1,'!',`La loyauté de ${g.name} chancelle`,`${Math.round(g.loy)} sur 100`,()=>nvGo('bGen'))}}catch(e){}
  try{if(S.pol&&S.pol.bar!=null&&S.pol.bar<25&&!S.peo&&!S.mirror)add(1,'!','Le Sénat se détourne de vous',`Appui ${Math.round(S.pol.bar)} sur 100`,()=>nvGo('bPol'))}catch(e){}
  try{const now=Date.now();if(now-nvDipCache.t>4000){nvDipCache={t:now,L:[]};
      if(S.dv&&typeof dvDisp==='function'){for(const r of (S.dv.req||[])){if(!r.st&&S.fac[r.f])nvDipCache.L.push([2,'✉',`Une demande ${dvDes(r.f)}`,'Ils attendent votre réponse',r.f])}
        for(const f in S.fac){const F=S.fac[f];if(!F||F.st!=='neutre'||!contact('car',f))continue;if(dvDisp(f).v>=25)nvDipCache.L.push([3,'✉',`${dvC(dvLes(f))} sont prêts à traiter`,'Le moment de conclure une alliance',f])}}}
    for(const x of nvDipCache.L)add(x[0],x[1],x[2],x[3],()=>dipOpenFac(x[4]))}catch(e){}
  return L.sort((a,b)=>a.lv-b.lv)}
function nvTodo(){try{if(!S||!document.querySelector('.ui-menu'))return;
  let el=document.getElementById('nvTodo');if(!el){el=document.createElement('div');el.id='nvTodo';document.body.appendChild(el)}
  const hide=!!($('chg')||$('chgB')||S.cur||S.over);el.hidden=hide;if(hide)return;
  // la tablette (armée, ville) peut monter jusqu'en haut à gauche : la liste se range alors à sa droite
  try{const sd=$('side'),r=sd&&sd.getBoundingClientRect(),h=el.offsetHeight||40;const sh=r&&r.width&&r.top<96+h+8&&r.left<280&&innerWidth>900;el.style.left=(sh?Math.round(r.right+10):12)+'px'}catch(e){}
  const L=nvTodoList(),sig=nvTodoOpen+'|'+L.map(x=>x.lv+x.t+x.s).join('|');if(sig===nvTodoSig)return;nvTodoSig=sig;
  const urg=L.filter(x=>x.lv<=1).length,show=L.slice(0,7);
  el.className=(nvTodoOpen?'open':'')+(urg?' urg':'');
  el.innerHTML=`<button type="button" class="nvTh" aria-expanded="${nvTodoOpen}"><b>À faire</b><i>${L.length}</i><span>${nvTodoOpen?'▾':'▸'}</span></button>`+
    (nvTodoOpen?(L.length?show.map((x,i)=>`<div class="nvTi l${x.lv}" data-i="${i}" role="button" tabindex="0"><em>${x.ic}</em><span><b>${esc(x.t)}</b><small>${x.s||''}</small></span>${x.ok?`<button type="button" class="nvTo" data-o="${i}" title="Laisser cette armée en poste : ne plus le rappeler tant qu'elle ne bouge pas">✓</button>`:''}</div>`).join('')+(L.length>7?`<p class="nvTm">et ${L.length-7} de plus</p>`:''):'<p class="nvTm">Rien ne presse. Le temps peut reprendre (Espace).</p>'):'');
  el.querySelector('.nvTh').onclick=()=>{nvTodoOpen=!nvTodoOpen;try{localStorage.setItem('bellum.nvTodo',nvTodoOpen?'1':'0')}catch(e){}nvTodoSig='';nvTodo()};
  el.querySelectorAll('.nvTi').forEach(d=>{d.onclick=e=>{if(e.target.closest('.nvTo'))return;try{show[+d.dataset.i].go()}catch(err){console.error(err)}}});
  el.querySelectorAll('.nvTo').forEach(b=>b.onclick=e=>{e.stopPropagation();try{show[+b.dataset.o].ok()}catch(err){}nvTodoSig='';nvTodo()})}catch(e){}}

{const st=document.createElement('style');st.textContent=`
.ui-menu.nvHid{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important;pointer-events:none!important;opacity:0!important}
#nvBar{display:flex;gap:4px;align-items:stretch;flex:none}
#nvBar .nvB{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;min-width:74px;min-height:46px;padding:4px 9px 3px;background:transparent;border:1px solid transparent;border-radius:4px;color:var(--mu2,#b9a98a);position:relative;font-size:11.5px;letter-spacing:.04em;line-height:1.1}
#nvBar .nvB svg{display:block;opacity:.9}
#nvBar .nvB:hover,#nvBar .nvB.on{color:var(--tx,#efe6d2);border-color:var(--bz,#8a6a3c);background:rgba(214,184,120,.1)}
#nvBar .nvB kbd{position:absolute;top:2px;right:3px;font:10px var(--ui,sans-serif);opacity:.45;border:0;background:none;padding:0;min-width:0}
#nvBar .nvI0,#nvDrop .nvI0{display:inline-block;border:1.5px solid currentColor;border-radius:50%;opacity:.6;flex:none}
#nvDrop{position:fixed;z-index:60;width:300px;max-width:calc(100vw - 16px);background:#211a13;border:1px solid var(--bz,#8a6a3c);box-shadow:0 10px 30px rgba(0,0,0,.6),0 0 0 3px #15110c;border-radius:4px;padding:6px}
#nvDrop[hidden]{display:none}
#nvDrop .nvDh{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mu2,#b9a98a);padding:4px 8px 6px}
#nvDrop button{display:flex;gap:10px;align-items:center;width:100%;text-align:left;background:transparent;border:1px solid transparent;border-radius:3px;padding:7px 8px;min-height:0}
#nvDrop button:hover,#nvDrop button:focus-visible{background:rgba(214,184,120,.14);border-color:var(--line,#6b5536)}
#nvDrop button svg{flex:none;color:var(--gold,#d6b878)}
#nvDrop button b{display:block;font-weight:600;font-size:14px}#nvDrop button small{display:block;color:var(--mu2,#b9a98a);font-size:12px;line-height:1.3;margin-top:1px}
#mcard>.nvTabs{display:flex;flex-wrap:wrap;align-items:center;gap:2px;margin:-4px 0 12px;padding-bottom:0;border-bottom:1px solid var(--bz,#8a6a3c)}
#mcard>.nvTabs .nvTg{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mu2,#b9a98a);margin-right:10px}
#mcard>.nvTabs button{display:inline-flex;align-items:center;gap:6px;background:transparent;border:1px solid transparent;border-bottom:0;border-radius:3px 3px 0 0;margin-bottom:-1px;min-height:30px;padding:4px 11px;color:var(--mu2,#b9a98a);font-size:13px}
#mcard>.nvTabs button:hover{color:var(--tx,#efe6d2)}
#mcard>.nvTabs button.on{color:var(--tx,#efe6d2);border-color:var(--bz,#8a6a3c);background:#2b2219;font-weight:600;cursor:default}
#mcard>.nvWhy{margin:-2px 0 10px;color:var(--mu2,#b9a98a);font-size:13px;font-style:italic}
#side.nvTown>.nvTT{margin-top:8px;flex-wrap:wrap}
#side.nvTown>.nvTT button{padding:3px 6px!important;font-size:12px!important}
#side.nvTown>.nvTB{padding-top:8px}
#side.nvTown .nvTP>h3:first-child{margin-top:2px}
#nvTodo{position:fixed;left:12px;top:96px;z-index:20;width:268px;max-width:calc(100vw - 24px);background:rgba(27,21,15,.94);border:1px solid var(--bz,#8a6a3c);border-radius:4px;box-shadow:0 6px 18px rgba(0,0,0,.5);font-size:13px}
#nvTodo[hidden]{display:none}
#nvTodo:not(.open){width:auto}
#nvTodo .nvTh{display:flex;align-items:center;gap:8px;width:100%;background:transparent;border:0;min-height:30px;padding:5px 10px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--tx,#efe6d2)}
#nvTodo .nvTh i{font-style:normal;background:var(--gold,#d6b878);color:#1b1712;border-radius:9px;min-width:18px;padding:0 5px;font-weight:700;letter-spacing:0;text-align:center}
#nvTodo.urg .nvTh i{background:#d9694f;color:#fff}
#nvTodo .nvTh span{margin-left:auto;opacity:.6}
#nvTodo .nvTi{display:flex;gap:8px;align-items:flex-start;padding:6px 8px 6px 10px;border-top:1px solid rgba(138,106,60,.35);cursor:pointer}
#nvTodo .nvTi:hover{background:rgba(214,184,120,.12)}
#nvTodo .nvTi em{font-style:normal;flex:none;width:18px;height:18px;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:700;background:rgba(214,184,120,.18);color:var(--gold,#d6b878);margin-top:1px}
#nvTodo .nvTi.l0 em,#nvTodo .nvTi.l1 em{background:#b5452f;color:#fff}
#nvTodo .nvTi span{flex:1;min-width:0}#nvTodo .nvTi b{display:block;font-weight:600;line-height:1.25}
#nvTodo .nvTi small{display:block;color:var(--mu2,#b9a98a);font-size:11.5px;line-height:1.3}
#nvTodo .nvTo{flex:none;min-height:0;width:22px;height:22px;padding:0;font-size:12px;opacity:.7}
#nvTodo .nvTm{margin:0;padding:6px 10px 8px;color:var(--mu2,#b9a98a);font-size:12px;border-top:1px solid rgba(138,106,60,.35)}
@media (max-width:1180px){#nvBar .nvB{min-width:0;padding:4px 7px}#nvBar .nvB>span{display:none}#nvBar .nvB kbd{display:none}}
@media (max-width:700px){#nvTodo{top:auto;bottom:8px;left:8px}}
`;document.head.appendChild(st)}
// installation après tous les autres modules (qui redessinent la barre et la tablette)
setTimeout(()=>{try{nvBuild();
  if(typeof renderSide==='function'){const _rs=renderSide;renderSide=function(){const r=_rs.apply(this,arguments);try{townTabs()}catch(e){}return r}}
  const so=new MutationObserver(()=>{if(!nvTownBusy)setTimeout(()=>{try{townTabs()}catch(e){}},0)});try{so.observe($('side'),{childList:true})}catch(e){}
  setInterval(()=>{nvBuild();nvTodo()},1000);nvTodo()}catch(e){console.error(e)}},1200);
/* ---------- CONSTRUCTION : cartes illustrées (fil Interface, 11 nov.) ----------
   Remplace le texte de ecoBlock (onglet « Construire » de la fiche de ville) par une carte par bâtiment :
   vignette gravée crème et or, niveaux, effet en clair, prix et durée. Les boutons gardent data-bld (bindTown les relie à build).
   Un bâtiment ajouté à BLD par un autre fil apparaît tout seul (vignette par défaut ; ajouter son dessin à BD_ICO et son effet court à BD_EFF). */
const BD_ICO={
  mar:`<path d="M21 6h6v6h-6z M19 4.5h10v2.6H19z"/><path d="M18 13Q9 22 15.5 34Q20 42 24 44Q28 42 32.5 34Q39 22 30 13Z"/><path d="M21 8Q12 9 15 19M27 8Q36 9 33 19" class="s" stroke-width="2.4"/><path d="M15 24h18" class="h" stroke-width="1.6"/><path d="M16.5 28h15" class="h" stroke-width="1.2"/>`,
  port:`<circle cx="24" cy="8.5" r="3.4" class="s" stroke-width="2.4"/><path d="M22.6 12h2.8v28h-2.8z M16 16.5h16v2.8H16z"/><path d="M9.5 29Q11 41 24 41Q37 41 38.500 29" class="s" stroke-width="3"/><path d="M9.500 26l-4 7l7.500 -1z M38.500 26l4 7l-7.500 -1z"/>`,
  tem:`<path d="M5 18L24 5L43 18Z"/><path d="M7 19.500h34v3H7z M5 38h38v3H5z M3 42h42v2.500H3z"/><path d="M9.500 24h4.500v13H9.500z M17.300 24h4.500v13h-4.500z M25.200 24h4.500v13h-4.500z M33 24h4.500v13H33z"/><circle cx="24" cy="13" r="2.300" class="hf"/>`,
  cas:`<path d="M8 44L39 5M40 44L9 5" class="s" stroke-width="2.600"/><path d="M39 5l-5.500 2.500l3.800 3z M9 5l5.500 2.500l-3.800 3z"/><circle cx="24" cy="27" r="12.500"/><circle cx="24" cy="27" r="9.500" class="h" stroke-width="1.500"/><circle cx="24" cy="27" r="3.200" class="hf"/>`,
  mur:`<path fill-rule="evenodd" d="M3 44V12h4v4h4v-4h4v4h3v8h3v-4h4v4h4v-4h4v4h3v-8h3v-4h4v4h1v28Z M19.500 44V35a4.500 4.500 0 0 1 9 0V44Z"/><path d="M5 26h9M5 34h9M34 26h9M34 34h9M20 30h8" class="h" stroke-width="1.200"/>`,
  gre:`<path d="M24 45V14" class="s" stroke-width="2.200"/><ellipse cx="24" cy="9.500" rx="3" ry="5.500"/><g><ellipse cx="18.500" cy="15" rx="2.800" ry="5.500" transform="rotate(-28 18.500 15)"/><ellipse cx="29.500" cy="15" rx="2.800" ry="5.500" transform="rotate(28 29.500 15)"/><ellipse cx="18" cy="23" rx="2.800" ry="5.500" transform="rotate(-28 18 23)"/><ellipse cx="30" cy="23" rx="2.800" ry="5.500" transform="rotate(28 30 23)"/><ellipse cx="18" cy="31" rx="2.800" ry="5.500" transform="rotate(-28 18 31)"/><ellipse cx="30" cy="31" rx="2.800" ry="5.500" transform="rotate(28 30 31)"/></g><path d="M24 44Q16 42 12 36M24 44Q32 42 36 36" class="s" stroke-width="1.800"/>`,
  min:`<path d="M10 43L31 15" class="s" stroke-width="3.400"/><path d="M17 9Q32 5 42 20Q33 13 22 14.500Z"/><circle cx="35" cy="36" r="7.500"/><circle cx="35" cy="36" r="4.600" class="h" stroke-width="1.400"/><circle cx="22.500" cy="40.500" r="4.500"/><circle cx="22.500" cy="40.500" r="2.300" class="h" stroke-width="1.200"/>`,
  ars:`<circle cx="16" cy="32" r="10.500" class="s" stroke-width="2.800"/><path d="M16 21.500v21M5.500 32h21M8.600 24.600l14.800 14.800M23.400 24.600L8.600 39.400" class="s" stroke-width="1.600"/><circle cx="16" cy="32" r="2.800"/><path d="M29 43L42 9" class="s" stroke-width="2.800"/><path d="M43.500 5l-6 5l6.500 2.500z"/><path d="M27 36l8 3M30.500 27l8 3" class="s" stroke-width="2"/>`,
  har:`<path d="M13 45Q12 30 19 22L16.500 10L24 16.500Q35 15 40 27L43 36Q41 41 36.500 39L29.500 32.500Q27.500 39 30 45Z"/><circle cx="31.500" cy="24.500" r="1.800" class="hf"/><path d="M19.500 22Q22 30 20.500 38" class="h" stroke-width="1.300"/><path d="M38.500 35.500l2 1.200" class="h" stroke-width="1.300"/>`,
  frg:`<path d="M5 23H33Q40 23 43 18V27.500H32Q30 32 32.500 36H38V42.500H13V36H19.500Q22 32 20 27.500H5Z"/><path d="M14 17L31 6" class="s" stroke-width="2.800"/><path d="M26.500 3.500l9.500 -1.500l2.500 6l-9 3.500z"/><path d="M9 14l2 -4M15 9l1 -4.500M4 18l3.500 -2" class="s" stroke-width="1.500"/>`,
  sci:`<path d="M5 31h33a5 5 0 0 1 0 10H5Z"/><ellipse cx="38.500" cy="36" rx="4.200" ry="5" class="h" stroke-width="1.300"/><ellipse cx="38.500" cy="36" rx="1.700" ry="2.200" class="h" stroke-width="1.100"/><path d="M8 34.500h22M10 38h17" class="h" stroke-width="1.100"/><path d="M6 10H37L43 16V19H6Z"/><path d="M6 19l3 5l3 -5l3 5l3 -5l3 5l3 -5l3 5l3 -5l3 5l3 -5l3 5l3 -5Z"/><circle cx="38" cy="14.500" r="1.800" class="hf"/>`,
  _:`<path d="M9 8h30v4H9z M11 12.500h26v2.500H11z M14 16h20v24H14z M10 40.500h28v3H10z M7 44h34v2.500H7z"/><path d="M19 17v22M24 17v22M29 17v22" class="h" stroke-width="1.300"/>`};
const BD_EFF={mar:'Revenu de la ville +15 %',port:'Commerce maritime : +2 or par mois',tem:'Ordre public +8',cas:'Recrues formées 40 % plus vite',mur:'Les sièges durent 50 % de plus',
  gre:'Ordre +5, vivres refaits en ville',min:'+8 or par mois',ars:'+12 de matériel par mois aux armées',har:'Chevaux de la ville doublés',frg:'Fer de la ville doublé',sci:'Bois de la ville doublé'};
let bdIcoN=0;
function bdIco(k,on,sz){const u=++bdIcoN;const c=(()=>{try{const p=START_PEO.find(p=>p.k===peoCur());return p?p.c:'#7d4fb8'}catch(e){return '#7d4fb8'}})();
  const d=(BD_ICO[k]||BD_ICO._).replace(/class="s"/g,`fill="none" stroke="url(#bdE${u})" stroke-linecap="round" stroke-linejoin="round"`).replace(/class="hf"/g,`fill="${on?c:'#2a2018'}" stroke="none"`).replace(/class="h"/g,`fill="none" stroke="${on?c:'#2a2018'}" stroke-linecap="round" opacity=".85"`);
  return `<svg class="bdI${on?' on':''}" viewBox="0 0 48 48" width="${sz||46}" height="${sz||46}" aria-hidden="true"><defs><linearGradient id="bdE${u}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff6dc"/><stop offset="1" stop-color="#d9b872"/></linearGradient>
    <radialGradient id="bdF${u}" cx=".4" cy=".32" r=".85"><stop offset="0" stop-color="${on?c:'#4a3a28'}"/><stop offset="1" stop-color="${on?'#1a120a':'#211910'}"/></radialGradient></defs>
    <rect x="1" y="1" width="46" height="46" rx="7" fill="url(#bdF${u})" stroke="${on?'#d6b878':'#6b5536'}" stroke-width="1.500"/>
    <g transform="translate(24 24) scale(.8) translate(-24 -25)"><g transform="translate(0 1.600)" fill="rgba(8,5,2,.55)" stroke="none" style="--x:0">${(BD_ICO[k]||BD_ICO._).replace(/class="s"/g,'fill="none" stroke="rgba(8,5,2,.55)" stroke-linecap="round"').replace(/class="hf?"/g,'fill="none" stroke="none"')}</g>
    <g fill="url(#bdE${u})" stroke="none">${d}</g></g></svg>`}
const bdPips=(l,max)=>`<span class="bdP" aria-label="niveau ${l} sur ${max}">${'<i class="on"></i>'.repeat(l)}${'<i></i>'.repeat(max-l)}</span>`;
if(typeof ecoBlock==='function'){const _ebE=ecoBlock;ecoBlock=function(i){try{ecoInit();const n=N[i],id=n.id;if(ownerN(i)!=='car'||n.col)return '';
  const o=Math.round(S.ord[id]==null?ordTarget(n):S.ord[id]),P=ordParts(n),tg=Math.round(ordTarget(n));
  const parts=P.filter(p=>p[0]!=='base').map(p=>`<span class="${p[1]>0?'pos':'neg'}">${esc(p[0])} ${p[1]>0?'+':'−'}${Math.abs(p[1])}</span>`).join('');
  let h=`<h3>Gouvernement de la ville</h3><div class="bdO"><div class="bdOh"><b>Ordre public</b><span>${o}<small> sur 100${tg!==o?` · tend vers ${tg}`:''}</small></span></div>
    <div class="bdOg"><i style="width:${o}%;background:${o<30?'var(--bad)':o<50?'var(--gold)':'var(--good)'}"></i>${tg!==o?`<u style="left:${Math.max(0,Math.min(100,tg))}%"></u>`:''}</div>
    ${parts?`<div class="bdOp">${parts}</div>`:''}<p class="sub">Revenu <b>${townIncome(n)}</b> or par mois${o<30?' · sous 12, la ville peut se révolter':''}</p></div>`;
  const q=S.bq[id],ks=Object.keys(BLD).filter(k=>!BLD[k].need||BLD[k].need(n)),gold=S.gold.car;
  if(q&&BLD[q.k]){const B=BLD[q.k],l=bl(id,q.k),tot=(B.days&&B.days[l])||q.d,pr=Math.max(0,Math.min(1,1-q.d/tot));
    h+=`<div class="bdW">${bdIco(q.k,true,40)}<div><b>En chantier : ${esc(B.n)}${B.max>1?' (niveau '+(l+1)+')':''}</b><div class="bdOg"><i style="width:${Math.round(pr*100)}%;background:var(--gold)"></i></div><small>encore ${Math.ceil(q.d)} jour${Math.ceil(q.d)>1?'s':''}</small></div></div>`}
  const card=k=>{const B=BLD[k],l=bl(id,k),full=l>=B.max,busy=q&&q.k===k,c=full?0:B.cost[l],poor=!full&&gold<c;
    const eff=BD_EFF[k]||(B.txt?B.txt.charAt(0).toUpperCase()+B.txt.slice(1):'');
    return `<div class="bdC${full?' full':''}${l?' has':''}${busy?' busy':''}" title="${esc(B.n+' : '+(B.txt||''))}">${bdIco(k,l>0)}
      <div class="bdT"><b>${esc(B.n)}</b>${bdPips(l,B.max)}<small>${esc(eff)}${B.max>1&&!full?' par niveau':''}</small></div>
      ${full?'<span class="bdF">Complet</span>':busy?'<span class="bdF">En cours</span>':`<button data-bld="${k}" data-id="${id}" type="button" class="bdB${poor?' poor':''}" ${q||poor?'disabled':''} title="${q?'Un seul chantier à la fois dans la ville':poor?`Il manque ${Math.ceil(c-gold)} or`:(l?'Agrandir':'Construire')+' : '+c+' or, '+B.days[l]+' jours'}"><b>${c}</b><small>${B.days[l]} j</small></button>`}</div>`};
  const todo=ks.filter(k=>bl(id,k)<BLD[k].max),done=ks.filter(k=>bl(id,k)>=BLD[k].max);
  if(todo.length)h+=`<div class="bdH">À construire${q?' <small>· un seul chantier à la fois</small>':''}</div>`+todo.map(card).join('');
  if(done.length)h+=`<div class="bdH">Achevés</div>`+done.map(card).join('');
  return h}catch(e){console.error(e);return _ebE.apply(this,arguments)}}}
{const st=document.createElement('style');st.textContent=`
.bdO{border:1px solid var(--line,#6b5536);border-radius:5px;padding:8px 10px;margin:6px 0 10px;background:rgba(0,0,0,.18)}
.bdOh{display:flex;justify-content:space-between;align-items:baseline}.bdOh span{font-family:var(--display,serif);font-size:19px}.bdOh small{font-family:var(--ui,sans-serif);font-size:11.500px;color:var(--mu2,#b9a98a)}
.bdOg{position:relative;height:7px;border-radius:4px;background:rgba(255,255,255,.1);margin:6px 0;overflow:visible}.bdOg i{display:block;height:100%;border-radius:4px}
.bdOg u{position:absolute;top:-3px;width:2px;height:13px;background:var(--tx,#efe6d2);opacity:.75;text-decoration:none}
.bdOp{display:flex;flex-wrap:wrap;gap:4px;margin:6px 0 2px}.bdOp span{font-size:11.500px;border:1px solid var(--line,#6b5536);border-radius:9px;padding:0 7px;line-height:17px}
.bdOp .pos{color:#a9d08c;border-color:rgba(169,208,140,.45)}.bdOp .neg{color:#e8907a;border-color:rgba(232,144,122,.45)}
.bdO p.sub{margin:6px 0 0}
.bdW{display:flex;gap:10px;align-items:center;border:1px solid var(--gold,#d6b878);border-radius:5px;padding:7px 9px;margin:0 0 10px;background:rgba(214,184,120,.1)}
.bdW>div{flex:1;min-width:0}.bdW b{font-size:13.500px}.bdW small{color:var(--mu2,#b9a98a);font-size:11.500px}
.bdH{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mu2,#b9a98a);margin:12px 0 5px}.bdH small{text-transform:none;letter-spacing:0}
.bdC{display:flex;gap:10px;align-items:center;padding:6px 7px;margin:0 0 5px;border:1px solid rgba(107,85,54,.7);border-radius:6px;background:rgba(255,255,255,.025)}
.bdC:hover{border-color:var(--bz,#8a6a3c);background:rgba(214,184,120,.07)}
.bdC .bdI{flex:none;display:block}.bdC:not(.has) .bdI{opacity:.82}
.bdT{flex:1;min-width:0;line-height:1.25}.bdT b{font-size:14px;font-weight:600;margin-right:6px}.bdT small{display:block;color:var(--mu2,#b9a98a);font-size:12px;margin-top:1px}
.bdP{display:inline-flex;gap:3px;vertical-align:1px}.bdP i{width:8px;height:8px;border-radius:50%;border:1.500px solid var(--gold,#d6b878);box-sizing:border-box}.bdP i.on{background:var(--gold,#d6b878)}
.bdC .bdB{flex:none;display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:50px;min-height:40px;padding:3px 8px;line-height:1.1;background:rgba(214,184,120,.2);border-color:var(--gold,#d6b878)}
.bdC .bdB b{font-size:15px}.bdC .bdB small{font-size:10.500px;color:var(--mu2,#b9a98a)}
.bdC .bdB:hover:not(:disabled){background:var(--gold,#d6b878);color:#1b1712}.bdC .bdB:hover:not(:disabled) small{color:#1b1712}
.bdC .bdB:disabled{opacity:.55;background:transparent;border-color:var(--line,#6b5536);cursor:default}.bdC .bdB.poor b{color:#e8907a}
.bdF{flex:none;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--gold,#d6b878);min-width:50px;text-align:center}
.bdC.full{border-color:rgba(214,184,120,.35)}
`;document.head.appendChild(st)}
/* ---------- CHANTIER NAVAL ET PANNEAU DE FLOTTE (fil Interface, 11 nov.) ----------
   1. shipyardBlock : une carte illustrée par type de navire (mêmes vignettes gravées que les bâtiments). Les boutons gardent
      data-ship / data-n (bindShipyard et le module des ressources les relient) et un .sub dans la carte reçoit le coût en bois.
   2. Panneau de flotte : rangé après coup dans la tablette (comme townTabs) : état, composition en vignettes, chiffres clés,
      puis onglets Ordres / À bord / Missions / Amiral. Les boutons d'origine sont déplacés, pas recréés : leurs actions restent.
      Une section ajoutée par un autre fil (nouveau h3) tombe dans « Missions » ; l'ajouter à NF_KIND pour la ranger ailleurs. */
Object.assign(BD_ICO,{
  quin:`<path d="M4 29H37L46 26.500L41.500 33Q39.500 37.500 35 37.500H10Q5 37.500 4 29Z"/><path d="M40.500 31.500L47.500 33.200L40 35.500Z"/><path d="M6 30Q1.500 22 6.500 15.500Q9.500 12.500 11.500 16.500" class="s" stroke-width="2.400"/>
    <path d="M17 21h2.500v2h2.500v-2h3v2h2.500v-2H30v8H17Z"/><path d="M23.500 3.500v18" class="s" stroke-width="2"/><path d="M14.500 6h18" class="s" stroke-width="2.200"/><path d="M15.500 7.500h16v5.500Q23.500 15.500 15.500 13Z"/>
    <path d="M8 32.500h29" class="h" stroke-width="1.300"/><circle cx="33.500" cy="26" r="1.700" class="hf"/><circle cx="12.500" cy="26.300" r="1.700" class="hf"/>
    <path d="M11 38l-3.500 7.500M15.500 38l-3.500 7.500M20 38l-3.500 7.500M24.500 38l-3.500 7.500M29 38l-3.500 7.500M33.500 38l-3.500 7.500" class="s" stroke-width="1.700"/>`,
  tri:`<path d="M3 31.500H37L46.500 29.500L41.500 34.500Q39.500 37.500 36 37.500H8.500Q4 37.500 3 31.500Z"/><path d="M41 33L47.500 34.300L40.500 36.300Z"/><path d="M4.500 32Q1 25 5.500 19.500Q8 17 9.500 20.500" class="s" stroke-width="2.200"/>
    <path d="M23.500 4v27" class="s" stroke-width="1.800"/><path d="M12.500 7H34.500Q38.500 16.500 34.500 26H12.500Q16.500 16.500 12.500 7Z"/><path d="M18 9.500Q21 16.500 18 23.500M29 9.500Q32 16.500 29 23.500" class="h" stroke-width="1.200"/>
    <circle cx="39" cy="32.300" r="1.500" class="hf"/>
    <path d="M9 38l-3 7M12.800 38l-3 7M16.600 38l-3 7M20.400 38l-3 7M24.200 38l-3 7M28 38l-3 7M31.800 38l-3 7M35.600 38l-3 7" class="s" stroke-width="1.300"/>`,
  trans:`<path d="M4.500 27H43.500Q43 40 33 42H15Q5 40 4.500 27Z"/><path d="M6 28Q2.500 21 6 15.500Q8.500 13 10.500 15.500" class="s" stroke-width="2.400"/><path d="M42 28Q45.500 24 44 19.500" class="s" stroke-width="2.200"/>
    <path d="M24 3.500v24" class="s" stroke-width="2.200"/><path d="M11 6H37Q39.500 14 37 22.500H11Q13.500 14 11 6Z"/><path d="M11.800 11.500h24.400M11.800 17h24.400M19.500 6.500v15.500M28.500 6.500v15.500" class="h" stroke-width="1.100"/>
    <path d="M7.500 32h33M9.500 36.500h29" class="h" stroke-width="1.200"/><path d="M9 29.500L5.500 44" class="s" stroke-width="2"/><path d="M4 41l3.500 .800l-1.800 4.700l-3 -.700Z"/>`});
const NF_ROLE={quin:['Vaisseaux de ligne : combat et blocus','Éperonnent, abordent, tiennent un blocus. Portent aussi quelques troupes.'],
  tri:['Galères rapides : poursuite et vigie','Poursuivent pirates et marchands, partent en vigie.'],
  trans:['Portent les armées, un régiment par navire','Un régiment par navire. Sans défense s\'ils naviguent seuls.']};
const nfPl=(n,k)=>n+' '+(n>1?SHIP[k].n.toLowerCase():SHIP[k].one);
if(typeof shipyardBlock==='function'){const _sbE=shipyardBlock;shipyardBlock=function(n){try{
  if(!n.port||ownerN(n.i)!=='car')return '';
  const yard=YARD.has(n.id),blocked=S.block[n.id]&&S.block[n.id].side!=='car',q=S.fq[n.id],gold=S.gold.car;
  let h=`<h3>Chantier naval</h3>`;
  if(blocked)h+=`<div class="bdW nfBad"><div><b>Port bloqué</b><small>Une flotte ennemie tient la rade : aucun navire ne peut être lancé. Chassez-la pour rouvrir le chantier.</small></div></div>`;
  else if(q&&SHIP[q.t]){const tot=SHIP[q.t].d,pr=Math.max(0,Math.min(1,1-q.d/tot));
    h+=`<div class="bdW">${bdIco(q.t,true,40)}<div><b>Sur cale : ${nfPl(q.n,q.t)}</b><div class="bdOg"><i style="width:${Math.round(pr*100)}%;background:var(--gold)"></i></div><small>lancement dans ${Math.ceil(q.d)} jour${Math.ceil(q.d)>1?'s':''}</small></div></div>`}
  const here=S.fleets.filter(f=>f.side==='car'&&f.at===n.i&&!f.legs.length);
  h+=`<p class="sub nfIn">Les navires sortent par escadres de ${BATCH}${here.length?` et rejoignent <b>${esc(here[0].name)}</b>, au port`:' et forment une flotte au port'}.${yard?'':' Petit port : il ne construit que des transports.'}</p>`;
  h+=`<div class="bdH">Mettre sur cale${q?' <small>· une seule cale à la fois</small>':''}</div>`;
  h+=Object.keys(SHIP).map(k=>{const s=SHIP[k],c=s.cost*BATCH,no=!yard&&k!=='trans',poor=gold<c,R=NF_ROLE[k]||['',''];
    return `<div class="bdC nfY${no?' nfNo':''}" title="${esc(s.n+' : '+R[1])}">${bdIco(k,!no)}
      <div class="bdT"><b>${BATCH} ${s.n.toLowerCase()}</b><small class="nfR">${R[0]}</small>
        <small class="sub nfS">${s.d} jours · entretien ${+(s.up*BATCH).toFixed(2)} or/mois</small></div>
      ${no?'<span class="bdF">Grand port requis</span>':`<button data-ship="${k}" data-n="${n.i}" type="button" class="bdB${poor?' poor':''}" ${q||blocked||poor?'disabled':''} title="${blocked?'Port bloqué':q?'Une seule cale à la fois':poor?`Il manque ${Math.ceil(c-gold)} or`:`Construire : ${c} or, ${s.d} jours`}"><b>${c}</b><small>or</small></button>`}</div>`}).join('');
  return h}catch(e){console.error(e);return _sbE.apply(this,arguments)}}}

/* ---- panneau de flotte ---- */
let nfTab='ord',nfBusy=false,nfHelpOpen=false;
const NF_TT=[['ord','Ordres'],['brd','À bord'],['mis','Missions'],['adm','Amiral']];
const NF_KIND=t=>/À bord/i.test(t)?'brd':/Commandement/i.test(t)?'adm':'mis';
const NF_HELP=/Clic droit|Une armée embarque|Une descente demande/;
function nfFleet(){const el=$('side');if(!el||nfBusy)return;
  const f=typeof sel!=='undefined'&&sel&&sel.f;
  if(!f||f.side!=='car'||!S.fleets.includes(f)){el.classList.remove('nfFleet');return}
  if(el.querySelector(':scope > .nfW')||!$('fCote'))return;
  nfBusy=true;try{
    const skip=c=>c.nodeType===1&&(c.classList.contains('ui-x')||c.classList.contains('ui-head')||c.tagName==='H2'||c.classList.contains('nvKeep'));
    const loose=[...el.childNodes].filter(c=>!skip(c)&&!(c.nodeType===3&&!c.textContent.trim()));
    const W=document.createElement('div');W.className='nfW';
    const P={};const body=document.createElement('div');body.className='nfB';
    NF_TT.forEach(([k])=>{const p=document.createElement('div');p.className='nfP';p.dataset.k=k;body.appendChild(p);P[k]=p});
    const help=[];let cur='ord',stat=null,first=true;
    for(const c of loose){
      if(c.nodeType!==1){continue}
      if(c.tagName==='H3'){cur=NF_KIND(c.textContent);const t=c.textContent.replace(/\s*\(.*$/,'').trim();
        if(/^(À bord|Missions|Commandement)$/.test(t)){c.remove();continue}
        c.classList.add('nfH');P[cur].appendChild(c);continue}
      if(c.tagName==='P'&&first&&cur==='ord'){first=false;stat=c;continue}
      if(c.tagName==='P'&&cur==='ord'&&c.classList.contains('sub')&&/quinquérèmes ·/.test(c.textContent)){c.remove();continue}
      if(c.tagName==='P'&&c.classList.contains('sub')&&!c.querySelector('button,select')&&NF_HELP.test(c.textContent)){c.removeAttribute('style');help.push(c);
        if(/^Aucune troupe/.test(c.textContent.trim()))P[cur].insertAdjacentHTML('beforeend','<p class="sub nfE">Aucune troupe à bord.</p>');continue}
      if(cur==='ord'&&c.classList.contains('row')){const lab=c.querySelector('#fCote')?'Route':c.querySelector('#fGar')?'Port':c.querySelector('#fHalt')?'Manœuvres':'';
        if(lab)P.ord.insertAdjacentHTML('beforeend',`<div class="nfL">${lab}</div>`)}
      P[cur].appendChild(c)}
    // en-tête : état, composition, chiffres clés
    const cap=fCap(f),used=fUsed(f),coast=f.at!=null||(typeof onCoast==='function'&&onCoast(f.x,f.y)),food=f.food==null?null:Math.round(f.food);
    const comp=Object.keys(SHIP).map(k=>{const n=f.ships[k]||0;return `<div class="nfS1${n?'':' zero'}" title="${esc((NF_ROLE[k]||['',''])[1])}">${bdIco(k,n>0,34)}<b>${n}</b><small>${n>1?SHIP[k].n.toLowerCase():SHIP[k].one}</small></div>`}).join('');
    const tile=(v,l,cls,tt)=>`<div class="nfK1${cls?' '+cls:''}"${tt?` title="${esc(tt)}"`:''}><b>${v}</b><small>${l}</small></div>`;
    let xp='';try{if(f.xp!=null&&typeof xpRank==='function')xp=tile(xpRank(f.xp),'équipages','',`Expérience ${Math.round(f.xp)}/100`)}catch(e){}
    const tiles=tile(Math.round(fSpeed(f)),'km/jour','',f.mode==='cote'?'Cabotage : plus lent mais sûr':'Haute mer : plus rapide, plus risqué')+
      (food!=null?tile(food+' j','vivres',food<=5?'bad':food<=10?'warn':'','Les vivres se refont au port ou par un convoi qui suit la flotte'):'')+
      tile(coast?'côte':(f.water+' j'),'eau',!coast&&f.water<=2?'bad':'',coast?'Renouvelée chaque soir près des côtes':'En haute mer, l\'eau est comptée')+
      tile(used+'/'+cap,'à bord',used>cap?'bad':'')+xp;
    const head=document.createElement('div');head.className='nfHd';
    if(stat){stat.classList.add('nfSt');head.appendChild(stat)}
    head.insertAdjacentHTML('beforeend',`<div class="nfS0">${comp}</div><div class="nfK">${tiles}</div>`);
    const bar=document.createElement('div');bar.className='nfT ua-tabs';bar.setAttribute('role','tablist');
    const cnt={brd:f.cargo.length||'',mis:(f.task||f.chase||f.follow!=null)?'●':''};
    bar.innerHTML=NF_TT.filter(([k])=>P[k].children.length).map(([k,n])=>`<button type="button" role="tab" data-k="${k}">${n}${cnt[k]?` <i>${cnt[k]}</i>`:''}</button>`).join('');
    bar.querySelectorAll('button').forEach(b=>b.onclick=()=>{nfTab=b.dataset.k;nfShow(el)});
    W.appendChild(head);W.appendChild(bar);W.appendChild(body);
    if(help.length){const d=document.createElement('details');d.className='nfHp';d.open=nfHelpOpen;d.innerHTML='<summary>Comment ça marche</summary>';help.forEach(p=>d.appendChild(p));d.ontoggle=()=>{nfHelpOpen=d.open};W.appendChild(d)}
    el.appendChild(W);el.classList.add('nfFleet');nfShow(el)}catch(e){console.error(e)}finally{nfBusy=false}}
function nfShow(el){const bar=el.querySelector('.nfT'),body=el.querySelector('.nfB');if(!bar||!body)return;
  const ks=[...bar.querySelectorAll('button')].map(b=>b.dataset.k);const t=ks.includes(nfTab)?nfTab:ks[0];
  bar.querySelectorAll('button').forEach(b=>b.classList.toggle('on',b.dataset.k===t));
  body.querySelectorAll(':scope > .nfP').forEach(p=>p.hidden=p.dataset.k!==t)}
{const st=document.createElement('style');st.textContent=`
.bdW.nfBad{border-color:#d9694f;background:rgba(217,105,79,.12)}.bdW.nfBad small{display:block;margin-top:2px}
p.nfIn{margin:0 0 4px}
.bdC.nfY{align-items:flex-start}.bdC.nfY .bdI{margin-top:2px}.bdC.nfY .bdB{align-self:center}.bdC.nfY .bdF{align-self:center;max-width:62px;line-height:1.25}
.bdC.nfY .bdT small.nfR{line-height:1.3}.bdC.nfY .bdT small.nfS{color:var(--tx,#efe6d2);opacity:.85;margin-top:3px;font-size:11.500px}
.bdC.nfNo{opacity:.62}
#side.nfFleet>.nfW{margin-top:6px}
.nfSt{margin:2px 0 8px;line-height:1.35}
.nfS0{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
.nfS1{display:grid;grid-template-columns:auto 1fr;column-gap:7px;row-gap:3px;align-items:center;padding:5px 6px;border:1px solid rgba(107,85,54,.7);border-radius:6px;background:rgba(255,255,255,.025)}
.nfS1 svg{display:block}.nfS1 b{font-family:var(--display,serif);font-size:21px;line-height:1}.nfS1 small{grid-column:1/3;font-size:11px;color:var(--mu2,#b9a98a);line-height:1.1}
.nfS1.zero{opacity:.5}
.nfK{display:flex;gap:5px;margin:5px 0 9px}
.nfK1{flex:1;min-width:0;text-align:center;padding:4px 2px;border-radius:5px;background:rgba(0,0,0,.2);border:1px solid rgba(107,85,54,.45)}
.nfK1 b{display:block;font-size:14px;font-weight:600;line-height:1.15;white-space:nowrap}.nfK1 small{display:block;font-size:10px;color:var(--mu2,#b9a98a);line-height:1.15;letter-spacing:.02em}
.nfK1.bad b{color:#e8907a}.nfK1.warn b{color:var(--gold,#d6b878)}
.nfT{flex-wrap:wrap}.nfT button{padding:3px 8px!important;font-size:12.500px!important}.nfT button i{font-style:normal;font-size:10.500px;color:var(--gold,#d6b878);margin-left:2px}
.nfB{padding-top:8px}.nfB .row{flex-wrap:wrap}
.nfL,.nfB h3.nfH{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mu2,#b9a98a);margin:10px 0 4px;font-weight:400;font-family:var(--ui,sans-serif);border:0;padding:0}
.nfP>.nfL:first-child,.nfP>h3.nfH:first-child{margin-top:0}
.nfP>p{margin:4px 0 6px;line-height:1.4}
.nfHp{margin-top:12px;border-top:1px solid rgba(138,106,60,.35);padding-top:6px}
.nfHp summary{cursor:pointer;font-size:12px;color:var(--mu2,#b9a98a);letter-spacing:.04em}.nfHp summary:hover{color:var(--tx,#efe6d2)}
.nfHp p{margin:6px 0 0;font-size:12px;line-height:1.4}
`;document.head.appendChild(st)}
setTimeout(()=>{try{
  if(typeof renderSide==='function'){const _rsN=renderSide;renderSide=function(){const r=_rsN.apply(this,arguments);try{nfFleet()}catch(e){}return r}}
  const so=new MutationObserver(()=>{if(!nfBusy)setTimeout(()=>{try{nfFleet()}catch(e){}},0)});try{so.observe($('side'),{childList:true})}catch(e){}
}catch(e){console.error(e)}},1300);
/* ================= FIN EMBLÈMES ================= */
