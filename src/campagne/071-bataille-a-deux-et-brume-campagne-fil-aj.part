/* ================= BATAILLE À DEUX ET BRUME (campagne ; fil « Ajouter sons, embuscades et bataille à deux ») =================
   Quand les deux joueurs concernés veulent livrer la bataille sur le terrain, ils s'affrontent pour de vrai :
   - le joueur du camp attaquant (« hôte de la bataille ») fait tourner la simulation dans son champ de bataille ;
   - il envoie aux autres (« invité de la bataille », joueurs qui la rejoignent) le champ de bataille, puis l'état des régiments ;
   - chacun donne ses ordres, qui repartent chez l'hôte. Les messages passent par la connexion de la partie à plusieurs
     (l'hôte de la partie les relaie en connexion directe). Le résultat revient à la campagne comme pour une bataille seule.
   Rôles (PVPC.cur.role) : 'h' hôte de la bataille, 'g' invité (l'autre camp), 'j' joueur qui rejoint la bataille en cours
   (voir rejoindre-campagne.js). Une bataille contre l'IA livrée par un joueur ('3d:…') a aussi un hôte, pour qu'on la rejoigne.
   Brume : chaque bataille tire au sort (selon la saison, l'eau proche) une brume du matin, envoyée dans CAMP.b.brume.
   Source : /mnt/project-files/futur/pvp-campagne.js, injecté par futur/patch.py après les autres blocs (avant BOUCLE). */
const PVPC={cur:null,done:new Set()};
{
  const sideOfIds=ids=>{const a=S.armies.find(x=>x.id===ids[0]);return a&&a.side};
  const peersOf=P=>P.role==='h'?[...P.peers]:[P.peer];
  function pvpSendTo(to,m){if(!MP.tr||!to)return;mpSend({t:'bv',to,o:MP.me,d:m})}
  function pvpSend(m){const P=PVPC.cur;if(!P||!MP.tr)return;for(const to of peersOf(P))pvpSendTo(to,m)}
  function pvpSendPay(to){const P=PVPC.cur;if(!P||!P.pay||!MP.tr)return;for(const t of to?[to]:peersOf(P))if(t)mpSendBig('bvb',{k:'pay',pay:P.pay},{to:t,o:MP.me})}
  function pvpRecv(d){
    if(d.to!==MP.me){if(MP.role==='host'&&MP.tr&&MP.tr.kind==='direct'){const c=Object.assign({},d);delete c.f;mpSend(c)}return} // relais (étoile WebRTC)
    if(d.t==='bvb'){mpChunk(d,o=>pvpIn(o,d));return}
    pvpIn(d.d,d)}
  const toFrame=(m,f)=>{const fr=$('battle3d');if(fr&&fr.contentWindow)fr.contentWindow.postMessage({bellum:'pvp',d:m,f},'*')};
  function pvpIn(m,d){const P=PVPC.cur;if(!m||!P)return;
    // l'hôte de la bataille accepte tous les joueurs qui la regardent ; les autres n'écoutent que lui
    if(P.role==='h'){if(m.k!=='join'){if(!d.o)return;P.peers.add(d.o)}}else if(d.o!==P.peer)return;
    P.seen=performance.now();
    if(m.k==='pay'){if(P.role!=='h')pvpGo(m.pay);return}
    if(m.k==='want'){if(P.role==='h')pvpSendPay(d.o);return}
    toFrame(m,d.o)}
  // le champ de bataille parle au réseau par la page
  window.addEventListener('message',ev=>{const d=ev.data;if(!d||d.bellum!=='pvp')return;const f=$('battle3d');if(!f||ev.source!==f.contentWindow)return;pvpSend(d.d)});
  {const _h=mpOnHost;mpOnHost=function(d){
    if(d&&(d.t==='bv'||d.t==='bvb')){const g=MP.gs[d.f];if(g)g.lastHb=performance.now();pvpRecv(d);return}
    // résultat d'une bataille à deux livrée chez un invité
    if(d&&d.t==='bres'&&S.cur&&S.cur.mp&&S.cur.mp.state==='pvp'&&S.cur.mp.bh===d.f&&mpBKey(S.cur)===d.k){const b=S.cur,r=d.res;S.cur=null;closeModal();
      log(`${battleTitle(b)} : ${esc(mpName(b.mp.bh))} et ${esc(mpName(b.mp.bg))} ont livré la bataille sur le terrain.`);applyResult(b,{attWin:r.attWin,A:r.A,D:r.D});refreshAfterBattle();mpKfSoon(0);return}
    return _h.apply(this,arguments)}}
  {const _g=mpOnGuest;mpOnGuest=function(d){if(d&&(d.t==='bv'||d.t==='bvb')){if(d.to&&d.to!==MP.me)return;pvpRecv(d);return}return _g.apply(this,arguments)}}
  // les deux veulent le terrain : bataille à deux (l'attaquant héberge la bataille)
  {const _r=mpResolve;mpResolve=function(){const b=S.cur;
    if(b&&b.mp&&!b.mp.state&&b.mp.car==='3d'&&b.mp.rom==='3d'){const O=b.mp.o||{},aS=sideOfIds(b.att)||'car',dS=aS==='car'?'rom':'car';
      if(O[aS]&&O[dS]&&O[aS]!==O[dS]){b.mp.state='pvp';b.mp.bh=O[aS];b.mp.bg=O[dS];b.mp.id=Math.random().toString(36).slice(2,8);b.mp.s0='att';
        log(`${battleTitle(b)} : ${esc(mpName(O.car))} et ${esc(mpName(O.rom))} vont s'affronter sur le terrain.`);MP.bmod=null;save();mpBattleUI();mpKfSoon(0);return}}
    // un seul joueur sur le terrain, contre l'IA : il héberge la bataille (on peut la rejoindre)
    if(b&&b.mp&&!b.mp.state){const want=['car','rom'].filter(s=>b.mp[s]==='3d'),O=b.mp.o||{};
      if(want.length===1&&!['car','rom'].some(k=>b.mp[k]===0)&&!['car','rom'].some(k=>b.mp[k]==='flee')){const s=want[0];b.mp.bh=O[s];b.mp.id=b.mp.id||Math.random().toString(36).slice(2,8);b.mp.s0=(sideOfIds(b.att)===s)?'att':'def'}}
    return _r.apply(this,arguments)}}
  // l'hôte d'une bataille contre l'IA prépare la liaison avant d'entrer sur le terrain
  {const _g3=go3D;go3D=function(){try{const b=S.cur,mp=b&&b.mp;
      if(MP.role&&mp&&/^3d:/.test(mp.state||'')&&mp.bh===MP.me&&!(PVPC.cur&&PVPC.cur.key===mpBKey(b))&&!PVPC.done.has(mp.id))PVPC.cur={role:'h',peer:null,peers:new Set(),key:mpBKey(b),id:mp.id,solo:true}}catch(e){console.warn(e)}
    return _g3.apply(this,arguments)}}
  {const _ui=mpBattleUI;mpBattleUI=function(){const b=S&&S.cur,mp=b&&b.mp;
    // bataille en direct déjà commencée : le joueur qui la rejoint, ou un bandeau pour les autres (rejoindre-campagne.js)
    if(MP.role&&mp&&mp.id&&typeof window.__lbUI==='function'&&window.__lbUI(b))return;
    if(!MP.role||!mp||mp.state!=='pvp'){const r=_ui.apply(this,arguments);
      try{document.querySelectorAll('#mcard p.sub').forEach(p=>{if(p.innerHTML.includes('la bataille à deux arrive bientôt'))p.innerHTML=p.innerHTML.replace(/si les deux la veulent, résolution automatique pour l'instant \(la bataille à deux arrive bientôt\)/,'si les deux la veulent, <b>vous vous affrontez sur le terrain</b>, chacun avec son armée')})}catch(e){}
      return r}
    if(MP.role==='guest'&&!MP.ready)return;
    const key=mpBKey(b);
    // une bataille déjà livrée (l'état de l'hôte peut la montrer encore un instant) ne se relance pas
    if(PVPC.done.has(mp.id))return;
    if(mp.bh===MP.me||mp.bg===MP.me){if(PVPC.cur&&PVPC.cur.key===key)return;
      const h=mp.bh===MP.me;PVPC.cur=h?{role:'h',peer:mp.bg,peers:new Set([mp.bg]),key,id:mp.id}:{role:'g',peer:mp.bh,key,id:mp.id};MP.played=key;
      if(h){if(MP.role==='guest')MP.in3d=key;closeModal();const att=S.armies.find(x=>x.id===b.att[0]);go3D(!!att&&att.side==='car')}
      else{MP.pvpG=key;MP.bmod=null;modal(`<i data-mpb hidden></i><h2>${battleTitle(b)}</h2><p>Bataille à deux : ${esc(mpName(mp.bh))} prépare le champ de bataille…</p><p class="sub">Il commande l'attaquant ; vous commanderez votre armée depuis votre écran.</p>`);
        pvpAsk()}
      return}
    const k2=key+'|pvp';if(MP.bmod===k2&&!$('modal').hidden)return;MP.bmod=k2;
    modal(`<i data-mpb hidden></i><h2>${battleTitle(b)}</h2><p>${esc(mpName(mp.bh))} et ${esc(mpName(mp.bg))} s'affrontent sur le terrain, chacun avec son armée.</p><p class="sub">Le jeu est en pause pour tous les joueurs jusqu'à la fin de la bataille.</p>`)}}
  // on réclame le champ de bataille à son hôte jusqu'à l'avoir reçu
  function pvpAsk(){const P=PVPC.cur;(function ask(){if(PVPC.cur!==P||P.go)return;pvpSend({k:'want'});setTimeout(ask,2500)})()}
  // hôte de la bataille : on garde le champ de bataille pour l'envoyer aux autres joueurs
  {const _dv=dive;dive=function(payload){const P=PVPC.cur;
    if(P&&P.role==='h'&&!payload.pvp&&S.cur&&mpBKey(S.cur)===P.key){let size=1;try{size=+localStorage.getItem('bellum.taille')||1}catch(e){}
      payload.pvp={role:'h',size,peer:P.peer?mpName(P.peer):null,hid:MP.me,gid:P.peer||null,solo:P.solo?1:0,names:{}};
      try{for(const id of Object.keys(S.mpP||{}))payload.pvp.names[id]=mpName(id)}catch(e){}
      P.pay={v:payload.v,b:payload.b,t:payload.t,size,me:mpName(MP.me),hid:MP.me,gid:P.peer||null,names:payload.pvp.names};pvpSendPay()}
    return _dv.apply(this,arguments)}}
  // invité de la bataille ou joueur qui la rejoint : même champ de bataille, vu de son côté
  function pvpGo(pay){const P=PVPC.cur;if(!P||P.role==='h'||P.go||!pay||!pay.t)return;P.go=true;closeModal();
    const flip=P.role==='g'||!!P.flip;const b=Object.assign({},pay.b);
    if(flip){if(b.cmd)b.cmd={p:b.cmd.e,e:b.cmd.p};if(b.walls)b.walls=Object.assign({},b.walls,{side:b.walls.side==='p'?'e':'p'})}
    b.desc=P.role==='g'?`Bataille à deux contre ${pay.me}, qui commande l'attaquant.`:`Vous rejoignez la bataille de ${pay.me}. Vos régiments arrivent en renfort par le bord du champ qui fait face à votre marche.`;
    b.enemy=flip?pay.me:b.enemy;
    const t=Object.assign({},pay.t);delete t.intro;
    dive({v:pay.v,st:S,b,t,pvp:{role:P.role,size:pay.size||1,peer:pay.me,hid:pay.hid,gid:pay.gid,me:MP.me,flip:flip?1:0,names:pay.names||{}}})}
  // l'invité de la bataille n'applique pas le résultat : c'est l'hôte de la bataille qui le renvoie à la campagne
  {const _ar=applyResult;applyResult=function(b,res){if(MP.pvpG&&b&&mpBKey(b)===MP.pvpG){MP.pvpG=null;if(MP.role==='host'&&!S.cur)S.cur=b;return}return _ar.apply(this,arguments)}}
  // fin de la bataille chez l'invité alors que la campagne a déjà tourné la page : on referme quand même le champ de bataille
  window.addEventListener('message',ev=>{const d=ev.data;if(!d||d.bellum!=='retour')return;const f=$('battle3d');if(!f||ev.source!==f.contentWindow)return;
    const P=PVPC.cur;PVPC.cur=null;if(!P)return;PVPC.done.add(P.id);
    setTimeout(()=>{if(DIVE&&DIVE.fr===f){DIVE=null;f.style.transition='opacity .6s';f.style.opacity='0';f.style.pointerEvents='none';setTimeout(()=>f.remove(),650);refreshAfterBattle()}},0)});
  window.__pvp={get cur(){return PVPC.cur},set cur(v){PVPC.cur=v},done:PVPC.done,pvpIn,pvpGo,pvpAsk,pvpSendTo,toFrame};
  // ---- brume du matin, tirée au sort pour chaque bataille ----
  {const _dv2=dive;dive=function(payload){try{const b=payload.b;if(b&&b.brume==null&&S){const s=season(),t=payload.t||{};
      let p={Printemps:.2,'Été':.06,Automne:.3,Hiver:.22}[s]||.15;if(t.water)p*=t.water.sea?1.4:1.9;p=Math.min(.6,p);
      const c=S.cur||{},h=Math.abs(Math.sin(Math.floor(S.day)*12.9898+(c.x||0)*78.233+(c.y||0)*37.719)*43758.5453)%1;b.brume=h<p}}catch(e){}
    return _dv2.apply(this,arguments)}}
}
/* ================= FIN BATAILLE À DEUX ET BRUME (campagne) ================= */
