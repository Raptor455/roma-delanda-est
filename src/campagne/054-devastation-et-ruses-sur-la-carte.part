/* ================= DÉVASTATION ET RUSES SUR LA CARTE ================= */
// champs brûlés autour des villages incendiés, réfugiés sur les routes, pays épuisé, villes pillées, feux trompeurs, bœufs aux torches
const _drawVillagesDyn9=drawVillagesDyn;
drawVillagesDyn=function(s,z,x0,y0,x1,y1){_drawVillagesDyn9.apply(this,arguments);try{devastDraw(s,z,x0,y0,x1,y1)}catch(e){}};
function devastDraw(s,z,x0,y0,x1,y1){const t=performance.now()/1000,inV=(x,y,m)=>x>x0-m&&x<x1+m&&y>y0-m&&y<y1+m;
  // pays épuisé : terre grillée autour des villes de la région
  if(S.exh)for(const n of N){if(n.col||!n.reg)continue;const e=S.exh[n.reg]||0;if(e<30||!inV(n.x,n.y,30))continue;const R=10+e*.15,gr=ctx.createRadialGradient(n.x,n.y,0,n.x,n.y,R);
    gr.addColorStop(0,`rgba(150,110,60,${Math.min(.3,(e-30)/200)})`);gr.addColorStop(1,'rgba(150,110,60,0)');ctx.fillStyle=gr;ctx.beginPath();ctx.arc(n.x,n.y,R,0,7);ctx.fill()}
  if(s>=1.2&&VIL.length)for(const v of villagesIn(x0-2,y0-2,x1+2,y1+2)){if(!vRuined(v))continue;const st=S.vil[v.id],age=S.day-(st.pd||0),R=v.k==='bourg'?1.4:v.k==='village'?1:.6;
    // champs noircis, et la ligne de feu qui court sur les blés les premiers jours
    if(0/*SANS-CHAMPS*/)for(let k=0;k<4;k++){const an=hash(v.id,k+11)*6.28,dd=R*(1.3+hash(k+5,v.id)*1.2),cx=v.x+Math.cos(an)*dd,cy=v.y+Math.sin(an)*dd,w=R*(.6+hash(v.id,k)*.6),h=R*(.35+hash(k,v.id+3)*.3);
      ctx.save();ctx.translate(cx,cy);ctx.rotate(an);ctx.fillStyle='rgba(35,28,22,.55)';ctx.fillRect(-w/2,-h/2,w,h);
      if(age<8){const fl=.5+.5*Math.sin(t*7+k*2),fx=-w/2+((age/8+t*.05+k*.25)%1)*w;ctx.fillStyle=`rgba(255,${120+Math.floor(80*fl)},40,.85)`;ctx.fillRect(fx-Math.max(.06,2*z),-h/2,Math.max(.12,3*z),h);
        ctx.fillStyle=`rgba(80,70,60,${.35*fl})`;ctx.beginPath();ctx.arc(fx,-h*.8,Math.max(.15,6*z),0,7);ctx.fill()}
      ctx.restore()}
    // réfugiés vers la ville voisine
    if(age<14&&s>=4){const n=N[v.t],f=Math.min(1,age/14),hx=v.x+(n.x-v.x)*f,hy=v.y+(n.y-v.y)*f,dx=n.x-v.x,dy=n.y-v.y,L=Math.hypot(dx,dy)||1,e=Math.max(3.5*z,.05);
      for(let k=0;k<7;k++){const back=k*e*2.6,px=hx-dx/L*back+Math.sin(t*3+k)*e*.3,py=hy-dy/L*back;ctx.fillStyle=k%3===0?'#6b4a2a':'#a89070';ctx.fillRect(px-e*.4,py-e,e*.8,e*1.3);ctx.fillStyle='#d9b48a';ctx.fillRect(px-e*.25,py-e*1.4,e*.5,e*.4);
        if(k===3){ctx.fillStyle='#5a4028';ctx.fillRect(px-e*1.2,py-e*.6,e*2,e*.9);ctx.fillStyle='#2b1c0e';ctx.beginPath();ctx.arc(px-e*.8,py+e*.3,e*.3,0,7);ctx.arc(px+e*.5,py+e*.3,e*.3,0,7);ctx.fill()}}}}
  // villes pillées : incendies et fumées pendant 45 jours
  if(S.sacked)for(const id in S.sacked){const n=N[NI[id]];if(!n||!inV(n.x,n.y,6))continue;const age=S.day-S.sacked[id];if(age>45)continue;const g=cityGeom(n),k0=Math.max(8*z,.15),nf=Math.max(2,Math.round((1-age/45)*(3+n.size*2)));
    for(let j=0;j<nf;j++){const an=hash(n.i,j)*6.28,rd=g.r*.6*hash(j,n.i),x=g.cx+Math.cos(an)*rd,y=g.cy+Math.sin(an)*rd;
      for(let q=0;q<5;q++){const ph=(t*.2+q/5+hash(j,3))%1;ctx.fillStyle=`rgba(50,45,42,${(.55*(1-ph)).toFixed(3)})`;ctx.beginPath();ctx.arc(x+ph*k0*3,y-ph*k0*8,k0*(1+ph*2.5),0,7);ctx.fill()}
      ctx.fillStyle=`rgba(255,${130+Math.floor(70*Math.abs(Math.sin(t*6+j)))},40,.9)`;ctx.beginPath();ctx.arc(x,y,k0*.6,0,7);ctx.fill()}
    if(s>6){ctx.save();ctx.setTransform(dpr,0,0,dpr,0,0);ctx.font='italic 12px Georgia,serif';ctx.textAlign='center';ctx.textBaseline='alphabetic';ctx.fillStyle='rgba(20,12,6,.7)';const X=view.ox+n.x*s,Y=view.oy+(g.cy-g.r)*s-8;ctx.fillRect(X-30,Y-11,60,15);ctx.fillStyle='#e8a070';ctx.fillText('pillée',X,Y);ctx.restore()}}
  // feux trompeurs : un camp vide où brûlent encore les feux (vus de vous seulement)
  for(const a of S.armies){if(!a.feux||a.side!=='car'||!inV(a.feux.x,a.feux.y,4))continue;const k0=Math.max(3*z,.06);
    for(let j=0;j<9;j++){const x=a.feux.x+(hash(a.id,j)-.5)*1.6,y=a.feux.y+(hash(j,a.id)-.5)*1.2,fl=.6+.4*Math.sin(t*8+j*1.3);const gr=ctx.createRadialGradient(x,y,0,x,y,k0*3);gr.addColorStop(0,`rgba(255,180,70,${.7*fl})`);gr.addColorStop(1,'rgba(255,120,40,0)');ctx.fillStyle=gr;ctx.beginPath();ctx.arc(x,y,k0*3,0,7);ctx.fill()}
    if(s>4){ctx.save();ctx.setTransform(dpr,0,0,dpr,0,0);ctx.font='italic 11px Georgia,serif';ctx.textAlign='center';ctx.textBaseline='alphabetic';ctx.fillStyle='#f3d08a';ctx.fillText('feux trompeurs',view.ox+a.feux.x*s,view.oy+(a.feux.y+1)*s+12);ctx.restore()}}
  // bœufs aux torches : une file de lumières qui gravit les collines
  for(const l of S.lures||[]){const f=Math.min(1,(S.day-l.t0)/1.2);if(!inV(l.x0,l.y0,30))continue;const k0=Math.max(2.5*z,.05);
    for(let j=0;j<40;j++){const u=f*(j/40),x=l.x0+(l.x1-l.x0)*u+Math.sin(u*14+j)*.8,y=l.y0+(l.y1-l.y0)*u+Math.cos(u*11+j*.7)*.8,fl=.6+.4*Math.sin(t*10+j);
      ctx.fillStyle=`rgba(255,${150+Math.floor(80*fl)},50,${.9*fl})`;ctx.beginPath();ctx.arc(x,y,k0,0,7);ctx.fill()}}}

