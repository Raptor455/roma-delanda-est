/* ---- Camp pillé en bataille (res.pille={p,e} envoyé par bataille.html, fil Batailles 2D) :
   l'armée dont le camp est pillé perd ses vivres (il en reste 15 %), tout son matériel et ses bagages ;
   le pilleur récupère 60 % des vivres et la moitié du matériel. L'écouteur de base ne transmet pas res.pille
   à applyResult : on le capte ici, avec la bataille en cours comme clé. ---- */
let HPIL=null;
window.addEventListener('message',ev=>{try{const d=ev.data,fr=$('battle3d');if(d&&d.bellum==='retour'&&d.res&&d.res.pille&&S&&S.cur&&fr&&ev.source===fr.contentWindow)HPIL={p:!!d.res.pille.p,e:!!d.res.pille.e,k:S.cur.att[0]}}catch(e){}},true);
function campPille(lose,win,snap){
  let f=0,m=0;const noms=[];
  for(const a of lose){const s=snap[a.id]||{f:0,m:0},mx=armyFoodMax(a);
    const reste=Math.min(a.dead?0:aFood(a),s.f,mx*.15);f+=Math.max(0,s.f-reste);m+=s.m;
    if(!a.dead){a.food=reste;a.mat=0;a.bag=false;noms.push(a.name)}}
  const w=win.find(x=>!x.dead&&x.units.length);let gf=0,gm=0;
  if(w){const mx=armyFoodMax(w);aFood(w);gf=Math.max(0,Math.min(mx-w.food,f*.6));w.food+=gf;
    const cap=typeof matCap==='function'?matCap(w):0;gm=Math.max(0,Math.min(cap-(w.mat||0),Math.floor(m*.5)));if(gm)w.mat=(w.mat||0)+gm}
  const hum=s=>s==='car'||(typeof MPRH==='function'&&MPRH(s));
  if(lose.length&&hum(lose[0].side))log(`Le camp de ${noms[0]||lose[0].name} est pillé : les vivres, le matériel et les bagages sont perdus.`);
  if(w&&hum(w.side))log(`${w.name} pille le camp ennemi${gf>=1||gm?' : '+[gf>=1?Math.round(gf)+' rations':'',gm?gm+' de matériel':''].filter(Boolean).join(' et ')+' récupérés':''}. L\'ennemi a perdu ses vivres et son matériel.`);
}
{const _arP=applyResult;applyResult=function(b,res){
  let pl=res&&res.pille;if(!pl&&HPIL&&b&&b.att&&HPIL.k===b.att[0])pl=HPIL;HPIL=null;
  if(!pl||(!pl.p&&!pl.e))return _arP.apply(this,arguments);
  const get=L=>(L||[]).map(id=>S.armies.find(x=>x.id===id)).filter(Boolean),attA=get(b.att),defA=get(b.def),snap={};
  for(const a of [...attA,...defA])snap[a.id]={f:aFood(a),m:Math.floor(a.mat||0)};
  const r=_arP.apply(this,arguments);
  try{const am=b.attMine!=null?b.attMine:!!(attA[0]&&attA[0].side==='car'),mine=am?attA:defA,other=am?defA:attA;
    if(pl.p)campPille(mine,other,snap);if(pl.e)campPille(other,mine,snap)}catch(e){console.warn('campPille',e)}
  return r}}
window.__hubs={applyResult:(b,r)=>applyResult(b,r),caraDaily,caraSend,moveCara,resAdd,resEff,vilFrac,hinterLoss,peageOf,relaisOf,resOf,resIncome,resMonthly,resCost,resHas,resPay,resLinked,resBuy,resInit,resWhy,regOf:n=>regOf(n),addRecruit:(i,s,t)=>addRecruit(i,s,t),get N(){return N},get S(){return S},get sel(){return sel},set sel(v){sel=v},renderAll:()=>renderAll(),centerOn:(x,y,s)=>centerOn(x,y,s),capture:(i,s)=>capture(i,s),hubNet,hubLvl,hubDebit,hubProd,hubCap,hubInit,hubSupply,hubConvoy,hubToggle,hubNearest,hubHinter,lineOf:a=>lineOf(a),get HUBV(){return HUBV},HUB_R,HUB_D,HUB_N};
