  // camp fortifié que l'armée vient d'établir : les régiments entrent en file par la porte, les tentes se montent à mesure (a._fold)
  if(key==='c'&&a._bt===now&&a.camp&&!a.camp.ok&&!a._lev){try{const L=campLayout(a),g=[a.camp.x,a.camp.y+L.H/2];const Q=a.units.filter(u=>u._f0&&Math.hypot(u._f0[0]-g[0],u._f0[1]-g[1])<10);
      if(Q.length){for(const u of a.units)u._ci=null;Q.sort((p,r)=>Math.hypot(p._f0[0]-g[0],p._f0[1]-g[1])-Math.hypot(r._f0[0]-g[0],r._f0[1]-g[1])).forEach((u,i)=>u._ci=i);a._cg=g;a._ce=now;a._cn=Q.length;a._cp=0;a._cl=now}}catch(e){}}
  // l'entrée suit la construction (temps de jeu) : le dernier régiment gagne son quartier quand la palissade se ferme ;
  // si le camp est achevé d'un coup (pionniers), l'entrée se termine en 1,5 s
  if(a._ce){if(key!=='c'||!a.camp)a._ce=0;else{if(a.camp.ok)a._cp=Math.min(1,a._cp+(now-a._cl)/1500);else a._cp=Math.max(a._cp,Math.min(1,1-(a.camp.t-S.day)));a._cl=now;
      if(a._cp>=1){a._ce=0;a._fold=0}else a._fold=Math.max(0,Math.min(1,1.05-a._cp*1.15))}}
  if(key==='d'&&a._bt===now&&a.decamp){a._dx=null;try{const cam=a.decamp.cam,L=campLayout(a),l0=a.legs[0],dx=l0.x-cam.x,dy=l0.y-cam.y,d=Math.abs(dx)>Math.abs(dy)?[dx>0?1:-1,0]:[0,dy>0?1:-1],g=[cam.x+d[0]*L.W/2,cam.y+d[1]*L.H/2];
      const Q=a.units.filter(u=>u._f0);for(const u of a.units)u._di=null;Q.sort((p,r)=>Math.hypot(p._f0[0]-g[0],p._f0[1]-g[1])-Math.hypot(r._f0[0]-g[0],r._f0[1]-g[1])).forEach((u,i)=>u._di=i);
      if(Q.length)a._dx={c:[cam.x,cam.y],d,g,n:Q.length,R:Math.ceil(Q.length/4)}}catch(e){}}
