  const y0=ty+q*3.1,pts=[],blk=[],jit=(k,m)=>{const v=Math.sin((a.id*7.13+k*12.9898+m*78.233))*43758.5453;return (v-Math.floor(v)-.5)*q*.5};
  for(let b=0;b<nb;b++){const r=Math.floor(b/bc),m=Math.min(bc,nb-r*bc),bx=cx+((b%bc)-(m-1)/2)*px+jit(b,1),by=y0+r*py+jit(b,2)*.7,k=Math.min(4,n-b*4);blk.push([bx,by,k]);
