  ctx.fillStyle='rgba(150,122,82,.30)';ctx.fill();ctx.strokeStyle='rgba(90,66,36,.28)';ctx.lineWidth=Math.max(1,q*.08);ctx.setLineDash([q*.5,q*.4]);ctx.stroke();ctx.setLineDash([]);
  if(sel&&sel.a===a){ctx.fillStyle='rgba(255,243,196,.35)';pts.forEach(([x,y])=>{ctx.beginPath();ctx.arc(x,y,q*.9,0,7);ctx.fill()})}
