  ctx.fillStyle=col;ctx.beginPath();ctx.moveTo(cx+cw*.62,by-cw*1.1);ctx.lineTo(cx+cw*1.12,by-cw*.95);ctx.lineTo(cx+cw*.62,by-cw*.78);ctx.closePath();ctx.fill();ctx.stroke();
