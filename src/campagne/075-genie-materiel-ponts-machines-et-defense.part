// point à la fraction tt (adoucie) d'un chemin brisé
function bivPath(P,tt){const D=[];let L=0;for(let k=1;k<P.length;k++){const d=Math.hypot(P[k][0]-P[k-1][0],P[k][1]-P[k-1][1]);D.push(d);L+=d}
  let d=L*(tt*tt*(3-2*tt)),k=0;while(k<D.length-1&&d>D[k]){d-=D[k];k++}const f=D[k]>1e-6?Math.min(1,d/D[k]):1;return [P[k][0]+(P[k+1][0]-P[k][0])*f,P[k][1]+(P[k+1][1]-P[k][1])*f]}
{const _us=unitSq;unitSq=function(x,y,q,u,c,dark){const a=BIV_A;if(!a||!u)return _us.apply(this,arguments);
  let wx=(x-view.ox)/BIV_S,wy=(y-view.oy)/BIV_S;const t=(BIV_NOW-(a._bt||0))/BIV_MS;
  if(a._ce&&a.camp&&u._f0&&u._ci!=null){
    // entrée au camp fortifié : en file par la porte sud, puis par la rue centrale jusqu'au quartier du régiment
    const tt=Math.max(0,Math.min(1,((a._cp||0)-u._ci*CAMP_RUN_GAP(a._cn))/CAMP_RUN));
    if(tt<1){const w=bivPath([u._f0,[a._cg[0],a._cg[1]+.35],[a._cg[0],a._cg[1]-.3],[a._cg[0],wy],[wx,wy]],tt);wx=w[0];wy=w[1];x=view.ox+wx*BIV_S;y=view.oy+wy*BIV_S}}
  else if(a._bk==='d'&&a.decamp&&a._dx&&u._f0&&u._di!=null){
    // levée du camp : les régiments sortent en file par la porte du départ et se rangent dehors par rangs de quatre
    const X=a._dx,d=a.decamp,p=Math.max(0,Math.min(1,(S.day-d.t0)/(d.end-d.t0))),tt=Math.max(0,Math.min(1,(p-u._di*(.97-DEC_RUN)/Math.max(1,X.n-1))/DEC_RUN));
    const r=Math.floor(u._di/4),m=Math.min(4,X.n-r*4),f=(u._di%4)-(m-1)/2,dist=UNIT_KM*(2+(X.R-1-r)*1.35),sl=[X.g[0]+X.d[0]*dist-X.d[1]*f*UNIT_KM*1.35,X.g[1]+X.d[1]*dist+X.d[0]*f*UNIT_KM*1.35];
    const st=X.d[0]?[u._f0[0],X.c[1]]:[X.c[0],u._f0[1]];
    const w=bivPath([u._f0,st,X.g,[X.g[0]+X.d[0]*UNIT_KM*1.2,X.g[1]+X.d[1]*UNIT_KM*1.2],sl],tt);wx=w[0];wy=w[1];x=view.ox+wx*BIV_S;y=view.oy+wy*BIV_S}
  else if(t<1&&u._f0){const dx=wx-u._f0[0],dy=wy-u._f0[1];if(dx*dx+dy*dy<64){const e=t<=0?0:t*t*(3-2*t);wx=u._f0[0]+dx*e;wy=u._f0[1]+dy*e;x=view.ox+wx*BIV_S;y=view.oy+wy*BIV_S}}
  u._fw=[wx,wy];u._ff=BIV_NOW;return _us.call(this,x,y,q,u,c,dark)}}
function bivKey(a){const sg=a.at!=null&&!a.legs.length&&N[a.at]&&!N[a.at].col&&S.siege&&S.siege[N[a.at].id];
  return a.decamp?'d':a.legs.length?(a.camp?'c':'m'):sg&&sg.a===a.id&&!a.inG?'s':a.camp?'c':'b'+(a.at==null?'':a.at)}
