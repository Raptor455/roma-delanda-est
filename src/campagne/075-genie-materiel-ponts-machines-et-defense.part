// garnison ou armée de capitaine en marche, vue rapprochée : écu sur hampe comme une armée
{const _tk2=token;token=function(x,y,side,txt,selected,a){if(a&&a.g&&a.legs&&a.legs.length&&!a.dead&&/^\d+$/.test(txt||'')&&a._sq)return _tk2.call(this,x,y-18,side,txt,selected,{side:a.side,at:a.at,id:a.id,g:false});
  return _tk2.apply(this,arguments)}}
/* ---- FOURRAGEURS BIEN VISIBLES (11 nov., Baptiste : « on ne voit toujours pas les petits carrés partir du camp/siège quand on pille ») ----
   Les détachements S.par 'raid' étaient dessinés en carrés de 8 px, noyés dans le camp ou les lignes de siège. On les redessine par-dessus :
   carré de la taille d'un régiment (12 px au moins), liseré doré, fanion, poussière, et un pointillé qui les relie à leur armée et à leur village. */
{const _dfF=drawFleets;drawFleets=function(s,z,inV){const r=_dfF.apply(this,arguments);
  try{if(S&&S.par&&S.par.length){const dark='rgba(26,18,10,.95)';
    for(const p of S.par){if(p.k!=='raid')continue;const a=parArmy(p);if(!a)continue;if(!(p.side==='car'||isMine(a)||visAt(p.x,p.y)===2))continue;if(!inV(p.x,p.y,40))continue;
      const c=FAC[p.side].c,col=`rgb(${c[0]},${c[1]},${c[2]})`,X=view.ox+p.x*s,Y=view.oy+p.y*s,q=Math.max(12,UNIT_KM*s*.85),AX=view.ox+a.x*s,AY=view.oy+a.y*s;
      ctx.save();
      // fil d'Ariane : de l'armée au détachement, puis jusqu'au village visé
      ctx.setLineDash([4,4]);ctx.lineWidth=1.4;ctx.strokeStyle='rgba(40,26,12,.55)';ctx.beginPath();ctx.moveTo(AX,AY);ctx.lineTo(X,Y);ctx.stroke();
      const L=p.legs&&p.legs[0];if(L&&p.state==='out'){ctx.strokeStyle='rgba(190,60,30,.7)';ctx.beginPath();ctx.moveTo(X,Y);ctx.lineTo(view.ox+L.x*s,view.oy+L.y*s);ctx.stroke()}
      ctx.setLineDash([]);
      if(L){const hx=L.x-p.x,hy=L.y-p.y,hl=Math.hypot(hx,hy)||1;for(let k=1;k<=3;k++){ctx.fillStyle=`rgba(170,150,110,${.4-k*.1})`;ctx.beginPath();ctx.arc(X-hx/hl*q*.8*k,Y-hy/hl*q*.8*k,q*.3*(1+k*.3),0,7);ctx.fill()}}
      const cav=a.units.find(u=>{const k=UT[u.t].k;return k==='cav'||k==='lcav'}),u0=(p.id%3===1?null:cav)||a.units.find(u=>UT[u.t].k==='inf')||cav||a.units[0];
      ctx.fillStyle='rgba(243,217,138,.9)';ctx.fillRect(X-q/2-2.5,Y-q/2-2.5,q+5,q+5);
      if(u0)unitSq(X,Y,q,{t:u0.t,men:UT[u0.t].men},c,dark);
      // fanion ; sac de butin au retour
      ctx.strokeStyle=dark;ctx.lineWidth=1.2;ctx.beginPath();ctx.moveTo(X+q/2,Y-q/2);ctx.lineTo(X+q/2,Y-q/2-9);ctx.stroke();
      ctx.fillStyle=p.state==='back'?'#e9c46a':col;ctx.beginPath();ctx.moveTo(X+q/2,Y-q/2-9);ctx.lineTo(X+q/2+7,Y-q/2-6.5);ctx.lineTo(X+q/2,Y-q/2-4);ctx.closePath();ctx.fill();ctx.stroke();
      ctx.restore()}}}catch(e){console.error('[fourrageurs]',e)}
  return r}}
/* ---- CONTACT PAR LA COLONNE (11 nov., Baptiste : « oui il faut améliorer ça ») ----
   Avant : bataille dès que deux têtes d'armées ennemies étaient à moins de 6 km, colonne ignorée.
   Maintenant (retouche ENC-COL de tick par genie/patch.py) :
   - chaque armée en marche laisse dans la simulation la trace de sa colonne (ENC_T, hors sauvegarde), longue de 0,37 km par régiment ;
   - une tête qui arrive à moins de encR(a)+0,6 km de la colonne d'un ennemi l'accroche : c'est elle qui attaque ;
   - deux têtes s'accrochent à moins de encR(a)+encR(b) : 1,5 km par armée en marche, jusqu'à 2,5 km pour une grande armée au bivouac.
   Les autres règles (murs, délai de grâce, se dérober, flottes, neutres) ne changent pas. */
const ENC_T=new Map(),ENC_SP=.15;
function encLen(a){return .33+(a.units?a.units.length:1)*UNIT_KM*1.22}
function encR(a){return a.legs&&a.legs.length?1.5:Math.min(2.5,1.5+(a.units?a.units.length:1)*.03)}
function encTrail(){if(!S||!S.armies)return;const live=new Set();
  for(const a of S.armies){if(a.dead||a.ship||!a.legs||!a.legs.length){ENC_T.delete(a.id);continue}live.add(a.id);
    let T=ENC_T.get(a.id);if(!T){T=[[a.x,a.y]];ENC_T.set(a.id,T)}const l=T[T.length-1];
    if(Math.hypot(l[0]-a.x,l[1]-a.y)>ENC_SP){T.push([a.x,a.y]);let len=0;for(let k=T.length-1;k>0;k--){len+=Math.hypot(T[k][0]-T[k-1][0],T[k][1]-T[k-1][1]);if(len>encLen(a)){T.splice(0,k-1);break}}}}
  for(const id of ENC_T.keys())if(!live.has(id))ENC_T.delete(id)}
// distance d'un point à la colonne de b (de sa tête vers l'arrière)
function encCol(px,py,b){const T=ENC_T.get(b.id);if(!T||T.length<1)return 1e9;let best=1e9,ax=b.x,ay=b.y;
  for(let k=T.length-1;k>=0;k--){const bx=T[k][0],by=T[k][1],dx=bx-ax,dy=by-ay,l2=dx*dx+dy*dy;let t=l2?((px-ax)*dx+(py-ay)*dy)/l2:0;t=Math.max(0,Math.min(1,t));
    best=Math.min(best,Math.hypot(px-(ax+dx*t),py-(ay+dy*t)));ax=bx;ay=by}return best}
let ENC_ATT=null;
function encNear(a,b){ENC_ATT=null;const d=Math.hypot(a.x-b.x,a.y-b.y);if(d>=40)return false;
  if(d<encR(a)+encR(b)){ENC_ATT=(a.legs.length>0)>=(b.legs.length>0)?a:b;return true}
  if(encCol(a.x,a.y,b)<encR(a)+.6){ENC_ATT=a;return true}
  if(encCol(b.x,b.y,a)<encR(b)+.6){ENC_ATT=b;return true}
  return false}
function encAtt(a,b){return ENC_ATT===a||ENC_ATT===b?ENC_ATT:((a.legs.length>0)>=(b.legs.length>0)?a:b)}
{const _tkE=tick;tick=function(dd){try{encTrail()}catch(e){}const r=_tkE.apply(this,arguments);try{encTrail()}catch(e){}return r}}
window.__genie={encNear,encCol,encR,encLen,ENC_T,bivFormation,bivKey,campDraw,campStill,capSync,towerIcon,grHire,grNewArmy,grTravel,grCand,cfwdSend,cfwdRecall,pilSend,cardPiece,uiPieces,pcSVG,peuInit,peuDaily,peuP,peuRegs,menMs,matCap,woodRate,buyMat,startBridge,stopBridge,bridgeSite,rivNear,burnGb,foldGb,buildDef,cityMat,ENG_M,GBRK,DEF,genSV,gbNear};
