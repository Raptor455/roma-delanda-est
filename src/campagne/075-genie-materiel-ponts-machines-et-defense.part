const BIV_ORD={inf:0,eleph:1,skirm:2,lcav:3,cav:4};
function bivFormation(a,s){
  const c=FAC[a.side].c,dark='rgba(26,18,10,.95)',col=`rgb(${c[0]},${c[1]},${c[2]})`,q=UNIT_KM*s,n=a.units.length,T=(S.day||0)*DAY_S;
