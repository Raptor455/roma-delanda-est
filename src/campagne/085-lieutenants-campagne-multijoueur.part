/* ================= LIEUTENANTS (campagne ; multijoueur) =================
   Baptiste (10 nov.) : « rentrer dans la bataille d'un ami même si je n'ai pas d'armée à côté, je pourrais alors contrôler
   certaines unités qu'il me donnerait ». Pendant une bataille livrée sur le terrain, un allié de celui qui la livre (même camp)
   peut la rejoindre sans armée : bouton dans le bandeau de rejoindre-campagne.js. L'hôte de la partie note b.jn['w'+id]={p,arr:0,w:1},
   ce qui ouvre le champ de bataille chez ce joueur (rôle 'j', même chemin qu'une armée engagée). Sur le terrain, celui qui livre
   la bataille lui confie des régiments (lieutenant-bataille.js). Source : /mnt/project-files/multijoueur/lieutenant-campagne.js. */
{
  const sideOf=id=>S&&S.mpP&&S.mpP[id]&&S.mpP[id].side;
  const L=()=>window.__lb;
  function canWatch(b,pid){const l=L();if(!MP.role||!l||!b||!b.mp||!l.live(b))return false;const mp=b.mp;
    if(!mp.bh||pid===mp.bh||pid===mp.bg)return false;if(b.jn&&Object.values(b.jn).some(j=>j&&j.p===pid))return false;
    const s=sideOf(pid);return !!s&&s===sideOf(mp.bh)}
  function doWatch(pid){const b=S.cur;if(MP.role!=='host'||!canWatch(b,pid))return;b.jn=b.jn||{};b.jn['w'+pid]={p:pid,arr:0,w:1};
    log(`${esc(mpName(pid))} rejoint la ${battleTitle(b).replace(/^B/,'b')} aux côtés de ${esc(mpName(b.mp.bh))}, qui peut lui confier des régiments.`);save();mpKfSoon(0)}
  {const _h=mpOnHost;mpOnHost=function(d){if(d&&d.t==='bwatch'){try{if(MP.gs[d.f])doWatch(d.f)}catch(e){console.warn(e)}return}return _h.apply(this,arguments)}}
  function ask(){if(MP.role==='host')doWatch(MP.me);else mpSend({t:'bwatch',k:S.cur?mpBKey(S.cur):''});const bt=$('ltGo');if(bt){bt.disabled=true;bt.textContent='Demande envoyée…'}}
  setInterval(()=>{try{const bar=$('lbBar'),b=S&&S.cur;if(!bar)return;let e=bar.querySelector('[data-lt]');
      if(!canWatch(b,MP.me)){if(e)e.remove();return}
      if(!e){e=document.createElement('div');e.dataset.lt='1';e.style.cssText='margin-top:6px;pointer-events:auto';
        e.innerHTML=`<button type="button" id="ltGo">Rejoindre la bataille sans armée</button> <span class="sub">${esc(mpName(b.mp.bh))} pourra vous confier des régiments à commander.</span>`;
        bar.appendChild(e);e.querySelector('#ltGo').onclick=ev=>{ev.stopPropagation();ask()}}}catch(err){console.warn(err)}},500);
  window.__lt={canWatch,doWatch};
}
/* ================= FIN LIEUTENANTS (campagne) ================= */
