/* ================= RELIEF RÉEL : altitudes mesurées (cases de 1,5 km) + détail fractal ================= */
// Altitudes tirées d'un modèle numérique de terrain, codées en racine carrée sur 8 bits (0 à 4 810 m).
// Quatre niveaux (1,5 / 3 / 6 / 12 km) pour ne pas crénelage en vue éloignée.
// De près, un bruit en crêtes ajoute arêtes et ravines sous la résolution des données, plus fort là où le relief est déjà marqué.
const DEM_SRC='data:image/webp;base64,';
let DEM=null;
async function loadDEM(){
  const im=new Image();im.src=DEM_SRC;await im.decode();
  const c=document.createElement('canvas');c.width=im.width;c.height=im.height;const g=c.getContext('2d',{willReadFrequently:true});g.drawImage(im,0,0);
  const w=c.width,h=c.height,d=g.getImageData(0,0,w,h).data,a=new Float32Array(w*h);
  for(let i=0;i<w*h;i++){const v=d[i*4]/255;a[i]=v*v*4810}
  const lv=[{a,w,h,r:MW/w}];
  while(lv.length<4){const p=lv[lv.length-1],W=p.w>>1,H=p.h>>1,b=new Float32Array(W*H);
    for(let y=0;y<H;y++)for(let x=0;x<W;x++){const o=2*y*p.w+2*x;b[y*W+x]=(p.a[o]+p.a[o+1]+p.a[o+p.w]+p.a[o+p.w+1])/4}
    lv.push({a:b,w:W,h:H,r:p.r*2})}
  // dénivelé local (max - min sur ± 3 cases, soit ± 4,5 km) : distingue la montagne du haut plateau
  const rug=new Float32Array(w*h),mx=new Float32Array(w*h),mn=new Float32Array(w*h),K=3;
  for(let y=0;y<h;y++)for(let x=0;x<w;x++){let M=-1,m=1e9;for(let k=-K;k<=K;k++){const xx=Math.min(w-1,Math.max(0,x+k)),v=a[y*w+xx];if(v>M)M=v;if(v<m)m=v}mx[y*w+x]=M;mn[y*w+x]=m}
  for(let y=0;y<h;y++)for(let x=0;x<w;x++){let M=-1,m=1e9;for(let k=-K;k<=K;k++){const yy=Math.min(h-1,Math.max(0,y+k)),o=yy*w+x;if(mx[o]>M)M=mx[o];if(mn[o]<m)m=mn[o]}rug[y*w+x]=M-m}
  DEM={lv,rug,w,h,r:lv[0].r};
}
function demS(L,arr,x,y){const u=Math.max(0,Math.min(L.w-1.001,x/L.r-.5)),v=Math.max(0,Math.min(L.h-1.001,y/L.r-.5)),i=u|0,j=v|0,fx=u-i,fy=v-j,o=j*L.w+i;
  return (arr[o]*(1-fx)+arr[o+1]*fx)*(1-fy)+(arr[o+L.w]*(1-fx)+arr[o+L.w+1]*fx)*fy}
// même chose en bicubique (Catmull-Rom) : pentes continues, sans facettes de la grille en vue rapprochée
function demC(L,arr,x,y){const u=Math.max(1,Math.min(L.w-2.001,x/L.r-.5)),v=Math.max(1,Math.min(L.h-2.001,y/L.r-.5)),i=u|0,j=v|0,fx=u-i,fy=v-j;
  const cr=(p0,p1,p2,p3,t)=>p1+.5*t*(p2-p0+t*(2*p0-5*p1+4*p2-p3+t*(3*(p1-p2)+p3-p0)));
  const row=k=>{const o=(j+k)*L.w+i;return cr(arr[o-1],arr[o],arr[o+1],arr[o+2],fx)};
  return cr(row(-1),row(0),row(1),row(2),fy)}
// altitude lissée (m) ; k = niveau (0 = 1,5 km)
const demH=(x,y,k=0)=>demS(DEM.lv[k],DEM.lv[k].a,x,y);
const demRug=(x,y)=>demS(DEM.lv[0],DEM.rug,x,y);
// montagne au sens du jeu : haut et accidenté (un haut plateau plat n'en est pas une)
function isMountain(x,y){const h=demH(x,y),r=demRug(x,y);return h>1700||r>620||(h>750&&r>330)}
// altitude détaillée : données + crêtes fractales jusqu'à la longueur d'onde minL (km)
const ROT=[...Array(16)].map((_,o)=>[Math.cos(o*1.13+.4),Math.sin(o*1.13+.4)]);
function relH(x,y,minL,k){if(minL>=3)return demH(x,y,k||0);
  // léger gauchissement pour casser la grille des données, puis interpolation bicubique
  const wx=x+(vnoise(x*.45,y*.45)-.5)*1.1,wy=y+(vnoise(x*.45+31,y*.45-7)-.5)*1.1,L0=DEM.lv[0];
  let h=demC(L0,L0.a,wx,wy);const r=demRug(x,y),am=Math.min(1,r/1000),base=2+Math.min(1,h/700)*5;
  let lam=3,o=1;while(lam>=minL){const [c,sn]=ROT[o&15],u=(x*c-y*sn)/lam,v=(x*sn+y*c)/lam,n=vnoise(u+o*17.3,v-o*9.1),rd=1-Math.abs(2*n-1);
    h+=am*(rd*rd-.4)*lam*62+(n-.5)*lam*base;lam*=.5;o++}
  return h}
const ss=(a,b,v)=>{const t=Math.max(0,Math.min(1,(v-a)/(b-a)));return t*t*(3-2*t)};
let RLC=null,LANDD=null;
// peint le sol en relief sur la tuile courante : couleur des terres, étages (prairie, roche, neige), ombrage depuis le nord-ouest
function paintRelief(w,h){
  if(!DEM)return;const s=view.s,q=w*dpr>1100?Math.ceil(w*dpr/520):Math.max(1.5,dpr*1.2),W=Math.ceil(w*dpr/q)+1,H=Math.ceil(h*dpr/q)+1,pk=q/(dpr*s);
  const wx0=-view.ox/s,wy0=-view.oy/s,lvl=pk>9?3:pk>4.5?2:pk>2.2?1:0,minL=Math.max(pk*2.2,.006);
  // rien à faire en pleine mer
  {let land=false;for(let j=0;j<=4&&!land;j++)for(let i=0;i<=4;i++)if(landFast(wx0+W*pk*i/4,wy0+H*pk*j/4)){land=true;break}if(!land&&!landFast(wx0+W*pk/2,wy0+H*pk/2)){let any=false;for(let j=0;j<12&&!any;j++)for(let i=0;i<12;i++)if(landFast(wx0+W*pk*(i+.5)/12,wy0+H*pk*(j+.5)/12)){any=true;break}if(!any)return}}
  if(!LANDD){const c=relief.land;LANDD={d:c.getContext('2d').getImageData(0,0,c.width,c.height).data,w:c.width,h:c.height,R:c.width/MW}}
  const G=new Float32Array((W+2)*(H+2));
  for(let j=0;j<H+2;j++){const y=wy0+(j-.5)*pk;for(let i=0;i<W+2;i++)G[j*(W+2)+i]=relH(wx0+(i-.5)*pk,y,minL,lvl)}
  if(!RLC||RLC.width<W||RLC.height<H){RLC=document.createElement('canvas');RLC.width=Math.max(W,RLC?RLC.width:0);RLC.height=Math.max(H,RLC?RLC.height:0)}
  const g=RLC.getContext('2d'),img=g.createImageData(W,H),D=img.data,LD=LANDD;
  // exagération verticale : forte de loin (sinon les Alpes sont plates à l'écran), modérée de près
  const SNV=S?SNOW[season()]+(season()==='Été'?0:200):2800,ve=Math.max(1.8,Math.min(10,3.2*Math.pow(pk,.36))),inv=1/(2*pk*1000),lx=-.6,ly=-.6,lz=.53,flat=lz;const WIN=S&&season()==='Hiver';
  for(let j=0;j<H;j++){const y=wy0+(j+.5)*pk;for(let i=0;i<W;i++){const x=wx0+(i+.5)*pk,o=(j+1)*(W+2)+i+1,hc=G[o];
    const dx=(G[o+1]-G[o-1])*inv,dy=(G[o+W+2]-G[o-W-2])*inv,sl=Math.hypot(dx,dy);
    const nx=-dx*ve,ny=-dy*ve,nl=1/Math.hypot(nx,ny,1),sh=(nx*lx+ny*ly+lz)*nl/flat;
    // couleur de base (peinte à 4 km/pixel, avec forêts et déserts)
    let u=Math.max(0,Math.min(LD.w-1.001,x*LD.R-.5)),v=Math.max(0,Math.min(LD.h-1.001,y*LD.R-.5)),ii=u|0,jj=v|0,fx=u-ii,fy=v-jj,b=(jj*LD.w+ii)*4,b2=b+LD.w*4;
    const L=c=>(LD.d[b+c]*(1-fx)+LD.d[b+4+c]*fx)*(1-fy)+(LD.d[b2+c]*(1-fx)+LD.d[b2+4+c]*fx)*fy;
    let r=L(0),gg=L(1),bb=L(2);
    // étages : piémont plus sec, roche nue au-dessus des arbres et sur les pentes raides, neige en haut
    const t1=ss(500,1600,hc)*.35,t2=Math.max(ss(1700,2500,hc),ss(.55,1.1,sl)*ss(300,900,hc))*.75,nz=vnoise(x*1.3,y*1.3)*500-250,t3=ss(SNV-300,SNV+300,hc+nz*.6-sl*600)*.9;
    if(t1){r+=(150-r)*t1;gg+=(140-gg)*t1;bb+=(98-bb)*t1}
    if(t2){r+=(150-r)*t2;gg+=(142-gg)*t2;bb+=(130-bb)*t2}
    if(WIN){const fr=ss(800,1400,hc+nz*.4)*.3;if(fr){r+=(236-r)*fr;gg+=(238-gg)*fr;bb+=(240-bb)*fr}}
    if(t3){r+=(246-r)*t3;gg+=(246-gg)*t3;bb+=(244-bb)*t3}
    // lumière : ombre bleutée côté sud-est, éclat chaud côté nord-ouest
    let k=sh-1;if(k<0){k=Math.max(-.75,k)*(1-.45*t3);r*=1+k*.8;gg*=1+k*.76;bb*=1+k*.55}else{k=Math.min(.6,k*.8);r+=(255-r)*k*.5;gg+=(248-gg)*k*.46;bb+=(225-bb)*k*.36}
    const p=(j*W+i)*4;D[p]=r;D[p+1]=gg;D[p+2]=bb;D[p+3]=255}}
  g.putImageData(img,0,0);
  ctx.save();ctx.clip(landSmooth);ctx.imageSmoothingEnabled=true;ctx.drawImage(RLC,0,0,W,H,wx0,wy0,W*pk,H*pk);ctx.restore()}
// collines du champ de bataille 3D, tirées du même relief : sommets locaux et leur hauteur au-dessus des environs
function battleHills(a0,b0,a1,b1,B,inB){const st=.25,nx=Math.ceil((a1-a0)/st)+1,ny=Math.ceil((b1-b0)/st)+1,Hh=new Float32Array(nx*ny);let mean=0;
  for(let j=0;j<ny;j++)for(let i=0;i<nx;i++){const v=relH(a0+i*st,b0+j*st,.05);Hh[j*nx+i]=v;mean+=v}mean/=nx*ny;const out=[];
  // pente d'ensemble (plan moyen) : le côté haut devient une large croupe, puis on cherche les sommets sur le reste
  let sx=0,sy=0,sxx=0,syy=0;const cxi=(nx-1)/2,cyi=(ny-1)/2;for(let j=0;j<ny;j++)for(let i=0;i<nx;i++){const v=Hh[j*nx+i]-mean,u=i-cxi,w=j-cyi;sx+=u*v;sy+=w*v;sxx+=u*u;syy+=w*w}
  const gx=sx/sxx,gy=sy/syy,gl=Math.hypot(gx,gy);for(let j=0;j<ny;j++)for(let i=0;i<nx;i++)Hh[j*nx+i]-=gx*(i-cxi)+gy*(j-cyi);
  if(gl*nx*.5>12){const ux=gx/gl,uy=gy/gl,rise=Math.min(160,gl*nx*.45);for(const off of [-1,0,1]){const x=(a0+a1)/2+ux*3.2-uy*off*2.2,y=(b0+b1)/2+uy*3.2+ux*off*2.2;if(!landFast(x,y))continue;const p=B(x,y);if(inB(p,1500))out.push({x:p[0],y:p[1],r:1500,h:Math.round(rise*(off?.75:1))})}}
  for(let j=2;j<ny-2;j++)for(let i=2;i<nx-2;i++){const v=Hh[j*nx+i];let top=true,lo=1e9;for(let dj=-2;dj<=2&&top;dj++)for(let di=-2;di<=2;di++){if(!di&&!dj)continue;const u=Hh[(j+dj)*nx+i+di];if(u>v){top=false;break}if(Math.abs(di)==2||Math.abs(dj)==2)lo=Math.min(lo,u)}
    if(!top)continue;const pr=v-Math.min(lo,mean);if(pr<10)continue;const x=a0+i*st,y=b0+j*st;if(!landFast(x,y))continue;const p=B(x,y);if(!inB(p,800))continue;
    out.push({x:p[0],y:p[1],r:Math.round(Math.min(1500,380+pr*7)),h:Math.round(Math.min(160,pr*.8))})}
  return out}

