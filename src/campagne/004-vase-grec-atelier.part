    <rect x="86" y="40" width="10" height="34" rx="2" transform="rotate(18 91 57)" fill="#7a4e2c" ${S}/><g stroke="${INK}" stroke-width=".8"><path d="M93 38 l2 -9 M96 39 l3 -8 M90 38 l0 -9" /></g><g fill="#d9cfb5"><path d="M95 29 l-2 -3 l4 0z"/><path d="M99 31 l-1 -3 l4 1z"/><path d="M90 29 l-2 -3 l4 0z"/></g>`;
  if(d.jet==='soliferrum'&&!mounted)back+=`<line x1="99" y1="18" x2="116" y2="126" stroke="${INK}" stroke-width="2.8"/><line x1="99" y1="18" x2="116" y2="126" stroke="${IRN}" stroke-width="1.6"/><path d="M99 18 l-2.4 -12 l4.2 9 l-3 -1z" fill="${IRN}" ${S} stroke-width=".8"/><path d="M106 60 l2 8" stroke="#6a4426" stroke-width="3"/>`;
  if(d.jet==='javelots'&&!mounted)back+=`<g><line x1="97" y1="22" x2="114" y2="124" stroke="${WOODs}" stroke-width="3.2"/><line x1="97" y1="22" x2="114" y2="124" stroke="${WOOD}" stroke-width="1.8"/><line x1="102" y1="20" x2="117" y2="120" stroke="${WOODs}" stroke-width="3.2"/><line x1="102" y1="20" x2="117" y2="120" stroke="${WOOD}" stroke-width="1.8"/>
    <path d="M97 22 l-1.6 -10 l3.4 8z" fill="${IRN}" ${S}/><path d="M102 20 l-1.4 -10 l3.4 8z" fill="${IRN}" ${S}/></g>`;
