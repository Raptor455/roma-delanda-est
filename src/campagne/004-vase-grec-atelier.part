    <line x1="104" y1="60" x2="118" y2="126" stroke="${WOODs}" stroke-width="3.6"/><line x1="104" y1="60" x2="118" y2="126" stroke="${WOOD}" stroke-width="2.2"/><line x1="104" y1="60" x2="97" y2="14" stroke="${INK}" stroke-width="2.4"/><line x1="104" y1="60" x2="97" y2="14" stroke="${IRN}" stroke-width="1.2"/><path d="M97 14 l-1.4 -7 l3 6z" fill="${IRN}" ${S} stroke-width=".7"/>`;
