  if(d.crest==='crete')cr=`<path d="M74 24 Q70 4 80 -4 Q90 4 86 24Z" fill="${RED}" ${S}/><path d="M80 -4 Q90 4 86 24 L82 24 Q85 8 80 -4Z" fill="${REDs}"/><path d="M76 20 q-2 -12 3 -20 M80 22 v-22 M84 20 q2 -12 -2 -20" stroke="#c4392f" stroke-width=".9" fill="none"/><path d="M75 24 h10 v-4 h-10z" fill="${BRZ}" ${S}/>`;
  if(d.crest==='noire')cr=`<path d="M74 24 Q70 4 80 -4 Q90 4 86 24Z" fill="#231a14" ${S}/><path d="M76 20 q-2 -12 3 -20 M80 22 v-22 M84 20 q2 -12 -2 -20" stroke="#4a3a2e" stroke-width=".9" fill="none"/><path d="M75 24 h10 v-4 h-10z" fill="${BRZ}" ${S}/><path d="M86 6 q12 4 14 20 q-6 -8 -12 -10z" fill="${RED}" ${S}/>`;
  if(d.crest==='aigrette')cr=`<path d="M79 22 q-6 -18 3 -34 q5 18 -3 34z" fill="#f4efe1" ${S} stroke-width=".9"/><path d="M79 20 q-1 -16 3 -30" stroke="#a89c80" stroke-width=".7" fill="none"/><path d="M77.5 24 h5 v-5 h-5z" fill="${BRZ}" ${S}/>`;
  if(d.crest==='plumes')cr=['M80 22 q-5 -16 -1 -26 q5 10 1 26z','M74 25 q-10 -12 -10 -22 q8 6 10 22z','M86 25 q10 -12 10 -22 q-8 6 -10 22z'].map((p,i)=>`<path d="${p}" fill="${i?'#e9e2cf':'#f4efe1'}" ${S} stroke-width=".9"/>`).join('')+`<path d="M80 21 q-1 -12 -1 -22 M74 24 q-5 -8 -8 -18 M86 24 q5 -8 8 -18" stroke="#a89c80" stroke-width=".7" fill="none"/>`;
  if(d.crest==='cornes')cr=`<path d="M69 32 Q56 30 53 12 Q55 10 57 12 Q60 24 71 27Z" fill="${BRZ}" ${S}/><path d="M91 32 Q104 30 107 12 Q105 10 103 12 Q100 24 89 27Z" fill="${BRZ}" ${S}/><path d="M57 14 q2 10 10 14" stroke="${BRZh}" stroke-width="1.2" fill="none"/><circle cx="54" cy="12" r="2" fill="${BRZh}" ${S} stroke-width=".7"/><circle cx="106" cy="12" r="2" fill="${BRZh}" ${S} stroke-width=".7"/>`;
