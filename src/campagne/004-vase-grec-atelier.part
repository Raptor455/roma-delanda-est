    <path d="M59 43 Q62 35 70 39 Q80 34 90 39 Q98 35 101 43 Q98 51 91 46 Q80 43 69 46 Q62 51 59 43Z" fill="${BRZ}" ${S}/><path d="M63 43 Q68 39 72 42 M88 42 Q92 39 97 43" stroke="${BRZh}" stroke-width="1.2" fill="none"/><path d="M71 29 q4 -4 9 -4" stroke="${BRZh}" stroke-width="1.6" fill="none"/>`;
  if(d.helm==='petase')head+=`<path d="M68 41 Q67 31 80 30 Q93 31 92 41 Q89 34 80 34 Q71 34 68 41Z" fill="${L.hair}" ${S}/><path d="M72 36 Q71 23 80 23 Q89 23 88 36Z" fill="#b8975e" ${S}/><path d="M85 25 Q89 28 88 36 L85 36 Q86 30 83 25Z" fill="#94753f"/>
    <ellipse cx="80" cy="37" rx="23" ry="4.6" fill="#b8975e" ${S}/><path d="M60 38 Q80 43 100 38" stroke="#94753f" stroke-width="1.4" fill="none"/><path d="M72 36 h16" stroke="#6a4426" stroke-width="2"/><path d="M70 42 Q72 56 80 58 M90 42 Q88 56 80 58" stroke="#6a4426" stroke-width=".9" fill="none"/>`;
  if(d.helm==='phrygien'){const pc=L.braies==='zig'?'#9b2a22':'#a0683a';
    head+=`<path d="M66 44 Q63 26 76 21 Q86 17 90 6 Q98 14 95 28 Q96 36 94 44Z" fill="${pc}" ${S}/><path d="M90 6 Q98 14 95 28 Q96 36 94 44 L89 44 Q92 30 90 22Z" fill="#000" opacity=".2"/><path d="M64 44 h32" stroke="${INK}" stroke-width="1.2"/>
    <path d="M66 43 Q63 52 64 60 L71 58 Q70 50 71 44Z M94 43 Q97 52 96 60 L89 58 Q90 50 89 44Z" fill="${pc}" ${S}/><path d="M68 32 q6 -8 14 -9" stroke="#fff" stroke-width="1.2" opacity=".35" fill="none"/>${L.braies==='zig'?`<path d="M67 40 l3 -3 l3 3 l3 -3 l3 3 l3 -3 l3 3 l3 -3 l3 3 l3 -3" stroke="#e3c27a" stroke-width="1.1" fill="none"/>`:''}`}
  // peau de loup des vélites, par-dessus le casque
  if(L.pelt)head+=`<path d="M65 46 Q60 58 62 70 L70 62 L68 46Z M95 46 Q100 58 98 70 L90 62 L92 46Z" fill="#7d6b57" ${S}/><path d="M64 44 Q61 21 80 19 Q99 21 96 44 Q91 36 80 36 Q69 36 64 44Z" fill="#8a7862" ${S}/>
    <path d="M68 24 l-1 -9 l7 5z M92 24 l1 -9 l-7 5z" fill="#8a7862" ${S}/><path d="M74 33 Q80 41 86 33 Q83 28 80 28 Q77 28 74 33Z" fill="#a8977e" ${S} stroke-width=".9"/><circle cx="80" cy="29.4" r="1.4" fill="${INK}"/><circle cx="74.5" cy="26" r=".9" fill="${INK}"/><circle cx="85.5" cy="26" r=".9" fill="${INK}"/>
    <path d="M67 30 q3 -2 5 1 M93 30 q-3 -2 -5 1 M70 40 l-2 3 M90 40 l2 3" stroke="#5e4f3e" stroke-width=".9" fill="none"/>`;
  // cimiers : posés au sommet du casque (plus haut sur le pilos)
  const cy={pilos:-10,thrace:-6,corinthien:-2,beotien:1}[d.helm]||0,RED='#9b1f1a',REDs='#741612';
  let cr='';
