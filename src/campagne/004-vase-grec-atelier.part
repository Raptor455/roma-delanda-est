  if(d.helm==='pilos')head+=`<path d="M66 43 Q72 38 80 12 Q88 38 94 43Z" fill="${BRZ}" ${S}/><path d="M84 22 Q88 36 94 43 L88 43 Q86 32 82 20Z" fill="${BRZs}"/><path d="M63 43 h34 q0 3 -3 3 h-28 q-3 0 -3 -3z" fill="${BRZ}" ${S}/><path d="M74 32 q3 -9 5 -16" stroke="${BRZh}" stroke-width="1.6" fill="none"/>`;
  if(d.helm==='attique')head+=`<path d="M66 43 Q65 25 80 24 Q95 25 94 43Z" fill="${BRZ}" ${S}/><path d="M88 27 Q94 31 94 43 L89 43 Q90 33 86 27Z" fill="${BRZs}"/><path d="M65 41 Q72 34 80 38 Q88 34 95 41 L95 44 Q88 38 80 42 Q72 38 65 44Z" fill="${BRZh}" ${S} stroke-width=".9"/>
