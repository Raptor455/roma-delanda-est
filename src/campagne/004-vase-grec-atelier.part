  if((d.jet==='javelots'||d.jet==='soliferrum')&&mounted)front+=`<line x1="${hx-4}" y1="14" x2="${hx+4}" y2="150" stroke="${WOOD}" stroke-width="2"/><line x1="${hx}" y1="12" x2="${hx+7}" y2="148" stroke="${WOOD}" stroke-width="2"/><path d="M${hx-4} 14 l-1.4 -9 l3 7z M${hx} 12 l-1.4 -9 l3 7z" fill="${IRN}" ${S} stroke-width=".7"/>`;
  front+=`<ellipse cx="${hx+1}" cy="${hy}" rx="5" ry="4.4" fill="${L.skin}" ${S}/><path d="M${hx-2} ${hy-1} h6 M${hx-2} ${hy+1.6} h6" stroke="${L.sh}" stroke-width=".9"/>`;
  // ---- bouclier (bras gauche) : teinte et motif au choix (« peuple » = emblème traditionnel)
  const sx=110,sy=88,T=SH_TINT[d.teinte]||SH_TINT.pourpre,SC=T[0],SCs=T[1],EC=T[2];
  const mot=!d.motif||d.motif==='peuple'?((L.embP&&L.embP[peoNow()])||L.emb):d.motif;
  const emb=(cx,cy,r,col)=>embSVG(mot,cx,cy,r,col);
  if(d.shield==='pelte')shield=`<path d="M${sx-19} ${sy-15} Q${sx} ${sy-3} ${sx+19} ${sy-15} Q${sx+22} ${sy+14} ${sx} ${sy+20} Q${sx-22} ${sy+14} ${sx-19} ${sy-15}Z" fill="#a07a4a" ${S}/>`+[-12,-6,0,6,12].map(o=>`<path d="M${sx+o} ${sy-8+Math.abs(o)*.25} Q${sx+o*1.15} ${sy+6} ${sx+o*.8} ${sy+17-Math.abs(o)*.2}" stroke="#7a5a34" stroke-width="1" fill="none"/>`).join('')+`<path d="M${sx-19} ${sy-15} Q${sx} ${sy-3} ${sx+19} ${sy-15}" stroke="#5a3d22" stroke-width="2.4" fill="none"/>${emb(sx,sy+7,8,'#4a2f1a')}`;
  if(d.shield==='peau')shield=`<circle cx="${sx}" cy="${sy}" r="21" fill="#c9a87a" ${S}/><path d="M${sx+5} ${sy-20.4} A21 21 0 0 1 ${sx+5} ${sy+20.4} A24 24 0 0 0 ${sx+5} ${sy-20.4}Z" fill="#a8885c"/><circle cx="${sx}" cy="${sy}" r="19" fill="none" stroke="#6a4426" stroke-width="1.2" stroke-dasharray="2.5 2"/>${[[-9,-8],[8,-11],[-12,6],[10,9],[1,13]].map(([a,b])=>`<ellipse cx="${sx+a}" cy="${sy+b}" rx="2.6" ry="1.8" fill="#7a5634" opacity=".7"/>`).join('')}${emb(sx,sy,12,'#4a2f1a')}`;
  if(d.shield==='rond')shield=`<circle cx="${sx}" cy="${sy}" r="26" fill="${BRZ}" ${S}/><circle cx="${sx}" cy="${sy}" r="21.5" fill="${SC}" ${S} stroke-width=".9"/><path d="M${sx+6} ${sy-20.5} A21.5 21.5 0 0 1 ${sx+6} ${sy+20.5} A26 26 0 0 0 ${sx+6} ${sy-20.5}Z" fill="${SCs}" opacity=".55"/>${emb(sx,sy,15,EC)}<path d="M${sx-18} ${sy-12} A22 22 0 0 1 ${sx-6} ${sy-22}" stroke="${BRZh}" stroke-width="1.6" fill="none"/>`;
  if(d.shield==='ovale')shield=`<ellipse cx="${sx}" cy="${sy+4}" rx="19" ry="36" fill="${SC}" ${S}/><path d="M${sx+6} ${sy-30} Q${sx+20} ${sy+4} ${sx+6} ${sy+38} Q${sx+19} ${sy+4} ${sx+6} ${sy-30}Z" fill="${SCs}"/><ellipse cx="${sx}" cy="${sy+4}" rx="17" ry="34" fill="none" stroke="#e3d6b3" stroke-width="1.6"/>${emb(sx,sy-14,10,EC)}${emb(sx,sy+22,10,EC)}<path d="M${sx} ${sy-30} V${sy+38}" stroke="#5a3d22" stroke-width="3.2"/><path d="M${sx-5} ${sy-5} h10 v18 h-10z" fill="${IRN}" ${S}/><path d="M${sx-3} ${sy-3} v12" stroke="${IRNh}" stroke-width="1"/>`;
  if(d.shield==='scutum')shield=`<path d="M${sx-20} ${sy-34} Q${sx} ${sy-40} ${sx+20} ${sy-34} L${sx+20} ${sy+36} Q${sx} ${sy+42} ${sx-20} ${sy+36}Z" fill="${SC}" ${S}/><path d="M${sx+11} ${sy-37} Q${sx+18} ${sy-36} ${sx+20} ${sy-34} L${sx+20} ${sy+36} Q${sx+16} ${sy+38} ${sx+11} ${sy+39}Z" fill="${SCs}"/><path d="M${sx-20} ${sy-34} Q${sx} ${sy-40} ${sx+20} ${sy-34} M${sx-20} ${sy+36} Q${sx} ${sy+42} ${sx+20} ${sy+36}" stroke="${BRZ}" stroke-width="2.6" fill="none"/>
    ${emb(sx,sy-18,9,EC)}${emb(sx,sy+22,9,EC)}<circle cx="${sx}" cy="${sy+2}" r="7.5" fill="${BRZ}" ${S}/><circle cx="${sx-2}" cy="${sy}" r="2.4" fill="${BRZh}"/><path d="M${sx-16} ${sy+2} h8 M${sx+8} ${sy+2} h8" stroke="${EC}" stroke-width="2"/>`;
  if(d.shield==='parma')shield=`<circle cx="${sx}" cy="${sy}" r="19" fill="${IRN}" ${S}/><circle cx="${sx}" cy="${sy}" r="16" fill="${SC}" ${S} stroke-width=".9"/><path d="M${sx+5} ${sy-15.2} A16 16 0 0 1 ${sx+5} ${sy+15.2} A19 19 0 0 0 ${sx+5} ${sy-15.2}Z" fill="${SCs}" opacity=".55"/>${emb(sx,sy,10.5,EC)}<circle cx="${sx}" cy="${sy}" r="3.6" fill="${IRN}" ${S} stroke-width=".9"/><path d="M${sx-13} ${sy-9} A16 16 0 0 1 ${sx-5} ${sy-16}" stroke="${IRNh}" stroke-width="1.4" fill="none"/>`;
  if(d.shield==='hoplon')shield=`<circle cx="${sx}" cy="${sy+3}" r="31" fill="${BRZ}" ${S}/><circle cx="${sx}" cy="${sy+3}" r="25" fill="${SC}" ${S} stroke-width=".9"/><path d="M${sx+7} ${sy-21} A25 25 0 0 1 ${sx+7} ${sy+27} A30 30 0 0 0 ${sx+7} ${sy-21}Z" fill="${SCs}" opacity=".55"/>${emb(sx,sy+3,18,EC)}<circle cx="${sx}" cy="${sy+3}" r="28" fill="none" stroke="${BRZs}" stroke-width="1" stroke-dasharray="1.2 2.6"/><path d="M${sx-24} ${sy-12} A30 30 0 0 1 ${sx-8} ${sy-26}" stroke="${BRZh}" stroke-width="2" fill="none"/>`;
  if(d.shield==='macedonien')shield=`<circle cx="${sx}" cy="${sy}" r="23" fill="${BRZ}" ${S}/><circle cx="${sx}" cy="${sy}" r="19.5" fill="${SC}" ${S} stroke-width=".9"/>${[...Array(8)].map((_,i)=>{const a=i*Math.PI/4,x=sx+Math.cos(a)*14,y=sy+Math.sin(a)*14;return `<path d="M${x-3.4} ${y} a3.4 3.4 0 0 1 6.8 0" transform="rotate(${i*45+90} ${x} ${y})" fill="none" stroke="${EC}" stroke-width="1.3"/>`}).join('')}${emb(sx,sy,7.5,EC)}<path d="M${sx-17} ${sy-10} A20 20 0 0 1 ${sx-6} ${sy-19}" stroke="${BRZh}" stroke-width="1.6" fill="none"/>`;
  if(d.shield==='aucun')shield=`<ellipse cx="106" cy="94" rx="4.6" ry="4.2" fill="${L.skin}" ${S}/>`;
  // ---- assemblage
  const defs=`<defs><pattern id="${id}m" width="3.6" height="3.2" patternUnits="userSpaceOnUse"><rect width="3.6" height="3.2" fill="${IRN}"/><path d="M0 1.6 q.9 -1.4 1.8 0 q.9 1.4 1.8 0" stroke="${IRNs}" stroke-width=".6" fill="none"/></pattern>
    <pattern id="${id}s" width="5" height="4.4" patternUnits="userSpaceOnUse"><rect width="5" height="4.4" fill="${BRZ}"/><path d="M0 0 q2.5 4.6 5 0" stroke="${BRZs}" stroke-width=".8" fill="${BRZ}"/><path d="M1 1 q1.5 2 3 0" stroke="${BRZh}" stroke-width=".5" fill="none"/></pattern>
 <pattern id="${id}z" width="6" height="6" patternUnits="userSpaceOnUse"><rect width="6" height="6" fill="#c08a3e"/><path d="M0 4 l1.5 -2 l1.5 2 l1.5 -2 l1.5 2" stroke="#4a2a18" stroke-width="1" fill="none"/><path d="M0 0.5h6" stroke="#9b2a22" stroke-width="1"/></pattern>
    <pattern id="${id}b" width="6" height="6" patternUnits="userSpaceOnUse"><rect width="6" height="6" fill="#7a5a2e"/><path d="M0 3h6M3 0v6" stroke="#b08a44" stroke-width="1.4"/><path d="M0 0h6" stroke="#4e3a1e" stroke-width=".8"/></pattern>
    <radialGradient id="${id}g" cx="50%" cy="78%" r="60%"><stop offset="0" stop-color="#d6b878" stop-opacity=".22"/><stop offset="1" stop-color="#d6b878" stop-opacity="0"/></radialGradient></defs>`;
  const man=back+legs+body+armL+head+front+shield;
  const sz=small?'class="doll mini"':'class="doll"';
  if(!mounted)return `<svg viewBox="0 -24 160 186" ${sz} role="img" aria-label="${esc(d.name||dAutoName(d))}">${defs}<ellipse cx="80" cy="157" rx="40" ry="5" fill="#000" opacity=".25"/>${man}</svg>`;
  // ---- monture : cheval de profil (tapis de selle pour les cavaliers, monté à cru avec une simple corde pour les Numides)
  const nu=k==='lcav',coat=nu?'#a87444':'#5a3a24',coatS=nu?'#7e5530':'#3c2616',coatH=nu?'#c89462':'#7a5236',mane=nu?'#3a2414':'#1c120b';
  // jambe : épaule/cuisse, genou ou jarret, canon fin, sabot ; dx décale le pied (pas)
  const leg=(x,top,dx,c,hind)=>{const kx=hind?x-4:x,ky=top+(hind?24:20);
    return `<path d="M${x-7} ${top} Q${x-8} ${top+12} ${kx-3} ${ky} L${x-2+dx} 149 L${x+3+dx} 149 L${kx+3} ${ky} Q${x+7} ${top+10} ${x+7} ${top}Z" fill="${c}" ${S}/><path d="M${x-3+dx} 149 h7 l1 6 h-9z" fill="#2a1d14" ${S} stroke-width=".9"/><path d="M${x-2+dx} 146 h5" stroke="${coatH}" stroke-width="1.2" opacity=".6"/>`};
  const horse=`<ellipse cx="82" cy="157" rx="58" ry="4.5" fill="#000" opacity=".25"/>
    <path d="M42 98 Q28 100 26 118 Q25 134 32 146 Q33 130 37 120 Q40 110 47 104Z" fill="${mane}" ${S}/><path d="M30 120 q2 12 2 20 M34 112 q0 14 1 26" stroke="#4a3624" stroke-width=".9" fill="none"/>
    ${leg(52,112,6,coatS,1)}${leg(118,108,-6,coatS,0)}
    <path d="M44 100 Q46 86 64 86 L100 86 Q112 84 122 92 Q130 100 128 112 Q126 124 112 125 L62 127 Q46 126 42 116 Q40 106 44 100Z" fill="${coat}" ${S}/>
    <path d="M62 122 Q86 128 112 122 Q120 120 124 114 Q120 126 108 127 L64 128 Q52 127 46 120 Q54 124 62 122Z" fill="${coatS}"/><path d="M60 89 Q80 86 100 88" stroke="${coatH}" stroke-width="1.6" fill="none"/>
    ${leg(60,114,-4,coat,1)}${leg(110,110,6,coat,0)}
    <path d="M106 90 Q110 70 126 56 L134 50 Q142 52 142 60 Q136 70 132 80 Q128 94 126 104 Q118 98 106 90Z" fill="${coat}" ${S}/>
    <path d="M128 50 Q134 44 141 47 L156 66 Q159 74 152 76 Q146 77 141 71 L131 60Z" fill="${coat}" ${S}/>
    <path d="M150 74 Q156 74 156 68 L157 70 Q158 76 152 77Z" fill="${coatS}"/><circle cx="153.5" cy="70" r="1" fill="${INK}"/><path d="M147 74 q3 2 7 1" stroke="${INK}" stroke-width=".9" fill="none"/>
    <path d="M139 55.5 q2 -1.6 3.6 .6" stroke="${INK}" stroke-width="1.1" fill="none"/><circle cx="140.6" cy="57" r="1.1" fill="${INK}"/>
    <path d="M131 51 l0 -10 l5 8z M135 49 l2 -9 l3 8z" fill="${coat}" ${S} stroke-width=".9"/>
    <path d="M131 50 Q120 58 112 72 Q106 82 104 92 L110 92 Q111 82 117 72 Q124 62 134 54Z" fill="${mane}" ${S} stroke-width=".9"/><path d="M114 70 l-4 6 M120 62 l-4 6 M126 56 l-4 5 M110 80 l-4 6" stroke="#4a3624" stroke-width=".8"/>
    ${nu?`<path d="M136 58 Q138 66 144 72 M136 58 Q120 74 104 86" stroke="#c9b48a" stroke-width="1.2" fill="none"/>`
       :`<path d="M131 58 L150 70 M136 50 L141 63 L131 58" stroke="#5a3b22" stroke-width="1.6" fill="none"/><circle cx="141" cy="63" r="1.6" fill="${BRZ}"/><path d="M141 63 Q120 78 100 84" stroke="#5a3b22" stroke-width="1.3" fill="none"/>
         <path d="M66 84 h40 l3 26 q-25 6 -49 0z" fill="${CAR}" ${S}/><path d="M60 110 q25 6 49 0" stroke="${GOLD}" stroke-width="2.4" fill="none"/>${[0,1,2,3,4,5,6,7].map(i=>`<path d="M${62+i*6.4} 112.6 v5" stroke="${GOLD}" stroke-width="1.2"/>`).join('')}<path d="M70 84 q16 -6 32 0" stroke="#3a2414" stroke-width="3" fill="none"/>`}`;
  // cavalier : buste jusqu'aux hanches posé sur le dos, cuisse vers l'avant, jambe pendante le long du flanc, pied vers l'avant
  const legC=L.braies?`url(#${id}${L.braies==='zig'?'z':'b'})`:L.skin,thigh=d.armor==='tunique'||d.armor==='pect'?L.tun:L.tun;
  const rlegs=`<path d="M78 86 Q90 86 98 92 L102 100 Q96 104 90 100 Q84 96 76 96Z" fill="${thigh}" ${S}/>
    <path d="M94 96 Q102 98 102 104 L98 128 L91 128 L92 106 Q90 101 94 96Z" fill="${legC}" ${S}/><path d="M99 104 L96 127" stroke="${L.sh}" stroke-width="1.6" opacity="${L.braies?0:1}"/>
    ${d.jamb==='cnemides'||d.jamb==='une'?`<path d="M92.5 107 Q97 104 101.6 105 L98.4 126 L91.4 126Z" fill="${BRZ}" ${S}/><path d="M96 109 L94.4 124" stroke="${BRZh}" stroke-width="1.2"/>`:d.jamb==='bandes'?[110,115,120].map(y=>`<path d="M91.6 ${y} l9 2" stroke="#6a4426" stroke-width="2.2"/>`).join(''):''}
    <path d="M90 127 h9 q5 1 6 4 h-15z" fill="${lev?L.skin:'#5a3b22'}" ${S}/>${lev?'':`<path d="M91 122 l7 2 M91 125 l7 -2" stroke="#5a3b22" stroke-width="1.2"/>`}`;
  const rider=`<g transform="translate(22.5 6) scale(.74)">${back+body+armL+head+front+shield}</g>`;
  return `<svg viewBox="0 -24 162 186" ${sz} role="img" aria-label="${esc(d.name||dAutoName(d))}">${defs}${horse}${rlegs}${rider}</svg>`;
}

/* ---- régiment en 5 petits carrés, comme sur le champ de bataille (pertes : carrés fissurés puis brisés) ---- */
function sqSVG(k,f,big){
  f=f==null?1:Math.max(0,Math.min(1,f));
  const c=(FAC.car&&FAC.car.c)||[125,79,184],col=`rgb(${c.join(',')})`,dk=`rgb(${c.map(v=>Math.round(v*.62)).join(',')})`,lt=`rgb(${c.map(v=>Math.min(255,Math.round(v*1.25+20))).join(',')})`;
  const INK='#1d150c',z=10,gap=3,sk=k==='skirm',H=sk?18:13,W=5*z+4*gap+2,nA=Math.ceil(f*5-1e-6),part=nA-f*5; // part : entame du dernier carré
  let h='';
  for(let i=0;i<5;i++){const x=1+i*(z+gap),y=1.5+(sk?(i%2?5:0):0);
    if(i>=nA){h+=`<rect x="${x+1}" y="${y+1}" width="${z-2}" height="${z-2}" fill="none" stroke="${dk}" stroke-width=".8" stroke-dasharray="1.5 1.5" opacity=".6"/>`;continue}
    const cr=i===nA-1&&part>.15;
    h+=`<rect x="${x}" y="${y}" width="${z}" height="${z}" fill="${cr?dk:col}" stroke="${INK}" stroke-width="1"/>`;
    if(k==='cav'||k==='lcav')h+=`<path d="M${x} ${y}h${z}L${x} ${y+z}Z" fill="#fff" opacity="${k==='lcav'?.45:.25}"/><path d="M${x+z} ${y}L${x} ${y+z}" stroke="${INK}" stroke-width="1"/>`+(k==='lcav'?`<circle cx="${x+7}" cy="${y+7}" r="1" fill="${INK}"/>`:'');
    else if(k==='skirm')h+=[[3.2,3.6],[6.8,3.6],[5,6.8]].map(([a,b])=>`<circle cx="${x+a}" cy="${y+b}" r="1" fill="${INK}"/>`).join('');
    else h+=`<path d="M${x+2} ${y+2}l6 6M${x+8} ${y+2}l-6 6" stroke="${INK}" stroke-width="1"/>`+(k==='eleph'?`<circle cx="${x+5}" cy="${y+5}" r="2" fill="${lt}" stroke="${INK}" stroke-width=".8"/>`:'');
    h+=`<rect x="${x}" y="${y}" width="${z}" height="1.6" fill="${lt}"/>`; // liseré du front
    if(cr)h+=`<path d="M${x+1} ${y+3}l3 2l1 3M${x+9} ${y+2}l-3 3l1 4" stroke="#1a1008" stroke-width=".8" fill="none"/>`;
  }
  return `<svg class="sq5${big?' big':''}" viewBox="0 0 ${W} ${H}" width="${W*(big?1.6:1)}" height="${H*(big?1.6:1)}" role="img" aria-label="${nA} carré${nA>1?'s':''} sur 5">${h}</svg>`;
}

/* ---- fenêtre de l'atelier ---- */
let wsD=null;
function newDesign(base){const P=wsPool();if(!base||!CORPS[base]||P.length&&!P.includes(base))base=P[0]||'lib';
  return dFix(Object.assign({id:null,base,name:'',helm:'bronze',crest:'rien',armor:'lin',jamb:'aucune',shield:'rond',motif:'peuple',teinte:'pourpre',tenue:'peuple',manteau:'aucun',arm:'lance',jet:'aucune',train:'reg'},
    (typeof S!=='undefined'&&S&&PEO_LOOK[S.peo])||{},BDEF[base]||{}))}
function openWorkshop(id){
  if(!S.designs)S.designs=[];
  const src=id!=null&&desOf(id);wsD=src?dFix(Object.assign({},src)):newDesign();
  renderWorkshop();
}
function renderWorkshop(){
  const d=wsD,s=dStats(d),k=CORPS[d.base].k,mine=S.designs.filter(x=>!x.del);
  const std=UT[d.base],cmp=(v,ref,fmt)=>{const dv=v-ref;return Math.abs(dv)<1e-6?'':`<i class="${dv>0?'up':'dn'}">${dv>0?'+':''}${fmt(dv)}</i>`};
  const ref=STD3D[d.base]||{atk:s.atk,def:s.def,mor:s.mor}; // comparaison avec le régiment ordinaire du même corps
  const bar=(lbl,v,max,txt,sub)=>`<div class="st"><span>${lbl}</span><span class="g"><i style="width:${Math.max(3,Math.min(100,v/max*100))}%"></i></span><b>${txt}</b>${sub?`<small>${sub}</small>`:''}</div>`;
  const chips=sl=>`<div class="slot"><h4>${GEAR[sl].n}</h4><div class="chips">${Object.entries(GEAR[sl].o).filter(([key])=>{const o=GEAR[sl].o[key];return !o.k||o.k.includes(k)}).map(([key,o])=>{const ok=gearOk(sl,key,d);
      return `<button type="button" data-g="${sl}" data-v="${key}" class="${d[sl]===key?'on':''}" ${ok?'':'disabled title="Incompatible avec le reste de l\'équipement"'}>${o.n}</button>`}).join('')}</div></div>`;
  modal(`<h2>Atelier des unités</h2>
    <p class="sub">Choisissez le corps de troupe puis chaque pièce d'équipement : elles changent le coût, la marche et la conduite au combat. Le modèle enregistré se recrute ensuite dans toute ville qui lève ce corps de troupe.</p>
    <div class="ws">
      <div class="wsL">
        <h4>Vos modèles</h4>
        ${mine.length?mine.map(x=>`<button type="button" data-wd="${x.id}" class="${x.id===d.id?'on':''}">${dollSVG(x,1)}<span>${esc(x.name)}<small>${CORPS[x.base].n} · ${dStats(x).cost} or</small></span></button>`).join(''):'<p class="sub">Aucun pour l\'instant.</p>'}
        <button type="button" id="wNew">+ Nouveau modèle</button>
      </div>
      <div class="wsM">
        ${dollSVG(d)}
        <p class="sub sqRow">En bataille ${sqSVG(k,1,1)}</p>
        <div class="stats">
          ${bar('Attaque',s.atk,12,s.atk.toFixed(1),cmp(s.atk,ref.atk,v=>v.toFixed(1)))}
          ${bar('Défense',s.def,1.6,s.def.toFixed(2),cmp(s.def,ref.def,v=>v.toFixed(2)))}
          ${bar('Moral',s.mor,130,Math.round(s.mor),cmp(s.mor,ref.mor,v=>Math.round(v)))}
          ${bar('Charge',s.chg,2.8,'×'+s.chg.toFixed(2),'')}
          ${bar('Vitesse',s.spd,50,s.spd.toFixed(1)+' m/s','')}
          ${s.ranged?bar('Tir',s.ranged.range,240,s.ranged.range+' m','dégâts '+s.ranged.dmg):''}
          <p class="sub">${s.men} hommes · marche ${s.km} km/jour · formation ${s.days} jours<br>Coût <b class="gold">${s.cost}</b> or · entretien ${(s.cost/12).toFixed(1)} par mois${std?` <span class="sub">(${esc(std.n)} : ${std.cost})</span>`:''}</p>
        </div>
      </div>
      <div class="wsR">
        <label class="nm"><span>Nom de l'unité</span><input id="wName" type="text" maxlength="32" value="${esc(d.name)}" placeholder="${esc(dAutoName(d))}" autocomplete="off"></label>
        <div class="slot"><h4>Corps de troupe</h4><div class="chips">${Object.entries(CORPS).filter(([key])=>wsPool().includes(key)||key===d.base).map(([key,c])=>`<button type="button" data-base="${key}" class="${d.base===key?'on':''}" title="${esc(c.txt)}">${c.n}</button>`).join('')}</div><p class="sub">${esc(CORPS[d.base].txt)}</p></div>
        ${SLOTS.filter(sl=>!GEAR[sl].look).map(chips).join('')}
        <h4 class="grpT">Apparence (sans effet au combat)</h4>${SLOTS.filter(sl=>GEAR[sl].look&&(d.shield!=='aucun'||!GEAR[sl].sh)).map(chips).join('')}
      </div>
    </div>
    <p class="sub" id="wMsg"></p>
    <div class="row" style="justify-content:flex-end">
      ${d.id!=null?`<button type="button" class="warn" id="wDel">Supprimer le modèle</button>`:''}
      <button type="button" id="wClose">Fermer</button>
      <button type="button" class="go" id="wSave">${d.id!=null?'Enregistrer les changements':'Enregistrer le modèle'}</button>
    </div>`);
  $('mcard').classList.add('wide');
  const nm=$('wName');nm.oninput=()=>{d.name=nm.value};
  document.querySelectorAll('[data-g]').forEach(b=>b.onclick=()=>{d[b.dataset.g]=b.dataset.v;dFix(d);renderWorkshop()});
  document.querySelectorAll('[data-base]').forEach(b=>b.onclick=()=>{if(d.id==null){const nm=d.name;wsD=newDesign(b.dataset.base);wsD.name=nm}else{d.base=b.dataset.base;dFix(d)}renderWorkshop()});
  document.querySelectorAll('[data-wd]').forEach(b=>b.onclick=()=>openWorkshop(+b.dataset.wd));
  $('wNew').onclick=()=>{wsD=newDesign(d.base);renderWorkshop()};
  $('wClose').onclick=closeModal;
  $('wSave').onclick=()=>{
    const name=(d.name||'').trim().slice(0,32)||dAutoName(d);
    if(S.designs.some(x=>!x.del&&x.id!==d.id&&x.name.toLowerCase()===name.toLowerCase())){$('wMsg').textContent='Un autre modèle porte déjà ce nom.';return}
    const rec=Object.assign({},d,{name});let msg='';
    if(d.id!=null&&dInUse(d.id)){ // les régiments déjà levés gardent leur équipement : l'ancien modèle est mis à la retraite
      const old=desOf(d.id);old.del=true;rec.id=S.duid=(S.duid||0)+1;S.designs.push(rec);msg=' Les régiments déjà levés gardent leur ancien équipement.'}
    else if(d.id!=null){Object.assign(desOf(d.id),rec)}
    else{rec.id=S.duid=(S.duid||0)+1;S.designs.push(rec)}
    wsD=Object.assign({},rec);save();renderWorkshop();renderSide();$('wMsg').textContent=`« ${name} » enregistré.`+msg;
  };
  if($('wDel'))$('wDel').onclick=()=>{const x=desOf(d.id);if(!x)return;if(dInUse(x.id))x.del=true;else S.designs=S.designs.filter(y=>y!==x);
    wsD=newDesign(d.base);save();renderWorkshop();renderSide();$('wMsg').textContent=`Modèle « ${x.name} » supprimé.`};
}

