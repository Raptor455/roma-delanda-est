  if(d.helm==='corinthien')head+=`<path d="M64 46 Q62 22 80 21 Q98 22 96 46 L95 59 Q90 62 85 59 L84 47 L90 46 L90 40 L70 40 L70 46 L76 47 L75 59 Q70 62 65 59Z" fill="${BRZ}" ${S}/><path d="M89 24 Q96 30 96 46 L95 59 Q92 61 89 60 Q92 44 87 25Z" fill="${BRZs}"/><path d="M79 40 h2 v8 h-2z" fill="${BRZ}" ${S} stroke-width=".8"/>
    <path d="M66 38 Q73 34 79 38 M81 38 Q87 34 94 38" stroke="${BRZs}" stroke-width="1.3" fill="none"/><path d="M69 30 q4 -5 10 -6" stroke="${BRZh}" stroke-width="1.8" fill="none"/>`;
