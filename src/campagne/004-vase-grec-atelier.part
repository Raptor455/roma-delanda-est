  if(d.arm==='sarisse')front+=`<line x1="${hx-7}" y1="-24" x2="${hx+3}" y2="158" stroke="${WOODs}" stroke-width="3.4"/><line x1="${hx-7}" y1="-24" x2="${hx+3}" y2="158" stroke="${WOOD}" stroke-width="1.8"/><path d="M${hx-7} -22 q-3 -4 0 -12 q3 8 0 12z" fill="${IRN}" ${S}/><rect x="${hx-6}" y="70" width="4" height="6" fill="${BRZ}" ${S} stroke-width=".7"/>`;
  if(d.arm==='epee')front+=`<path d="M${hx+1} ${hy-3} Q${hx-6} ${hy-22} ${hx-1} ${hy-40} Q${hx+8} ${hy-30} ${hx+4} ${hy-3}Z" fill="#cfd4d8" ${S}/><path d="M${hx+1} ${hy-8} Q${hx-2} ${hy-24} ${hx} ${hy-36}" stroke="${IRNs}" stroke-width=".8" fill="none"/><path d="M${hx-5} ${hy-3} h14" stroke="${INK}" stroke-width="3.4"/><path d="M${hx-5} ${hy-3} h14" stroke="${BRZ}" stroke-width="2"/><path d="M${hx+2} ${hy-1} q6 4 2 8" stroke="${BRZ}" stroke-width="2" fill="none"/>`;
  if(d.arm==='longue')front+=`<path d="M${hx} ${hy-4} L${hx-1} ${hy-56} L${hx+2.5} ${hy-61} L${hx+6} ${hy-56} L${hx+5} ${hy-4}Z" fill="#cfd4d8" ${S}/><path d="M${hx+2.5} ${hy-8} V${hy-56}" stroke="${IRNs}" stroke-width=".8"/><path d="M${hx-4} ${hy-4} h13" stroke="${INK}" stroke-width="3.4"/><path d="M${hx-4} ${hy-4} h13" stroke="${IRN}" stroke-width="2"/><circle cx="${hx+2.5}" cy="${hy+7}" r="2.4" fill="${IRN}" ${S}/>`;
  if(d.arm==='dague')front+=`<path d="M${hx+1} ${hy-3} L${hx} ${hy-20} L${hx+2.5} ${hy-24} L${hx+5} ${hy-20} L${hx+4} ${hy-3}Z" fill="#cfd4d8" ${S}/><path d="M${hx-3} ${hy-3} h11" stroke="${INK}" stroke-width="3"/><path d="M${hx-3} ${hy-3} h11" stroke="${BRZ}" stroke-width="1.6"/>`;
  if(d.arm==='hache')front+=`<path d="M${hx+1} ${hy+10} L${hx-1} ${hy-44}" stroke="${WOODs}" stroke-width="4" stroke-linecap="round"/><path d="M${hx+1} ${hy+10} L${hx-1} ${hy-44}" stroke="${WOOD}" stroke-width="2.4" stroke-linecap="round"/><path d="M${hx} ${hy-42} Q${hx-12} ${hy-50} ${hx-17} ${hy-40} Q${hx-15} ${hy-30} ${hx} ${hy-32}Z" fill="${IRN}" ${S}/><path d="M${hx-16} ${hy-41} Q${hx-15} ${hy-34} ${hx-11} ${hy-32}" stroke="${IRNh}" stroke-width="1.2" fill="none"/><path d="M${hx} ${hy-44} l4 2 v8 l-4 2z" fill="${IRN}" ${S} stroke-width=".8"/>`;
  if(d.arm==='glaive')front+=`<path d="M${hx} ${hy-4} L${hx-.6} ${hy-36} L${hx+2.5} ${hy-43} L${hx+5.6} ${hy-36} L${hx+5} ${hy-4}Z" fill="#cfd4d8" ${S}/><path d="M${hx+2.5} ${hy-8} V${hy-37}" stroke="${IRNs}" stroke-width=".8"/><path d="M${hx-3} ${hy-4} h11 q1 -3 -1 -4 h-9 q-2 1 -1 4z" fill="#e9dcc0" ${S} stroke-width=".9"/><circle cx="${hx+2.5}" cy="${hy+7}" r="3" fill="#e9dcc0" ${S} stroke-width=".9"/>`;
  if(d.arm==='kopis')front+=`<path d="M${hx+1} ${hy-4} Q${hx-3} ${hy-22} ${hx+4} ${hy-42} Q${hx+12} ${hy-38} ${hx+10} ${hy-28} Q${hx+6} ${hy-16} ${hx+5} ${hy-4}Z" fill="#cfd4d8" ${S}/><path d="M${hx+1.5} ${hy-10} Q${hx} ${hy-24} ${hx+5} ${hy-38}" stroke="${IRNs}" stroke-width=".8" fill="none"/><path d="M${hx-3} ${hy-4} h11" stroke="${INK}" stroke-width="3.2"/><path d="M${hx-3} ${hy-4} h11" stroke="${BRZ}" stroke-width="1.8"/><path d="M${hx+1} ${hy+4} q-6 4 -2 9" stroke="${BRZ}" stroke-width="2.2" fill="none"/>`;
  if(d.arm==='xyston')front+=`<line x1="${hx-8}" y1="-16" x2="${hx+4}" y2="160" stroke="${WOODs}" stroke-width="3.4"/><line x1="${hx-8}" y1="-16" x2="${hx+4}" y2="160" stroke="${WOOD}" stroke-width="1.8"/><path d="M${hx-8} -14 q-4 -6 0 -18 q4 12 0 18z" fill="${IRN}" ${S}/><path d="M${hx+4} 156 l1 8 l-3 -1z" fill="${IRN}" ${S} stroke-width=".8"/>`;
