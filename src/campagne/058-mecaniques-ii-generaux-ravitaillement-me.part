// quel peuple représente une armée de ce camp
function depPeo(side){if(side==='pun')return 'car';if(side==='car'){const k=S.peo;if(k&&k!=='car'&&k!=='rom'&&DEP_R[k])return k;return realSide('car')}
  if(side==='rom')return realSide('rom');return DEP_R[side]?side:null}
function depDesign(side,peo,base,e){if(!CORPS[base])return null;const mine=side==='car',key='dep:'+side+':'+peo+':'+base+':'+e[0];
  S.designs=S.designs||[];let d=S.designs.find(x=>x.sys==='dep'&&x.k===key);if(d)return d;
  d=Object.assign({id:null,base,name:'',helm:'bronze',crest:'rien',armor:'lin',jamb:'aucune',shield:'rond',motif:'peuple',teinte:DEP_T[peo]||'ocre',tenue:'peuple',manteau:'aucun',arm:'lance',jet:'aucune',train:'reg'},BDEF[base]||{},{teinte:DEP_T[peo]||'ocre'},e[1]);
  dFix(d);d.base=base;d.name=e[0];d.sys='dep';d.k=key;if(!mine)d.del=true;d.id=S.duid=(S.duid||0)+1;S.designs.push(d);return d}
const depOwn=u=>{if(u.d==null)return u.ds==null;const d=desOf(u.d);return !!(d&&(d.sys==='dep'||d.sys==='ia'))};
function depOne(a,u,cnt){if(!a||!u||!UT[u.t]||!CORPS[u.t]||!depOwn(u))return;const peo=depPeo(a.side),R=peo&&DEP_R[peo],L=R&&R[u.t];if(!L||!L.length)return;
  cnt=cnt||{};const j=cnt[u.t]=(cnt[u.t]||0)+1;const d=depDesign(a.side,peo,u.t,L[(j-1)%L.length]);if(d)u.d=d.id}
const depTag=a=>a.side+':'+depPeo(a.side);
function depArmy(a){a._dep=depTag(a);const cnt={};for(const u of a.units)depOne(a,u,cnt)}
function depSweep(){for(const a of S.armies)if(!a.dead&&depPeo(a.side)&&a._dep!==depTag(a))try{depArmy(a)}catch(e){console.error(e)}}
// au départ (jour 0 à 3) : garnisons minimales puis troupes équipées ; refait après l'échange des camps (jouer Rome)
function depStart(){if(!S||!S.armies||S.day>3)return;if(!S.garMin){S.garMin=1;garAll(99)}depSweep();S.depArm=1}
{const _ngD=newGame;newGame=function(){const r=_ngD.apply(this,arguments);try{depStart()}catch(e){console.error(e)}return r}}
{const _alD=afterLoad;afterLoad=function(){const r=_alD.apply(this,arguments);try{depStart()}catch(e){console.error(e)}return r}}
{const _mgD=mirrorGame;mirrorGame=function(){const r=_mgD.apply(this,arguments);try{depStart()}catch(e){console.error(e)}return r}}
{const _dDA=daily;daily=function(d){const r=_dDA.apply(this,arguments);try{if(S&&!S.depArm){S.depArm=1;if(S.day<=3)depSweep()}else if(S&&S.day<=3)depSweep()}catch(e){console.error(e)}return r}}
