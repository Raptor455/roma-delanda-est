      {w:2,f:()=>{for(const a of S.armies)if(a.side==='car'&&a.mor!=null)a.mor=Math.min(100,a.mor+5);evCard('Artémis d\'Éphèse',"La fête d'Artémis rassemble la cité ; vos soldats sont fiers de leurs ancêtres phocéens (moral +5).")}},
