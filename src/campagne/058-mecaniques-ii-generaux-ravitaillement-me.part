const pxOn=()=>!!(S&&PX[S.peo]);
for(const k in PX){const X=PX[k];P218[k]=Object.assign({},X.p218);
  X.PH=[[" Prendre Rome. Vous perdez si Carthage tombe."," "+X.goal],["écu violet","écu "+X.adj],["Alliance : ils rejoignent Carthage avec","Alliance : ils rejoignent "+X.n+" avec"],[" Les tributaires (soumis par les Barcides) paient"," Les tributaires de Carthage (soumis par les Barcides) paient"],["quand une armée punique est proche et tant que vous gardez leurs otages","quand une armée punique est proche et tant que Carthage garde leurs otages"]]}
function pxStatic(k){if(peoDone===k)return;peoDone=k;macDone=true;const X=PX[k];for(const t in X.utn||{})if(UT[t])UT[t].n=X.utn[t];
  FAC.pun={n:'Carthage',c:FAC.car.c.slice(),a:[40,-100],cul:'afr'};FAC.car={n:X.n,c:X.c.slice()};
  GEN.pun=GEN.car.slice();GEN.car=X.gens.slice();if(X.foeGens&&X.p218.foe&&X.p218.foe!=='pun')GEN[X.p218.foe]=X.foeGens.slice();
  const cul=new Set(Object.keys(POOL_CAR));for(const f in FAC)if(FAC[f].cul)cul.add(FAC[f].cul);['afr','ibe','gau','ita','gre','num','bal','lig','cel'].forEach(c=>cul.add(c));
  for(const c in POOL_CAR)delete POOL_CAR[c];for(const c of cul)POOL_CAR[c]=[...new Set(X.units)];
  try{document.documentElement.style.setProperty('--punic',X.css)}catch(e){}document.title='Roma Delenda Est · '+X.n}
// tous les peuples : rétablir les tables du peuple joué (aussi appelé par le multijoueur)
function peoStatic(k){if(k==='mac')macStatic();else if(k==='syr')syrStatic();else if(k==='ath')athStatic();else if(PX[k])pxStatic(k)}
function pxSetup(k){const X=PX[k];
  for(const [id,L,g] of X.mine)if(NI[id]!=null&&S.own[id]==='car')scenArmy('car',id,L,g);
  if(X.p218.foe!=='rom'&&X.p218.foe!=='pun'&&S.fac[X.p218.foe]){S.fac[X.p218.foe].st='neutre';S.fac[X.p218.foe].car=-20}
  if(X.p218.foe==='pun'&&S.fac.pun)S.fac.pun.car=-100;
  for(const [id,sh,nm] of X.fleet||[])if(NI[id]!=null&&S.own[id]==='car')try{newFleet('car',NI[id],sh,nm)}catch(e){console.error(e)}
  S.trade=(S.trade||[]).filter(r=>r.side!=='car');S.gi=S.gi||{};const f=X.p218.foe;if(S.gi[f]==null)S.gi[f]=0}
function pxWar(k,early){const X=PX[k],f=X.p218.foe;
  if(f==='rom'){evCard(X.p218.n.replace(/^218 : /,'').replace(/^./,m=>m.toUpperCase()),"Les colons romains sont chassés de leurs terres ; Mutina est assiégée. Rome envoie ses légions vers le Pô.");return}
  if(S.fac[f]&&f!=='pun'){S.fac[f].st='guerre_car';S.fac[f].car=-100;S.fac[f].cd=0}else if(S.fac[f])S.fac[f].car=-100;
  for(const [id,L,g] of X.foeA||[])if(NI[id]!=null&&S.own[id]===f)scenArmy(f,id,L,g);
  if(X.onWar)try{X.onWar(early)}catch(e){console.error(e)}
  if(X.warCard){evCard(X.warCard[0],early?X.warCard[1]:X.warCard[2]);return}
  evCard('Syphax entre en guerre',early?"Vos cavaliers franchissent l'Ampsaga : la guerre contre Syphax commence.":"Syphax s'est allié aux Scipions ; des centurions romains dressent son infanterie. Il marche sur Cirta.")}
// IA de l'ennemi mineur (Syphax) : renforts à sa capitale, attaques des armées et des villes du joueur
function pxDaily(d){const X=PX[S.peo],f=X.p218.foe;if(f==='rom'||S.peace||d%2)return;
  const cap=N[NI[X.cap]];for(const a of S.armies.filter(a=>a.side===f&&!a.dead&&!a.g&&!a.ship&&(!X.foeAI||(!/^Hannibal/.test(a.name||'')&&cap&&Math.hypot(a.x-cap.x,a.y-cap.y)<700)))){if(a.legs.length||a.units.length<5||(a.cool||0)>0)continue;const sg=a.at!=null&&S.siege[N[a.at].id];if(sg&&sg.a===a.id)continue;
    if(a.qh&&season()==='Hiver')continue;const my=strength(a);
    const foe=S.armies.filter(o=>o.side==='car'&&!o.dead&&!o.ship&&!o.g&&strength(o)<my*.9&&Math.hypot(o.x-a.x,o.y-a.y)<160).sort((x,y)=>Math.hypot(x.x-a.x,x.y-a.y)-Math.hypot(y.x-a.x,y.y-a.y))[0];
    if(foe){order(a,foe.x,foe.y,null);continue}
    const t=N.filter(n=>!n.col&&S.own[n.id]==='car').map(n=>{const def=S.armies.filter(x=>x.side==='car'&&!x.dead&&Math.hypot(x.x-n.x,x.y-n.y)<6).reduce((s,x)=>s+strength(x),0);return {n,def,dd:Math.hypot(n.x-a.x,n.y-a.y)}}).filter(o=>o.def<my*.8&&o.dd<700).sort((x,y)=>x.dd-y.dd)[0];
    if(t&&t.dd>3)order(a,0,0,t.n.i)}}
function pxMonthly(d){if(S.over)return;const X=PX[S.peo],f=X.p218.foe;
  if(f!=='rom'&&!S.peace&&!X.foeAI){const own=N.filter(n=>!n.col&&S.own[n.id]===f),inc=own.reduce((s,n)=>s+(n.inc||4),0)+25;S.gold[f]=(S.gold[f]||0)+inc*dif().ai;
    const C=X.foeCap;for(let k=0;k<1&&S.gold[f]>=60&&NI[C]!=null&&S.own[C]===f;k++){const t=X.foeUnits[Math.floor(Math.random()*X.foeUnits.length)];S.gold[f]-=UT[t].cost;
      const g=S.armies.find(a=>a.side===f&&!a.dead&&!a.g&&a.at===NI[C]&&!a.legs.length);if(g&&g.units.length<MAXU)g.units.push({t,men:UT[t].men});else scenArmy(f,C,[[t,1]],X.foeGens[Math.floor(Math.random()*X.foeGens.length)])}
    for(const a of S.armies){if(a.side!==f||a.dead||a.g||a.legs.length||a.units.length>=5)continue;const o=S.armies.find(b=>b!==a&&b.side===f&&!b.dead&&!b.g&&b.units.length+a.units.length<=MAXU&&Math.hypot(b.x-a.x,b.y-a.y)<4);if(o){o.units.push(...a.units);a.units=[];a.dead=true}}
    S.armies=S.armies.filter(a=>!a.dead)}
  const key=X.keys.filter(id=>NI[id]!=null&&S.own[id]==='car').length;
  if(S.own[X.cap]!=='car'){finish('lose',X.loseT[0],X.loseT[1]);return}
  if(key===X.keys.length&&!S.ev.pxWin){S.ev.pxWin=d;finish('win',X.winT[0],X.winT[1]);return}
  if(d>=17*360+60)finish('win',X.endT[0],X.endT[1])}
function pxPol(){const X=PX[S.peo],f=X.p218.foe;const key=X.keys.map(id=>NI[id]!=null?`${N[NI[id]].n} : ${S.own[id]==='car'?'<b style="color:var(--good)">à vous</b>':sideName(S.own[id])}`:'').filter(Boolean).join(' · ');
  const foeTxt=f==='rom'?`Rome : ${S.armies.filter(a=>a.side==='rom'&&!a.g&&!a.dead).length} armées en campagne.`:`${FAC[f]?FAC[f].n:f} : trésor ${Math.round(S.gold[f]||0)} or · ${N.filter(n=>!n.col&&S.own[n.id]===f).length} villes · ${S.armies.filter(a=>a.side===f&&!a.g&&!a.dead).reduce((s,a)=>s+a.units.length,0)} régiments.`;
  modal(`<h2>${X.n}</h2><p>${X.t}</p><h3>Objectif</h3><p class="sub">${key}</p><p class="sub">${X.goal} En 201, la guerre s'achève.</p><h3>L'ennemi</h3><p class="sub">${foeTxt}</p><p class="sub">Carthage : ${Math.round(S.gold.pun||0)} or · ${S.armies.filter(a=>a.side==='pun'&&!a.g).length} armées.</p><div class="row" style="justify-content:flex-end"><button class="go" id="mClose" type="button">Fermer</button></div>`);$('mClose').onclick=closeModal}
// Numidie : Rome ne vient en Afrique qu'avec Scipion (même calendrier que pour Carthage)
{const _chX=cityHostile;cityHostile=function(i,side){const r=_chX.apply(this,arguments);try{if(r&&pxOn()&&PX[S.peo].front&&side==='rom'&&ownerN(i)==='car'&&!macFront(N[i]))return false}catch(e){}return r}}
// Carthage alliée ne prend pas les villes du joueur, ni lui les siennes (tous les peuples alliés)
{const _chY=cityHostile;cityHostile=function(i,side){const r=_chY.apply(this,arguments);try{if(r&&isMac()){const o=ownerN(i);if(side==='pun'&&o==='car'||side==='car'&&o==='pun')return false}}catch(e){}return r}}
{const _hoY=hostile;hostile=function(a,b){if(S&&isMac()){const p=[a.side,b.side].sort().join();if(p==='car,pun')return false}return _hoY.apply(this,arguments)}}
// textes écrits pour Carthage : l'ennemi mineur (Syphax) assiège et pille à la place des Romains
{const _hoX=hostile;hostile=function(a,b){if(pxOn()&&PX[S.peo].romPeace){const p=[a.side,b.side].sort().join();if(p==='car,rom')return false}return _hoX.apply(this,arguments)}}
{const _chX2=cityHostile;cityHostile=function(i,side){const r=_chX2.apply(this,arguments);try{if(r&&pxOn()&&PX[S.peo].romPeace){const o=ownerN(i);if(side==='rom'&&o==='car'||side==='car'&&o==='rom')return false}}catch(e){}return r}}
{const _logX=log;log=function(t){try{if(pxOn()&&typeof t==='string'){const f=PX[S.peo].p218.foe;if(f!=='rom'&&FAC[f])t=t.replace(/Les Romains (pillent|coupent|assiègent)/g,`Les ${PX[S.peo].foeN||FAC[f].n} $1`)}}catch(e){}return _logX.apply(this,[t].concat([].slice.call(arguments,1)))}}
{const _dX=daily;daily=function(d){const r=_dX.apply(this,arguments);try{if(pxOn()){pxDaily(d);if(d%30===0)pxMonthly(d)}}catch(e){console.error(e)}return r}}
// alliés de Rome (Pergame, Massalia) : les espions qui vous visent sont ceux de l'ennemi, pas de Rome
{const _logA=log;log=function(t){try{if(pxOn()&&PX[S.peo].romPeace&&PX[S.peo].foeAdj&&typeof t==='string'){const A=PX[S.peo].foeAdj;t=t.replace(/agents romains/g,'agents '+A[0]).replace(/espion romain/g,'espion '+A[1]).replace(/secrets de Rome/g,'secrets '+A[2])}}catch(e){}return _logA.apply(this,[t].concat([].slice.call(arguments,1)))}}
{const _hoM=hostile;hostile=function(a,b){if(S&&pxOn()&&PX[S.peo].p218.foe==='pun'&&!S.peace){const p=[a.side,b.side].sort().join();if(p==='car,pun')return true}return _hoM.apply(this,arguments)}}
{const _chM=cityHostile;cityHostile=function(i,side){try{if(S&&pxOn()&&PX[S.peo].p218.foe==='pun'&&!S.peace){const o=ownerN(i);if(side==='pun'&&o==='car'||side==='car'&&o==='pun')return true}}catch(e){}return _chM.apply(this,arguments)}}

/* ---------- 13. TRAITÉS DE PAIX NÉGOCIÉS ---------- */
// Fenêtre Politique → « Négocier la paix » : provinces exigées ou cédées, tribut, indemnité, otages, flotte limitée.
// L'ennemi accepte si ce qu'on lui demande ne dépasse pas ce que la guerre justifie (score de guerre). La paix signée termine la campagne.
const PZ_CAPS=new Set(['roma','carthago','pella','syracusae','athenae','siga','cirta','mediolanum']);
function pzFoe(){if(!S||S.over)return null;if(isMac()){if(S.peace)return null;const k=S.peo;return k==='ath'?'mac':PX[k]?PX[k].p218.foe:'rom'}return 'rom'}
function pzScore(){if(!isMac())return warScore().v;const f=pzFoe(),my=N.filter(n=>!n.col&&ownerN(n.i)==='car').length,fo=N.filter(n=>!n.col&&ownerN(n.i)===f).length;
  if(!S.pz0||S.pz0.f!==f)S.pz0={f,my,fo,v:S.vict||0,d:S.defeats||0};const Z=S.pz0;
  return Math.max(-100,Math.min(100,6*((S.vict||0)-Z.v)-6*((S.defeats||0)-Z.d)+6*(Z.fo-fo)-6*(Z.my-my)))}
const pzTownV=n=>(n.size+1)*4;
function pzRegions(side){const R={};for(const n of N){if(n.col||ownerN(n.i)!==side||PZ_CAPS.has(n.id))continue;const r=regOf(n)||'?';(R[r]=R[r]||[]).push(n.i)}
  return Object.entries(R).map(([r,L])=>({r,L,v:L.reduce((s,i)=>s+pzTownV(N[i]),0)})).sort((a,b)=>b.v-a.v)}
function pzBal(T){let b=0;for(const x of T.dem)b+=x.v;for(const x of T.ced)b-=x.v;b+=T.trib*10+T.ind*8+(T.host?5:0)+(T.fleet?10:0);return b}
function openTreaty(){const f=pzFoe();if(!f)return;const fn=sideName(f),score=pzScore(),lim=Math.round(score*.8+5);
  const DEM=pzRegions(f),CED=pzRegions('car');const T={dem:new Set(),ced:new Set(),trib:0,ind:0,host:false,fleet:false};
  const hasFleet=(S.fleets||[]).some(x=>x.side===f);
  const chip=(id,t,on,tt)=>`<button type="button" data-pz="${id}" class="${on?'on':''}" title="${tt||''}" ${on?'style="outline:2px solid #d8b56a;color:#fff3c4"':''}>${on?'✓ ':''}${t}</button>`;
  const draw=()=>{const b=pzBal(T),ok=b<=lim,cool=S.pzT&&S.day<S.pzT;
    const verdict=ok?(b<lim-15?`<b style="color:var(--good)">${fn} acceptera sans hésiter.</b>`:`<b style="color:var(--good)">${fn} devrait accepter.</b>`):`<b style="color:var(--bad,#c0543a)">${fn} refusera : c'est plus que la guerre ne justifie.</b>`;
    modal(`<h2>Négocier la paix avec ${esc(fn)}</h2><p class="sub">Score de guerre ${score} : ${fn} accepte des conditions qui valent jusqu'à ${lim} points. Signer la paix met fin à la campagne.</p>
      <div class="stH">Vous exigez</div><div class="chips" style="display:flex;flex-wrap:wrap;gap:4px">${DEM.slice(0,14).map((x,k)=>chip('d'+k,`${esc(x.r)} (${x.L.length} v. · ${x.v})`,T.dem.has(x),x.L.map(i=>N[i].n).join(', '))).join('')||'<span class="sub">Aucune province à exiger.</span>'}</div>
      <div class="stH">Vous cédez</div><div class="chips" style="display:flex;flex-wrap:wrap;gap:4px">${CED.slice(0,14).map((x,k)=>chip('c'+k,`${esc(x.r)} (${x.L.length} v. · −${x.v})`,T.ced.has(x),x.L.map(i=>N[i].n).join(', '))).join('')||'<span class="sub">Rien à céder.</span>'}</div>
      <div class="stH">Clauses</div><div class="chips" style="display:flex;flex-wrap:wrap;gap:4px">${chip('t1','Tribut reçu, 30 or par an (10)',T.trib===1)}${chip('t-1','Tribut payé, 30 or par an (−10)',T.trib===-1)}${chip('i1','Indemnité reçue, 200 or (8)',T.ind===1)}${chip('i-1','Indemnité payée, 200 or (−8)',T.ind===-1)}${chip('h','Otages livrés (5)',T.host)}${hasFleet?chip('f','Flotte ennemie limitée à 10 navires (10)',T.fleet):''}</div>
      <p style="margin-top:10px">Vos conditions valent <b>${b}</b> points sur ${lim} acceptables. ${verdict}</p>
      <div class="row" style="justify-content:flex-end"><button id="pzNo" type="button">Fermer</button><button class="go" id="pzGo" type="button" ${cool?'disabled':''}>${cool?`Ambassade possible dans ${Math.ceil(S.pzT-S.day)} jours`:'Envoyer les ambassadeurs'}</button></div>`);
    document.querySelectorAll('[data-pz]').forEach(e=>e.onclick=()=>{const id=e.dataset.pz;
      if(id[0]==='d'){const x=DEM[+id.slice(1)];T.dem.has(x)?T.dem.delete(x):T.dem.add(x)}else if(id[0]==='c'){const x=CED[+id.slice(1)];T.ced.has(x)?T.ced.delete(x):T.ced.add(x)}
      else if(id[0]==='t'){const v=+id.slice(1);T.trib=T.trib===v?0:v}else if(id[0]==='i'){const v=+id.slice(1);T.ind=T.ind===v?0:v}else if(id==='h')T.host=!T.host;else if(id==='f')T.fleet=!T.fleet;draw()});
    $('pzNo').onclick=closeModal;$('pzGo').onclick=()=>{if(pzBal(T)<=lim)pzSign(f,T,b);else{S.pzT=Math.floor(S.day)+60;closeModal();log(`${fn} renvoie vos ambassadeurs : ces conditions sont inacceptables. Pas de nouvelle ambassade avant deux mois.`)}}};
  draw()}
function pzSign(f,T,b){const fn=sideName(f),me=sideName('car');
  const move=(L,to)=>{const from=to==='car'?f:'car';for(const i of L){S.armies=S.armies.filter(a=>!(a.g&&a.at===i&&a.side===from))}setOwn(L.map(i=>N[i].id),to)};
  for(const x of T.dem)move(x.L,'car');for(const x of T.ced)move(x.L,f);
  if(T.ind===1){const g=Math.min(200,Math.max(0,S.gold[f]||0));S.gold[f]=(S.gold[f]||0)-g;S.gold.car+=200}else if(T.ind===-1)S.gold.car=Math.max(0,S.gold.car-200);
  if(T.fleet)for(const fl of (S.fleets||[]).filter(x=>x.side===f).slice(10))fl.dead=true;
  const L=[];if(T.dem.size)L.push(`${fn} vous cède ${[...T.dem].map(x=>x.r).join(', ')}`);if(T.ced.size)L.push(`vous cédez ${[...T.ced].map(x=>x.r).join(', ')}`);
  if(T.trib===1)L.push(`${fn} vous paiera tribut`);if(T.trib===-1)L.push(`vous paierez tribut à ${fn}`);if(T.ind===1)L.push(`${fn} verse une indemnité de 200 or`);if(T.ind===-1)L.push(`vous versez une indemnité de 200 or`);
  if(T.host)L.push(`${fn} livre des otages`);if(T.fleet)L.push(`la flotte de ${fn} est limitée à dix navires`);
  const txt=(L.length?L.join(' ; ')+'.':"La paix est signée sur les positions actuelles.")+` Bilan du traité : ${b} points.`;
  closeModal();log(`Paix signée entre ${me} et ${fn}.`);
  if(b>=15)finish('win','Paix victorieuse',txt);else if(b<=-15)finish('lose','Paix de résignation',txt);else finish('win','Paix de compromis',txt)}
// point de départ du score des peuples alliés : le premier jour de guerre
{const _dZ=daily;daily=function(d){const r=_dZ.apply(this,arguments);try{if(S&&isMac()&&!S.over&&pzFoe()&&(!S.pz0||S.pz0.f!==pzFoe()))pzScore()}catch(e){}return r}}
// la fenêtre Politique propose la négociation pendant la guerre
{const _opZ=openPol;openPol=function(){const r=_opZ.apply(this,arguments);try{const f=pzFoe();if(f){const C=$('mcard');if(C&&!$('pzOpen')){const el=document.createElement('div');el.className='rec';
    el.innerHTML=`<span><b>Négocier la paix avec ${esc(sideName(f))}</b><br><span class="sub">Provinces, tribut, indemnité, otages : composez vos conditions. Score de guerre ${pzScore()}.</span></span><button class="go" id="pzOpen" type="button">Négocier</button>`;
    const h=C.querySelectorAll('h3')[1],rows=C.querySelectorAll('.row'),row=rows[rows.length-1];const at=h||row;if(at)at.parentNode.insertBefore(el,at);else C.appendChild(el);$('pzOpen').onclick=openTreaty}}}catch(e){console.error(e)}return r}}

/* ---------- 10. ÉCRAN DE DÉPART : le pays, la date, la difficulté ---------- */
const BOOT_SKIP=(()=>{try{return location.hash.startsWith('#r=')||!!sessionStorage.getItem('bellum.scenPend')}catch(e){return false}})();
const START_PEO=[
  {k:'car',n:'Carthage',c:'#7d4fb8',l:'<svg viewBox="-10 -10 20 20" width="24" height="24" fill="#f4ead2"><circle cy="-6.2" r="2.4"/><path d="M-5.5 -3 h11 v1.4 h-11z"/><path d="M0 -2.2 L4.8 7 H-4.8Z"/></svg>',t:"Hannibal porte la guerre en Italie. Prenez Rome."},
  {k:'rom',n:'Rome',c:'#bf3b31',l:'R',t:"Le Sénat face à Hannibal. Tenez l'Italie, puis frappez Carthage."},
  {k:'mac',n:'Macédoine',c:'#c8962e',l:'Μ',t:"Philippe V, allié d'Hannibal. Chassez Rome d'Illyrie."},
  {k:'syr',n:'Syracuse',c:'#3f78c0',l:'Σ',t:"Hippocrate et Épicyde contre Marcellus, avec Archimède."},
  {k:'ath',n:'Athènes',c:'#6f9a4a',l:'Α',t:"Avec les Étoliens et Attale, contre Philippe V. Libérez la Grèce."},
  {k:'num',n:'Numidie',c:'#b07a3a',l:'Ν',t:"Gaïa et Massinissa, cavaliers d'Afrique. Battez Syphax."},
  {k:'ins',n:'Gaulois cisalpins',c:'#2f8a7a',l:'G',t:"Insubres et Boïens. Chassez Rome de la plaine du Pô."},
  {k:'per',n:'Pergame',c:'#4a56a8',l:'Π',t:"Attale Ier, allié de Rome, avec sa flotte. Brisez les entraves de Philippe V."},
  {k:'mas',n:'Massalia',c:'#2c5d9e',l:'Μ',t:"La cité des Phocéens, alliée de Rome. Chassez Carthage de l'Ibérie."}];
const startDates=k=>P218[k]?[{k:'218',n:P218[k].n,d:P218[k].t}].concat(startDates0(k)):startDates0(k);
const startDates0=k=>PX&&PX[k]?[]:k==='mac'?[{k:'mac',n:'215 : Philippe V et Hannibal',d:MAC_TXT}]:k==='syr'?[{k:'syr',n:'214 : Syracuse rompt avec Rome',d:SYR_TXT}]:k==='ath'?[{k:'ath',n:'209 : Athènes contre Philippe V',d:ATH_TXT}]:Object.keys(SCEN).sort((a,b)=>b-a).map(x=>({k:x,n:SCEN[x].n,d:SCEN[x].d}));
function startCamp(){if(!S)return '';return S.peo==='mac'?'Macédoine':S.peo==='syr'?'Syracuse':S.peo==='ath'?'Athènes':PX&&PX[S.peo]?PX[S.peo].n:S.mirror?'Rome':'Carthage'}
function openStart(){let peo=S&&(S.peo||(S.mirror?'rom':'car'))||'car',date='218',df=(S&&S.diff)||'normal';const canGo=S&&(S.started||S.day>0)&&!S.over;
  const draw=()=>{const D=startDates(peo);if(!D.some(x=>x.k===date))date=D[0].k;const c=cal(S.day);
    modal(`<h2 style="margin-bottom:2px">Roma Delenda Est</h2><p class="sub" style="margin-top:0">La deuxième guerre punique, 218 à 201 av. J.-C.</p>
    ${canGo?`<div class="rec" style="border:1px solid var(--line);border-radius:6px;padding:8px 10px;margin:10px 0"><span><b>Continuer la partie</b><br><span class="sub">${startCamp()} · ${c.season.toLowerCase()} ${c.year} av. J.-C.</span></span><button class="go" id="stCont" type="button">Continuer</button></div>`:''}
    <div class="stH">Votre pays</div>
    <div id="stPeo" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px">${START_PEO.map(p=>`<button type="button" data-peo="${p.k}" style="display:flex;gap:10px;align-items:center;text-align:left;padding:10px;min-height:64px;${peo===p.k?`border-color:${p.c};background:${p.c}33;box-shadow:inset 0 0 0 1px ${p.c}`:''}">
      ${PEO_EMB(p.k,56)}
      <span><b style="font-size:16px">${p.n}</b><br><span class="sub">${p.t}</span></span></button>`).join('')}</div>
    <div class="stH">La date</div>
    <div id="stDate">${D.map(x=>`<button type="button" data-date="${x.k}" style="display:block;width:100%;text-align:left;margin:0 0 6px;padding:8px 10px;${date===x.k?'border-color:var(--gold);background:rgba(214,184,120,.22)':''}"><b>${x.n}</b><br><span class="sub">${x.d}</span></button>`).join('')}</div>
    <div class="stH">Difficulté</div>${difRow(df,'stDif')}
    <div class="row" style="justify-content:space-between;margin-top:14px"><span class="row" style="margin:0">${$('mpTag')?'<button id="stMp" type="button">Jouer à plusieurs</button>':''}<button id="stHelp" type="button">Comment jouer</button></span><button class="go" id="stGo" type="button">Commencer</button></div>`);
    $('mcard').classList.add('wide');$('modal').style.background='rgba(10,8,5,.86)';
    document.querySelectorAll('#stPeo [data-peo]').forEach(b=>b.onclick=()=>{peo=b.dataset.peo;draw()});
    document.querySelectorAll('#stDate [data-date]').forEach(b=>b.onclick=()=>{date=b.dataset.date;draw()});
    document.querySelectorAll('#stDif [data-dif]').forEach(b=>b.onclick=()=>{df=b.dataset.dif;draw()});
    if($('stCont'))$('stCont').onclick=()=>{closeModal();const h=S.armies.find(a=>a.side==='car'&&!a.g&&!a.dead);if(h)centerOn(h.x,h.y,1.1)};
    if($('stMp'))$('stMp').onclick=()=>{closeModal();$('mpTag').click()};
    $('stHelp').onclick=openHelp;
    $('stGo').onclick=()=>{if(P218[peo]&&date==='218')scenGo(()=>startPeo218(peo,df),peo,'218',df);else if(peo==='mac')scenGo(()=>startMac(df),'mac','mac',df);else if(peo==='syr')scenGo(()=>startSyr(df),'syr','syr',df);else if(peo==='ath')scenGo(()=>startAth(df),'ath','ath',df);
      else scenGo(()=>startScen(date,peo,df),date,peo,df)}};
  draw()}
{const st=document.createElement('style');st.textContent='#mcard .stH{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:16px 0 6px;font-weight:500}';document.head.appendChild(st)}
{const _cmSt=closeModal;closeModal=function(){try{$('modal').style.background=''}catch(e){}return _cmSt.apply(this,arguments)}}
// une partie romaine (tables en miroir) se recharge aussi avant de changer de pays
{const _alR=afterLoad;afterLoad=function(){const r=_alR.apply(this,arguments);if(S&&S.mirror&&!peoDone)peoDone='rom';return r}}
{const _mgR=mirrorGame;mirrorGame=function(){const r=_mgR.apply(this,arguments);if(!peoDone)peoDone='rom';return r}}
// au lancement : l'écran de départ remplace l'ancienne introduction (sauf au retour d'une bataille 3D ou d'un rechargement de scénario)
/* ---------- 14. IA CARTHAGINOISE PLUS ACTIVE QUAND ON JOUE ROME ---------- */
// Hasdrubal quitte l'Hispanie si Rome n'y envoie personne ; Carthage débarque des renforts (Bomilcar à Locres, Hasdrubal le Chauve en Sardaigne,
// Himilcon en Sicile, Magon en Ligurie) : une armée qui attend à Carthage embarque, sinon le trésor de l'IA paie l'expédition.
const MX=[
  {k:'bomil',d:1080,until:2200,name:'Bomilcar',cost:110,ids:['locri','croton','rhegium'],spec:[['lib',3],['ncav',2],['eleph',2]],
    cond:()=>{const H=mxHanni();return H&&inItaly(H.x,H.y)},
    txt:(n,g)=>`Une flotte carthaginoise trompe la surveillance : ${g} débarque à ${n} avec des renforts pour Hannibal.`},
  {k:'sard',d:1140,until:2300,name:'Hasdrubal le Chauve',cost:140,ids:['caralis','tharros','sulci','olbia'],spec:[['lib',4],['iber',2],['ncav',2],['sling',1]],
    cond:()=>mxIds(['caralis','tharros','sulci','olbia']).some(i=>ownerN(i)==='car'),
    txt:(n,g)=>`Les Sardes se soulèvent : ${g} débarque à ${n} pour leur prêter main-forte.`},
  {k:'sic',d:1740,until:2900,name:'Himilcon',cost:170,ids:['agrigentum','lilybaeum'],spec:[['lib',5],['iber',2],['ncav',3],['eleph',1]],
    cond:()=>N.filter(n=>!n.col&&inSic(n.x,n.y)&&ownerN(n.i)==='car').length>=2,
    txt:(n,g)=>`${g} débarque en Sicile à ${n} avec une grande armée : Carthage veut reprendre l'île.`},
  {k:'lig',d:4920,until:5600,name:'Magon',cost:130,ids:['genua'],spec:[['lib',3],['iber',3],['ncav',2]],
    cond:()=>true,txt:(n,g)=>`${g} débarque à ${n} et lève les Ligures et les Gaulois contre Rome.`}];
function mxIds(ids){return ids.map(id=>NI[id]).filter(i=>i!=null)}
function mxAI(){return sideOfReal('car')}
function mxHanni(){return S.armies.find(x=>x.side===mxAI()&&x.name==='Hannibal'&&!x.dead)}
let SARD=null;function inSard(x,y){if(!SARD){const P=mxIds(['caralis','tharros','sulci','olbia']).map(i=>N[i]);if(!P.length)return false;
  SARD={x0:Math.min(...P.map(p=>p.x))-40,x1:Math.max(...P.map(p=>p.x))+40,y0:Math.min(...P.map(p=>p.y))-40,y1:Math.max(...P.map(p=>p.y))+40}}
  return x>SARD.x0&&x<SARD.x1&&y>SARD.y0&&y<SARD.y1}
function mxLand(e){const side=mxAI(),cands=mxIds(e.ids);if(!cands.length)return null;
  const foeAt=i=>S.armies.filter(x=>!x.dead&&!x.ship&&x.side!==side&&hostileSides(x.side,side)&&Math.hypot(x.x-N[i].x,x.y-N[i].y)<(x.g?6:30)).reduce((s,x)=>s+strength(x),0);
  // d'abord une ville amie ou neutre, sinon la place ennemie la moins défendue (débarquement de vive force)
  const H=e.k==='bomil'?mxHanni():null,dist=i=>H?Math.hypot(N[i].x-H.x,N[i].y-H.y):0;
  const ok=cands.filter(i=>!cityHostile(i,side)).sort((a,b)=>dist(a)-dist(b));if(ok.length)return ok[0];
  return cands.slice().sort((a,b)=>foeAt(a)-foeAt(b)||dist(a)-dist(b))[0]}
function mxDaily(d){if(!S.mirror||S.over||S.cur||S.auto)return;S.mx=S.mx||{};const side=mxAI();
  for(const e of MX){if(S.mx[e.k]||d<e.d)continue;if(d>e.until){S.mx[e.k]=-1;continue}
    if(d%15!==0)continue;if(!e.cond())continue;
    const i=mxLand(e);if(i==null){S.mx[e.k]=-1;continue}
    // une armée qui attend à Carthage embarque (sauf Giscon, qui garde la ville) ; sinon Carthage lève l'expédition
    const C=NI.carthago,idle=S.armies.filter(x=>x.side===side&&!x.dead&&!x.g&&!x.ship&&!x.legs.length&&x.at===C&&!/Giscon/.test(x.name)&&!x.mxk&&x.units.length>=4);
    let a=idle.find(x=>x.name===e.name)||idle.sort((x,y)=>y.units.length-x.units.length)[0];
    if(a){a.x=N[i].x;a.y=N[i].y;a.at=i;a.legs=[];a.target=null;a.ai=null}
    else{S.gold[side]=Math.max(0,(S.gold[side]||0)-e.cost);a=scenArmy(side,N[i].id,e.spec,e.name,{mor:75})}
    if(!a){S.mx[e.k]=-1;continue}a.mxk=e.k;
    S.mx[e.k]=Math.floor(d);try{if(typeof genInit==='function')genInit()}catch(x){}
    log(e.txt(N[i].n,a.name));try{arrive(a)}catch(x){console.error(x)}
    if(cityHostile(i,side))S.paused=true}}
{const _ahX=aiHist;aiHist=function(side,a){
  if(S&&S.mirror&&side===mxAI()&&!a.g&&!a.ship){const d=S.day;
    // Hasdrubal : si aucune armée romaine (4 unités ou plus) ne tient l'Hispanie, il part rejoindre Hannibal dès 217
    if(a.name==='Hasdrubal'&&d>=600&&d<3200){const pin=S.armies.some(x=>x.side==='car'&&!x.dead&&!x.g&&!x.ship&&x.units.length>=4&&inIber(x.x,x.y));
      if(!pin){if(inItaly(a.x,a.y))return {ok:(x,y)=>inItaly(x,y)};const H=mxHanni();
        if(H&&inItaly(H.x,H.y)){const n=nearestNode(H.x,H.y,n=>!n.col&&!cityHostile(n.i,side));if(n)return {go:n.i}}
        return NI.mediolanum!=null?{go:NI.mediolanum}:null}}
    if(a.mxk==='bomil')return {ok:(x,y)=>inItaly(x,y)};
    if(a.mxk==='sard')return inSard(a.x,a.y)?{ok:inSard}:null;
    if(a.mxk==='sic')return inSic(a.x,a.y)?{ok:inSic}:null}
  return _ahX.apply(this,arguments)}}
{const _dMX=daily;daily=function(d){const r=_dMX.apply(this,arguments);try{mxDaily(Math.floor(d))}catch(e){console.error(e)}return r}}
/* ---------- 15. COORDINATION AVEC HANNIBAL (peuples alliés) ---------- */
// Faveur auprès de Carthage (S.cd.fav) : or ou mercenaires envoyés, demande d'offensive sur une région, subsides, traité d'alliance (clauses au choix).
const CD_CL={sub:{n:'Subsides puniques',d:'Carthage vous verse 25 or par mois.'},
  fleet:{n:'Flotte punique contre le commerce romain',d:'Rome perd 15 or par mois tant que dure la guerre.'},
  sep:{n:'Pas de paix séparée',d:'Rome vous craint davantage : +8 au score de guerre pour négocier.'},
  share:{n:'Partage des conquêtes',d:''}};
function cdOn(){return S&&isMac()&&S.peo!=='ath'&&S.peo!=='per'&&S.peo!=='mas'&&!S.over&&S.armies.some(a=>a.side==='pun'&&!a.dead&&!a.g)}
function cdInit(){S.cd=S.cd||{fav:30,req:null,tr:null};return S.cd}
function cdZone(){const k=S.peo;return k==='mac'?(n=>n.lon>=18.4):k==='syr'?(n=>inSic(n.x,n.y)):k==='ins'?(n=>n.lat>=43.9&&n.lon<13.6):k==='num'?(n=>n.lat<37.6&&n.lon<9.2):(()=>false)}
function cdZoneTxt(){const k=S.peo;return k==='mac'?"les villes d'Illyrie et de Grèce prises par Carthage vous reviennent":k==='syr'?'les villes de Sicile prises par Carthage vous reviennent':k==='ins'?'les villes de Cisalpine prises par Carthage vous reviennent':'les villes de Numidie et de Maurétanie prises par Carthage vous reviennent'}
function cdPay(fn){try{if(typeof mpdWith==='function')return mpdWith(null,fn)}catch(e){}return fn()}
function cdHanni(){return S.armies.find(a=>a.side==='pun'&&!a.dead&&!a.g&&a.name==='Hannibal')}
function cdRegions(){const R={};for(const n of N){if(n.col||!cityHostile(n.i,'pun'))continue;const o=ownerN(n.i);if(o!=='rom'&&!(PX&&PX[S.peo]&&o===PX[S.peo].foe))continue;
    const r=regOf(n)||'?';(R[r]=R[r]||[]).push(n.i)}
  // l'armée punique qui arrive le plus vite par la terre (Hannibal en Italie, une autre en Afrique ou en Hispanie)
  const A=S.armies.filter(a=>a.side==='pun'&&!a.dead&&!a.g&&!a.ship&&a.units.length>=4).map(a=>{let D=null;try{D=dijkstra(a,startsOf(a)).dist}catch(e){}return {a,D}}).filter(x=>x.D);
  return Object.entries(R).map(([r,L])=>{let best=null,bd=1e9;for(const x of A)for(const i of L){const v=x.D[i];if(v<bd){bd=v;best=x.a}}return {r,L,a:best,days:bd}})
    .filter(x=>x.a&&x.days<1e8).sort((p,q)=>p.days-q.days).slice(0,10)}
function cdAsk(x){const C=cdInit();if(C.fav<30)return 'Votre crédit auprès de Carthage est trop faible.';
  const i=x.L.slice().sort((p,q)=>Math.hypot(N[p].x-x.a.x,N[p].y-x.a.y)-Math.hypot(N[q].x-x.a.x,N[q].y-x.a.y))[0];
  let P=null;try{P=plan(x.a,0,0,i)}catch(e){}if(!P)return `${x.a.name} ne peut pas atteindre ${x.r} par la terre.`;
  C.fav-=30;C.req={a:x.a.id,r:x.r,L:x.L.slice(),until:Math.floor(S.day)+Math.round(x.days||0)+120};x.a.ai=null;
  log(`${x.a.name} accepte de porter la guerre en ${x.r} à votre demande.`);return ''}
function cdReqNodes(){const C=S.cd;if(!C||!C.req)return null;return C.req.L.filter(i=>cityHostile(i,'pun'))}
{const _ahC=aiHist;aiHist=function(side,a){
  if(S&&side==='pun'&&isMac()&&S.cd&&S.cd.req&&a.id===S.cd.req.a&&!a.g&&!a.ship){const R=cdReqNodes();
    if(R&&R.length&&S.day<S.cd.req.until){const near=R.some(i=>Math.hypot(N[i].x-a.x,N[i].y-a.y)<60);
      if(near)return {ok:(x,y)=>R.some(i=>N[i].x===x&&N[i].y===y)};
      const t=R.slice().sort((p,q)=>Math.hypot(N[p].x-a.x,N[p].y-a.y)-Math.hypot(N[q].x-a.x,N[q].y-a.y))[0];return {go:t}}}
  return _ahC.apply(this,arguments)}}
function cdMonthly(){if(!S.cd||!isMac()||S.peo==='ath'||S.peo==='per'||S.peo==='mas')return;const C=S.cd;
  if(!S.peace)C.fav=Math.min(100,C.fav+2);
  if(C.req){const R=cdReqNodes(),a=S.armies.find(x=>x.id===C.req.a&&!x.dead);
    if(!a){log(`L'armée chargée de l'offensive en ${C.req.r} n'existe plus.`);C.req=null}
    else if(R&&!R.length){log(`${a.name} a soumis ${C.req.r}, comme promis. Carthage vous en sait gré.`);C.fav=Math.min(100,C.fav+5);C.req=null}
    else if(S.day>=C.req.until){log(`${a.name} met fin à l'offensive en ${C.req.r}.`);C.req=null}}
  if(C.tr&&!S.peace&&!S.over){if(C.tr.includes('sub')){const g=Math.min(25,Math.max(0,S.gold.pun||0));S.gold.pun=(S.gold.pun||0)-g;cdPay(()=>{S.gold.car+=25})}
    if(C.tr.includes('fleet')&&S.gold.rom!=null)S.gold.rom=Math.max(0,S.gold.rom-15)}}
{const _cpC=capture;capture=function(i,side){const r=_cpC.apply(this,arguments);
  try{if(side==='pun'&&S.cd&&S.cd.tr&&S.cd.tr.includes('share')&&isMac()&&cdZone()(N[i])&&ownerN(i)==='pun'){setOwn([N[i].id],'car');log(`Selon le traité, Carthage vous remet ${N[i].n}.`)}}catch(e){console.error(e)}return r}}
{const _pzC=pzScore;pzScore=function(){const v=_pzC.apply(this,arguments);return S&&S.cd&&S.cd.tr&&S.cd.tr.includes('sep')&&isMac()?v+8:v}}
function openCoord(msg){const C=cdInit(),H=cdHanni(),war=!S.peace;const regs=cdRegions(),R=cdReqNodes();
  const btn=(id,t,dis,tt)=>`<button type="button" id="${id}" ${dis?'disabled':''} title="${tt||''}">${t}</button>`;
  const hist=S.peo==='mac'?'En 215, Philippe V et Hannibal ont juré une alliance contre Rome.':S.peo==='syr'?'En 215, Hiéronyme de Syracuse traite avec Hannibal et Carthage.':'Carthage cherche des alliés contre Rome.';
  modal(`<h2>Hannibal et Carthage</h2>${msg?`<p><b>${esc(msg)}</b></p>`:''}
    <p class="sub">${H?`Hannibal est à ${esc((nearestNode(H.x,H.y,n=>!n.col)||{n:'?'}).n)} avec ${H.units.length} régiments.`:'Hannibal n\'a plus d\'armée en campagne.'} Trésor de Carthage : ${Math.round(S.gold.pun||0)} or.</p>
    <p>Crédit auprès de Carthage : <b>${Math.round(C.fav)}</b> / 100 <span class="sub">(+2 par mois de guerre, plus vos envois)</span></p>
    <div class="stH">Aider Carthage</div><div class="row" style="flex-wrap:wrap;gap:6px">
      ${btn('cdGold','Envoyer 100 or (+15)',S.gold.car<100)}${btn('cdMerc','Payer 3 régiments de mercenaires à Hannibal, 150 or (+20)',S.gold.car<150||!H||H.units.length>MAXU-3)}</div>
    <div class="stH">Demander une offensive (30 de crédit ; la marche, puis quatre mois sur place)</div>
    ${C.req?`<p class="sub">En cours : ${esc((S.armies.find(x=>x.id===C.req.a)||{name:'?'}).name)} en ${esc(C.req.r)}, ${R?R.length:0} place(s) à prendre, encore ${Math.max(0,Math.ceil(C.req.until-S.day))} jours.</p>`:
      `<div class="chips" style="display:flex;flex-wrap:wrap;gap:4px">${regs.map((x,k)=>`<button type="button" data-cd="${k}" ${C.fav<30?'disabled':''} title="${esc(x.L.map(i=>N[i].n).join(', '))}">${esc(x.r)} · ${esc(x.a.name)}, ${Math.round(x.days)} j</button>`).join('')||'<span class="sub">Aucune région ennemie à portée.</span>'}</div>`}
    <div class="stH">Demander de l'or</div><div class="row">${btn('cdSub','Subsides : 120 or (40 de crédit)',C.fav<40||(S.gold.pun||0)<120)}</div>
    <div class="stH">Traité d'alliance</div>
    ${C.tr?`<p class="sub">Signé : ${C.tr.map(k=>CD_CL[k].n).join(', ')}.</p>`:war?`<p class="sub">${hist} Choisissez deux clauses ; Hannibal demande 100 or pour sceller le traité.</p><div class="chips" style="display:flex;flex-wrap:wrap;gap:4px">${Object.keys(CD_CL).map(k=>`<button type="button" data-cl="${k}" title="${esc(k==='share'?cdZoneTxt():CD_CL[k].d)}">${CD_CL[k].n}</button>`).join('')}</div><p class="sub" id="cdClTxt">Aucune clause choisie.</p><div class="row">${btn('cdSign','Sceller le traité (100 or)',true)}</div>`:'<p class="sub">Le traité se négocie quand vous êtes en guerre contre Rome.</p>'}
    <div class="row" style="justify-content:flex-end"><button class="go" id="cdClose" type="button">Fermer</button></div>`);
  $('cdClose').onclick=closeModal;
  const g=$('cdGold');if(g)g.onclick=()=>{cdPay(()=>{S.gold.car-=100});S.gold.pun=(S.gold.pun||0)+100;C.fav=Math.min(100,C.fav+15);log('Vous envoyez 100 or à Carthage.');openCoord()};
  const m=$('cdMerc');if(m)m.onclick=()=>{const H2=cdHanni();if(!H2)return;cdPay(()=>{S.gold.car-=150});for(const t of ['gaul','iber','ncav'])H2.units.push({t,men:UT[t].men});C.fav=Math.min(100,C.fav+20);log('Trois régiments de mercenaires payés par vous rejoignent Hannibal.');openCoord()};
  document.querySelectorAll('[data-cd]').forEach(e=>e.onclick=()=>{const er=cdAsk(regs[+e.dataset.cd]);openCoord(er)});
  const s=$('cdSub');if(s)s.onclick=()=>{C.fav-=40;S.gold.pun-=120;cdPay(()=>{S.gold.car+=120});log('Carthage vous envoie 120 or de subsides.');openCoord()};
  const pick=new Set();document.querySelectorAll('[data-cl]').forEach(e=>e.onclick=()=>{const k=e.dataset.cl;if(pick.has(k))pick.delete(k);else if(pick.size<2)pick.add(k);
    document.querySelectorAll('[data-cl]').forEach(b=>{const on=pick.has(b.dataset.cl);b.style.outline=on?'2px solid #d8b56a':'';b.textContent=(on?'✓ ':'')+CD_CL[b.dataset.cl].n});
    $('cdClTxt').textContent=pick.size?[...pick].map(k=>CD_CL[k].n+' : '+(k==='share'?cdZoneTxt():CD_CL[k].d)).join(' · '):'Aucune clause choisie.';$('cdSign').disabled=pick.size!==2||S.gold.car<100});
  const sg=$('cdSign');if(sg)sg.onclick=()=>{if(pick.size!==2||S.gold.car<100)return;cdPay(()=>{S.gold.car-=100});C.tr=[...pick];C.fav=Math.min(100,C.fav+10);
    log(`Traité d'alliance scellé avec Hannibal : ${C.tr.map(k=>CD_CL[k].n.toLowerCase()).join(' et ')}.`);openCoord()}}
{const _opC=openPol;openPol=function(){const r=_opC.apply(this,arguments);try{if(cdOn()){cdInit();const M=$('mcard');if(M&&!$('cdOpen')){const el=document.createElement('div');el.className='rec';
    el.innerHTML=`<span><b>Hannibal et Carthage</b><br><span class="sub">Crédit ${Math.round(S.cd.fav)} / 100 : aide, offensive concertée, subsides, traité d'alliance.</span></span><button class="go" id="cdOpen" type="button">Coordonner</button>`;
    const h=M.querySelectorAll('h3')[1],rows=M.querySelectorAll('.row'),row=rows[rows.length-1];const at=h||row;if(at)at.parentNode.insertBefore(el,at);else M.appendChild(el);$('cdOpen').onclick=()=>openCoord()}}}catch(e){console.error(e)}return r}}
{const _dCD=daily;daily=function(d){const r=_dCD.apply(this,arguments);try{if(Math.floor(d)%30===0&&S&&!S.over&&!S.cur)cdMonthly()}catch(e){console.error(e)}return r}}
/* ---------- 16. TERRITOIRE AU CLIC : le territoire de la ville cliquée, son maître, la diplomatie en un clic ---------- */
let RGC=null; // {r: nom de la région, wx, wy}
function rgcTowns(r){return N.filter(n=>!n.col&&regOf(n)===r)}
function rgcClose(){RGC=null;const c=$('rgCard');if(c)c.remove()}
function rgcOwnerName(o){return o==='car'||o==='rom'||o==='pun'?sideName(o):FAC[o]?FAC[o].n:o}
// point d'entrée unique « diplomatie avec ce peuple » (f, clé de S.fac) ou « avec ces alliés de Rome » (g, clé de SOCII) ; le fil diplomatie peut le remplacer
// par défaut : ouvre la diplomatie sur la ligne du peuple, bon onglet, ligne surlignée
function dipOpenFac(f,g){closeModal();openDip();
  setTimeout(()=>{try{const C=$('mcard');if(!C)return;const name=g?SOCII[g].n:(FAC[f]&&FAC[f].n);if(!name)return;
    const tr=[...C.querySelectorAll('tr')].find(t=>{const b=t.querySelector('td b');return b&&b.textContent===name});if(!tr)return;
    const pane=tr.closest('.ui-pane');if(pane&&pane.hidden){const panes=[...C.querySelectorAll('.ui-pane')],k=panes.indexOf(pane),bar=C.querySelector('.ui-tabs');if(bar&&bar.children[k])bar.children[k].click()}
    tr.style.outline='2px solid var(--bzL,#d2ae6c)';tr.style.background='rgba(210,174,108,.12)';tr.scrollIntoView({block:'center'})}catch(e){console.error(e)}},60)}
function rgcShow(mx,my){if(!S)return;const wx=(mx-view.ox)/view.s,wy=(my-view.oy)/view.s;
  if(!isLand(wx,wy)){rgcClose();return}const t=townAt(wx,wy);if(!t){rgcClose();return}const r=regOf(t)||'';
  // le territoire de la ville la plus proche (sa cellule), la région en sous-titre
  RGC={i:t.i,r,wx,wy};const o=ownerN(t.i)||'?',me='car';
  const col=FAC[o]&&FAC[o].c?`rgb(${FAC[o].c})`:'#888';let btn='';
  if(o===me)btn='<span class="sub">à vous</span>';
  else if(S.fac&&S.fac[o])btn=`<button type="button" data-rgf="${o}">Diplomatie</button>`;
  else if(o==='rom'){const g=Object.keys(SOCII).find(g=>SOCII[g].t[t.id]!=null);
    btn=g&&!S.mirror&&!isMac()?`<button type="button" data-rgs="${g}" title="Fidélité de ce peuple à Rome">Diplomatie : ${esc(SOCII[g].n)}</button>`:'<span class="sub">en guerre</span>'}
  else btn='<span class="sub">en guerre</span>';
  const kind=(typeof SIZE!=='undefined'&&SIZE[t.size])||'';
  let c=$('rgCard');if(!c){c=document.createElement('div');c.id='rgCard';document.body.appendChild(c)}
  c.style.cssText='position:fixed;z-index:30;max-width:330px;min-width:220px;background:var(--pan2,#231b14);color:var(--tx,#efe4cc);border:1px solid var(--bz,#8a6a3c);border-radius:6px;padding:8px 12px 10px;font-size:13px;box-shadow:0 6px 24px rgba(0,0,0,.45)';
  c.innerHTML=`<div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px"><b style="font-family:Marcellus,Georgia,serif;font-size:16px;letter-spacing:.04em">Territoire ${esc(deN(t.n))}</b><button type="button" id="rgX" title="Fermer" style="padding:0 6px">×</button></div><div class="sub" style="font-size:12px;margin-bottom:4px">${esc(kind)}${r?' · '+esc(r):''}</div><div style="display:flex;gap:8px;align-items:center;justify-content:space-between;margin:5px 0"><span><i style="display:inline-block;width:10px;height:10px;border-radius:2px;background:${col};margin-right:6px;vertical-align:-1px"></i><b>${esc(rgcOwnerName(o))}</b></span><span style="white-space:nowrap">${btn}</span></div>`;
  try{const pl=popLine(t);if(pl)c.insertAdjacentHTML('beforeend',pl.replace('<p class="sub">','<p class="sub" style="margin:4px 0 0;font-size:12px">'))}catch(e){}
  rgcPlace();
  $('rgX').onclick=rgcClose;
  c.querySelectorAll('[data-rgf]').forEach(b=>b.onclick=()=>{const f=b.dataset.rgf;rgcClose();dipOpenFac(f)});
  c.querySelectorAll('[data-rgs]').forEach(b=>b.onclick=()=>{const g=b.dataset.rgs;rgcClose();dipOpenFac(null,g)})}
// le clic gauche simple sur la carte (sans armée ni flotte choisie) montre la région
{let pd=null;cv.addEventListener('pointerdown',e=>{pd={x:e.clientX,y:e.clientY,b:e.button,t:e.pointerType}},true);
  cv.addEventListener('pointerup',e=>{const d=pd;pd=null;if(!d||d.b!==0||e.shiftKey||Math.hypot(e.clientX-d.x,e.clientY-d.y)>6)return;
    const rc=cv.getBoundingClientRect(),mx=e.clientX-rc.left,my=e.clientY-rc.top;
    setTimeout(()=>{try{if(sel&&sel.f){rgcClose();return}if(typeof GRP!=='undefined'&&GRP&&GRP.length>1){rgcClose();return}rgcShow(mx,my)}catch(x){console.error(x)}},0)})}
document.addEventListener('keydown',e=>{if(e.key==='Escape')rgcClose()});
/* 10 nov. (Baptiste) : plus de liste « Vos armées / Vos flottes » en bas à gauche quand rien n'est choisi ;
   la fiche de territoire se range en bas à gauche, au-dessus du panneau ouvert s'il y en a un. */
function rgcPlace(){const c=$('rgCard');if(!c)return;const sd=$('side'),H=window.innerHeight;
  const r=sd&&sd.style.display!=='none'&&sd.offsetHeight>0?sd.getBoundingClientRect():null;
  const left=r?r.left:10,bottom=r?Math.max(10,H-r.top+8):10;
  c.style.left=left+'px';c.style.top='auto';c.style.bottom=bottom+'px';c.style.width=(r?Math.max(240,r.width):330)+'px';c.style.maxWidth='none';
  c.style.maxHeight=Math.max(120,H-bottom-90)+'px';c.style.overflowY='auto'}
function sideIdle(){const sd=$('side');if(!sd)return;const idle=!sel&&!(typeof GRP!=='undefined'&&GRP&&GRP.length>1);
  sd.style.display=idle?'none':'';rgcPlace()}
setTimeout(()=>{const _rs=renderSide;renderSide=function(){const r=_rs.apply(this,arguments);try{sideIdle()}catch(e){console.error(e)}return r};try{sideIdle()}catch(e){}},150);
window.addEventListener('resize',()=>{try{rgcPlace()}catch(e){}});
try{const sd=$('side');if(sd&&window.ResizeObserver)new ResizeObserver(()=>{try{rgcPlace()}catch(e){}}).observe(sd)}catch(e){}
// contour du territoire cliqué : la cellule de la ville (CELL, coupée à la terre), teinte claire et bord
function drawRegionHL(s){if(!RGC||RGC.i==null||!CELL||!CELL[RGC.i]||!CELL[RGC.i].path)return;const P=new Path2D();P.addPath(CELL[RGC.i].path);
  ctx.save();ctx.setTransform(dpr*s,0,0,dpr*s,dpr*view.ox,dpr*view.oy);const land=s<5?landPath:landSmooth;
  ctx.save();ctx.clip(land);ctx.fillStyle='rgba(255,236,180,.22)';ctx.fill(P);ctx.restore();
  // bord : trait large, coupé à l'extérieur de la région (pair-impair avec un grand rectangle) et à la terre
  const O=new Path2D();O.rect(-1e5,-1e5,2e5,2e5);O.addPath(P);ctx.clip(land);ctx.clip(O,'evenodd');
  ctx.strokeStyle='rgba(255,226,150,.95)';ctx.lineWidth=7/s;ctx.lineJoin='round';ctx.stroke(P);ctx.restore()}
{const _ddR=drawDynamic;drawDynamic=function(w,h,s,z,inV){try{drawRegionHL(s)}catch(e){}return _ddR.apply(this,arguments)}}
{let first=true;const _alSt=afterLoad;afterLoad=function(){const r=_alSt.apply(this,arguments);if(first){first=false;if(!BOOT_SKIP)setTimeout(()=>{try{if(!S.cur)openStart()}catch(e){console.error(e)}},0)}return r}}
{const _ohI=openHelpIntro;openHelpIntro=function(){if(!BOOT_SKIP)return;return _ohI.apply(this,arguments)}}

// garde-fou : un peuple sans liste de généraux (ex. les Étoliens en mode Macédoine) en reçoit une, au lieu de bloquer la journée
{const GEN_X={eto:['Dorimachos','Scopas','Phainéas','Damocritos','Alexandros','Archidamos'],ach:['Aratos','Philopoimen','Lykortas'],ill:['Skerdilaïdas','Démétrios de Pharos','Pleuratos']};
  const _ngP=nextGen;nextGen=function(side){try{if(!GEN[side]||!GEN[side].length)GEN[side]=GEN_X[side]||[1,2,3,4,5].map(k=>'Chef '+((FAC[side]&&FAC[side].n)||side)+(k>1?' '+['','II','III','IV','V'][k-1]:''));
    S.gi=S.gi||{};if(S.gi[side]==null||!isFinite(S.gi[side]))S.gi[side]=0}catch(e){}return _ngP.apply(this,arguments)}}
/* ---------- 17. POPULATION : réserves d'hommes des villes et de leurs villages ---------- */
// S.pop[id] = hommes mobilisables d'une ville, ses villages compris. Le recrutement, le remplissage des régiments diminués,
// les levées de paysans et les auxiliaires y puisent. La réserve se refait lentement ; sièges, sacs, pillages et levées la vident.
// S.popRes[id] = hommes déjà retenus pour le régiment en formation ; S.levV[id village] = jour de la dernière levée ; S.levT[id ville] = jours des levées.
const POP_SZ=[500,1500,3500,8000],POP_VK={ferme:40,village:120,bourg:320},POP_DAYS=720;
let POPV=null;
function popVil(){if(POPV)return POPV;const M={};if(!VIL||!VIL.length)return M;for(const v of VIL)M[v.t]=(M[v.t]||0)+POP_VK[v.k];return POPV=M}
// l'Italie fournit beaucoup d'hommes (paysans citoyens et alliés) ; les capitales et les plaines peuplées aussi
function popMax(n){if(!n||n.col)return 0;let m=POP_SZ[n.size]||500;m+=Math.min(5000,popVil()[n.i]||0);if(n.cul==='ita')m*=1.5;return Math.round(m)}
function popGet(n){S.pop=S.pop||{};let p=S.pop[n.id];if(p==null||!isFinite(p))p=S.pop[n.id]=popMax(n)*.8;return p}
function popAdd(n,v){const m=popMax(n);S.pop[n.id]=Math.max(0,Math.min(m,popGet(n)+v))}
// villes qui peuvent fournir des hommes à « side » autour de la ville i : elle d'abord, puis celles de sa région, les plus proches d'abord
function popSrc(side,i,wide,guest){const n=N[i],L=[];if(!n||n.col)return L;if(ownerN(i)===side||guest)L.push(n);if(!wide)return L;const r=regOf(n);if(!r)return L;
  for(const m of TOWNS)if(m!==n&&!m.col&&ownerN(m.i)===side&&regOf(m)===r)L.push(m);
  return L.sort((a,b)=>(a===n?-1:b===n?1:Math.hypot(a.x-n.x,a.y-n.y)-Math.hypot(b.x-n.x,b.y-n.y)))}
function popAvail(side,i,wide,guest){return popSrc(side,i,wide,guest).reduce((s,n)=>s+popGet(n),0)}
function popTake(side,i,need,wide,guest){let got=0;for(const n of popSrc(side,i,wide,guest)){if(got>=need)break;const k=Math.min(popGet(n),need-got);S.pop[n.id]-=k;got+=k}return got}
// d'où une armée au repos tire ses hommes : sa ville, ou la ville du territoire où elle campe ; en quartiers d'hiver chez un ami, la ville hôte
function popHome(a){if(a.at!=null&&N[a.at]&&!N[a.at].col&&(ownerN(a.at)===a.side||a.qh))return a.at;const t=townAt(a.x,a.y);return t&&ownerN(t.i)===a.side?t.i:null}
const popOn=side=>!(FAC[side]&&FAC[side].a);
// regain quotidien : environ deux ans pour refaire une ville vide ; rien pendant un siège ; moins quand les villages sont brûlés
function popRegen(){S.pop=S.pop||{};const ru={};
  for(const id in S.vil){const st=S.vil[id];if(st.r&&S.day<st.r&&VIL[id]){const t=VIL[id].t;ru[t]=(ru[t]||0)+POP_VK[VIL[id].k]}}
  const w=season()==='Hiver'?1.25:1;
  for(const n of TOWNS){if(n.col||S.siege[n.id])continue;const m=popMax(n);if(!m)continue;const p=popGet(n);if(p>=m)continue;
    const vr=popVil()[n.i]||0,k=vr?1-.7*Math.min(1,(ru[n.i]||0)/vr):1;S.pop[n.id]=Math.min(m,p+m/POP_DAYS*w*k)}}
// remplissage : tout ce que les règles existantes rendent aux régiments (repos, garnison, quartiers d'hiver, chevaux…) est payé en hommes
// la milice des garnisons (u.gm) est la ville elle-même : elle se refait sans puiser dans les réserves (12 nov., plan de reprise, étape 3)
function popSnap(){const M=new Map();for(const a of S.armies)if(!a.dead&&popOn(a.side))for(const u of a.units)if(!u.gm)M.set(u,u.men);return M}
// une garnison ne prévient que si un ennemi rôde à moins de 60 km : sinon le manque d'hommes n'a rien d'urgent
function popFoeNear(a){try{return S.armies.some(o=>!o.dead&&!o.ship&&o.side!==a.side&&Math.hypot(o.x-a.x,o.y-a.y)<60&&hostile(o,a))}catch(e){return false}}
function popSettle(M){for(const a of S.armies){if(a.dead||!popOn(a.side))continue;let need=0;const L=[];
    for(const u of a.units){const m0=M.get(u);if(m0==null)continue;const d=u.men-m0;if(d>1e-6){need+=d;L.push([u,m0,d])}}
    if(!need)continue;const i=popHome(a),got=i==null?0:popTake(a.side,i,need,true,a.qh&&i===a.at);
    if(got<need-1e-6){const k=got/need;for(const [u,m0,d] of L)u.men=m0+d*k;
      if(isMine(a)&&i!=null&&got<need*.5&&!(a._popE>S.day)&&(!a.g||popFoeNear(a))){a._popE=S.day+90;log(`Les campagnes autour ${deN(N[i].n)} n'ont plus d'hommes : ${esc(a.name)} ne se refait plus. Allez dans une autre région, levez des paysans ou payez des mercenaires.`)}}}}
setTimeout(()=>{const _dPop=daily;daily=function(d){if(!S||S.cur||S.over)return _dPop.apply(this,arguments);let M=null;try{M=popSnap()}catch(e){}
  const r=_dPop.apply(this,arguments);try{if(M)popSettle(M);popRegen()}catch(e){console.error(e)}return r}},0);
// recrutement : le régiment prend ses hommes à la ville (ou à sa région) ; ceux du joueur sont retenus dès la mise en formation
{const _arP=addRecruit;addRecruit=function(i,side,t,ds){const before=new Set();for(const a of S.armies)if(a.side===side)for(const u of a.units)before.add(u);
  const r=_arP.apply(this,arguments);try{if(!popOn(side))return r;const id=N[i].id;S.popRes=S.popRes||{};
    let nu=null;for(const a of S.armies){if(a.side!==side||a.dead)continue;for(const u of a.units)if(!before.has(u)){nu=u;break}if(nu)break}
    if(!nu)return r;const need=UT[nu.t].men;let got;
    if(S.popRes[id]!=null){got=Math.min(need,S.popRes[id]);delete S.popRes[id]}else got=popTake(side,i,need,true);
    if(got<need-1){nu.men=Math.max(1,got);
      if(side==='car'||!isFinite(S.gold[side]))log(`${esc(uName(nu))} : faute d'hommes à ${N[i].n}, le régiment n'a que ${Math.round(got)} soldats sur ${need}.`);
      else S.gold[side]+=Math.round(UT[nu.t].cost*(1-got/need)*.8)}
  }catch(e){console.error(e)}return r}}
// les meilleures troupes se lèvent dans les villes : un bourg ne donne ni cavalerie ni éléphants ni vétérans
function popBigOnly(t,ds){const k=UT[t]&&UT[t].k,d=ds!=null?desOf(ds):null;return k==='cav'||k==='eleph'||!!(d&&d.train==='vet')}
{const _btP=bindTown;bindTown=function(){const r=_btP.apply(this,arguments);try{
  document.querySelectorAll('[data-rec],[data-recd]').forEach(b=>{const i=+b.dataset.n,n=N[i];if(!n)return;
    const d=b.dataset.recd!=null?desOf(+b.dataset.recd):null,t=d?d.base:b.dataset.rec,need=UT[t]?UT[t].men:600;
    if(n.size<2&&popBigOnly(t,d&&d.id)){b.disabled=true;b.title="Un bourg ne fournit ni cavalerie, ni éléphants, ni vétérans : il faut une ville";return}
    if(popAvail('car',i,true)<need*.5){b.disabled=true;b.title=`Pas assez d'hommes dans la région (il en faut au moins ${Math.round(need*.5)})`;return}
    const old=b.onclick;b.onclick=function(e){const id=n.id,had=!!S.q[id];const res=old&&old.call(this,e);
      try{if(!had&&S.q[id]){S.popRes=S.popRes||{};S.popRes[id]=popTake('car',i,need,true)}}catch(x){}return res}})}catch(e){console.error(e)}return r}}
// fiche de la ville : la réserve d'hommes
function popLine(n){if(!n||n.col)return '';const o=ownerN(n.i);if(o!=='car'&&visAt(n.x,n.y)<1)return '';const p=popGet(n),m=popMax(n);if(!m)return '';
  const f=p/m,txt=f>=.75?'nombreux':f>=.4?'moyens':f>=.15?'rares':'épuisés',col=f<.15?'#d98a6a':f<.4?'#d9b25a':'inherit';
  return `<p class="sub">Hommes mobilisables : <b style="color:${col}">${Math.round(p).toLocaleString('fr-FR')}</b> / ${m.toLocaleString('fr-FR')} (${txt})${S.siege[n.id]?' · le siège empêche de les refaire':''}${S.popRes&&S.popRes[n.id]?` · ${Math.round(S.popRes[n.id])} en formation`:''}.</p>`}
{const _tbP=townBlock;townBlock=function(i,main){let h=_tbP.apply(this,arguments);try{const n=N[i];if(!n||n.col)return h;const L=popLine(n);if(!L)return h;
  const m=h.match(/<p class="sub">Revenu[^<]*<\/p>/);h=m?h.replace(m[0],m[0]+L):h+L;
  if(ownerN(i)==='car'&&n.size===1)h=h.replace(/(<h3>Recrutement à [^<]*<\/h3>)/,'$1<p class="sub">Bourg : infanterie et tirailleurs seulement. La cavalerie, les éléphants et les vétérans se lèvent dans les villes.</p>')}catch(e){}return h}}
// ---- levée de paysans dans les villages ----
function levyBase(n){const P=POOL_CAR[n.cul]||POOL_CAR.ibe||['iber'];return P.find(t=>CORPS[t]&&CORPS[t].k==='inf')||P.find(t=>CORPS[t]&&CORPS[t].k==='skirm')||P[0]}
function levyDesign(base){S.designs=S.designs||[];let d=S.designs.find(x=>x.sys==='lev'&&x.base===base);if(d)return d;
  const k=CORPS[base].k,adj=(CORPS[base].adjP&&CORPS[base].adjP[S.peo])||CORPS[base].adj;
  d=Object.assign({},newDesign(base),{base,helm:'nu',crest:'rien',armor:'tunique',jamb:'aucune',shield:k==='skirm'?'aucun':'peau',arm:k==='skirm'?'dague':'lance',jet:'javelots',train:'levee',manteau:'aucun'});
  dFix(d);d.base=base;d.name=('Paysans '+(adj||'levés')).trim();d.sys='lev';d.del=true;d.id=S.duid=(S.duid||0)+1;S.designs.push(d);return d}
const LEV_CD=180,LEV_F={village:.5,bourg:.75};
function levyInfo(v){const n=N[v.t],base=levyBase(n),men=Math.round(UT[base].men*(LEV_F[v.k]||.5));S.levV=S.levV||{};const cd=S.levV[v.id]!=null&&S.day<S.levV[v.id]+LEV_CD;
  return {n,base,men,cd,left:cd?Math.ceil((S.levV[v.id]+LEV_CD-S.day)/30):0,ok:popGet(n)>=men}}
function levyCount(id){S.levT=S.levT||{};const L=(S.levT[id]||[]).filter(d=>S.day-d<180);S.levT[id]=L;return L.length}
function raiseLevy(v,a){if(!a||a.units.length>=MAXU)return null;const I=levyInfo(v);if(I.cd||!I.ok)return null;
  const d=levyDesign(I.base);popAdd(I.n,-I.men);a.units.push({t:I.base,men:I.men,d:d.id,xp:0,lev:1});
  S.levV[v.id]=Math.floor(S.day);levyCount(I.n.id);S.levT[I.n.id].push(Math.floor(S.day));
  if(a.food!=null)a.food+=5;return d}
{const _vbP=villageBlock;villageBlock=function(v,a,main){let h=_vbP.apply(this,arguments);try{
  if(!a||v.k==='ferme'||vRel(v,'car')!=='own'||vRuined(v))return h;const I=levyInfo(v),k=levyCount(I.n.id);
  const tip=I.cd?`Ce village a déjà donné ses hommes : encore ${I.left} mois`:!I.ok?`${I.n.n} n'a plus assez d'hommes`:`${I.men} paysans mal armés (levée : moral et attaque faibles), pris sur la réserve ${deN(I.n.n)}. Gratuit, mais chaque levée fâche la ville pendant six mois (ordre public −6)${k?` ; déjà ${k} levée${k>1?'s':''} récente${k>1?'s':''}`:''}`;
  const b=`<button id="vLev" type="button" title="${esc(tip)}" ${I.cd||!I.ok||a.units.length>=MAXU?'disabled':''}>Lever des paysans (${I.men} h.)</button>`;
  const j=h.lastIndexOf('</div>');h=j>=0?h.slice(0,j)+b+h.slice(j):h+`<div class="row">${b}</div>`}catch(e){console.error(e)}return h}}
{const _bvP=bindVillage;bindVillage=function(v,a){const r=_bvP.apply(this,arguments);const e=$('vLev');
  if(e)e.onclick=()=>{const d=raiseLevy(v,a);if(d){const k=levyCount(N[v.t].id);log(`${a.name} lève des paysans à ${v.n} : ${esc(d.name)}${k>=3?`. ${N[v.t].n} gronde contre ces levées répétées`:''}.`)}renderAll()};return r}}
// les auxiliaires des bourgs viennent aussi de la réserve
{const _vaP=vAux;vAux=function(v,a){const n=N[v.t],t=(AUX[a.side]||AUX.car)[v.cul]||'sling',need=UT[t].men*.6;
  if(popOn(a.side)&&popGet(n)<need){if(isMine(a))log(`${v.n} n'a plus d'hommes à donner : la réserve ${deN(n.n)} est épuisée.`);return null}
  const r=_vaP.apply(this,arguments);if(r&&popOn(a.side))popAdd(n,-need);return r}}
// ordre public : les levées forcées et les campagnes vidées fâchent la ville
{const _opP=ordParts;ordParts=function(n){const P=_opP.apply(this,arguments);try{const k=levyCount(n.id);if(k)P.push(['levées forcées',-6*k]);
  const m=popMax(n);if(m&&popGet(n)<m*.1)P.push(['campagnes vidées',-5])}catch(e){}return P}}
// la guerre vide le pays : prise (et surtout sac) d'une ville, villages pillés ou brûlés
{const _cpP=capture;capture=function(i,side){const n=N[i],sg=S.siege[n.id],prev=ownerN(i);
  const sack=(typeof CAPMODE!=='undefined'&&CAPMODE==='pil')||(sg&&sg.side===side&&sg.sack==='pil');
  const r=_cpP.apply(this,arguments);try{if(prev!==ownerN(i)&&!n.col){popGet(n);S.pop[n.id]*=sack?.4:.8;if(S.popRes)delete S.popRes[n.id]}}catch(e){}return r}}
{const _vpP=vPillage;vPillage=function(v,a){const r=_vpP.apply(this,arguments);try{popAdd(N[v.t],-POP_VK[v.k]*.6)}catch(e){}return r}}
{const _vbuP=vBurn;vBurn=function(v,side){const r=_vbuP.apply(this,arguments);try{popAdd(N[v.t],-POP_VK[v.k]*.2)}catch(e){}return r}}
// ---- compléter les rangs avec des mercenaires (or au lieu des hommes du pays) ----
function mercFillCost(a){let c=0,m=0;for(const u of a.units){const mx=UT[u.t].men,miss=mx-u.men;if(miss<1)continue;m+=miss;c+=miss*uCost(u)/mx*1.6}return {c:Math.ceil(c),m:Math.round(m)}}
function mercFillOk(a){return a&&!a.dead&&!a.legs.length&&!a.ship&&!a.g&&a.reinf==null&&!(ownerAt(a.x,a.y)&&hostileSides(ownerAt(a.x,a.y),a.side))}
function mercFill(a){const F=mercFillCost(a);if(!F.m||!mercFillOk(a))return false;let ok=false;
  engPay(a,()=>{if((S.gold[a.side]||0)<F.c)return;S.gold[a.side]-=F.c;for(const u of a.units){const mx=UT[u.t].men;if(u.men<mx){if(u.xp&&u.men>0)u.xp*=u.men/mx;u.men=mx;u._m=mx}}ok=true});
  if(ok&&isMine(a))log(`${esc(a.name)} complète ses rangs avec ${F.m.toLocaleString('fr-FR')} mercenaires (${F.c} or).`);return ok}
function popArmyHtml(a){if(!a||!isMine(a)||a.legs.length||a.ship||a.g)return '';const F=mercFillCost(a);if(F.m<1)return '';const i=popHome(a);
  let h=`<div class="sub" data-popbox style="margin:6px 0 2px">`+(i==null?`Hors de vos terres : les régiments ne se refont pas.`:`Les régiments se refont en puisant dans la réserve ${deN(N[i].n)} et de sa région : <b>${Math.round(popAvail(a.side,i,true,a.qh&&i===a.at)).toLocaleString('fr-FR')}</b> hommes.`);
  if(mercFillOk(a))h+=` <button type="button" data-pmerc="${a.id}" ${(S.gold[a.side]||0)<F.c?'disabled':''} title="Remplit tout de suite les ${F.m.toLocaleString('fr-FR')} places vides avec des mercenaires, sans toucher à la réserve ; l'expérience se dilue">Compléter avec des mercenaires (${F.c} or)</button>`;
  return h+`</div>`}
setTimeout(()=>{const _ulP=unitLines;unitLines=function(a,checks){const h=_ulP.apply(this,arguments);try{if(checks)return h+popArmyHtml(a)}catch(e){}return h}},0);
document.addEventListener('click',e=>{const b=e.target&&e.target.closest&&e.target.closest('[data-pmerc]');if(!b||b.disabled)return;const a=S&&S.armies.find(x=>x.id==b.dataset.pmerc);if(a&&isMine(a)){mercFill(a);renderAll()}});
/* ---------- branchements : journée, mois, boutons, raccourcis de test ---------- */
const _dailyG=daily;
daily=function(d){const r=_dailyG.apply(this,arguments);if(S.cur||S.over)return r;
  try{heroDaily();exhDaily();campSickDaily();corsairDaily();aiSupply(d);
    if(d%30===0){genMonthly();tradeMonthly();if(cal(d).mo===2)genYearly()}}catch(e){console.error(e)}return r};
const _afterLoadG=afterLoad;afterLoad=function(){const r=_afterLoadG.apply(this,arguments);try{genInit();tradeInit()}catch(e){}return r};
{const add=(id,txt,title,fn,after,icon)=>{if($(id))return;const b=document.createElement('button');b.id=id;b.type='button';b.textContent=txt;b.title=title;b.onclick=fn;const ref=$(after)||$('bDip');ref.after(b)};
  add('bGen','Généraux','Vos généraux, leurs rivalités et les chefs ennemis',()=>openGens(),'bPol');
  add('bSea','Commerce','Routes marchandes, guerre de course, pirates',()=>openTrade(),'bEco');
  setTimeout(()=>{try{const top=$('bDip');if(!top||!top.querySelector('.ui-i'))return;
    const svg=(p,n)=>`<svg class="ui-i" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" stroke="currentColor" stroke-width="0" aria-hidden="true">${p}</svg><span>${n}</span>`;
    const I={bGen:['<circle cx="12" cy="7" r="4"/><path d="M4 21c0-5 4-8 8-8s8 3 8 8z"/><path d="M9 3l3-2 3 2" fill="none" stroke-width="1.6"/>','Généraux'],
      bSea:['<path d="M3 15h18l-3 5H6z"/><path d="M11 3h2v11h-2z"/><path d="M13 4c3 1 5 4 5 8h-5z"/><path d="M11 6c-2 1-4 3-4 6h4z"/>','Commerce']};
    for(const id in I){const b=$(id);if(b&&!b.querySelector('.ui-i'))b.innerHTML=svg(I[id][0],I[id][1])}}catch(e){}},0)}
/* ---------- 18. GARNISONS MINIMALES (10 nov., Baptiste : « un minimum acceptable, 5-6 régiments ») ----------
   Chaque bourg, ville et capitale tenus par quelqu'un garde au moins 5 régiments (6 pour une capitale).
   Les régiments ajoutés sont la milice de la ville (u.gm) : payés surtout par la ville (un cinquième de l'entretien depuis l'étape 4), jamais congédiés par l'IA.
   Au début de la partie (ou au premier jour d'une partie chargée), toutes les garnisons sont complétées ;
   ensuite, chaque mois, une ville qui n'est pas assiégée en relève un de plus si elle est sous le minimum. */
const GARMIN=n=>!n||n.col?0:n.size>=3?6:n.size>=1?5:0;
function garArmy(n,o){return S.armies.find(a=>a.g&&!a.dead&&a.at===n.i&&a.side===o)}
function garTypes(o,a){const ok=t=>UT[t]&&(UT[t].k==='inf'||UT[t].k==='skirm');
  let L=a?a.units.map(u=>u.t).filter(ok):[];
  if(!L.length)for(const b of S.armies)if(b.side===o&&!b.dead&&!b.ship)for(const u of b.units)if(ok(u.t))L.push(u.t);
  if(!L.length){const r=realSide(o);L=r==='rom'?['legion','legion','velites']:r==='car'?['lib','iber','sling']:['iber','iber','sling']}
  return L}
function garFill(n,max){const o=ownerN(n.i);if(!o)return 0;const m=GARMIN(n);if(!m)return 0;let a=garArmy(n,o),k=0;
  const T=garTypes(o,a);
  if(!a){a={id:S.uid++,side:o,name:'Garnison '+deN(n.n),x:n.x,y:n.y,at:n.i,legs:[],units:[],scout:0,cool:0,g:true,mor:65};S.armies.push(a)}
  while(a.units.length<m&&k<max){const t=T[(a.units.length*2+1)%T.length];a.units.push({t,men:UT[t].men,gm:1});try{const c={};c[t]=a.units.filter(x=>x.t===t).length-1;depOne(a,a.units[a.units.length-1],c)}catch(e){}k++}
  return k}
function garAll(max){let k=0;for(const n of N){if(n.col||GARMIN(n)===0)continue;if(S.siege&&S.siege[n.id])continue;
  const o=ownerN(n.i);if(S.armies.some(a=>{if(a.dead||a.g||a.side===o||Math.hypot(a.x-n.x,a.y-n.y)>6)return false;try{return hostile(a,{side:o,units:[]})}catch(e){return true}}))continue;k+=garFill(n,max)}return k}
{const _dGM=daily;daily=function(d){const r=_dGM.apply(this,arguments);try{if(S&&!S.over&&!S.cur){
  if(!S.garMin){S.garMin=1;garAll(99)}else if(Math.floor(d)%30===15)garAll(1)}}catch(e){console.error(e)}return r}}
// la milice coûte un cinquième d'un régiment : on retire le reste de son entretien (la moitié est déjà retirée pour une armée à l'abri des murs).
// Étape 4 du plan de reprise : gratuite, elle laissait un joueur sans rien faire amasser 2 300 or la première année.
const MIL_PAYE=.2;
{const _incG=income;income=function(side){const r=_incG.apply(this,arguments);try{let x=0;for(const a of S.armies)if(a.side===side&&!a.dead)for(const u of a.units)if(u.gm)x+=uCost(u)/12*(a.inG?.5:1)*(1-MIL_PAYE);
  if(realSide(side)==='rom')x*=ROM_ALLY; // l'entretien romain est déjà réduit à ROM_ALLY : sans cela la milice effaçait aussi celui des légions (étape 4)
  if(x&&r&&typeof r.up==='number')r.up=Math.max(0,Math.round(r.up-x))}catch(e){}return r}}
/* ---------- 19. ARMÉES DE DÉPART DES PEUPLES JOUABLES (10 nov., Baptiste : « re travaille les armées de base, l'équipement des unités surtout ») ----------
   Au début de la partie, chaque régiment des armées et garnisons de Carthage, Rome et des peuples jouables reçoit une troupe
   historique, nommée et équipée (modèle d'atelier). Les troupes du camp du joueur sont des modèles visibles dans l'atelier
   (on peut les relever) ; celles des autres camps sont cachées (del). Les régiments d'un même type alternent les troupes de la liste. */
const DEP_T={car:'pourpre',rom:'rouge',mac:'bronze',syr:'bleu',ath:'blanc',num:'ocre',ins:'vert',per:'bleu',mas:'blanc'};
const DEP_HOP=(o)=>Object.assign({helm:'corinthien',crest:'crin',armor:'lin',jamb:'cnemides',shield:'hoplon',arm:'lance',jet:'aucune'},o||{});
const DEP_THU=(o)=>Object.assign({helm:'pilos',crest:'rien',armor:'lin',jamb:'aucune',shield:'ovale',arm:'lance',jet:'javelots'},o||{});
const DEP_CRE=['Archers crétois',{helm:'nu',armor:'tunique',shield:'pelte',arm:'dague',jet:'arc'}];
const DEP_ROM={hastati:{helm:'bronze',crest:'plumes',armor:'pect',jamb:'une',shield:'scutum',arm:'glaive',jet:'pilum',train:'reg'},
  principes:{helm:'bronze',crest:'plumes',armor:'maille',jamb:'une',shield:'scutum',arm:'glaive',jet:'pilum',train:'vet'},
  triarii:{helm:'bronze',crest:'noire',armor:'maille',jamb:'une',shield:'scutum',arm:'lance',jet:'aucune',train:'vet'},
  socii:{helm:'attique',crest:'crete',armor:'pect',jamb:'une',shield:'scutum',arm:'glaive',jet:'pilum',teinte:'blanc'}};
const DEP_R={
  car:{lib:[['Lanciers libyens',{helm:'attique',crest:'rien',armor:'lin',jamb:'aucune',shield:'hoplon',arm:'lance',jet:'aucune',train:'vet'}]],
    iber:[['Scutarii ibères',{helm:'bronze',crest:'crete',armor:'tunique',jamb:'aucune',shield:'ovale',arm:'epee',jet:'soliferrum',tenue:'blanc'}],
      ['Guerriers celtibères',{helm:'bronze',crest:'crin',armor:'cuir',jamb:'bandes',shield:'ovale',arm:'epee',jet:'soliferrum'}]],
    gaul:[['Guerriers gaulois',{helm:'nu',armor:'tunique',shield:'ovale',arm:'longue',jet:'javelots'}]],
    sling:[['Frondeurs baléares',{helm:'nu',armor:'tunique',shield:'aucun',arm:'dague',jet:'fronde'}],['Caetrati ibères',{helm:'cuir',armor:'tunique',shield:'parma',arm:'epee',jet:'javelots',tenue:'blanc'}]],
    hcav:[['Cavalerie ibère',{helm:'bronze',armor:'cuir',shield:'rond',arm:'epee',jet:'javelots'}],['Cavalerie libyphénicienne',{helm:'attique',crest:'crin',armor:'lin',shield:'rond',arm:'lance',jet:'aucune',train:'vet'}]],
    ncav:[['Cavalerie numide',{helm:'nu',armor:'tunique',shield:'peau',arm:'lance',jet:'javelots'}]]},
  rom:{legion:[['Hastati',DEP_ROM.hastati],['Principes',DEP_ROM.principes],['Fantassins alliés',DEP_ROM.socii],['Triarii',DEP_ROM.triarii]],
    velites:[['Vélites',{helm:'cuir',armor:'tunique',shield:'parma',arm:'glaive',jet:'javelots',train:'levee'}]],
