  mac:{phalange:[['Chalkaspides',{helm:'thrace',crest:'rien',armor:'lin',jamb:'cnemides',shield:'macedonien',arm:'sarisse',jet:'aucune'}],['Leukaspides',{helm:'thrace',crest:'rien',armor:'tunique',jamb:'aucune',shield:'macedonien',arm:'sarisse',jet:'aucune',teinte:'blanc'}]],
    hypasp:[['Peltastes royaux',{helm:'attique',crest:'crin',armor:'lin',jamb:'cnemides',shield:'macedonien',arm:'lance',jet:'aucune',train:'vet'}]],
    peltaste:[['Peltastes thraces',{helm:'thrace',armor:'tunique',shield:'pelte',arm:'kopis',jet:'javelots',manteau:'ocre'}]],
    cretois:[DEP_CRE],
    compagnons:[['Escadron royal',{helm:'beotien',crest:'crin',armor:'lin',shield:'aucun',arm:'xyston',jet:'aucune',manteau:'pourpre',train:'vet'}]],
    thessal:[['Cavalerie thessalienne',{helm:'petase',armor:'cuir',shield:'aucun',arm:'xyston',jet:'javelots',manteau:'pourpre'}]]},
  syr:{athoplites:[['Hoplites syracusains',DEP_HOP({helm:'attique'})]],thureo:[['Mercenaires de Hiéron',DEP_THU()]],
    athpelt:[['Peltastes siciliotes',{helm:'pilos',armor:'tunique',shield:'pelte',arm:'epee',jet:'javelots'}]],cretois:[DEP_CRE],
