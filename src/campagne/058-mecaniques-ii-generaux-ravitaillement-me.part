    gaul:[['Galates tolistobogiens',{helm:'bronze',crest:'roue',armor:'maille',shield:'ovale',arm:'longue',jet:'javelots',motif:'triskel'}]],
    athpelt:[['Peltastes mysiens',{helm:'pilos',armor:'tunique',shield:'pelte',arm:'epee',jet:'javelots'}]],cretois:[DEP_CRE],
    hippeis:[['Cavaliers pergaméniens',{helm:'beotien',armor:'lin',shield:'rond',arm:'lance',jet:'javelots'}]]},
  mas:{athoplites:[['Hoplites massaliotes',DEP_HOP()]],thureo:[['Thuréophores massaliotes',DEP_THU()]],
    gaul:[['Mercenaires celto-ligures',{helm:'nu',armor:'tunique',shield:'ovale',arm:'longue',jet:'javelots'}]],
