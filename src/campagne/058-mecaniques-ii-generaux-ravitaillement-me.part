  ath:{athoplites:[['Hoplites athéniens',DEP_HOP()],['Éphèbes',DEP_HOP({helm:'attique',armor:'tunique',jamb:'aucune',train:'levee'})]],thureo:[['Thuréophores athéniens',DEP_THU()]],
    athpelt:[['Peltastes athéniens',{helm:'pilos',armor:'tunique',shield:'pelte',arm:'epee',jet:'javelots'}]],
    scythes:[['Archers scythes',{helm:'phrygien',armor:'tunique',shield:'aucun',arm:'dague',jet:'arc'}]],cretois:[DEP_CRE],
