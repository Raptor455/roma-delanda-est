/* ================= MÉCANIQUES II : généraux, ravitaillement, mer et commerce, scénarios, partie test, jouer Rome ================= */
// Module du fil « Développer les mécaniques de campagne » (8 novembre 2026). Il s'appuie sur les blocs ARMÉES, LOGISTIQUE, FLOTTES
// et MÉCANIQUES, et les enveloppe sans les réécrire. Réinjecté par mecaniques/patch.py, juste après « FIN MÉCANIQUES ».
// En « Jouer Rome », la partie est en miroir comme chez l'invité du multijoueur : 'car' désigne le camp du joueur (Rome),
// 'rom' le camp de l'ordinateur (Carthage). realSide() rend le vrai peuple d'un camp.
const realSide=s=>S&&S.mirror?(s==='car'?'rom':s==='rom'?'car':s):s;
const sideOfReal=r=>S&&S.mirror?(r==='car'?'rom':r==='rom'?'car':r):r;
const capOf=s=>realSide(s)==='rom'?NI.roma:NI.carthago;
const yearNow=()=>cal(Math.floor(S.day)).year;
const rnd=L=>L[Math.floor(Math.random()*L.length)];

/* ---------- 1. GÉNÉRAUX : âge, expérience, états de service, loyauté, rivalités, succession ---------- */
Object.assign(TRAITS,{
  age:{n:'Vieillissant',d:'−10 % de vitesse ; plus prudent : +5 % en défense',neg:1},
  ebranle:{n:'Ébranlé',d:'−8 % au combat jusqu’à sa prochaine victoire',neg:1},
  heros:{n:'Héros',d:'moral +8 pour son armée, +4 pour les armées voisines'},
  vieux:{n:'Vieux renard',d:'+6 % en défense, ennemi mieux deviné'}});
// années de naissance (av. J.-C.) ; les autres naissent entre 28 et 50 ans avant l'année de leur apparition
const BORN={'Hannibal':247,'Hasdrubal':245,'Magon':243,'Giscon':260,'Hannon':270,'Bomilcar':262,'Himilcon':258,'Maharbal':250,'Carthalon':262,'Hamilcar':255,'Adherbal':258,'Bostar':260,'Mutines':240,'Hasdrubal le Chauve':255,
  'P. Cornelius Scipio':262,'Ti. Sempronius Longus':260,'C. Flaminius':275,'Cn. Cornelius Scipio':265,'Q. Fabius Maximus':280,'M. Claudius Marcellus':268,'L. Aemilius Paullus':266,'C. Terentius Varro':262,
  'M. Minucius Rufus':262,'Ti. Sempronius Gracchus':250,'Q. Fulvius Flaccus':277,'M. Livius Salinator':254,'C. Claudius Nero':250,'T. Manlius Torquatus':272,'P. Cornelius Scipio l’Africain':236};
const FAMILY={'Hannibal':'Barca','Hasdrubal':'Barca','Magon':'Barca','P. Cornelius Scipio':'Cornelii','Cn. Cornelius Scipio':'Cornelii','P. Cornelius Scipio l’Africain':'Cornelii'};
HIST_GEN['P. Cornelius Scipio l’Africain']=[['tact','aime','march'],9];
// rivalités historiques (elles naissent quand les deux commandent en même temps)
const HIST_RIV=[['Hannibal','Hannon','le parti de la paix contre les Barcides'],['Q. Fabius Maximus','M. Minucius Rufus','la temporisation contre l’audace'],['L. Aemilius Paullus','C. Terentius Varro','deux consuls, deux conduites de la guerre'],['M. Livius Salinator','C. Claudius Nero','une vieille haine personnelle']];
function genLife(g){if(!g)return g;if(g.born==null){const b=BORN[g.name.replace(/ II$/,'')];g.born=b&&!/ II$/.test(g.name)?b:yearNow()+28+Math.floor(Math.random()*22)}
  if(g.w==null){g.w=0;g.l=0;g.hist=[]}if(g.loy==null)g.loy=FAMILY[g.name]==='Barca'?92:70+Math.round(Math.random()*15);if(g.amb==null)g.amb=20+Math.round(Math.random()*50);return g}
const ageOf=g=>g.born-yearNow();
function genInit(){if(!S.gens)return;for(const g of S.gens)genLife(g);S.riv=S.riv||[];S.fallen=S.fallen||[]}
const rivOf=g=>(S.riv||[]).filter(r=>r.a===g.id||r.b===g.id).map(r=>S.gens.find(x=>x.id===(r.a===g.id?r.b:r.a))).filter(x=>x&&!x.dead);
const areRivals=(g,h)=>(S.riv||[]).some(r=>(r.a===g.id&&r.b===h.id)||(r.a===h.id&&r.b===g.id));
function addRival(g,h,why){if(!g||!h||g===h||g.dead||h.dead||g.side!==h.side||areRivals(g,h))return;S.riv.push({a:g.id,b:h.id,d:Math.floor(S.day),why});
  if(g.side==='car')log(`Rivalité : ${g.name} et ${h.name} ne se supportent plus (${why}).`)}
// combat : rivaux côte à côte, général ébranlé, vieillissant, héros, vieux renard
const _armyMulG=armyMul;
armyMul=function(a,role){let m=_armyMulG.apply(this,arguments);const g=genOf(a);if(!g)return m;
  if(hasTr(g,'ebranle'))m*=.92;if(hasTr(g,'age')&&role==='def')m*=1.05;if(hasTr(g,'vieux')&&role==='def')m*=1.06;return m};
const _oddsG=odds;
odds=function(b){let p=_oddsG.apply(this,arguments);try{const pen=ids=>{const A=ids.map(id=>S.armies.find(x=>x.id===id)).filter(Boolean);if(typeof rivalOf==='function'&&rivalOf(A))return 1;/* le module ARMÉES compte déjà le commandement disputé */const G=A.map(genOf).filter(Boolean);for(let i=0;i<G.length;i++)for(let j=i+1;j<G.length;j++)if(areRivals(G[i],G[j]))return .88;return 1};
  const fa=pen(b.att),fd=pen(b.def);if(fa!==1||fd!==1){const r=Math.sqrt(p/(1-p))*fa/fd;p=r*r/(r*r+1)}}catch(e){}return p};
const _legSpeedG=legSpeed;legSpeed=function(a,type){let v=_legSpeedG.apply(null,arguments);if(type==='mer'||a.conv)return v;const g=genOf(a);if(g&&hasTr(g,'age'))v*=.9;return v};
// états de service, traits nés de la bataille
const _applyResultG=applyResult;
applyResult=function(b,res){genInit();const G=id=>{const a=S.armies.find(x=>x.id===id);return a?genOf(a):null};
  const gA=b.att.map(G).filter(Boolean),gD=b.def.map(G).filter(Boolean),t=battleTitle(b),y=yearNow(),p=odds(b);
  const r=_applyResultG.apply(this,arguments);
  try{const W=res.attWin?gA:gD,L=res.attWin?gD:gA,under=res.attWin?p<.4:p>.6;
    for(const g of W){genLife(g);g.w++;g.hist.unshift({t,y,v:1});g.hist.length=Math.min(g.hist.length,8);g.loy=Math.min(100,g.loy+4);
      if(hasTr(g,'ebranle')){g.tr=g.tr.filter(k=>k!=='ebranle');if(g.side==='car')log(`${g.name} a retrouvé son assurance.`)}
      if(under&&!hasTr(g,'heros')&&g.w>=3&&Math.random()<.35){g.tr.push('heros');if(g.side==='car')log(`${g.name} devient un héros : ses soldats le suivraient partout.`)}}
    for(const g of L){genLife(g);g.l++;g.hist.unshift({t,y,v:0});g.hist.length=Math.min(g.hist.length,8);g.loy=Math.max(0,g.loy-3);
      if(!g.dead&&!hasTr(g,'ebranle')&&Math.random()<.35){g.tr.push('ebranle');if(g.side==='car')log(`${g.name} est ébranlé par la défaite.`)}}
    // défaite à plusieurs : on cherche un coupable
    const Lv=L.filter(g=>!g.dead);if(Lv.length>=2&&Math.random()<.4)addRival(Lv[0],Lv[1],'chacun accuse l’autre de la défaite');
    // les vaincus apprennent à connaître le vainqueur
    for(const g of [...gA,...gD])if(g.side!=='car')g.seen=1}catch(e){console.error(e)}
  return r};
// remplaçants : un général présent prend la suite ; la mort d'un Barca ou d'un grand chef ébranle tout le camp
const _killGenG=killGen;
killGen=function(g,why){genInit();const a=S.armies.find(x=>x.id===g.army);
  let c=null;if(a){let bd=150;for(const x of S.gens){if(x.dead||x===g||x.side!==g.side||x.army!=null||x.at==null)continue;const n=N[x.at],d=Math.hypot(n.x-a.x,n.y-a.y);if(d<bd||(d<150&&c&&stars(x)>stars(c))){bd=d;c=x}}}
  const st=stars(g);_killGenG.apply(this,arguments);
  try{genLife(g);S.fallen.unshift({name:g.name,side:g.side,y:yearNow(),why,st,w:g.w,l:g.l});S.fallen.length=Math.min(S.fallen.length,30);
    if(c&&a&&!a.dead){const tmp=genOf(a);giveGen(a,c);if(tmp&&tmp!==c){S.gens=S.gens.filter(x=>x!==tmp)}if(g.side==='car')log(`${c.name} succède à ${g.name} à la tête de l'armée.`)}
    grief(g)}catch(e){console.error(e)}};
function grief(g){const big=stars(g)>=4||g.name==='Hannibal'||(g.side==='car'&&FAMILY[g.name]==='Barca');if(!big)return;
  for(const a of S.armies){if(a.dead||a.mor==null)continue;if(a.side===g.side)a.mor=Math.max(0,a.mor-(g.name==='Hannibal'?15:8));else a.mor=Math.min(100,a.mor+6)}
  if(g.side==='car'&&S.pol){senAdj(g.name==='Hannibal'?-12:-5)}
  evCard(g.side==='car'?'Un deuil pour votre camp':'Un grand chef ennemi est mort',`${g.name} est mort. ${g.side==='car'?'Vos armées sont en deuil (moral en baisse).':'Ses troupes doutent ; les vôtres reprennent courage.'}`,g.side==='car')}
// chaque printemps : on vieillit ; chaque mois : loyauté, rivalités
function genYearly(){genInit();
  for(const g of S.gens.slice()){if(g.dead)continue;genLife(g);const age=ageOf(g);
    if(age>=60&&!hasTr(g,'age')){g.tr.push('age');if(g.side==='car')log(`${g.name} a ${age} ans : il marche moins vite, mais se garde mieux.`)}
    if(age>=55&&stars(g)>=3&&!hasTr(g,'vieux')&&Math.random()<.3){g.tr.push('vieux');if(g.side==='car')log(`${g.name}, vieux renard, sent venir l'ennemi.`)}
    let p=age<45?.004:age<55?.015:age<62?.04:age<70?.09:.2;if(hasTr(g,'dur'))p*=.6;
    if(Math.random()<p){if(g.army!=null)killGen(g,`meurt de maladie à ${age} ans`);else{g.dead=true;S.fallen.unshift({name:g.name,side:g.side,y:yearNow(),why:`mort à ${age} ans`,st:stars(g),w:g.w,l:g.l});if(g.side==='car')log(`${g.name} meurt à ${age} ans, loin des combats.`)}}}
  // Scipion l'Africain entre en scène (il a 25 ans en 211)
  if(!S.ev.afr&&yearNow()<=211){S.ev.afr=1;const side=sideOfReal('rom'),cap=N.find(n=>n.id==='tarraco'&&ownerN(n.i)===side)||N[NI.roma];
    if(ownerN(cap.i)===side){const U=(t,k)=>Array.from({length:k},()=>({t,men:UT[t].men}));const a={id:S.uid++,side,name:'P. Cornelius Scipio l’Africain',x:cap.x,y:cap.y,at:cap.i,legs:[],units:[...U('legion',4),...U('velites',2),...U('rcav',1),...U('acav',1)],scout:0,cool:0,mor:75,food:80,bag:true};
      S.armies.push(a);syncGens();const g=genOf(a);if(g){g.born=236;genLife(g)}
      evCard(side==='car'?'Un jeune chef se lève':'Scipion le Jeune',side==='car'?'Le Sénat confie l’Hispanie à P. Cornelius Scipio, 25 ans, fils du consul. Les soldats l’adorent.':`Rome confie une armée à P. Cornelius Scipio, 25 ans, fils du consul de 218. On le dit inspiré des dieux. Méfiez-vous de lui.`,true)}}}
function genMonthly(){genInit();const mine=S.gens.filter(g=>!g.dead&&g.side==='car');
  for(const g of S.gens){if(g.dead)continue;genLife(g);
    if(g.side==='car'){if(S.gold.car<=0)g.loy=Math.max(0,g.loy-3);g.loy+=(70-g.loy)*.03;if(stars(g)>=3)g.amb=Math.min(100,g.amb+1)}}
  // rivalités historiques et rivalités d'ambitieux
  for(const [x,y,why] of HIST_RIV){const g=S.gens.find(k=>!k.dead&&k.name===x),h=S.gens.find(k=>!k.dead&&k.name===y);if(g&&h&&g.side===h.side)addRival(g,h,why)}
  for(let i=0;i<mine.length;i++)for(let j=i+1;j<mine.length;j++){const a=mine[i],b=mine[j];if(stars(a)>=3&&stars(b)>=3&&a.amb+b.amb>110&&Math.random()<.02)addRival(a,b,'deux ambitions pour une seule gloire')}
  // querelles : deux rivaux à moins de 120 km se disputent
  for(const r of (S.riv||[]).slice()){const g=S.gens.find(x=>x.id===r.a),h=S.gens.find(x=>x.id===r.b);if(!g||!h||g.dead||h.dead){S.riv=S.riv.filter(x=>x!==r);continue}
    const A=S.armies.find(x=>x.id===g.army),B=S.armies.find(x=>x.id===h.army);
    if(g.side==='car'){g.loy=Math.max(0,g.loy-1);h.loy=Math.max(0,h.loy-1)}
    if(A&&B&&Math.hypot(A.x-B.x,A.y-B.y)<120&&Math.random()<.3){for(const a of [A,B])if(a.mor!=null)a.mor=Math.max(0,a.mor-4);if(g.side==='car')log(`${g.name} et ${h.name} se querellent devant les troupes (moral −4).`)}
    if(g.side==='car'&&S.pol&&Math.random()<.1){senAdj(-2);log(`${rnd([g,h]).name} intrigue contre son rival auprès du Sénat (−2).`)}}
  // un général mécontent et ambitieux se cabre
  for(const g of mine){if(g.loy>=20||g.army==null||stars(g)<2||S.cur||!$('modal').hidden)continue;if(Math.random()<.25){genRevolt(g);break}}}
function genRevolt(g){const a=S.armies.find(x=>x.id===g.army);if(!a)return;S.paused=true;const pay=40+20*stars(g);
  modal(`<h2>${esc(g.name)} se cabre</h2><p>Mal payé, mal aimé, ${esc(g.name)} menace de rentrer chez lui avec ses officiers. Il réclame ${pay} or et des honneurs.</p><p class="sub">Loyauté ${Math.round(g.loy)}. S'il part, ${esc(a.name)} perd son chef et son moral baisse.</p>
    <div class="row"><button id="gPay" class="go" type="button" ${S.gold.car<pay?'disabled':''}>Payer ${pay} or</button><button id="gFire" type="button">Le relever de son commandement</button></div>`);
  $('gPay').onclick=()=>{S.gold.car-=pay;g.loy=60;closeModal();log(`${g.name} accepte l'or et reprend son service (loyauté 60).`);renderAll()};
  $('gFire').onclick=()=>{closeModal();const n=nearestNode(a.x,a.y,n=>!n.col&&ownerN(n.i)==='car');g.army=null;a.gen=null;g.dead=true;S.fallen.unshift({name:g.name,side:'car',y:yearNow(),why:'relevé de son commandement',st:stars(g),w:g.w,l:g.l});
    a.mor=Math.max(0,(a.mor||60)-10);syncGens();log(`${g.name} est relevé de son commandement ; ${genOf(a)?genOf(a).name:'un tribun'} le remplace.`);renderAll()}}
// actions : honorer, réconcilier, mettre à la retraite
function genAct(k,id,id2){genInit();const g=S.gens.find(x=>x.id===id);if(!g||g.dead)return;
  if(k==='hon'){if(S.gold.car<80||(g.hon&&S.day-g.hon<360))return;S.gold.car-=80;g.hon=Math.floor(S.day);g.loy=Math.min(100,g.loy+20);const a=S.armies.find(x=>x.id===g.army);if(a&&a.mor!=null)a.mor=Math.min(100,a.mor+8);if(S.pol)senAdj(2);
    log(`${g.name} reçoit des honneurs publics : couronne d'or, statue, banquet (loyauté +20${a?', moral +8':''}).`)}
  if(k==='rec'){const h=S.gens.find(x=>x.id===id2);if(!h||S.gold.car<60)return;S.gold.car-=60;if(Math.random()<.6){S.riv=S.riv.filter(r=>!((r.a===g.id&&r.b===h.id)||(r.a===h.id&&r.b===g.id)));log(`Banquet de réconciliation : ${g.name} et ${h.name} se sont donné l'accolade.`)}
    else{g.loy=Math.max(0,g.loy-5);h.loy=Math.max(0,h.loy-5);log(`Le banquet tourne mal : ${g.name} et ${h.name} en sont venus aux injures (loyauté −5).`)}}
  if(k==='ret'){if(g.army!=null)return;g.dead=true;g.retired=1;S.fallen.unshift({name:g.name,side:'car',y:yearNow(),why:`retiré du service à ${ageOf(g)} ans`,st:stars(g),w:g.w,l:g.l});log(`${g.name} se retire sur ses terres, honoré.`)}
  renderAll();openGens()}
function openGens(){genInit();syncGens();
  const L=S.gens.filter(g=>!g.dead&&g.side==='car').sort((a,b)=>(b.army!=null)-(a.army!=null)||stars(b)-stars(a));
  const F=S.gens.filter(g=>!g.dead&&g.side!=='car'&&(g.seen||(g.army!=null&&(()=>{const a=S.armies.find(x=>x.id===g.army);return a&&visOfArmy(a)>=1})())));
  const loyC=v=>v>=60?'var(--good)':v>=35?'var(--gold)':'var(--bad)';
  const row=(g,mine)=>{const a=S.armies.find(x=>x.id===g.army),s=stars(g),nx=XP_STAR[s+1],rv=rivOf(g);
    return `<tr><td style="min-width:200px"><b>${esc(g.name)}</b> <span class="stars">${starTxt(s)}</span><br><span class="sub">${ageOf(g)} ans${FAMILY[g.name]?' · famille '+FAMILY[g.name]:''} · ${a?esc(a.title||a.name)+' ('+a.units.length+' rég.)':g.at!=null?'sans commandement, à '+N[g.at].n:'—'}</span></td>
      <td>${g.tr.map(k=>`<span class="tr${TRAITS[k].neg?' neg':''}" title="${TRAITS[k].d}">${TRAITS[k].n}</span>`).join(' ')}<br><span class="sub">expérience ${Math.floor(g.xp)}${nx!=null?' / '+nx:''} · ${g.w} victoire${g.w>1?'s':''}, ${g.l} défaite${g.l>1?'s':''}${g.hist.length?' · dernière : '+esc(g.hist[0].t)+' ('+g.hist[0].y+')':''}</span>
      ${rv.length?`<br><span class="sub" style="color:var(--bad)">Rival de ${rv.map(h=>esc(h.name)).join(', ')}</span>`:''}</td>
      ${mine?`<td style="min-width:110px"><span class="sub">Loyauté</span> <b style="color:${loyC(g.loy)}">${Math.round(g.loy)}</b><br><span class="sub">Ambition ${Math.round(g.amb)}</span></td>
      <td style="white-space:nowrap"><button data-ghon="${g.id}" type="button" ${S.gold.car<80||(g.hon&&S.day-g.hon<360)?'disabled':''} title="Couronne, statue et banquet : loyauté +20, moral +8 (une fois par an)">Honorer (80)</button>
        ${rv.map(h=>`<button data-grec="${g.id}:${h.id}" type="button" ${S.gold.car<60?'disabled':''} title="Six chances sur dix de les réconcilier">Réconcilier avec ${esc(h.name.split(' ').slice(-1)[0])} (60)</button>`).join(' ')}
        ${g.army==null&&ageOf(g)>=55?`<button data-gret="${g.id}" type="button" title="Il ne coûte plus rien">Retraite</button>`:''}</td>`:''}</tr>`};
  modal(`<h2>Généraux</h2><p class="sub">Vos chefs vieillissent (après 60 ans ils marchent moins vite ; la mort guette), gagnent de l'expérience et des traits au combat, et se souviennent de leurs victoires comme de leurs défaites. Un général ébranlé par une défaite se bat moins bien jusqu'à sa prochaine victoire. Deux rivaux dans la même bataille coordonnent mal (−12 %) et se querellent s'ils sont proches. Un général mal payé ou délaissé peut se cabrer. À la mort d'un chef, un général présent à moins de 150 km lui succède.</p>
    <table class="dip"><tr><th>Général</th><th>Traits et états de service</th><th>Loyauté</th><th></th></tr>${L.map(g=>row(g,true)).join('')||'<tr><td class="sub">Aucun.</td></tr>'}</table>
    <h3>Chefs ennemis connus</h3><table class="dip">${F.map(g=>row(g,false)).join('')||'<tr><td class="sub">Vous ne savez rien de leurs chefs : il faut les voir ou les affronter.</td></tr>'}</table>
    ${(S.fallen||[]).length?`<h3>Ils ne sont plus</h3><p class="sub">${S.fallen.slice(0,12).map(f=>`${esc(f.name)} (${f.side==='car'?'vôtre':'ennemi'}, ${f.y}) : ${esc(f.why)}`).join(' · ')}</p>`:''}
    <div class="row" style="justify-content:flex-end"><button class="go" id="mClose" type="button">Fermer</button></div>`);
  $('mcard').classList.add('wide');$('mClose').onclick=closeModal;
  document.querySelectorAll('[data-ghon]').forEach(b=>b.onclick=()=>genAct('hon',+b.dataset.ghon));
  document.querySelectorAll('[data-grec]').forEach(b=>b.onclick=()=>{const [x,y]=b.dataset.grec.split(':').map(Number);genAct('rec',x,y)});
  document.querySelectorAll('[data-gret]').forEach(b=>b.onclick=()=>genAct('ret',+b.dataset.gret))}
// héros : moral de son armée et des voisines
function heroDaily(){for(const a of S.armies){const g=genOf(a);if(!g||!hasTr(g,'heros')||a.dead)continue;if(a.mor!=null)a.mor=Math.min(100,a.mor+.25);
  for(const o of S.armies)if(o!==a&&o.side===a.side&&!o.dead&&o.mor!=null&&Math.hypot(o.x-a.x,o.y-a.y)<60)o.mor=Math.min(100,o.mor+.1)}}

/* ---------- 2. RAVITAILLEMENT : terre brûlée, pays épuisé, maladies de camp, blé acheté, dépôts romains ---------- */
const villagesNear=(x,y,km)=>VIL.filter(v=>Math.abs(v.x-x)<km&&Math.abs(v.y-y)<km&&Math.hypot(v.x-x,v.y-y)<km);
function scorch(a,km,silent){const L=villagesNear(a.x,a.y,km).filter(v=>!vRuined(v));let own=0,oth=0;const F=new Set();
  for(const v of L){vBurn(v,a.side);const o=ownerN(v.t);if(o===a.side)own++;else{oth++;if(o&&S.fac[o]&&S.fac[o].st==='neutre'){F.add(o)}}}
  for(const f of F){S.fac[f][a.side]-=8}
  if(a.side==='car'){ecoInit();for(const n of N)if(!n.col&&ownerN(n.i)==='car'&&Math.hypot(n.x-a.x,n.y-a.y)<km+15&&S.ord[n.id]!=null)S.ord[n.id]=Math.max(0,S.ord[n.id]-10)}
  if(!silent&&a.side==='car')log(`${a.name} pratique la terre brûlée : ${L.length} villages et domaines incendiés${own?` (dont ${own} chez vous : revenus perdus, ordre −10)`:''}. L'ennemi ne trouvera rien à manger ici pendant des mois.`);
  return L.length}
// pays épuisé : chaque région a une réserve que les armées mangent
function exhInit(){S.exh=S.exh||{}}
function regAt(x,y){const t=townAt(x,y);return t&&t.reg}
function exhDaily(){exhInit();if(!REGN)regionsBuild();const se=season(),back=se==='Été'?.5:se==='Printemps'?.35:se==='Automne'?.25:.1;
  for(const r in S.exh){S.exh[r]=Math.max(0,S.exh[r]-back);if(S.exh[r]<=0)delete S.exh[r]}
  for(const a of S.armies){if(a.dead||a.g||a.ship||a.inG||a.conv||!a.units.length)continue;const r=regAt(a.x,a.y);if(!r)continue;const home=ownerAt(a.x,a.y)===a.side;
    S.exh[r]=Math.min(100,(S.exh[r]||0)+a.units.length*(home?.012:.03))}}
const exhOf=n=>S&&S.exh&&n&&n.reg?(S.exh[n.reg]||0):0;
const _townIncomeE=townIncome;townIncome=function(n){const v=_townIncomeE.apply(this,arguments);const e=exhOf(n);return e>10?Math.round(v*(1-e/250)):v};
const _villagesDailyE=villagesDaily;villagesDaily=function(){_villagesDailyE.apply(this,arguments);if(!S.exh)return;
  for(const id in S.vil){const st=S.vil[id],v=VIL[id];if(!v||st.r)continue;const e=exhOf(N[v.t]);if(e>15)st.f=Math.max(0,st.f-VK[v.k].cap/100*e/80)}};
// maladies de camp : une armée qui reste au même endroit hors de chez elle
function campSickDaily(){for(const a of S.armies){if(a.dead||a.g||a.ship||a.inG||a.conv||a.qh)continue;
  const home=ownerAt(a.x,a.y)===a.side;if(a.legs.length||home){a._still=0;a._sick=0;continue}a._still=(a._still||0)+1;
  if(a._still>25){const k=a.units.length>12?.0035:.0022;for(const u of a.units)u.men-=u.men*k;if(a.mor!=null)a.mor=Math.max(0,a.mor-.1);
    if(!a._sick){a._sick=1;if(a.side==='car')log(`La dysenterie gagne le camp de ${a.name} : une armée immobile hors de chez elle pourrit sur place. Bougez, ou prenez une ville.`)}cleanArmy(a)}}}
// blé acheté : un port ami (non bloqué) fait venir du blé de Sicile, d'Égypte ou de Sardaigne pour son dépôt
function buyGrain(id){initLogi();const i=NI[id],n=N[i];if(!n.port||ownerN(i)!=='car'||S.block[id]||S.gold.car<70)return;const d=S.dep[id]=S.dep[id]||{f:0};
  if(d.f>=depCap(n))return;S.gold.car-=70;d.f=Math.min(depCap(n),d.f+240);log(`Des navires marchands déchargent du blé à ${n.n} : +240 rations au dépôt.`);renderAll()}
const _townBlockR=townBlock;
townBlock=function(i,main){let h=_townBlockR.apply(this,arguments);const n=N[i];if(!S||n.col||ownerN(i)!=='car')return h;
  const e=Math.round(exhOf(n));if(e>=10)h+=`<p class="sub">Pays épuisé à ${e} % (${n.reg}) : villages lents à se refaire, revenus −${Math.round(e/2.5)} %.</p>`;
  if(n.port){const d=S.dep&&S.dep[n.id];h+=`<div class="rec"><span class="sub">Blé de Sicile ou d'Égypte : 240 rations au dépôt du port${S.block&&S.block[n.id]?' (port bloqué)':''}</span><button data-grain="${n.id}" type="button" ${S.gold.car<70||(S.block&&S.block[n.id])||(d&&d.f>=depCap(n))?'disabled':''}>Acheter (70)</button></div>`}
  return h};
const _bindTownR=bindTown;bindTown=function(){_bindTownR.apply(this,arguments);document.querySelectorAll('[data-grain]').forEach(b=>b.onclick=()=>buyGrain(b.dataset.grain))};
// panneau de l'armée : terre brûlée, pays épuisé, camp malade
const _renderSideR=renderSide;
renderSide=function(){const r=_renderSideR.apply(this,arguments);try{if(sel&&sel.a&&isMine(sel.a)&&!sel.a.dead&&!sel.a.g&&!sel.a.ship){const a=sel.a,el=$('side'),d=document.createElement('div');
  const e=Math.round(S.exh&&S.exh[regAt(a.x,a.y)]||0),nV=villagesNear(a.x,a.y,25).filter(v=>!vRuined(v)).length;
  d.innerHTML=`<p class="sub">${e>=10?`Pays mangé à ${e} % : on y trouve de moins en moins à fourrager. `:''}${a._still>25?'<b style="color:var(--bad)">Dysenterie au camp.</b> ':''}</p>`+
    (!a.legs.length?`<div class="row"><button id="aScorch" type="button" class="warn" ${nV?'':'disabled'} title="Brûler tous les villages à 25 km : l'ennemi n'y trouvera plus de vivres ; vos propres villes y perdent revenu et ordre">Terre brûlée (${nV} villages)</button></div>`:'');
  el.appendChild(d);if($('aScorch'))$('aScorch').onclick=()=>{scorch(a,25);renderAll()}}}catch(e){console.error(e)}return r};
// l'IA : Fabius brûle le pays devant Hannibal ; Rome tient des dépôts pour ses armées en campagne
function aiSupply(d){const R=sideOfReal('rom'),C=sideOfReal('car');
  if(S.pol&&S.pol.mode==='temporise'&&d%10===0&&realSide(R)==='rom'){const foe=S.armies.find(a=>a.side===C&&!a.g&&!a.dead&&!a.ship&&inItaly(a.x,a.y)&&a.units.length>=6);
    if(foe){const tx=foe.legs.length?foe.legs[foe.legs.length-1].x:foe.x+(Math.random()-.5)*60,ty=foe.legs.length?foe.legs[foe.legs.length-1].y:foe.y+(Math.random()-.5)*60;
      const n=scorch({x:tx,y:ty,side:R,name:'Rome'},22,true);if(n&&(visAt(tx,ty)>=1||Math.random()<.5))log(`Fabius fait brûler les récoltes devant vous : ${n} villages incendiés près ${deN(nearestNode(tx,ty,n=>!n.col).n)}.`)}}
  if(d%15===0){initLogi();for(const a of S.armies){if(a.side!==R||a.g||a.dead||a.ship||a.reinf!=null||a.units.length<4)continue;if(ownerAt(a.x,a.y)===R)continue;
    if(Object.values(S.dep).some(x=>x.auto===a.id))continue;const n=nearestNode(a.x,a.y,n=>!n.col&&ownerN(n.i)===R&&n.size>=1&&!S.siege[n.id]);
    if(n&&Math.hypot(n.x-a.x,n.y-a.y)<300){const dp=S.dep[n.id]=S.dep[n.id]||{f:120};dp.auto=a.id}}}}

/* ---------- 3. MER ET COMMERCE : routes marchandes, blocus, guerre de course, pirates ---------- */
const zN=z=>{const Z=ZONES[z];return Z?(Z.n||Z[0]||''):''};
const PIRZ={ill:{n:'pirates illyriens',z:['Adriatique','Mer Ionienne']},lig:{n:'pirates ligures',z:['Mer de Ligurie','Golfe du Lion']},bal:{n:'pirates baléares',z:['Mer des Baléares']}};
const zoneName=(x,y)=>ZONES[zoneOf(x,y)].n||ZONES[zoneOf(x,y)][0];
function routePts(A,B){const a=A.anch||[A.x,A.y],b=B.anch||[B.x,B.y];let P=null;try{P=seaPath(a[0],a[1],b[0],b[1]);if(P)P=P.map(q=>Array.isArray(q)?q:[q.x,q.y])}catch(e){}
  if(!P||!P.length){P=[];for(let k=0;k<=12;k++)P.push([a[0]+(b[0]-a[0])*k/12,a[1]+(b[1]-a[1])*k/12])}
  const out=[];const st=Math.max(1,Math.floor(P.length/24));for(let k=0;k<P.length;k+=st)out.push([Math.round(P[k][0]),Math.round(P[k][1])]);const l=P[P.length-1];out.push([Math.round(l[0]),Math.round(l[1])]);return out}
function routeKm(P){let s=0;for(let k=1;k<P.length;k++)s+=Math.hypot(P[k][0]-P[k-1][0],P[k][1]-P[k-1][1]);return s}
function routeVal(A,B,km){return Math.round(2+Math.min(6,km/250)+(A.size+B.size))}
function mkRoute(side,a,b){const A=N[NI[a]],B=N[NI[b]];if(!A||!B)return null;const P=routePts(A,B),km=routeKm(P);
  const zs=[...new Set(P.map(p=>zoneOf(p[0],p[1])))];return {id:S.uid++,side,a,b,P,km:Math.round(km),v:routeVal(A,B,km),zs,ok:1,why:''}}
const TR_ROM=[['ostia','neapolis'],['ostia','massalia'],['ostia','caralis'],['brundisium','tarentum'],['neapolis','messana'],['ostia','pisae']];
const TR_CAR=[['carthago','gades'],['carthago','cnova'],['carthago','leptis']];
function tradeInit(){if(S.trade){for(const r of S.trade)if(!isFinite(r.v)||!isFinite(r.km)){const x=mkRoute(r.side,r.a,r.b);if(x){r.P=x.P;r.km=x.km;r.v=x.v;r.zs=x.zs}}return}S.trade=[];S.pir=S.pir||{};
  for(const [a,b] of TR_CAR){const r=mkRoute(sideOfReal('car'),a,b);if(r)S.trade.push(r)}for(const [a,b] of TR_ROM){const r=mkRoute(sideOfReal('rom'),a,b);if(r)S.trade.push(r)}}
const portOk=(id,side)=>{const i=NI[id];if(i==null)return false;const o=ownerN(i);if(o===side)return true;const F=S.fac[o];return !!(F&&F.st==='neutre'&&F[side]>=30)};
const zoneHasFoe=(z,side,k)=>S.fleets.filter(f=>f.side!==side&&hostileSides(f.side,side)&&warN(f)>=(k||3)&&f.at==null&&zoneOf(f.x,f.y)===z);
const nearFleet=(r,side,km)=>S.fleets.filter(f=>f.side===side&&warN(f)>=3&&r.P.some(p=>Math.hypot(p[0]-f.x,p[1]-f.y)<km));
function routeState(r){if(!portOk(r.a,r.side)||!portOk(r.b,r.side))return [0,'port perdu'];
  if((S.block[r.a]&&S.block[r.a].side!==r.side)||(S.block[r.b]&&S.block[r.b].side!==r.side))return [0,'port bloqué'];
  if(r.sus&&r.sus>S.day)return [0,'navires pris : reprise dans '+Math.ceil((r.sus-S.day)/30)+' mois'];
  if(season()==='Hiver')return [.5,'hiver : mer fermée à demi'];return [1,'']}
function tradeIncome(side){if(!S||!S.trade)return 0;let v=0;for(const r of S.trade)if(r.side===side&&isFinite(r.v)){const [k]=routeState(r);v+=r.v*k}return Math.round(v)}
const _incomeT=income;income=function(side){const r=_incomeT.apply(this,arguments);let up=r.up;try{if(realSide(side)==='rom')up=Math.round(up*ROM_ALLY)}catch(e){}return {inc:r.inc+tradeIncome(side),up}};
// les alliés italiens soldent eux-mêmes leurs contingents : Rome ne paie qu'une partie de l'entretien de ses armées
const ROM_ALLY=.72;
function tradeMonthly(){tradeInit();for(const k in S.pir)if(S.pir[k]<=S.day)delete S.pir[k];
  for(const r of S.trade.slice()){const [k,why]=routeState(r);r.ok=k;r.why=why;if(!k)continue;
    // pirates
    for(const pk in PIRZ){const P=PIRZ[pk];if(S.pir[pk])continue;if(!r.zs.some(z=>P.z.includes(zN(z))))continue;
      if(Math.random()<(nearFleet(r,r.side,60).length?.03:.09)){r.sus=S.day+30;if(r.side==='car')log(`Les ${P.n} ont pris des navires sur la route ${deN(N[NI[r.a]].n)} à ${N[NI[r.b]].n} : un mois sans commerce.`);break}}
    // le voisin qui donne asile au commerce y gagne en amitié
    for(const id of [r.a,r.b]){const o=ownerN(NI[id]),F=S.fac[o];if(F&&F.st==='neutre')F[r.side]=Math.min(100,F[r.side]+.5)}}}
// guerre de course : une escadre en mer (au moins 5 galères) prend les marchands ennemis qui passent dans sa zone
function corsairDaily(){if(!S.trade)return;for(const f of S.fleets){if(f.at!=null||warN(f)<5||f.legs.length&&f.task&&f.task.k==='transport')continue;const z=zoneOf(f.x,f.y);
  for(const r of S.trade){if(!hostileSides(r.side,f.side)||!r.zs.includes(z)||(r.sus&&r.sus>S.day))continue;
    const esc_=nearFleet(r,r.side,50).reduce((s,o)=>s+warN(o),0);if(Math.random()>(esc_>=warN(f)?.01:.05))continue;
    const prize=r.v*3;S.gold[f.side]=(S.gold[f.side]||0)+prize;S.gold[r.side]=Math.max(0,(S.gold[r.side]||0)-r.v);r.sus=S.day+60;
    if(f.side==='car')log(`${f.name} capture des marchands ennemis ${ZONES[z].loc||ZONES[z][3]||''} : ${prize} or de prises ; leur route est coupée deux mois.`);
    else if(r.side==='car'){log(`Des galères ennemies ont pris vos marchands sur la route ${deN(N[NI[r.a]].n)} à ${N[NI[r.b]].n} (−${r.v} or, deux mois sans commerce). Une escadre en escorte les protégerait.`)}}}}
function openRoute(a,b){tradeInit();if(a===b||S.gold.car<60)return;const mine=S.trade.filter(r=>r.side==='car');if(mine.length>=TRADE_MAX())return;
  if(mine.some(r=>(r.a===a&&r.b===b)||(r.a===b&&r.b===a)))return;const r=mkRoute('car',a,b);if(!r)return;S.gold.car-=60;S.trade.push(r);log(`Nouvelle route marchande ${deN(N[NI[a]].n)} à ${N[NI[b]].n} : ${r.v} or par mois.`);renderAll();openTrade()}
const TRADE_MAX=()=>3+Math.floor(N.filter(n=>n.port&&!n.col&&ownerN(n.i)==='car'&&n.size>=2).length/2);
function pirHunt(k){tradeInit();if(S.gold.car<100||S.pir[k])return;const war=S.fleets.filter(f=>f.side==='car').reduce((s,f)=>s+warN(f),0);if(war<10)return;S.gold.car-=100;
  if(Math.random()<.7){S.pir[k]=S.day+720;S.gold.car+=40;log(`Vos galères ont brûlé les repaires des ${PIRZ[k].n} : la mer est sûre pour deux ans (+40 or de butin).`)}
  else log(`L'expédition contre les ${PIRZ[k].n} rentre bredouille : ils se sont cachés dans leurs criques.`);renderAll();openTrade()}
function openTrade(){tradeInit();const mine=S.trade.filter(r=>r.side==='car'),foe=S.trade.filter(r=>r.side!=='car');
  const ports=N.filter(n=>n.port&&!n.col&&portOk(n.id,'car')).sort((a,b)=>a.n.localeCompare(b.n));
  const st=r=>{const [k,why]=routeState(r);const thr=r.zs.filter(z=>zoneHasFoe(z,r.side).length).map(z=>zN(z));return k===0?`<b style="color:var(--bad)">suspendue</b> : ${why}`:(thr.length?`<b style="color:#e0a060">menacée</b> (galères ennemies : ${thr.join(', ')})`:'<b style="color:var(--good)">active</b>')+(why?' · '+why:'')};
  const pz=r=>Object.keys(PIRZ).filter(k=>r.zs.some(z=>PIRZ[k].z.includes(zN(z)))).map(k=>PIRZ[k].n);
  const war=S.fleets.filter(f=>f.side==='car').reduce((s,f)=>s+warN(f),0);
  modal(`<h2>Mer et commerce</h2><p class="sub">Chaque route marchande rapporte de l'or chaque mois (moitié moins l'hiver). Elle s'arrête si un de ses ports est perdu ou bloqué. Les escadres ennemies en mer (5 galères ou plus) prennent vos marchands dans les zones qu'elles traversent ; une escadre amie près de la route les protège. Les vôtres font de même : envoyez des galères croiser sur les routes romaines (guerre de course). Les pirates guettent l'Adriatique, la mer Ionienne, la Ligurie et les Baléares.</p>
    <h3>Vos routes (${mine.length}/${TRADE_MAX()}) : ${tradeIncome('car')} or ce mois</h3>
    <table class="dip"><tr><th>Route</th><th>Rapport</th><th>État</th></tr>${mine.map(r=>`<tr><td>${N[NI[r.a]].n} – ${N[NI[r.b]].n}<br><span class="sub">${r.km} km${pz(r).length?' · '+pz(r).join(', '):''}</span></td><td>${r.v} or/mois</td><td>${st(r)} <button data-trx="${r.id}" type="button">Fermer</button></td></tr>`).join('')||'<tr><td class="sub">Aucune.</td></tr>'}</table>
    <div class="row"><select id="trA">${ports.map(n=>`<option value="${n.id}">${n.n}${ownerN(n.i)!=='car'?' ('+sideName(ownerN(n.i))+')':''}</option>`).join('')}</select><select id="trB">${ports.map((n,k)=>`<option value="${n.id}" ${k===1?'selected':''}>${n.n}${ownerN(n.i)!=='car'?' ('+sideName(ownerN(n.i))+')':''}</option>`).join('')}</select><button id="trGo" type="button" ${S.gold.car<60||mine.length>=TRADE_MAX()?'disabled':''}>Ouvrir la route (60)</button></div>
    <p class="sub">Les ports neutres qui vous estiment (30 au moins) accueillent vos marchands, et vous en estiment davantage. Une grande ville portuaire de plus permet une route de plus.</p>
    <h3>Pirates</h3><div class="row">${Object.keys(PIRZ).map(k=>`<button data-pir="${k}" type="button" ${S.pir[k]||S.gold.car<100||war<10?'disabled':''} title="100 or, 10 galères au moins dans vos flottes ; 7 chances sur 10">${S.pir[k]?PIRZ[k].n+' : mer sûre':'Chasser les '+PIRZ[k].n+' (100)'}</button>`).join('')}</div>
    <h3>Commerce ennemi connu</h3><p class="sub">${foe.map(r=>`${N[NI[r.a]].n} – ${N[NI[r.b]].n} (${zN(r.zs[Math.floor(r.zs.length/2)])}${r.sus&&r.sus>S.day?', coupée':''})`).join(' · ')||'—'}</p>
    <div class="row" style="justify-content:flex-end"><button class="go" id="mClose" type="button">Fermer</button></div>`);
  $('mcard').classList.add('wide');$('mClose').onclick=closeModal;
  $('trGo').onclick=()=>openRoute($('trA').value,$('trB').value);
  document.querySelectorAll('[data-trx]').forEach(b=>b.onclick=()=>{S.trade=S.trade.filter(r=>r.id!==+b.dataset.trx);renderAll();openTrade()});
  document.querySelectorAll('[data-pir]').forEach(b=>b.onclick=()=>pirHunt(b.dataset.pir))}
function drawTrade(s){if(!S.trade||s<.35)return;ctx.save();ctx.setTransform(dpr,0,0,dpr,0,0);
  for(const r of S.trade){const mine=r.side==='car';if(!mine&&s<.6)continue;const [k]=routeState(r);ctx.setLineDash(mine?[5,5]:[2,6]);ctx.lineWidth=mine?1.3:1;
    ctx.strokeStyle=!k?'rgba(208,100,79,.45)':mine?'rgba(230,205,140,.55)':'rgba(200,120,110,.35)';ctx.beginPath();r.P.forEach((p,j)=>{const X=p[0]*s+view.ox,Y=p[1]*s+view.oy;j?ctx.lineTo(X,Y):ctx.moveTo(X,Y)});ctx.stroke();
    if(k&&mine){const t=(S.day*4/Math.max(60,r.km))%1,j=Math.floor(t*(r.P.length-1)),f=t*(r.P.length-1)-j,A=r.P[j],B=r.P[Math.min(j+1,r.P.length-1)],X=(A[0]+(B[0]-A[0])*f)*s+view.ox,Y=(A[1]+(B[1]-A[1])*f)*s+view.oy;
      ctx.setLineDash([]);ctx.fillStyle='#e9dcc0';ctx.strokeStyle='rgba(40,28,16,.8)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(X-5,Y);ctx.lineTo(X+5,Y);ctx.lineTo(X+3,Y+3);ctx.lineTo(X-3,Y+3);ctx.closePath();ctx.fill();ctx.stroke();ctx.beginPath();ctx.moveTo(X,Y);ctx.lineTo(X,Y-7);ctx.lineTo(X+4,Y-2);ctx.closePath();ctx.fill()}}
  ctx.restore()}
const _drawDynamicT=drawDynamic;drawDynamic=function(w,h,s){const r=_drawDynamicT.apply(this,arguments);try{drawTrade(s)}catch(e){}return r};

/* ---------- 4. IA GÉNÉRALE (n'importe quel camp) : sert à Carthage quand vous jouez Rome, et aux deux camps dans la partie test ---------- */
const POOL_CAR0=JSON.parse(JSON.stringify(POOL_CAR));
function aiPick(side,n){const r=realSide(side),x=Math.random();
  if(r==='rom')return n.cul==='ita'?(x<.5?'legion':x<.72?'velites':x<.86?'rcav':'acav'):(x<.6?'velites':'acav');
  if(n.id==='carthago'&&x<.08)return 'eleph';const P=POOL_CAR0[n.cul]||['iber'];return x<.65?P[0]:x<.85?(P[1]||P[0]):'sling'}
// l'IA ne lève une troupe que si le trésor tient un an avec son entretien
function aiAfford(side,t){const r=income(side),net=r.inc-r.up-(UT[t].cost/12),res=realSide(side)==='car'&&S.pol&&!S.mirror?150:0;return S.gold[side]-UT[t].cost>=Math.max(res,-net*12)&&(net>-25||S.gold[side]>900)}
// banqueroute : congédier les troupes les plus chères plutôt que de laisser le Sénat s'effondrer
function aiTrim(side){const r=income(side);if(S.gold[side]>60||r.inc-r.up>=0)return;let over=r.up-r.inc;
  const L=[];S.armies.forEach(a=>{if(a.side===side&&!a.dead&&!a.ship&&a.units.length>1)a.units.forEach(u=>{if(!u.gm)L.push([a,u])})});L.sort((x,y)=>uCost(y[1])-uCost(x[1]));
  for(const [a,u] of L){if(over<=0||a.units.length<=2)continue;a.units.splice(a.units.indexOf(u),1);over-=uCost(u)/12}}
function aiRecruit(side){const cap0=capOf(side),cap=side==='pun'&&S.armies.some(a=>a.side==='pun'&&!a.g&&a.at===cap0&&a.units.length>=10)?-1:cap0;if(S.gold[side]<220||Math.floor(S.day)%10)return;
  const spots=N.filter(n=>!n.col&&ownerN(n.i)===side&&n.size>=1&&!S.q[n.id]&&(n.i===cap||S.armies.some(a=>a.side===side&&!a.g&&a.at===n.i&&!a.legs.length&&a.units.length<MAXU)));
  const n=spots.sort((a,b)=>(b.i===cap)-(a.i===cap)||b.size-a.size)[0]||N[cap];if(!n||ownerN(n.i)!==side||S.q[n.id])return;
  const t=aiPick(side,n);if(S.gold[side]<UT[t].cost||!aiAfford(side,t))return;S.gold[side]-=UT[t].cost;S.q[n.id]={t,d:TRAIN[UT[t].k],side}}
// dépenser l'or accumulé : plusieurs villes lèvent en même temps quand le trésor déborde
function aiRecruitMany(side,keep){const cap=capOf(side);let k=0;const T=N.filter(n=>!n.col&&ownerN(n.i)===side&&n.size>=1&&!S.q[n.id]&&!S.siege[n.id]).sort((a,b)=>(b.i===cap)-(a.i===cap)||b.size-a.size);
  for(const n of T){if(S.gold[side]<keep||k>=4)break;const t=aiPick(side,n);if(S.gold[side]-UT[t].cost<keep||!aiAfford(side,t))break;S.gold[side]-=UT[t].cost;S.q[n.id]={t,d:TRAIN[UT[t].k],side};k++}}
// plan historique de l'IA carthaginoise (Rome jouée, ou partie test) : Hannibal passe en Italie et y reste ; Hasdrubal tient l'Hispanie puis le rejoint (207)
const inIber=(x,y)=>x<1230&&y>480;
const inSic=(x,y)=>x>1930&&x<2289&&y>1010&&y<1190;
function aiHist(side,a){if((realSide(side)!=='car'&&side!=='pun')||a.g||a.ship)return null;const d=S.day;
  if(a.name==='Hannibal'){if(inItaly(a.x,a.y))return {ok:(x,y)=>inItaly(x,y)};
    const T=NI.mediolanum!=null?NI.mediolanum:NI.placentia;return T!=null&&d<5000?{go:T}:null}
  if(a.name==='Hasdrubal'){if(d<3200)return {ok:inIber};const H=S.armies.find(x=>x.side===side&&x.name==='Hannibal'&&!x.dead);
    if(inItaly(a.x,a.y))return {ok:(x,y)=>inItaly(x,y)};if(H&&inItaly(H.x,H.y)){const n=nearestNode(H.x,H.y,n=>!n.col&&!cityHostile(n.i,side));if(n)return {go:n.i}}return {go:NI.mediolanum}}
  if(/^Magon/.test(a.name)&&(d<2400||side==='pun'&&d<4000))return {ok:inIber};
  if(side==='pun'&&/Himilcon/.test(a.name)){if(inSic(a.x,a.y))return {ok:inSic};return NI.agrigentum!=null?{go:NI.agrigentum}:null}
  if(side==='pun'&&/Giscon/.test(a.name)){if(inIber(a.x,a.y))return {ok:inIber};return NI.cnova!=null?{go:NI.cnova}:null}
  return null}
function aiSide(side){if(Math.floor(S.day)%30===0){aiTrim(side);
    // l'IA carthaginoise soigne son Sénat : butin envoyé aux Barcides quand Hannon gagne du terrain
    if(realSide(side)==='car'&&!S.mirror&&S.pol&&S.pol.bar<35&&S.gold[side]>=160){S.gold[side]-=100;senAdj(8)}}if(S.gold[side]>600)aiRecruitMany(side,400);const cap=capOf(side),C=N[cap];aiRecruit(side);
  const mine=S.armies.filter(a=>a.side===side&&!a.dead),foes=S.armies.filter(o=>!o.dead&&!o.ship&&hostileSides(o.side,side));
  const threat=foes.some(f=>!f.g&&f.units.length>=5&&Math.hypot(f.x-C.x,f.y-C.y)<380&&(side!=='pun'||!f.ship&&(n=>n&&n.lat<37.2&&n.lon>7)(nearestNode(f.x,f.y))));
  if(threat&&!mine.some(a=>!a.g&&(a.at===cap||a.ai==='defend'))){const c=mine.filter(a=>!a.g&&!a.ship&&a.units.length>=4).map(a=>({a,p:plan(a,0,0,cap)})).filter(x=>x.p).sort((x,y)=>x.p.days-y.p.days)[0];if(c){order(c.a,0,0,cap);c.a.ai='defend'}}
  for(const a of mine){if(a.g||a.cool>0||a.ship||a.reinf!=null||a.conv)continue;if(a.ai==='defend'&&threat)continue;if(a.ai==='defend')a.ai=null;
    if(a.legs.length)continue;const sg=a.at!=null&&S.siege[N[a.at].id];if(sg&&sg.a===a.id)continue;
    if(a.qh&&season()==='Hiver')continue;
    const H=aiHist(side,a);if(H&&H.go!=null){const g=N[H.go];if(g&&Math.hypot(g.x-a.x,g.y-a.y)>25&&!a.legs.length){order(a,0,0,H.go);continue}}
    if(a.units.length<6){// petite armée : rejoindre une autre ou attendre en ville
      const o=mine.find(b=>b!==a&&!b.g&&!b.ship&&b.units.length+a.units.length<=MAXU&&Math.hypot(b.x-a.x,b.y-a.y)<4);if(o&&!o.legs.length){for(const u of a.units.slice())if(!moveUnit(a,o,u))break;if(!a.units.length)dropArmy(a);continue}
      continue}
    const my=strength(a);let D;try{D=dijkstra(a,startsOf(a))}catch(e){continue}let best=null,bv=0;
    for(const n of N){if(n.col||!cityHostile(n.i,side))continue;if(H&&H.ok&&!H.ok(n.x,n.y))continue;const days=D.dist[n.i];if(days>=1e9)continue;
      const def=S.armies.filter(x=>x.side===ownerN(n.i)&&!x.dead&&Math.hypot(x.x-n.x,x.y-n.y)<6).reduce((s,x)=>s+strength(x),0);if(def>my*.85)continue;
      const v=(n.inc+12+(n.i===capOf(sideOfReal(realSide(side)==='car'?'rom':'car'))?40:0))/(8+days);if(v>bv){bv=v;best=['n',n.i]}}
    for(const f of foes){if(f.g||abriteMurs(f)||strength(f)>my*.8)continue;if(H&&H.ok&&!H.ok(f.x,f.y))continue;const nn=nearestNode(f.x,f.y),days=D.dist[nn.i];if(days>=1e9)continue;const v=(60+strength(f)/10)/(8+days);if(v>bv){bv=v;best=['p',f.x,f.y]}}
    if(best){if(best[0]==='n')order(a,0,0,best[1]);else order(a,best[1],best[2],null)}}}
// l'IA ne conquiert pas les peuples hors de sa guerre (Grèce, Gaule transalpine, alliés de Rome…) sauf s'ils lui ont déclaré la guerre
const AI_OFF={rom:new Set(['mas','ven','syr','epi','mac','thr','eto','ach','ath','cre','cyr','ill','dar','gau','num','mae','mau']),car:new Set(['epi','mac','thr','eto','ach','ath','cre','cyr','ill','dar'])};
const aiCtl=side=>S&&(S.auto||(side==='rom'&&!(S.mpP&&MP.role&&(MP.role==='guest'||MPRH('rom'))))/*MP*/);
{const _chA=cityHostile;cityHostile=function(i,side){const r=_chA.apply(this,arguments);try{if(r&&aiCtl(side)){const o=ownerN(i),rs=realSide(side),F=S.fac[o];
  if(AI_OFF[rs]&&AI_OFF[rs].has(o)&&!(F&&F.st==='guerre_'+side))return false}}catch(e){}return r}}
// ni ralliement diplomatique de ces peuples (la Rome de l'IA ralliait toute la Grèce)
let scenSetup=false;
{const _jA=joinAlliance;joinAlliance=function(f,side){try{if(!scenSetup&&aiCtl(side)){const rs=realSide(side);if(AI_OFF[rs]&&AI_OFF[rs].has(f)){const F=S.fac[f];if(F)F[side]=Math.min(F[side]||0,55);return}}}catch(e){}return _jA.apply(this,arguments)}}
{const _aSc=applyScen;applyScen=function(){scenSetup=true;try{return _aSc.apply(this,arguments)}finally{scenSetup=false}}}
// l'IA générale prend la main sur Carthage en miroir ; la Rome historique garde son IA (consuls, Fabius…)
const _aiTurnS=aiTurn;
aiTurn=function(){if(S.mirror){try{aiSide('rom')}catch(e){console.error(e)}return}const r=_aiTurnS.apply(this,arguments);if(S.gold.rom>600){try{aiRecruitMany('rom',400)}catch(e){}}if(S.auto){try{aiSide('car')}catch(e){console.error(e)}}return r};
{const _aiR=aiRome;aiRome=function(){if(S.mirror)return;return _aiR.apply(this,arguments)}}
{const _bA=bigActors;bigActors=function(){if(S.mirror)return;return _bA.apply(this,arguments)}}

/* ---------- 5. SCÉNARIOS ---------- */
const SCEN={
  218:{n:'218 : la guerre commence',d:"Sagonte est tombée. Hannibal attend à Nova Carthago, Rome a ses légions en Italie et en Sicile. La campagne complète, dix-sept ans.",day:0},
  216:{n:'216 : à la veille de Cannes',d:"Hannibal a franchi les Alpes, écrasé Rome à la Trébie et au lac Trasimène. Il campe en Apulie ; les consuls Varron et Paul Émile marchent contre lui avec la plus grande armée que Rome ait jamais levée. Les Gaulois de la plaine du Pô sont vos alliés.",day:2*360+120},
  211:{n:'211 : Capoue assiégée',d:"Capoue, Tarente et le Sud ont rejoint Carthage, Syracuse aussi ; mais Rome a tenu. Ses légions assiègent Capoue et Syracuse, et Hannibal doit choisir : sauver Capoue ou marcher sur Rome. En Hispanie, les deux Scipions viennent de mourir.",day:7*360+120},
  204:{n:'204 : Scipion en Afrique',d:"L'Hispanie est perdue, Capoue et Tarente reprises. Scipion débarque près d'Utique avec ses vétérans ; le Numide Massinissa est avec lui. Hannibal tient encore le Bruttium. Syphax est votre allié. Sauver Carthage.",day:14*360+60}};
function setOwn(ids,side){for(const id of ids){const i=NI[id];if(i==null)continue;S.own[id]=side;delete S.siege[id];
  S.armies=S.armies.filter(a=>!(a.g&&a.at===i&&a.side!==side))}}
function scenArmy(side,at,spec,name,extra){const n=N[NI[at]];if(!n)return null;const units=[];for(const [t,k] of spec)for(let j=0;j<k;j++)units.push({t,men:UT[t].men});
  const a=Object.assign({id:S.uid++,side,name,x:n.x,y:n.y,at:n.i,legs:[],units,scout:0,cool:0,mor:70,bag:true},extra||{});a.food=armyFoodMax(a);S.armies.push(a);return a}
function scenGar(side,ids,spec){for(const id of ids){const i=NI[id];if(i==null||ownerN(i)!==side||S.armies.some(a=>a.g&&a.at===i&&a.side===side))continue;scenArmy(side,id,spec,'Garnison '+deN(N[i].n),{g:true})}}
function clearField(side){S.armies=S.armies.filter(a=>a.side!==side||a.g);for(const g of S.gens||[])if(g.side===side&&g.army!=null)g.army=null}
function applyScen(k){const sc=SCEN[k];if(!sc||k==218)return;S.day=sc.day;S.ev=S.ev||{};Object.assign(S.ev,{scip:1,tras:1});clearField('car');clearField('rom');S.gens=[];S.riv=[];if(S.guid==null)S.guid=1;S.rally=S.rally||{};S.cand=S.cand||{};
  const C='car',R='rom';
  if(k==216){S.ev.portas=0;joinAlliance('ins',C);joinAlliance('lig',C);
    scenArmy(C,'arpi',[['lib',4],['iber',3],['gaul',5],['sling',2],['hcav',3],['ncav',3]],'Hannibal',{mor:88});
    scenArmy(C,'cnova',[['lib',2],['iber',3],['sling',1],['hcav',1],['ncav',1],['eleph',1]],'Hasdrubal');
    scenArmy(C,'carthago',[['lib',3],['ncav',1],['sling',1]],'Giscon');
    scenArmy(R,'canusium',[['legion',6],['velites',2],['rcav',1],['acav',1]],'L. Aemilius Paullus',{mor:72});
    scenArmy(R,'canusium',[['legion',6],['velites',2],['acav',1]],'C. Terentius Varro',{mor:72});
    scenArmy(R,'roma',[['legion',2],['velites',1]],'M. Minucius Rufus');
    setOwn(['tarraco','emporion'],R);scenArmy(R,'tarraco',[['legion',3],['velites',1],['rcav',1]],'Cn. Cornelius Scipio');scenArmy(R,'emporion',[['legion',2],['velites',1]],'P. Cornelius Scipio');
    S.vict=3;S.bigWin=2;S.gold.car=420;S.gold.rom=700;polInit();S.pol.bar=72}
  if(k==211){joinAlliance('ins',C);joinAlliance('syr',C);
    setOwn(['capua','tarentum','arpi','metapontum','thurii','croton','locri','consentia','grumentum'],C);
    scenGar(C,['capua'],[['lib',2],['iber',1]]);scenGar(C,['tarentum','croton','locri'],[['lib',1],['sling',1]]);
    scenArmy(C,'grumentum',[['lib',3],['iber',2],['gaul',3],['sling',1],['hcav',2],['ncav',3]],'Hannibal',{mor:70});
    scenArmy(C,'castulo',[['lib',2],['iber',4],['sling',1],['hcav',1],['ncav',1],['eleph',1]],'Hasdrubal');
    scenArmy(C,'gades',[['iber',3],['sling',1],['ncav',1]],'Magon');scenArmy(C,'carthago',[['lib',3],['ncav',1]],'Giscon');
    scenArmy(R,'capua',[['legion',5],['velites',2],['rcav',1]],'Q. Fulvius Flaccus',{mor:70});scenArmy(R,'capua',[['legion',4],['velites',2],['acav',1]],'Ap. Claudius Pulcher');
    scenArmy(R,'syracusae',[['legion',4],['velites',2],['rcav',1]],'M. Claudius Marcellus');scenArmy(R,'roma',[['legion',3],['velites',1]],'Q. Fabius Maximus');
    setOwn(['tarraco','emporion','saguntum'],R);scenArmy(R,'tarraco',[['legion',2],['velites',1]],'C. Claudius Nero');
    const sg=(id,a)=>{const n=N[NI[id]],x=S.armies.find(o=>o.name===a);if(x&&n)S.siege[id]={side:R,a:x.id,d:Math.round([5,15,30,60][n.size]*.55),need:[5,15,30,60][n.size]}};
    for(const a of S.armies)if(a.side===R&&!a.g&&(a.at===NI.capua||a.at===NI.syracusae)){const n=N[a.at];a.x=n.x+3;a.y=n.y+2}
    sg('capua','Q. Fulvius Flaccus');sg('syracusae','M. Claudius Marcellus');
    S.vict=5;S.bigWin=3;S.gold.car=320;S.gold.rom=520;polInit();S.pol.bar=58;S.ev.afr=0;S.ev.portas=0}
  if(k==204){joinAlliance('mae',C);joinAlliance('num',R);
    setOwn(N.filter(n=>!n.col&&S.own[n.id]==='car'&&['ibe','bal'].includes(n.cul)&&n.lon<1.6&&n.lat>36.6).map(n=>n.id),R);
    setOwn(['croton','consentia'],C);scenGar(C,['croton'],[['lib',2],['iber',1]]);
    scenArmy(C,'croton',[['lib',4],['iber',2],['gaul',2],['sling',1],['ncav',1]],'Hannibal',{mor:62});
    scenArmy(C,'genua',[['gaul',3],['iber',2],['sling',1]],'Magon');setOwn(['genua'],C);
    scenArmy(C,'carthago',[['lib',4],['iber',2],['ncav',2],['eleph',2]],'Hasdrubal le Chauve');scenArmy(C,'siga',[['ncav',4],['lib',2]],'Syphax');
    scenArmy(R,'utica',[['legion',6],['velites',2],['rcav',2],['acav',2]],'P. Cornelius Scipio l’Africain',{mor:85});const u=N[NI.utica];S.armies[S.armies.length-1].x=u.x+4;
    scenArmy(R,'rhegium',[['legion',3],['velites',1]],'P. Licinius Crassus');scenArmy(R,'roma',[['legion',2],['velites',1]],'M. Cornelius Cethegus');
    scenArmy(R,'cnova',[['legion',3],['velites',1],['acav',1]],'L. Cornelius Lentulus');
    scenGar(R,['cnova','gades','castulo','saguntum'],[['legion',1],['velites',1]]);
    S.vict=6;S.defeats=4;S.bigWin=3;S.gold.car=360;S.gold.rom=900;polInit();S.pol.bar=48;S.ev.afr=1}
  for(const id in S.q)delete S.q[id];syncGens();genInit();
  for(const g of S.gens){const b=BORN[g.name];if(b)g.born=b;if(g.name==='Hannibal')g.xp=Math.max(g.xp,k==216?17:20)}
  for(const a of S.armies)if(a.food==null)a.food=armyFoodMax(a);
  S.t0=N.filter(n=>!n.col&&S.own[n.id]==='car').length;S.scen=+k;territoryDirty=true;
  S.log=[];log(`${sc.n.replace(/^\d+ : /,'').replace(/^./,m=>m.toUpperCase())} : ${cal(S.day).season.toLowerCase()} ${cal(S.day).year} av. J.-C.`)}
function startScen(k,side,df){newGame();S.diff=DIFF[df]?df:'normal';try{tradeInit();genInit();applyScen(k)}catch(e){console.error(e)}
  if(side==='rom')mirrorGame();S.started=false;S.paused=true;save();afterLoad();closeModal();
  const sc=SCEN[k];modal(`<h2>${sc.n}</h2><p>${side==='rom'?'Vous commandez Rome. ':''}${sc.d}</p>${side==='rom'?`<p class="sub">${ROME_TXT}</p>`:''}<div class="row"><button class="go" id="mGo" type="button">Commencer</button><button id="mHelp" type="button">Comment jouer</button></div>`);
  $('mGo').onclick=()=>{closeModal();const h=S.armies.find(a=>a.side==='car'&&!a.g)||S.armies[0];centerOn(h.x,h.y,1.1)};$('mHelp').onclick=openHelp}
function openScen(){let side='car',df=(S&&S.diff)||'normal';const draw=()=>{modal(`<h2>Nouvelle campagne</h2><p class="sub">Choisissez votre camp, la difficulté et le moment de la guerre où vous entrez. La partie en cours sera remplacée.</p>
  <div class="row"><button id="sdC" type="button" class="${side==='car'?'on':''}">Carthage</button><button id="sdR" type="button" class="${side==='rom'?'on':''}">Rome</button><button id="sdM" type="button" class="${side==='mac'?'on':''}">Macédoine</button><button id="sdS" type="button" class="${side==='syr'?'on':''}">Syracuse</button></div>${difRow(df,'scDif')}
  ${side==='mac'?`<div class="rec"><span><b>215 : Philippe V et Hannibal</b><br><span class="sub">${MAC_TXT}</span></span><button class="go" id="scMac" type="button">Jouer</button></div>`:side==='syr'?`<div class="rec"><span><b>214 : Syracuse rompt avec Rome</b><br><span class="sub">${SYR_TXT}</span></span><button class="go" id="scSyr" type="button">Jouer</button></div>`:Object.keys(SCEN).map(k=>`<div class="rec"><span><b>${SCEN[k].n}</b><br><span class="sub">${SCEN[k].d}</span></span><button class="go" data-scn="${k}" type="button">Jouer</button></div>`).join('')}
  <div class="row" style="justify-content:flex-end"><button id="mClose" type="button">Annuler</button></div>`);$('mcard').classList.add('wide');
  $('sdC').onclick=()=>{side='car';draw()};$('sdR').onclick=()=>{side='rom';draw()};$('sdM').onclick=()=>{side='mac';draw()};$('sdS').onclick=()=>{side='syr';draw()};if($('scMac'))$('scMac').onclick=()=>scenGo(()=>startMac(df),'mac','mac',df);if($('scSyr'))$('scSyr').onclick=()=>scenGo(()=>startSyr(df),'syr','syr',df);$('mClose').onclick=closeModal;
  document.querySelectorAll('#scDif [data-dif]').forEach(b=>b.onclick=()=>{df=b.dataset.dif;draw()});
  document.querySelectorAll('[data-scn]').forEach(b=>b.onclick=()=>scenGo(()=>startScen(b.dataset.scn,side,df),b.dataset.scn,side,df))};draw()}
// après une partie macédonienne, les tables du jeu ont changé : on recharge la page avant toute autre partie
function scenGo(f,k,side,df){if(peoDone&&peoDone!==k&&k!=null){try{sessionStorage.setItem('bellum.scenPend',JSON.stringify({k,side,df}));localStorage.removeItem(SAVE)}catch(e){f();return}location.reload();return}f()}
setTimeout(()=>{let P=null;try{P=JSON.parse(sessionStorage.getItem('bellum.scenPend')||'null');sessionStorage.removeItem('bellum.scenPend')}catch(e){}if(P)try{if(P218[P.k]&&P.side==='218')startPeo218(P.k,P.df);else if(P.k==='mac')startMac(P.df);else if(P.k==='syr')startSyr(P.df);else if(P.k==='ath')startAth(P.df);else startScen(P.k,P.side,P.df)}catch(e){console.error(e)}},1200);
const _openMenuS=openMenu;
openMenu=function(){_openMenuS.apply(this,arguments);try{$('mNew').onclick=openScen;const row=$('mNew').parentNode;
  const t=document.createElement('button');t.type='button';t.id='mTest';t.textContent='Partie test (ordinateur contre ordinateur)';t.title='Les deux camps joués par l’ordinateur, pour vérifier l’équilibre ; votre partie est conservée';t.onclick=openAutoTest;row.insertBefore(t,$('mClose'));
  const h=document.createElement('div');h.innerHTML='<h3 style="margin:14px 0 4px">Difficulté</h3>'+difRow((S&&S.diff)||'normal','mnDif');row.after(h);
  h.querySelectorAll('[data-dif]').forEach(b=>b.onclick=()=>{S.diff=b.dataset.dif;save();log('Difficulté : '+DIFF[S.diff].n+'.');openMenu()})}catch(e){console.error(e)}};
const _openHelpIntroS=openHelpIntro;
openHelpIntro=function(){_openHelpIntroS.apply(this,arguments);try{const row=$('mGo').parentNode;const b=document.createElement('button');b.type='button';b.textContent='Autre scénario ou jouer Rome…';b.onclick=openScen;row.appendChild(b)}catch(e){}};

/* ---------- 5 bis. DIFFICULTÉ ---------- */
const DIFF={facile:{n:'Facile',ai:.8,bat:1.18,sen:.6,d:"L'ennemi a moins d'or pour lever ses troupes, vos armées l'emportent un peu plus souvent et le Sénat pardonne plus vite."},
  normal:{n:'Normal',ai:1,bat:1,sen:1,d:"Les règles telles quelles."},
  difficile:{n:'Difficile',ai:1.25,bat:.88,sen:1.35,d:"L'ennemi a un quart d'or en plus, il gagne plus souvent les batailles serrées et le Sénat vous passe moins de choses."}};
const dif=()=>DIFF[(S&&S.diff)||'normal']||DIFF.normal;
const difOn=()=>S&&!S.auto&&!(S.mpP&&Object.keys(S.mpP).length>1);
{const _incD=income;income=function(side){const r=_incD.apply(this,arguments);try{if(difOn()&&side==='rom'&&dif().ai!==1)return {inc:Math.round(r.inc*dif().ai),up:r.up}}catch(e){}return r}}
{const _oddsD=odds;odds=function(b){let p=_oddsD.apply(this,arguments);try{const k=dif().bat;if(difOn()&&k!==1&&p>0&&p<1){const A=S.armies.find(x=>x.id===b.att[0]),D=S.armies.find(x=>x.id===b.def[0]);
  const f=A&&A.side==='car'?k:D&&D.side==='car'?1/k:1;if(f!==1){const r=p/(1-p)*f;p=r/(1+r)}}}catch(e){}return p}}
{const _senD=senAdj;senAdj=function(v){if(difOn()&&v<0)v*=dif().sen;return _senD.call(this,v)}}
function difRow(cur,id){return `<div class="row" id="${id}">${Object.keys(DIFF).map(k=>`<button type="button" data-dif="${k}" class="${cur===k?'on':''}" title="${DIFF[k].d}">${DIFF[k].n}</button>`).join('')}</div><p class="sub" style="margin-top:0">${DIFF[cur].d}</p>`}
/* ---------- 6. PARTIE TEST : l'ordinateur joue les deux camps, puis rapport d'équilibre ---------- */
const _saveA=save;save=function(){if(S&&S.auto)return;return _saveA.apply(this,arguments)};
const _startBattleA=startBattle;
startBattle=function(att,defs){if(S&&S.auto){const b={att:[att.id],def:defs.map(d=>d.id),x:(att.x+defs[0].x)/2,y:(att.y+defs[0].y)/2,node:nearestNode((att.x+defs[0].x)/2,(att.y+defs[0].y)/2).i};applyResult(b,autoResolve(b));return}
  return _startBattleA.apply(this,arguments)};
{const _ec=evCard;evCard=function(t,x,p){if(S&&S.auto){log(`${t} : ${x}`);return}return _ec.apply(this,arguments)}}
{const _gr=genRevolt;genRevolt=function(g){if(S&&S.auto){g.loy=50;return}return _gr.apply(this,arguments)}}
function autoSnap(){const W=warScore(),men=s=>Math.round(S.armies.filter(a=>a.side===s).reduce((t,a)=>t+armyMen(a),0)),tw=s=>N.filter(n=>!n.col&&ownerN(n.i)===s).length,inc=s=>{const r=income(s);return r.inc-r.up};
  return {d:Math.floor(S.day),y:yearNow(),gc:Math.round(S.gold.car),gr:Math.round(S.gold.rom),tc:tw('car'),tr:tw('rom'),mc:men('car'),mr:men('rom'),ic:inc('car'),ir:inc('rom'),w:W.v,sen:S.pol?Math.round(S.pol.bar):0,soc:W.soc}}
function autoRun(years,scen,onStep){const back=JSON.stringify(S);let R;
  try{newGame();tradeInit();genInit();if(scen&&scen!=218)applyScen(scen);S.auto=true;S.paused=false;const own0=Object.assign({},S.own);
    const end=Math.min(END_DAY,S.day+years*360),T=[autoSnap()],B={n:0,cw:0,rw:0},tk0=(S.chron||[]).length;
    const _ar=applyResult;applyResult=function(b,res){B.n++;const a=S.armies.find(x=>x.id===b.att[0]),s=a&&a.side;if(s){if((res.attWin?s:(s==='car'?'rom':'car'))==='car')B.cw++;else B.rw++}return _ar.apply(this,arguments)};
    let guard=0;
    try{while(S.day<end&&!S.over&&guard++<200000){if(S.cur){const b=S.cur;S.cur=null;applyResult(b,autoResolve(b))}tick(.25);if(Math.floor(S.day*4)%120===0){computeVis();for(const a of S.armies)if(a.side!=='car'&&visOfArmy(a)>0)S.intel[a.id]={x:a.x,y:a.y,d:Math.floor(S.day)}}
      if(Math.floor(S.day)%30===0&&T[T.length-1].d!==Math.floor(S.day))T.push(autoSnap());if(onStep&&guard%400===0)onStep(S.day,end)}}
    finally{applyResult=_ar}
    T.push(autoSnap());R={T,B,over:S.over,overMsg:S.overMsg,end:Math.floor(S.day),scen:scen||218,years,chron:(S.chron||[]).slice(tk0).map(e=>({d:e.d,t:e.t})),log:S.log.slice(0,20).map(l=>l.t)};R.moves={};for(const n of N){if(n.col)continue;const o=S.own[n.id];if(o!==own0[n.id]&&(o==='car'||o==='rom')){const rs=realSide(o),M=R.moves[rs]=R.moves[rs]||{};const k=n.reg||'?';M[k]=(M[k]||0)+1}}R.verdict=autoVerdict(R)}
  finally{S=JSON.parse(back);try{fixOldSave();afterLoad()}catch(e){console.error(e)}}
  return R}
function autoVerdict(R){const T=R.T,f=T[0],l=T[T.length-1],V=[];const avg=k=>Math.round(T.reduce((s,x)=>s+x[k],0)/T.length);
  if(avg('gc')>1500)V.push('Carthage accumule trop d’or (moyenne '+avg('gc')+') : revenus trop généreux ou rien à dépenser.');
  if(avg('gr')>1500)V.push('Rome accumule trop d’or (moyenne '+avg('gr')+').');
  if(l.tc<f.tc*.6)V.push('Carthage s’effondre : '+f.tc+' villes au départ, '+l.tc+' à la fin.');
  if(l.tr<f.tr*.6)V.push('Rome s’effondre : '+f.tr+' villes au départ, '+l.tr+' à la fin.');
  if(Math.abs(l.tc-f.tc)<=2&&Math.abs(l.tr-f.tr)<=2&&R.years>=3)V.push('Front figé : presque aucune ville n’a changé de main en '+R.years+' ans.');
  if(R.B.n<R.years*2)V.push('Peu de batailles ('+R.B.n+') : les IA évitent le combat.');
  if(l.sen<15)V.push('Le Sénat de Carthage s’écroule ('+l.sen+').');
  if(l.w>=60)V.push('Score de guerre très favorable à Carthage ('+l.w+').');if(l.w<=-60)V.push('Score de guerre très favorable à Rome ('+l.w+').');
  if(!V.length)V.push('Rien d’anormal : les deux camps restent dans la partie.');return V}
function autoTxt(R){const T=R.T;return `PARTIE TEST · scénario ${R.scen} · ${R.years} an(s) · fin au jour ${R.end}${R.over?' · '+(R.overMsg?R.overMsg.title:R.over):''}\n\nVERDICT\n- `+R.verdict.join('\n- ')+
  `\n\nBATAILLES : ${R.B.n} (Carthage ${R.B.cw}, Rome ${R.B.rw})\n\nMOIS PAR MOIS (an, or Carthage/Rome, villes, hommes, solde mensuel, score, Sénat)\n`+T.map(x=>`${x.y} j${x.d}  or ${x.gc}/${x.gr}  villes ${x.tc}/${x.tr}  hommes ${x.mc}/${x.mr}  solde ${x.ic}/${x.ir}  score ${x.w}  sénat ${x.sen}`).join('\n')+
  `\n\nCHRONIQUE\n`+R.chron.map(e=>`${cal(e.d).year} ${MONTHS[cal(e.d).mo]} : ${e.t}`).join('\n')}
function autoChart(T){const W=520,H=150,mx=Math.max(1,...T.map(x=>Math.max(x.tc,x.tr))),n=Math.max(1,T.length-1);
  const line=(k,c)=>`<polyline fill="none" stroke="${c}" stroke-width="2" points="${T.map((x,i)=>`${(i/n*W).toFixed(1)},${(H-x[k]/mx*(H-10)).toFixed(1)}`).join(' ')}"/>`;
  const mg=Math.max(1,...T.map(x=>Math.max(x.gc,x.gr)));const gl=(k,c)=>`<polyline fill="none" stroke="${c}" stroke-width="1.2" stroke-dasharray="4 3" points="${T.map((x,i)=>`${(i/n*W).toFixed(1)},${(H-x[k]/mg*(H-10)).toFixed(1)}`).join(' ')}"/>`;
  return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;background:rgba(0,0,0,.2);border-radius:4px">${line('tc','#9b6fd6')}${line('tr','#e2665a')}${gl('gc','#9b6fd6')}${gl('gr','#e2665a')}</svg>
    <p class="sub">Traits pleins : villes tenues (violet Carthage, rouge Rome). Pointillés : trésor.</p>`}
function openAutoTest(){modal(`<h2>Partie test</h2><p>L'ordinateur joue Carthage et Rome à toute vitesse, batailles résolues automatiquement, puis un rapport dit ce qui paraît trop facile ou trop dur. Votre partie en cours est mise de côté et reprise ensuite.</p>
  <div class="row"><select id="atS">${Object.keys(SCEN).map(k=>`<option value="${k}">${SCEN[k].n}</option>`).join('')}</select><select id="atY"><option value="1">1 an</option><option value="3" selected>3 ans</option><option value="6">6 ans</option><option value="17">jusqu'à la fin</option></select><button class="go" id="atGo" type="button">Lancer</button><button id="mClose" type="button">Annuler</button></div><p class="sub" id="atP"></p>`);
  $('mClose').onclick=closeModal;$('atGo').onclick=()=>{$('atP').textContent='Simulation en cours… (quelques secondes par année)';$('atGo').disabled=true;
    setTimeout(()=>{let R;try{R=autoRun(+$('atY').value,+$('atS').value)}catch(e){console.error(e);$('atP').textContent='Erreur : '+e.message;return}showAuto(R)},60)}}
function showAuto(R){const l=R.T[R.T.length-1],f=R.T[0];
  modal(`<h2>Rapport de la partie test</h2><p class="sub">Scénario ${R.scen}, ${R.years} an(s) simulé(s)${R.over?' · fin : '+esc(R.overMsg?R.overMsg.title:R.over):''}.</p>
   <h3>Verdict</h3><ul>${R.verdict.map(v=>`<li>${esc(v)}</li>`).join('')}</ul>
   ${autoChart(R.T)}
   <table class="dip"><tr><th></th><th>Carthage</th><th>Rome</th></tr><tr><td>Villes</td><td>${f.tc} → ${l.tc}</td><td>${f.tr} → ${l.tr}</td></tr><tr><td>Trésor</td><td>${f.gc} → ${l.gc}</td><td>${f.gr} → ${l.gr}</td></tr>
     <tr><td>Hommes</td><td>${f.mc.toLocaleString('fr-FR')} → ${l.mc.toLocaleString('fr-FR')}</td><td>${f.mr.toLocaleString('fr-FR')} → ${l.mr.toLocaleString('fr-FR')}</td></tr><tr><td>Batailles gagnées</td><td>${R.B.cw}</td><td>${R.B.rw}</td></tr><tr><td>Score de guerre</td><td colspan="2">${f.w} → ${l.w}</td></tr></table>
   <h3>Faits marquants</h3><div style="max-height:30vh;overflow:auto" class="sub">${R.chron.slice(-40).map(e=>`${cal(e.d).year} : ${esc(e.t)}`).join('<br>')||'—'}</div>
   <div class="row" style="justify-content:flex-end"><button id="atDl" type="button">Télécharger le rapport</button><button class="go" id="mClose" type="button">Revenir à ma partie</button></div>`);
  $('mcard').classList.add('wide');$('mClose').onclick=closeModal;$('atDl').onclick=()=>dlText('rapport-partie-test.txt',autoTxt(R))}
function dlText(name,txt){const local=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([txt],{type:'text/plain'}));a.download=name;document.body.appendChild(a);a.click();a.remove()};
  const c=window.claude&&window.claude.use?window.claude.use('downloads'):null;if(!c){local();return}
  c.then(d=>{if(!d){local();return}d.save({filename:name,data:txt}).catch(e=>{if(e&&e.code!=='declined')log("Le téléchargement n'est pas disponible ici.")})}).catch(local)}

/* ---------- 7. JOUER ROME : la partie en miroir, avec la politique, les alliés et les fins propres à Rome ---------- */
const ROME_TXT="Rome se gouverne autrement que Carthage : chaque printemps, le peuple élit deux consuls. Le Sénat veut leur confier vos deux plus grandes armées ; vous pouvez proroger vos généraux, mais cela coûte de l'appui. Gardez vos alliés italiens fidèles : quand l'ennemi rôde près de chez eux et que vous perdez, ils passent à Carthage. Vous gagnez en prenant Carthage, ou en tenant jusqu'en 201 avec un score positif ; vous perdez si Rome tombe, si l'Italie vous lâche ou si le peuple se lasse de la guerre.";
function mirrorGame(){if(typeof mpSwap!=='function')return false;const s=mpSwap(S);S=s;S.mirror=true;mirrorStatic();
  for(const f in S.fac){const F=S.fac[f];const m=/^(tribut_|pacte_)(car|rom)$/.exec(F.st||'');if(m)F.st=m[1]+(m[2]==='car'?'rom':'car')}
  for(const a of S.armies)if(a.side==='car'&&a.name.startsWith('Socii – '))a.name=a.name.replace('Socii – ','Alliés – ');
  S.intel=S.intel||{};S.intelR=S.intelR||{};S.msg=S.msg||[];S.rep=S.rep||{};S.pol=S.pol||{};S.pol.bar=60;S.pol.cd=0;S.pol.low=0;delete S.pol.dict;S.rpol={pro:{}};
  log("Vous commandez Rome. Le Sénat attend vos ordres.");mirObserve();return true}
// textes du jeu écrits pour Carthage : en miroir, « Romains » désigne l'ennemi, donc Carthage
const MIR_RX=/Les Romains (pillent|coupent|assiègent|donnent)|patrouille romaine|La flotte romaine|une armée romaine|aucune armée romaine|garnison romaine et ouvre ses portes à Carthage|grande famille carthaginoise/;
const MIR_W=[['Les Romains','Les Carthaginois'],['romaines','carthaginoises'],['romaine','carthaginoise'],['romains','carthaginois'],['romain','carthaginois'],['à Carthage','à Rome']];
function mirTxt(t){const tok=[];MIR_W.forEach(([a,b],i)=>{t=t.split(a).join('\u0001'+i+'a\u0002');t=t.split(b).join('\u0001'+i+'b\u0002')});
  return t.replace(/\u0001(\d+)([ab])\u0002/g,(_,i,k)=>MIR_W[+i][k==='a'?1:0])}
{const _logM=log;log=function(t){if(S&&S.mirror&&typeof t==='string'&&MIR_RX.test(t))t=mirTxt(t);return _logM.apply(this,[t].concat([].slice.call(arguments,1)))}}
// fenêtres et panneaux écrits pour Carthage : en miroir, phrases remises du point de vue de Rome
const MIR_PH=[
  ["une armée romaine peut intercepter l'ambassade","une armée carthaginoise peut intercepter l'ambassade"],
  ["Les alliés italiens de Rome","Vos alliés italiens"],
  ["Rome tient l'Italie par ses alliés. Chaque victoire punique, surtout en Italie, ébranle leur fidélité ; une armée punique proche (4 régiments ou plus) les fait réfléchir ; piller leurs terres les rejette vers Rome. Sous 25, une ville proche d'une de vos armées peut chasser sa garnison et passer à Carthage. Les colonies latines ne trahissent jamais.",
   "Rome tient l'Italie par ses alliés. Chaque victoire d'Hannibal, surtout en Italie, ébranle leur fidélité ; une armée carthaginoise proche (4 régiments ou plus) les fait réfléchir ; quand l'ennemi pille leurs terres, ils se serrent contre vous. Sous 25, une ville proche d'une armée carthaginoise peut chasser votre garnison et passer à Carthage. Vos victoires, les jeux et une armée romaine à leurs côtés les retiennent. Les colonies latines ne trahissent jamais."],
  ["Alliance : ils rejoignent Carthage avec","Alliance : ils rejoignent Rome avec"],
  ["Les tributaires (soumis par les Barcides) paient la moitié du revenu de leurs villes ; ils restent fidèles quand une armée punique est proche et tant que vous gardez leurs otages à Sagonte",
   "Les tributaires de Carthage (soumis par les Barcides) lui paient la moitié du revenu de leurs villes ; ils lui restent fidèles quand une armée punique est proche et tant qu'elle garde leurs otages à Sagonte (vos agents peuvent attiser leur révolte)"],
  ["menacée par une armée romaine","menacée par une armée carthaginoise"],
  ["Une armée romaine à moins de 30 km","Une armée carthaginoise à moins de 30 km"],
  ["Rome a aussi ses espions","Carthage a aussi ses espions"],
  ["chez un allié italien de Rome : sa fidélité baisse de 12","chez un tributaire de Carthage (Carpétans, Olcades, Vaccéens…) : sa fidélité baisse de 12"],
  ["le général de l'armée romaine la plus proche","le général de l'armée carthaginoise la plus proche"],
  ["Semer la discorde à Rome","Semer la discorde à Carthage"],
  ["rumeurs au forum : les consuls se disputent (Rome devient prudente), alliés −4, Rome −80 or","rumeurs de trahison au Sénat punique : Carthage retient l'or de ses généraux (−100 or)"],
  ["déjoue les agents romains","déjoue les agents carthaginois"],
  ["écu violet","écu rouge"],
  ["Les Romains coupent parfois un pont devant une armée carthaginoise","Les Carthaginois coupent parfois un pont devant une armée romaine"],
  ["Les Romains sont soumis aux mêmes règles.","Les Carthaginois sont soumis aux mêmes règles."],
  ["nettement plus que pour Rome","nettement plus que pour Carthage"],
  [" Prendre Rome. Vous perdez si Carthage tombe."," Prendre Carthage. Vous perdez si Rome tombe."]];
function mirFix(root){if(!S||!S.mirror||!root)return;
  const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT),L=[];while(w.nextNode())L.push(w.currentNode);
  for(const t of L){let v=t.nodeValue;const o=v;for(const [a,b] of MIR_PH)if(v.indexOf(a)>=0)v=v.split(a).join(b);if(v!==o)t.nodeValue=v}
  root.querySelectorAll('.att>span:first-child:not([data-mir])').forEach(e=>{e.dataset.mir='1';const v=e.textContent;if(v==='Carthage')e.textContent='Rome';else if(v==='Rome')e.textContent='Carthage'})}
const SPQR_SVG='<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M12 3l2 3h-4z" fill="currentColor"/><text x="12" y="15.2" text-anchor="middle" font-size="6.6" font-family="Georgia,serif" font-weight="700" fill="currentColor">SPQR</text><path d="M5 18h14" stroke="currentColor" stroke-width="1.2"/></svg>';
function mirMed(m){if(m&&!m.dataset.mir){m.dataset.mir='1';m.innerHTML=SPQR_SVG}}
function mirTop(){if(!S||!S.mirror)return;mirMed(document.querySelector('.ui-fac .ui-med'));if(!sel)mirMed(document.querySelector('#side .ui-head .ui-med'));const f=document.querySelector('.ui-fac b');if(f&&f.textContent==='Carthage'){f.textContent='Rome';const sm=f.nextElementSibling;if(sm)sm.textContent='Sénat et peuple romain';const fac=f.closest('.ui-fac');if(fac)fac.title='Roma Delenda Est, campagne de la 2e guerre punique, côté romain'}}
// observe les panneaux (les autres modules les redessinent après nous) ; changer un texte ne relance pas l'observateur
let _mirObs=null;
function mirApply(){if(!S||!S.mirror)return;try{mirFix($('mcard'));const el=$('side');mirFix(el);if(!sel){const h=el&&el.querySelector('h2');if(h&&h.textContent==='Carthage')h.textContent='Rome'}mirTop()}catch(e){}}
function mirObserve(){if(_mirObs||typeof MutationObserver==='undefined')return;_mirObs=new MutationObserver(mirApply);
  ['side','top','mcard'].forEach(id=>{const e=$(id);if(e)_mirObs.observe(e,{childList:true,subtree:true})})}
try{mirObserve()}catch(e){}
// bataille 3D : couleurs et noms du peuple joué
{const _diveM=dive;dive=function(payload){try{if(payload&&payload.b)payload.b.pk=S&&S.peo==='mac'?['mac','rom']:S&&S.peo==='syr'?['syr','rom']:S&&S.peo==='ath'?['ath','mac']:S&&PX&&PX[S.peo]?[PX[S.peo].pal,PX[S.peo].foePal]:S&&S.mirror?['rom','car']:['car','rom'];
    // l'adversaire réel (un peuple neutre, une tribu, Carthage pour Massalia…) : ses couleurs et son nom, pas ceux de l'ennemi principal
    const b=S&&S.cur,ea=b&&S.armies.find(x=>x.id===(b.attMine?b.def[0]:b.att[0])),es=ea&&ea.side;
    if(es&&payload.b.pk){const k=es==='pun'||(S.mirror&&es==='rom')?'car':es==='car'?payload.b.pk[0]:es;const F=FAC[es]||{};
      if(k!==payload.b.pk[1]){payload.b.pk=[payload.b.pk[0],k];payload.b.pkx=[null,{n:sideName(es),c:F.c||[120,120,120]}]}}}catch(e){}return _diveM.apply(this,arguments)}}
function mirrorStatic(){if(typeof mpSwapStatic==='function')mpSwapStatic();const t=AUX.car;AUX.car=AUX.rom;AUX.rom=t;document.title='Roma Delenda Est · Rome'}
const _afterLoadR=afterLoad;afterLoad=function(){if(S&&S.mirror&&!(typeof MP!=='undefined'&&MP.swapped))mirrorStatic();if(S&&S.mirror)mirObserve();return _afterLoadR.apply(this,arguments)};
// la politique romaine : Sénat, consuls, prorogation, levées, jeux
const CONS_EXTRA=['M. Valerius Laevinus','Cn. Fulvius Centumalus','P. Sulpicius Galba','Ti. Claudius Nero','Q. Caecilius Metellus','L. Veturius Philo','P. Licinius Crassus','Ti. Sempronius Tuditanus','M. Cornelius Cethegus','Cn. Servilius Caepio','C. Servilius Geminus','Ti. Claudius Nero'];
function consulsOf(y){const C=CONSULS[y];if(C)return C.map(c=>c[0]);return [CONS_EXTRA[(y*3)%CONS_EXTRA.length],CONS_EXTRA[(y*5+1)%CONS_EXTRA.length]]}
function romPolMonthly(d){const P=S.pol;if(P.cd>0)P.cd--;const foe=sideOfReal('car');
  const inv=S.armies.filter(a=>a.side===foe&&!a.g&&!a.dead&&!a.ship&&a.units.length>=5&&inItaly(a.x,a.y));if(inv.length){senAdj(-1.5*inv.length);if(Math.random()<.3)log("L'ennemi ravage l'Italie : au forum, on réclame des généraux qui se battent.")}
  if(S.gold.car<=0)senAdj(-3);P.bar+=P.bar<50?.5:P.bar>50?-.5:0;const sub=SUBS(P.bar);if(sub)S.gold.car+=sub;
  if(P.bar<20){P.low++;if(P.low===1)log("Le peuple romain se lasse : le Sénat rechigne à voter l'impôt de guerre.");S.gold.car=Math.max(0,S.gold.car-15)}else P.low=0;
  const c=cal(d);if(c.mo===2&&d>0)romElectPlayer(c.year)}
function romElectPlayer(y){const names=consulsOf(y);S.rpol=S.rpol||{pro:{}};const big=S.armies.filter(a=>a.side==='car'&&!a.g&&!a.dead&&a.reinf==null).sort((a,b)=>strength(b)-strength(a)).slice(0,2);
  S.pol.cons=names.map(n=>[n,'p']);log(`Le peuple élit ses consuls pour ${y} : ${names.join(' et ')}.`);if(!big.length)return;
  const go=(keep)=>{closeModal();big.forEach((a,k)=>{if(keep[k]){senAdj(-8);const g=genOf(a);if(g)log(`${g.name} est prorogé à la tête de son armée (appui −8).`);return}
      const g=mkGen('car',names[k]);genLife(g);g.xp=Math.max(g.xp,3);S.gens.push(g);giveGen(a,g);log(`Le consul ${g.name} prend le commandement de ${a.title||'l’armée'}.`)});renderAll()};
  if(S.auto){go([true,true]);return}S.paused=true;
  const keep=big.map(()=>false);
  const draw=()=>{modal(`<h2>Élections consulaires de ${y}</h2><p>Le peuple a élu <b>${names.join('</b> et <b>')}</b>. Selon la coutume, le Sénat leur confie les deux plus grandes armées de la République.</p>
    ${big.map((a,k)=>{const g=genOf(a);return `<div class="rec"><span><b>${esc(a.title||a.name)}</b> <span class="sub">· ${g?esc(g.name)+' '+starTxt(stars(g)):'sans général'} → consul ${esc(names[k])}</span></span><button data-kp="${k}" type="button" class="${keep[k]?'on':''}" title="Garder ce général (appui du Sénat −8)">${keep[k]?'Prorogé':'Proroger'}</button></div>`}).join('')}
    <p class="sub">Un consul arrive sans expérience, mais le peuple l'a choisi ; un général prorogé garde ses étoiles et ses traits. Appui du Sénat : ${Math.round(S.pol.bar)}.</p>
    <div class="row" style="justify-content:flex-end"><button class="go" id="kOk" type="button">Valider</button></div>`);
    document.querySelectorAll('[data-kp]').forEach(b=>b.onclick=()=>{keep[+b.dataset.kp]=!keep[+b.dataset.kp];draw()});$('kOk').onclick=()=>go(keep)};
  draw()}
function romSenAction(k){const P=S.pol;
  if(k==='games'){if(S.gold.car<100)return;S.gold.car-=100;senAdj(8);log("Vous donnez des jeux au peuple : le Sénat vous suit (+8).")}
  if(k==='levy'){if(P.cd>0||P.bar<40)return;P.cd=4;senAdj(-8);const n=N[NI.roma];scenArmy('car','roma',[['legion',4],['velites',2],['rcav',1]],nextGen('car'));syncGens();log("Le Sénat vote une levée : quatre légions se rassemblent à Rome (appui −8).")}
  if(k==='volones'){if(P.cd>0||!(S.defeats>=2))return;P.cd=6;scenArmy('car','roma',[['legion',2],['velites',2]],'Volones');syncGens();S.gold.car=Math.max(0,S.gold.car-60);log("Rome arme huit mille esclaves volontaires, les volones, contre la promesse de la liberté.")}
  renderAll();openPol()}
function openPolRome(){const P=S.pol,b=Math.round(P.bar),c=cal(Math.floor(S.day)),W=warScore();
  modal(`<h2>Politique</h2><h3 style="margin:10px 0 4px">Le Sénat et le peuple romain</h3>
   <p class="sub">Vos victoires, vos conquêtes et les jeux renforcent l'appui du Sénat ; les défaites, les villes perdues, l'ennemi en Italie et un trésor vide l'usent. Sous 20, le peuple refuse l'impôt de guerre ; à 0, Rome traite avec Carthage.</p>
   <div class="att" style="grid-template-columns:90px 1fr 90px"><span>Lassitude</span><span class="g"><i style="background:var(--punic);left:0;width:${b}%"></i></span><span style="text-align:right">Appui ${b}</span></div>
   <p>Tribut voté : <b>${SUBS(P.bar)}</b> or par mois. Consuls de ${c.year} : <b>${(P.cons||[]).map(x=>x[0]).join('</b> et <b>')||'—'}</b>.</p>
   <div class="row"><button id="rG" type="button" ${S.gold.car<100?'disabled':''} title="Appui +8">Donner des jeux (100)</button><button id="rL" type="button" ${P.cd>0||P.bar<40?'disabled':''} title="Appui 40 au moins ; 7 régiments à Rome ; appui −8">Voter une levée${P.cd>0?' (dans '+P.cd+' mois)':''}</button><button id="rV" type="button" ${P.cd>0||!(S.defeats>=2)?'disabled':''} title="Après deux défaites : 4 régiments d'esclaves volontaires (60 or)">Armer les volones (60)</button></div>
   <h3 style="margin:16px 0 4px">Score de guerre : ${W.v}</h3><p class="sub">${W.P.filter(p=>p[1]).map(p=>`${p[0]} ${p[1]>0?'+':'−'}${Math.abs(p[1])}`).join(', ')||'Rien encore.'}</p>
   <p class="sub">Comment gagner : prendre Carthage ; ou atteindre 60 au score de guerre, et Carthage demandera la paix ; ou finir au printemps 201 avec un score positif. On perd si Rome tombe, si l'appui du Sénat tombe à 0, si 40 % des alliés italiens passent à Carthage, ou en 201 avec un score négatif ou nul.</p>
   <div class="row" style="justify-content:flex-end"><button class="go" id="mClose" type="button">Fermer</button></div>`);
  $('rG').onclick=()=>romSenAction('games');$('rL').onclick=()=>romSenAction('levy');$('rV').onclick=()=>romSenAction('volones');$('mClose').onclick=closeModal}
{const _op=openPol;openPol=function(){if(S.mirror)return openPolRome();return _op.apply(this,arguments)}}
{const _pm=polMonthly;polMonthly=function(d){if(S.mirror){polInit();return romPolMonthly(d)}return _pm.apply(this,arguments)}}
// les alliés italiens en miroir : l'armée de Carthage les travaille, les vôtres les rassurent
{const _sm=socMonthly;socMonthly=function(){if(!S.mirror)return _sm.apply(this,arguments);socInit();const foe=sideOfReal('car');
  for(const g in SOCII){const G=S.soc[g];if(G.cd>0)G.cd--;const T=socTowns(g).map(id=>N[NI[id]]);
    if(T.some(n=>S.armies.some(a=>a.side===foe&&!a.g&&!a.dead&&a.units.length>=4&&Math.hypot(a.x-n.x,a.y-n.y)<120)))socAdj(g,-2);else if(G.fid<SOCII[g].f0)socAdj(g,1);
    if(T.some(n=>S.armies.some(a=>a.side==='car'&&!a.g&&!a.dead&&Math.hypot(a.x-n.x,a.y-n.y)<80)))socAdj(g,1)}
  socCheck()}}
{const _sc=socCheck;socCheck=function(){if(!S.mirror)return _sc.apply(this,arguments);socInit();const foe=sideOfReal('car');
  for(const g in SOCII){const G=S.soc[g];if(G.fid>=25)continue;const T=socTowns(g).filter(id=>ownerN(NI[id])==='car'&&!COL_IDS.has(id));if(!T.length)continue;
    if(!T.some(id=>{const n=N[NI[id]];return S.armies.some(a=>a.side===foe&&!a.g&&!a.dead&&Math.hypot(a.x-n.x,a.y-n.y)<220)}))continue;
    for(const id of T){S.own[id]=foe;delete S.siege[id];S.armies=S.armies.filter(a=>!(a.g&&a.side==='car'&&a.at===NI[id]))}territoryDirty=true;
    evCard('Défection',`Les ${SOCII[g].n} abandonnent Rome et ouvrent leurs portes à Carthage (${T.map(id=>N[NI[id]].n).join(', ')}).`,true)}}}
{const _sa=socAction;socAction=function(g,k){if(!S.mirror)return _sa.apply(this,arguments);socInit();const G=S.soc[g];if(G.cd>0)return;
  if(k==='env'){if(S.gold.car<40)return;S.gold.car-=40;socAdj(g,6);G.cd=1;log(`Vous rassurez les ${SOCII[g].n} : fidélité +6.`)}
  if(k==='prom'){if(S.gold.car<100)return;S.gold.car-=100;socAdj(g,14);G.cd=3;log(`Vous promettez aux ${SOCII[g].n} une part du butin et des terres : fidélité +14.`)}
  renderAll();openDip()}}
{const _ar=applyResult;applyResult=function(b,res){if(!S.mirror||!S.soc)return _ar.apply(this,arguments);const f0={};for(const g in S.soc)f0[g]=S.soc[g].fid;const r=_ar.apply(this,arguments);
  for(const g in S.soc){const d=S.soc[g].fid-f0[g];S.soc[g].fid=Math.max(0,Math.min(100,f0[g]-d))}socCheck();return r}}
// score, victoire et fin de partie vus de Rome
{const _ws=warScore;warScore=function(){const W=_ws.apply(this,arguments);if(!S.mirror)return W;const lost=Object.keys(SOCII).reduce((s,g)=>s+socTowns(g).filter(id=>ownerN(NI[id])===sideOfReal('car')).length,0);
  const P=W.P.map(p=>p[0]==='alliés italiens ralliés'?['alliés italiens perdus',-4*lost]:p);return {v:Math.max(-100,Math.min(100,P.reduce((s,p)=>s+p[1],0))),P,soc:lost}}}
{const _vc=victoryCheck;victoryCheck=function(d){if(!S.mirror)return _vc.apply(this,arguments);if(S.over)return;const W=warScore();
  const soc=Object.keys(SOCII).flatMap(g=>socTowns(g).filter(id=>!COL_IDS.has(id))),lost=soc.filter(id=>ownerN(NI[id])===sideOfReal('car')).length;
  if(lost>=Math.ceil(soc.length*.4)){finish('lose','L’Italie se détache',"Vos alliés italiens sont passés en masse à Carthage. Rome, réduite au Latium, doit traiter : la Sicile et la Sardaigne sont perdues.");return}
  if(S.pol.bar<=0){finish('lose','Le peuple se lasse',"Le Sénat, sous la pression du peuple, a ouvert des pourparlers avec Carthage. La guerre s'achève sans gloire.");return}
  if(d>=END_DAY){if(W.v>0)finish('win','La paix romaine',`Après dix-sept ans de guerre, Carthage accepte la paix : flotte livrée, tribut, plus de guerre sans l'accord de Rome. Score ${W.v}.`);else finish('lose','Paix blanche',`Après dix-sept ans, aucune des deux villes n'a plié ; Rome doit reconnaître Carthage maîtresse de l'Hispanie. Score ${W.v}.`);return}
  if(W.v>=60&&!S.ev.romPeace){S.ev.romPeace=d;S.paused=true;modal(`<h2>Carthage demande la paix</h2><p>Le Sénat punique, débordé par le parti d'Hannon, rappelle ses généraux et offre l'Hispanie, sa flotte et un lourd tribut.</p><p class="sub">Score ${W.v}. Accepter met fin à la campagne par une victoire.</p><div class="row"><button class="go" id="pAcc" type="button">Accepter la paix</button><button id="pRef" type="button">Continuer jusqu'à Carthage</button></div>`);
    $('pAcc').onclick=()=>{closeModal();finish('win','Paix victorieuse',"Carthage cède : Rome domine la Méditerranée occidentale.")};$('pRef').onclick=()=>{closeModal();log("Vous refusez : Carthage doit être détruite.")}}}}
{const _cp=capture;capture=function(i,side){const r=_cp.apply(this,arguments);if(S.mirror&&!S.over){const n=N[i];
  if(n.id==='carthago'&&side==='car')finish('win','Carthage est tombée',"Vos légions sont entrées dans Carthage. La rivale de Rome n'est plus.");
  else if(n.id==='roma'&&side!=='car')finish('lose','Rome est tombée',"Hannibal est entré dans Rome. La République n'est plus.")}return r}}
// événements romains (la table d'origine raconte Carthage)
const ROM_EVENTS=[
  {w:3,f:()=>EVENTS[0].f()},{w:3,f:()=>EVENTS[1].f()},
  {w:2,f:()=>{for(const a of S.armies)if(a.side==='car'&&a.mor!=null)a.mor=Math.max(0,a.mor-6);evCard('Prodiges',"On a vu pleuvoir des pierres et un bœuf a parlé au forum : les légions doutent (moral −6). Le Sénat consulte les livres sibyllins.")}},
  {w:2,f:()=>{senAdj(4);evCard('Jeux romains',"Les jeux du cirque ont enthousiasmé le peuple : l'appui du Sénat monte (+4).")}},
  {w:2,f:()=>{const g=50+Math.round(Math.random()*50);S.gold.car+=g;evCard('Blé de Sicile',`Les cités grecques de Sicile envoient blé et argent : +${g} or.`)}},
  {w:2,f:()=>{const g=Math.min(S.gold.car,40+Math.round(Math.random()*40));S.gold.car-=g;evCard('Fraude des publicains',`Des fermiers de l'impôt ont coulé de vieux navires pour toucher l'assurance de l'État : −${g} or.`)}},
  {w:1,f:()=>{for(const g in SOCII)socAdj(g,-3);evCard('Les colonies latines grognent',"Douze colonies latines refusent de fournir encore des hommes : vos alliés doutent (fidélité −3).")}},
  {w:1,f:()=>{for(const a of S.armies)if(a.side==='car'&&a.mor!=null)a.mor=Math.min(100,a.mor+6);evCard('La Mère des dieux',"La pierre noire de Cybèle arrive de Pessinonte : présage de victoire (moral +6).")}}];
{const _em=eventsMonthly;eventsMonthly=function(d){if(!S.mirror)return _em.apply(this,arguments);if(Math.random()<.14){let t=ROM_EVENTS.reduce((s,e)=>s+e.w,0),r=Math.random()*t;for(const e of ROM_EVENTS){r-=e.w;if(r<=0){try{e.f()}catch(x){console.error(x)}break}}}}}
{const _ob=openBattle;openBattle=function(){const r=_ob.apply(this,arguments);if(S.mirror){const h=document.querySelector('#mcard .vs h4');if(h){h.textContent=sideName('car');h.style.color='#e2665a'}const h2=document.querySelectorAll('#mcard .vs h4')[1];if(h2)h2.style.color='#b48ae6';
  const p=[...document.querySelectorAll('#mcard p.sub')].find(x=>/vous commandez toujours/.test(x.textContent));if(p)p.textContent="Sur le champ de bataille, vos régiments romains sont de votre côté de la carte ; les pertes reviennent dans la campagne. Battre en retraite coûte des hommes."}return r}}

/* ---------- 8. JOUER LA MACÉDOINE : Philippe V, allié d'Hannibal (215) ---------- */
// Le joueur garde le camp interne 'car' ; Carthage devient un peuple allié de fait ('pun') qui mène sa propre guerre contre Rome avec l'IA générale.
Object.assign(UT,{phalange:{n:'Phalange macédonienne',men:640,cost:55,k:'inf'},hypasp:{n:'Hypaspistes',men:480,cost:66,k:'inf'},peltaste:{n:'Peltastes thraces',men:300,cost:32,k:'skirm'},
  cretois:{n:'Archers crétois',men:300,cost:40,k:'skirm'},compagnons:{n:'Compagnons',men:300,cost:80,k:'cav'},thessal:{n:'Cavalerie thessalienne',men:300,cost:66,k:'cav'}});
Object.assign(SHORT,{phalange:'Phalange',hypasp:'Hypaspistes',peltaste:'Peltastes',cretois:'Crétois',compagnons:'Compagnons',thessal:'Thessaliens'});
const POOL_MAC={mac:['phalange','hypasp','compagnons','thessal'],thr:['peltaste','thessal'],gre:['hypasp','cretois','peltaste'],cre:['cretois','peltaste'],ill:['peltaste','thessal'],
  afr:['peltaste'],num:['peltaste'],ibe:['peltaste'],bal:['cretois'],gau:['peltaste'],ita:['peltaste','thessal']};
const GEN_MAC=['Philippe V','Démétrios de Pharos','Héracleidès de Tarente','Taurion','Alexandros','Ménippe','Polyphantas','Philoclès','Nicanor','Androsthène'];
const isMac=()=>!!(S&&(S.peo==='mac'||S.peo==='syr'||S.peo==='ath'||!!(PX&&PX[S.peo])));let peoDone=null;
const MAC_ILL=['apollonia','epidamnus','lissus'];
const MAC_TXT="Vous êtes Philippe V, roi de Macédoine. Après Cannes, vous avez juré alliance à Hannibal : l'Italie pour lui, l'Illyrie et l'Adriatique pour vous. Chassez Rome de la côte illyrienne (Apollonia, Épidamne, Lissos) ; tenez la Grèce face aux Étoliens. Carthage mène sa guerre en Italie : vos armées et les siennes ne se combattent pas. Perdre Pella met fin au règne.";
let macDone=false;
function macStatic(){if(macDone)return;macDone=true;peoDone='mac';
  FAC.pun={n:'Carthage',c:FAC.car.c.slice(),a:[40,-100],cul:'afr'};FAC.car={n:'Macédoine',c:[200,150,46]};
  GEN.pun=GEN.car.slice();GEN.car=GEN_MAC.slice();for(const k in POOL_CAR)delete POOL_CAR[k];Object.assign(POOL_CAR,POOL_MAC);
  try{const R=document.documentElement.style;R.setProperty('--punic','#c8962e')}catch(e){}document.title='Roma Delenda Est · Macédoine'}
function startMac(df){newGame();S.diff=DIFF[df]?df:'normal';try{tradeInit();genInit();applyScen(216)}catch(e){console.error(e)}
  scenSetup=true;try{macSetup()}finally{scenSetup=false}
  S.started=false;S.paused=true;save();afterLoad();closeModal();
  modal(`<h2>215 : Philippe V et Hannibal</h2><p>${MAC_TXT}</p><p class="sub">Vos troupes : phalange, hypaspistes, Compagnons, cavalerie thessalienne, peltastes thraces et archers crétois. Les batailles se jouent aux couleurs de la Macédoine.</p><div class="row"><button class="go" id="mGo" type="button">Commencer</button><button id="mHelp" type="button">Comment jouer</button></div>`);
  $('mGo').onclick=()=>{closeModal();const h=S.armies.find(a=>a.side==='car'&&!a.g)||S.armies[0];centerOn(h.x,h.y,1.1)};$('mHelp').onclick=openHelp}
function macSetup(){macStatic();S.peo='mac';S.day=3*360+120;S.gold.pun=Math.max(300,S.gold.car||0);S.gold.car=520;punConvert();
  // la Macédoine : ses villes, ses garnisons, l'armée royale
  for(const n of N)if(S.own[n.id]==='mac')S.own[n.id]='car';for(const a of S.armies)if(a.side==='mac'){a.side='car'}
  delete S.fac.mac;S.fac.ach.st='pacte_car';macSetup2()}
// Carthage : villes, armées, flottes et routes passent au peuple allié 'pun'
function punConvert(){
  for(const n of N)if(S.own[n.id]==='car')S.own[n.id]='pun';setOwn(['capua','arpi','tarentum'].filter(id=>NI[id]!=null&&id!=='tarentum'),'pun');
  for(const a of S.armies)if(a.side==='car')a.side='pun';for(const f of S.fleets||[])if(f.side==='car')f.side='pun';
  for(const r of S.trade||[])if(r.side==='car')r.side='pun';for(const g of S.gens||[])if(g.side==='car')g.side='pun';
  for(const id in S.q)if(S.q[id].side==='car')S.q[id].side='pun';
  S.fac.pun={car:60,rom:-100,st:'guerre_rom',cd:0,fid:60};
  for(const f in S.fac){const F=S.fac[f];if(f==='pun')continue;if(/^(tribut|pacte|allie)_car$/.test(F.st||''))F.st='neutre';const a=FAC[f]&&FAC[f].a;if(a){F.car=f==='ach'?50:f==='eto'?-40:f==='ill'?-10:f==='epi'?10:f==='ath'?-10:0}}
  // Magon débarque en Hispanie (215), garnisons des places barcides et de la Cisalpine
  scenArmy('pun','cnova',[['iber',4],['lib',2],['hcav',1],['sling',1]],'Magon');
  scenGar('pun',['cnova','gades','castulo','saguntum','capua','mediolanum','felsina'].filter(id=>NI[id]!=null&&S.own[id]==='pun'),[['iber',1],['sling',1]]);
  S.pol=null;S.mirror=false}
function macSetup2(){
  scenGar('car',['pella','thessalonica','corinthus','demetrias','chalcis'],[['phalange',1]]);
  scenArmy('car','pella',[['phalange',4],['hypasp',2],['peltaste',2],['cretois',1],['compagnons',2],['thessal',1]],'Philippe V');
  scenArmy('car','corinthus',[['phalange',2],['hypasp',1],['cretois',1],['thessal',1]],'Taurion');
  // Rome : M. Valerius Laevinus garde l'Adriatique
  scenArmy('rom','brundisium',[['legion',2],['velites',1],['acav',1]],'M. Valerius Laevinus');
  scenGar('rom',MAC_ILL,[['legion',1],['velites',1]]);
  S.macWar=1;S.ev=S.ev||{};S.ev.macPhil=1;S.pol=null;S.mirror=false;
  for(const a of S.armies){if(a.food==null||!isFinite(a.food))a.food=armyFoodMax(a)}
  S.trade=(S.trade||[]).filter(r=>r.side!=='car');for(const [a,b] of [['thessalonica','demetrias'],['thessalonica','corinthus'],['demetrias','chalcis']]){const r=mkRoute('car',a,b);if(r)S.trade.push(r)}
  log("Philippe V scelle son alliance avec Hannibal. La Macédoine entre en guerre contre Rome.")}
// économie : domaine royal et mines du Pangée ; Rome saignée par Cannes ; Carthage aidée par ses alliés
{const _incM=income;income=function(side){const r=_incM.apply(this,arguments);if(!isMac())return r;
  if(side==='car')return {inc:r.inc+(PX&&PX[S.peo]?PX[S.peo].bonus:S.peace?30:S.peo==='syr'?95:S.peo==='ath'?75:80),up:r.up};if(side==='rom')return {inc:Math.round(r.inc*(S.day>=840?.7:1)),up:r.up};if(side==='pun')return {inc:Math.round(r.inc*1.35)+40,up:Math.round(r.up*.7)};return r}}
// statiques rétablis au chargement
{const _alM=afterLoad;afterLoad=function(){if(S&&S.peo==='mac')macStatic();else if(S&&S.peo==='syr')syrStatic();else if(S&&S.peo==='ath')athStatic();else if(S&&PX&&PX[S.peo])pxStatic(S.peo);return _alM.apply(this,arguments)}}
// Carthage alliée : son trésor et son IA (l'IA générale, en Italie et en Hispanie)
{const _dM=daily;daily=function(d){const r=_dM.apply(this,arguments);if(isMac()){try{
    if(d%30===0){const {inc,up}=income('pun');S.gold.pun=Math.max(0,(S.gold.pun||0)+inc-up)}
    if(d%2===0){aiSide('pun');macStrike()}if(d%30===0){if(S.peo==='syr')syrMonthly(d);else if(S.peo==='ath')athMonthly(d);else if(!(PX&&PX[S.peo]))macMonthly(d)}if(S.peo==='syr')syrDaily(d);if(S.peo==='ath')athDaily(d)}catch(e){console.error(e)}}return r}}
// victoire : l'Illyrie ; défaite : Pella ; fin en 205 (paix de Phoinikè)
function macMonthly(d){if(S.over)return;const ill=MAC_ILL.filter(id=>NI[id]!=null&&S.own[id]==='car').length;
  if(S.own.pella!=='car'){finish('lose','Pella est tombée',"Les légions sont entrées dans la capitale. La maison des Antigonides a perdu son royaume.");return}
  if(ill===MAC_ILL.length&&!S.ev.macWin){S.ev.macWin=d;finish('win','L’Adriatique est macédonienne',"Apollonia, Épidamne et Lissos sont à vous : Rome abandonne l'Illyrie. Philippe V tient la porte de l'Italie, et Hannibal un allié sur l'autre rive.");return}
  if(d>=13*360+60){if(ill>0)finish('win','Paix de Phoinikè',`Rome, épuisée, signe la paix : vous gardez ${ill} des ports illyriens.`);else finish('lose','Paix de Phoinikè',"Rome signe la paix sans rien céder : l'Illyrie reste romaine, et la Macédoine devra un jour rendre des comptes.");return}
  // 211 : les Étoliens s'allient à Rome
  if(d>=7*360+180&&!S.ev.macEto&&S.fac.eto){S.ev.macEto=1;S.fac.eto.st='guerre_car';S.fac.eto.car=-100;evCard('Rome s’allie aux Étoliens',"Laevinus a signé un traité avec la Ligue étolienne : les villes qu'ils prendront seront à eux, le butin à Rome. Les Étoliens vous déclarent la guerre.")}}
{const _vcM=victoryCheck;victoryCheck=function(d){if(isMac())return;return _vcM.apply(this,arguments)}}
{const _cpM=capture;capture=function(i,side){const o0=S.over;const r=_cpM.apply(this,arguments);if(isMac()&&N[i].id==='carthago'&&!o0&&S.over==='lose'){S.over=null;log('Carthage est tombée : Hannibal a perdu sa patrie.')}return r}}
// Rome n'ouvre le front d'Afrique qu'avec Scipion (204) ; l'armée de Carthage sort frapper les Romains qui s'approchent
{const _chM=cityHostile;cityHostile=function(i,side){const r=_chM.apply(this,arguments);try{if(r&&isMac()&&side==='rom'&&ownerN(i)==='pun'&&!macFront(N[i]))return false}catch(e){}return r}}
// le front romain suit le calendrier historique : Arpi (213), Capoue (211), l'Hispanie avec Scipion (210), la Cisalpine après 207, l'Afrique en 204
function macFront(n){const d=S.day;if(n.id==='arpi')return d>=1800;if(n.id==='capua')return d>=2400;
  if(n.lat<37&&n.lon>-7)return d>=5040;if(n.lon<1)return n.lat>39.5||d>=2880;if(n.lat>43.8&&n.lon>6.5&&n.lon<13)return d>=4000;return true}
function macStrike(){const C=N[capOf('pun')];if(!C)return;for(const a of S.armies){if(a.side!=='pun'||a.dead||a.g||a.ship||a.legs.length||a.units.length<6||Math.hypot(a.x-C.x,a.y-C.y)>60)continue;
  const my=strength(a);const f=S.armies.filter(o=>!o.dead&&!o.ship&&!o.g&&hostileSides(o.side,'pun')&&Math.hypot(o.x-C.x,o.y-C.y)<220&&strength(o)<my*1.1).sort((x,y)=>Math.hypot(x.x-a.x,x.y-a.y)-Math.hypot(y.x-a.x,y.y-a.y))[0];
  if(f){a.ai=null;order(a,f.x,f.y,null)}}}
// diplomatie macédonienne : pas d'onglet des alliés italiens (affaire de Carthage)
{const _odM=openDip;openDip=function(){const r=_odM.apply(this,arguments);try{if(isMac()){const C=$('mcard'),h=[...C.querySelectorAll('h3')].find(x=>/alliés italiens/.test(x.textContent));
  if(h){let e=h.nextElementSibling;while(e&&e.tagName!=='H3'){const n=e.nextElementSibling;e.remove();e=n}h.remove()}}}catch(e){}return r}}
{const _pmM=polMonthly;polMonthly=function(){if(isMac())return;return _pmM.apply(this,arguments)}}
{const _opM=openPol;openPol=function(){if(!isMac())return _opM.apply(this,arguments);if(S.peo==='syr')return syrPol();if(S.peo==='ath')return athPol();if(PX&&PX[S.peo])return pxPol();const ill=MAC_ILL.map(id=>NI[id]!=null?`${N[NI[id]].n} : ${S.own[id]==='car'?'<b style="color:var(--good)">à vous</b>':sideName(S.own[id])}`:'').filter(Boolean).join(' · ');
  modal(`<h2>La cour de Pella</h2><p>Philippe V gouverne seul : pas de Sénat ici, mais des alliés à tenir et une guerre à gagner sur deux fronts.</p><h3>Objectif</h3><p class="sub">${ill}</p><p class="sub">Prenez les trois ports pour gagner tout de suite. En 205, la paix de Phoinikè vous laisse ceux que vous tenez. Perdre Pella, c'est perdre le royaume.</p><h3>Carthage</h3><p class="sub">Trésor punique : ${Math.round(S.gold.pun||0)} or · ${S.armies.filter(a=>a.side==='pun'&&!a.g).length} armées en campagne.</p><div class="row" style="justify-content:flex-end"><button class="go" id="mClose" type="button">Fermer</button></div>`);$('mClose').onclick=closeModal}}
{const _bAM=bigActors;bigActors=function(){if(isMac())return;return _bAM.apply(this,arguments)}}
{const _sMM=socMonthly;socMonthly=function(){if(isMac())return;return _sMM.apply(this,arguments)}}
{const _sCM=socCheck;socCheck=function(){if(isMac())return;return _sCM.apply(this,arguments)}}
const MAC_EVENTS=[
  {w:3,f:()=>EVENTS[0].f()},{w:3,f:()=>EVENTS[1].f()},
  {w:2,f:()=>{const g=40+Math.round(Math.random()*60);S.gold.car+=g;evCard('Mines du Pangée',`Les mines d'or et d'argent du Pangée rendent bien cette année : +${g} or.`)}},
  {w:2,f:()=>{for(const a of S.armies)if(a.side==='car'&&a.mor!=null)a.mor=Math.min(100,a.mor+6);evCard('Les Antigonides',"Vous rappelez à vos phalangites qu'ils sont les héritiers d'Alexandre : moral +6.")}},
  {w:1,f:()=>{if(S.fac.ach){S.fac.ach.car=Math.max(-100,S.fac.ach.car-10)}evCard('Aratos de Sicyone',"Le vieux stratège achéen vous reproche le sac de Messène : la Ligue achéenne doute (attitude −10).")}},
  {w:1,f:()=>{const g=Math.min(S.gold.car,30+Math.round(Math.random()*30));S.gold.car-=g;evCard('Les Dardaniens',`Les Dardaniens descendent du nord et pillent la Péonie : −${g} or.`)}}];
{const _emM=eventsMonthly;eventsMonthly=function(d){if(!isMac())return _emM.apply(this,arguments);const EV=S.peo==='syr'?SYR_EVENTS:S.peo==='ath'?ATH_EVENTS:PX&&PX[S.peo]?PX[S.peo].EV:MAC_EVENTS;if(Math.random()<.14){let t=EV.reduce((s,e)=>s+e.w,0),r=Math.random()*t;for(const e of EV){r-=e.w;if(r<=0){try{e.f()}catch(x){console.error(x)}break}}}}}
// textes : bandeau, panneau, aide
const MAC_PH=[[" Prendre Rome. Vous perdez si Carthage tombe."," Chasser Rome d'Illyrie (Apollonia, Épidamne, Lissos). Vous perdez si Pella tombe."],["écu violet","écu doré"],
  ["Au-delà de 50 (et nettement plus que pour Rome)","Au-delà de 50 (et nettement plus que pour Rome)"],["Alliance : ils rejoignent Carthage avec","Alliance : ils rejoignent la Macédoine avec"],[" Les tributaires (soumis par les Barcides) paient"," Les tributaires de Carthage (soumis par les Barcides) paient"],["quand une armée punique est proche et tant que vous gardez leurs otages","quand une armée punique est proche et tant que Carthage garde leurs otages"]];
function macApply(){if(!isMac())return;try{
  const P=PX&&PX[S.peo]?{n:PX[S.peo].n,sub:PX[S.peo].sub,PH:PX[S.peo].PH}:S.peo==='syr'?{n:'Syracuse',sub:'Hippocrate et Épicyde',PH:SYR_PH}:S.peo==='ath'?{n:'Athènes',sub:'Le peuple athénien',PH:ATH_PH}:{n:'Macédoine',sub:'Philippe V, roi',PH:MAC_PH};
  const f=document.querySelector('.ui-fac b');if(f&&f.textContent!==P.n){f.textContent=P.n;const sm=f.nextElementSibling;if(sm)sm.textContent=P.sub}
  for(const id of ['mcard','side']){const el=$(id);if(!el)continue;const w=document.createTreeWalker(el,NodeFilter.SHOW_TEXT),L=[];while(w.nextNode())L.push(w.currentNode);
    for(const t of L){let v=t.nodeValue;const o=v;for(const [a,b] of P.PH)if(v.indexOf(a)>=0)v=v.split(a).join(b);if(v!==o)t.nodeValue=v}
    el.querySelectorAll('.att>span:first-child:not([data-mac])').forEach(e=>{e.dataset.mac='1';if(e.textContent==='Carthage')e.textContent=P.n})}
  if(!sel){const h=$('side')&&$('side').querySelector('h2');if(h&&h.textContent==='Carthage')h.textContent=P.n}}catch(e){}}
{let ob=null;try{ob=new MutationObserver(macApply);['side','top','mcard'].forEach(id=>{const e=$(id);if(e)ob.observe(e,{childList:true,subtree:true})})}catch(e){}}

/* ---------- 9. JOUER SYRACUSE : Hippocrate et Épicyde, alliés de Carthage (214) ---------- */
// Même principe que la Macédoine : le joueur est 'car', Carthage est l'alliée 'pun'. Les régiments reprennent les types grecs de la bataille 3D.
Object.assign(UT,{athoplites:{n:'Hoplites syracusains',men:600,cost:48,k:'inf'},thureo:{n:'Mercenaires thuréophores',men:500,cost:44,k:'inf'},
  athpelt:{n:'Peltastes siciliotes',men:300,cost:30,k:'skirm'},hippeis:{n:'Cavalerie syracusaine',men:300,cost:62,k:'cav'}});
Object.assign(SHORT,{athoplites:'Hoplites',thureo:'Thuréophores',athpelt:'Peltastes',hippeis:'Cavaliers'});
const POOL_SYR={gre:['athoplites','thureo','athpelt','hippeis','cretois'],cre:['cretois','athpelt'],afr:['thureo','athpelt'],num:['athpelt'],ibe:['thureo'],bal:['athpelt'],gau:['thureo'],ita:['thureo','athpelt'],mac:['thureo'],thr:['athpelt'],ill:['thureo']};
const GEN_SYR=['Hippocrate','Épicyde','Sosis','Dinoménès','Thrason','Zoïppos','Théodotos','Héraclide','Polyclite','Damippos'];
const SYR_KEY=['messana','lilybaeum','panormus','agrigentum'];
const SYR_TXT="Hiéronymos est mort, assassiné à Léontinoi. Hippocrate et Épicyde, petits-fils d'un exilé syracusain et officiers d'Hannibal, tiennent la ville et rompent avec Rome. Marcellus arrive avec ses légions ; Archimède arme les remparts. Tenez Syracuse jusqu'en 207, ou chassez Rome de Sicile (Messana, Lilybée, Panormus, Agrigente). Carthage enverra Himilcon : ses armées et les vôtres ne se combattent pas.";
function syrStatic(){if(peoDone==='syr')return;peoDone='syr';macDone=true;
  FAC.pun={n:'Carthage',c:FAC.car.c.slice(),a:[40,-100],cul:'afr'};FAC.car={n:'Syracuse',c:[63,120,192]};
  GEN.pun=GEN.car.slice();GEN.car=GEN_SYR.slice();for(const k in POOL_CAR)delete POOL_CAR[k];Object.assign(POOL_CAR,POOL_SYR);
  try{document.documentElement.style.setProperty('--punic','#3f78c0')}catch(e){}document.title='Roma Delenda Est · Syracuse'}
function startSyr(df){newGame();S.diff=DIFF[df]?df:'normal';try{tradeInit();genInit();applyScen(216)}catch(e){console.error(e)}
  scenSetup=true;try{syrSetup()}finally{scenSetup=false}
  S.started=false;S.paused=true;save();afterLoad();closeModal();
  modal(`<h2>214 : Syracuse rompt avec Rome</h2><p>${SYR_TXT}</p><p class="sub">Vos troupes : hoplites, mercenaires thuréophores, peltastes, archers crétois et cavalerie syracusaine. Les remparts d'Archimède font durer trois fois plus longtemps un siège de Syracuse. Les batailles se jouent aux couleurs de Syracuse.</p><div class="row"><button class="go" id="mGo" type="button">Commencer</button><button id="mHelp" type="button">Comment jouer</button></div>`);
  $('mGo').onclick=()=>{closeModal();const h=S.armies.find(a=>a.side==='car'&&!a.g)||S.armies[0];centerOn(h.x,h.y,1.3)};$('mHelp').onclick=openHelp}
function syrSetup(){syrStatic();S.peo='syr';S.day=4*360;S.gold.pun=Math.max(300,S.gold.car||0);S.gold.car=380;punConvert();
  for(const n of N)if(S.own[n.id]==='syr')S.own[n.id]='car';for(const a of S.armies)if(a.side==='syr')a.side='car';
  delete S.fac.syr;if(S.fac.mac){S.fac.mac.st='neutre';S.fac.mac.car=20}
  scenGar('car',['syracusae'],[['athoplites',2],['cretois',1]]);scenGar('car',['leontini','catana','tauromenium'].filter(id=>NI[id]!=null),[['athoplites',1]]);
  scenArmy('car','syracusae',[['athoplites',3],['thureo',2],['cretois',1],['athpelt',1],['hippeis',2]],'Hippocrate');
  scenArmy('car','leontini',[['athoplites',2],['athpelt',1],['hippeis',1]],'Épicyde');
  // Rome : Marcellus en Sicile, Appius Claudius devant Syracuse
  scenArmy('rom','messana',[['legion',4],['velites',1],['rcav',1]],'M. Claudius Marcellus');
  scenArmy('rom','agrigentum',[['legion',2],['velites',1]],'Ap. Claudius Pulcher');
  scenGar('rom',SYR_KEY.filter(id=>NI[id]!=null&&S.own[id]==='rom'),[['legion',1]]);
  S.ev=S.ev||{};S.ev.syrRev=1;
  for(const a of S.armies){if(a.food==null||!isFinite(a.food))a.food=armyFoodMax(a)}
  S.trade=(S.trade||[]).filter(r=>r.side!=='car');for(const [a,b] of [['syracusae','catana'],['syracusae','carthago']]){const r=mkRoute('car',a,b);if(r)S.trade.push(r)}
  log("Hippocrate et Épicyde prennent le pouvoir à Syracuse. La cité de Hiéron rompt avec Rome et s'allie à Carthage.")}
// Archimède : un siège de Syracuse dure trois fois plus longtemps, et ses machines frappent les assiégeants
function syrDaily(d){const sg=S.siege.syracusae;if(sg&&sg.side!=='car'){if(!sg.arch){sg.arch=1;sg.need*=3;evCard('Les machines d’Archimède',"Les Romains approchent des murs : grappins de fer, catapultes et poutres basculantes les attendent. Le siège de Syracuse durera trois fois plus longtemps.")}
  if(d%15===0){const a=S.armies.find(x=>x.id===sg.a);if(a&&!a.dead){let k=0;for(const u of a.units){const l=u.men*.02;u.men-=l;k+=l}cleanArmy(a);if(d%45===0)log(`Les machines d'Archimède frappent les assiégeants : ${Math.round(k)} hommes perdus.`)}}}}
function syrMonthly(d){if(S.over)return;const key=SYR_KEY.filter(id=>NI[id]!=null&&S.own[id]==='car').length;
  if(S.own.syracusae!=='car'){finish('lose','Syracuse est tombée',"Les légions sont entrées dans la ville d'Hiéron. On raconte qu'Archimède, penché sur ses figures, n'a pas vu venir le soldat qui l'a tué.");return}
  if(key===SYR_KEY.length&&!S.ev.syrWin){S.ev.syrWin=d;finish('win','La Sicile libre',"Messana, Lilybée, Panormus et Agrigente sont à vous : Rome a perdu la Sicile, son grenier et sa première province. Syracuse redevient la première cité de l'Occident grec.");return}
  if(d>=11*360){finish('win','Syracuse a tenu',`Rome, épuisée par Hannibal, renonce au siège et traite avec Syracuse${key?` : vous gardez ${key} des places romaines de Sicile`:''}. Les remparts d'Archimède ont tenu.`);return}
  // 213 : Himilcon débarque à Héraclée Minoa
  if(d>=4*360+300&&!S.ev.syrHim){S.ev.syrHim=1;const a=scenArmy('pun','carthago',[['lib',4],['ncav',2],['hcav',1],['eleph',1]],'Himilcon');evCard('Himilcon débarque en Sicile',"Carthage envoie Himilcon avec vingt-cinq mille hommes et des éléphants. Il marche sur Agrigente.")}}
function syrPol(){const key=SYR_KEY.map(id=>NI[id]!=null?`${N[NI[id]].n} : ${S.own[id]==='car'?'<b style="color:var(--good)">à vous</b>':sideName(S.own[id])}`:'').filter(Boolean).join(' · ');
  modal(`<h2>Le conseil de Syracuse</h2><p>Hippocrate et Épicyde gouvernent avec l'armée et les mercenaires ; le parti de Rome attend son heure dans la ville.</p><h3>Objectif</h3><p class="sub">${key}</p><p class="sub">Prenez les quatre places pour gagner tout de suite. En 207, si Syracuse tient encore, Rome traite. Perdre Syracuse, c'est perdre la guerre.</p><h3>Carthage</h3><p class="sub">Trésor ${Math.round(S.gold.pun||0)} or · ${N.filter(n=>!n.col&&S.own[n.id]==='pun').length} villes. Himilcon débarque en 213.</p><div class="row" style="justify-content:flex-end"><button class="go" id="mClose" type="button">Fermer</button></div>`);$('mClose').onclick=closeModal}
const SYR_EVENTS=[
  {w:3,f:()=>EVENTS[0].f()},{w:3,f:()=>EVENTS[1].f()},
  {w:2,f:()=>{const g=40+Math.round(Math.random()*50);S.gold.car+=g;evCard('Le trésor de Hiéron',`On découvre une part du trésor du vieux roi Hiéron : +${g} or.`)}},
  {w:2,f:()=>{const g=30+Math.round(Math.random()*30);S.gold.car+=g;evCard('Le blé de Sicile',`La moisson est bonne et les marchands d'Afrique paient bien : +${g} or.`)}},
  {w:1,f:()=>{const g=Math.min(S.gold.car,20+Math.round(Math.random()*30));S.gold.car-=g;for(const a of S.armies)if(a.side==='car'&&a.mor!=null)a.mor=Math.max(5,a.mor-4);evCard('Le parti de Rome',`Des notables complotent pour livrer une porte à Marcellus ; on les arrête, mais la ville doute (−${g} or, moral −4).`)}},
  {w:1,f:()=>{for(const a of S.armies)if(a.side==='car'&&a.mor!=null)a.mor=Math.min(100,a.mor+6);evCard('Archimède',"Le vieux savant a encore inventé une machine : la garnison reprend courage (moral +6).")}}];
const SYR_PH=[[" Prendre Rome. Vous perdez si Carthage tombe."," Chasser Rome de Sicile (Messana, Lilybée, Panormus, Agrigente) ou tenir jusqu'en 207. Vous perdez si Syracuse tombe."],["écu violet","écu bleu"],["Alliance : ils rejoignent Carthage avec","Alliance : ils rejoignent Syracuse avec"],[" Les tributaires (soumis par les Barcides) paient"," Les tributaires de Carthage (soumis par les Barcides) paient"],["quand une armée punique est proche et tant que vous gardez leurs otages","quand une armée punique est proche et tant que Carthage garde leurs otages"]];

/* ---------- 9 bis. JOUER ATHÈNES : la guerre contre Philippe V (209) ---------- */
// Le joueur est 'car' (Athènes). Rome reste en guerre contre Carthage ('pun', IA) mais en paix avec Athènes ; la Macédoine ('mac') est l'ennemie, menée par sa propre IA.
Object.assign(UT,{scythes:{n:'Archers scythes',men:300,cost:38,k:'skirm'}});Object.assign(SHORT,{scythes:'Scythes'});
const POOL_ATH={gre:['athoplites','thureo','athpelt','hippeis','scythes'],cre:['cretois','athpelt'],thr:['athpelt','thureo'],mac:['thureo'],ill:['thureo'],ita:['thureo'],afr:['thureo'],ibe:['thureo'],gau:['thureo'],bal:['athpelt'],num:['athpelt']};
const GEN_ATH=['Eurycléidès','Mikion','Céphisodore','Léon','Callias','Philocratès','Diodore','Ménandre','Échédémos','Thrasyclès'];
const ATH_KEY=['corinthus','chalcis'];
const ATH_TXT="Philippe V tient la Grèce par ses « entraves » : Corinthe, Chalcis et Démétrias. Rome, alliée des Étoliens et d'Attale de Pergame, lui fait la guerre, et Athènes prend parti. Défendez l'Attique, puis brisez les entraves : Corinthe et Chalcis. Les Étoliens sont vos alliés ; Rome reste en paix avec vous et combat Carthage en Italie.";
function athStatic(){if(peoDone==='ath')return;peoDone='ath';macDone=true;
  FAC.pun={n:'Carthage',c:FAC.car.c.slice(),a:[40,-100],cul:'afr'};FAC.car={n:'Athènes',c:[96,140,80]};
  GEN.pun=GEN.car.slice();GEN.car=GEN_ATH.slice();GEN.mac=GEN_MAC.slice();for(const k in POOL_CAR)delete POOL_CAR[k];Object.assign(POOL_CAR,POOL_ATH);
  try{document.documentElement.style.setProperty('--punic','#6f9a4a')}catch(e){}document.title='Roma Delenda Est · Athènes'}
function startAth(df){newGame();S.diff=DIFF[df]?df:'normal';try{tradeInit();genInit();applyScen(211)}catch(e){console.error(e)}
  scenSetup=true;try{athSetup()}finally{scenSetup=false}
  S.started=false;S.paused=true;save();afterLoad();closeModal();
  modal(`<h2>209 : Athènes contre Philippe V</h2><p>${ATH_TXT}</p><p class="sub">Vos troupes : hoplites, thuréophores, peltastes, archers scythes et cavaliers athéniens. En 208, Attale de Pergame débarque pour vous aider. Les batailles se jouent aux couleurs d'Athènes.</p><div class="row"><button class="go" id="mGo" type="button">Commencer</button><button id="mHelp" type="button">Comment jouer</button></div>`);
  $('mGo').onclick=()=>{closeModal();const h=S.armies.find(a=>a.side==='car'&&!a.g)||S.armies[0];centerOn(h.x,h.y,1.3)};$('mHelp').onclick=openHelp}
function athSetup(){S.gi=S.gi||{};S.gi.mac=S.gi.mac||0;athStatic();S.peo='ath';S.day=3330;S.gold.pun=Math.max(300,S.gold.car||0);S.gold.car=320;S.gold.mac=400;punConvert();
  for(const n of N)if(S.own[n.id]==='ath')S.own[n.id]='car';for(const a of S.armies)if(a.side==='ath')a.side='car';delete S.fac.ath;
  // la Macédoine ennemie : phalanges et cavalerie thessalienne à la place des troupes d'origine
  S.fac.mac=Object.assign(S.fac.mac||{},{st:'guerre_car',car:-100,cd:0});
  for(const a of S.armies)if(a.side==='mac')for(const u of a.units){if(u.t==='lib'){u.t='phalange';u.men=UT.phalange.men}else if(u.t==='hcav'){u.t='thessal';u.men=UT.thessal.men}}
  scenArmy('mac','pella',[['phalange',5],['hypasp',2],['peltaste',2],['compagnons',2],['thessal',1],['cretois',1]],'Philippe V');
  scenArmy('mac','chalcis',[['phalange',2],['peltaste',1],['thessal',1]],'Philoclès');
  // alliés : les Étoliens ; les Achéens restent fidèles à Philippe
  if(S.fac.eto){S.fac.eto.st='pacte_car';S.fac.eto.car=60}if(S.fac.ach){S.fac.ach.st='neutre';S.fac.ach.car=-25}
  scenGar('car',['athenae'],[['athoplites',2],['scythes',1]]);scenGar('car',['thebae'].filter(id=>NI[id]!=null&&S.own[id]==='car'),[['athoplites',1]]);
  scenArmy('car','athenae',[['athoplites',4],['thureo',2],['scythes',1],['athpelt',2],['hippeis',1]],'Eurycléidès');
  S.ev=S.ev||{};S.ev.athWar=1;
  for(const a of S.armies){if(a.food==null||!isFinite(a.food))a.food=armyFoodMax(a)}
  S.trade=(S.trade||[]).filter(r=>r.side!=='car');
  log("Athènes rompt avec Philippe V et rejoint la coalition de Rome, des Étoliens et d'Attale.")}
// Rome et Athènes ne se combattent pas, ni Carthage et Athènes
{const _hoA=hostile;hostile=function(a,b){if(S&&S.peo==='ath'){const p=[a.side,b.side].sort().join();if(p==='car,rom'||p==='car,pun')return false}return _hoA.apply(this,arguments)}}
{const _chA2=cityHostile;cityHostile=function(i,side){const r=_chA2.apply(this,arguments);try{if(r&&S&&S.peo==='ath'){const o=ownerN(i);if(side==='rom'&&o==='car'||side==='car'&&(o==='rom'||o==='pun')||side==='pun'&&o==='car')return false}}catch(e){}return r}}
// l'IA de Philippe : renforts à Pella, puis marche sur l'Attique et les villes athéniennes
// textes écrits pour Carthage : à Athènes, seul Philippe assiège et pille l'Attique
{const _logA=log;log=function(t){if(S&&S.peo==='ath'&&typeof t==='string')t=t.replace(/Les Romains (pillent|coupent|assiègent)/g,'Les Macédoniens $1').replace(/patrouille romaine/g,'patrouille macédonienne').replace(/agents romains/g,'agents macédoniens').replace(/espion romain/g,'espion macédonien').replace(/émissaires secrets de Rome/g,'émissaires secrets de Philippe');return _logA.apply(this,[t].concat([].slice.call(arguments,1)))}}
function athDaily(d){const lw=S.siege.athenae;if(lw&&lw.side!=='car'&&!lw.lw){lw.lw=1;lw.need*=2;evCard('Les Longs Murs',"Les Macédoniens investissent l'Attique, mais Athènes et le Pirée tiennent derrière leurs murs ; la flotte de Rhodes et d'Attale ravitaille la ville. Le siège durera deux fois plus longtemps.")}
  if(d%2||S.peace)return;const macA=S.armies.filter(a=>a.side==='mac'&&!a.dead&&!a.g&&!a.ship);
  for(const a of macA){if(a.legs.length||a.units.length<5||(a.cool||0)>0)continue;const sg=a.at!=null&&S.siege[N[a.at].id];if(sg&&sg.a===a.id)continue;
    if(a.qh&&season()==='Hiver')continue;const my=strength(a);
    const foe=S.armies.filter(f=>f.side==='car'&&!f.dead&&!f.ship&&!f.g&&strength(f)<my*.9&&Math.hypot(f.x-a.x,f.y-a.y)<160).sort((x,y)=>Math.hypot(x.x-a.x,x.y-a.y)-Math.hypot(y.x-a.x,y.y-a.y))[0];
    if(foe){order(a,foe.x,foe.y,null);continue}
    const t=N.filter(n=>!n.col&&S.own[n.id]==='car').map(n=>{const def=S.armies.filter(x=>x.side==='car'&&!x.dead&&Math.hypot(x.x-n.x,x.y-n.y)<6).reduce((s,x)=>s+strength(x),0);return {n,def,dd:Math.hypot(n.x-a.x,n.y-a.y)}}).filter(o=>o.def<my*.8).sort((x,y)=>x.dd-y.dd)[0];
    if(t&&t.dd>3)order(a,0,0,t.n.i)}}
function athMonthly(d){if(S.over)return;S.gi=S.gi||{};if(S.gi.mac==null)S.gi.mac=0;
  // trésor et renforts macédoniens
  const own=N.filter(n=>!n.col&&S.own[n.id]==='mac'),inc=own.reduce((s,n)=>s+(n.inc||4),0)+60;S.gold.mac=(S.gold.mac||0)+inc*dif().ai;if(S.peace)S.gold.mac=Math.min(S.gold.mac,400);
  const P=S.armies.find(a=>a.side==='mac'&&!a.dead&&!a.g&&a.name==='Philippe V')||S.armies.find(a=>a.side==='mac'&&!a.dead&&!a.g);
  const at=P&&P.at!=null&&S.own[N[P.at].id]==='mac';
  for(let k=0;k<2&&!S.peace&&S.gold.mac>=60;k++){const t=['phalange','phalange','peltaste','thessal','hypasp'][Math.floor(Math.random()*5)];S.gold.mac-=UT[t].cost;
    if(P&&at&&P.units.length<MAXU)P.units.push({t,men:UT[t].men});else if(NI.pella!=null&&S.own.pella==='mac'){const g=S.armies.find(a=>a.side==='mac'&&!a.dead&&!a.g&&a.at===NI.pella&&!a.legs.length);if(g&&g.units.length<MAXU)g.units.push({t,men:UT[t].men});else scenArmy('mac','pella',[[t,1]],GEN_MAC[1+Math.floor(Math.random()*(GEN_MAC.length-1))])}}
  // petites armées macédoniennes qui se rejoignent
  for(const a of S.armies){if(a.side!=='mac'||a.dead||a.g||a.legs.length||a.units.length>=5)continue;const o=S.armies.find(b=>b!==a&&b.side==='mac'&&!b.dead&&!b.g&&b.units.length+a.units.length<=MAXU&&Math.hypot(b.x-a.x,b.y-a.y)<4);if(o){o.units.push(...a.units);a.units=[];a.dead=true}}
  S.armies=S.armies.filter(a=>!a.dead);
  const key=ATH_KEY.filter(id=>NI[id]!=null&&S.own[id]==='car').length;
  if(S.own.athenae!=='car'){finish('lose','Athènes est tombée',"Les phalanges de Philippe sont entrées dans la ville de Périclès. L'Attique est macédonienne.");return}
  if(key===ATH_KEY.length&&!S.ev.athWin){S.ev.athWin=d;finish('win','Les entraves sont brisées',"Corinthe et Chalcis sont à vous : Philippe V ne tient plus la Grèce. Athènes redevient la première cité de l'Hellade libre.");return}
  if(d>=13*360+60){if(key)finish('win','Paix de Phoinikè',`La paix est signée : Athènes y figure aux côtés de Rome et garde ${key===1?'une des entraves':'les entraves'} de la Grèce.`);else finish('win','Paix de Phoinikè',"La paix est signée : Athènes y figure aux côtés de Rome. L'Attique est libre, mais Philippe garde ses entraves.");return}
  // 208 : Attale de Pergame débarque à Égine
  if(d>=3330+300&&!S.ev.athAtt){S.ev.athAtt=1;scenArmy('car','athenae',[['thureo',3],['athpelt',2],['scythes',1],['hippeis',1]],'Attale Ier');evCard('Attale de Pergame débarque',"Le roi Attale arrive d'Égine avec sa flotte et ses mercenaires ; Athènes l'accueille en libérateur. Son armée se joint à la vôtre.")}}
function athPol(){const key=ATH_KEY.map(id=>NI[id]!=null?`${N[NI[id]].n} : ${S.own[id]==='car'?'<b style="color:var(--good)">à vous</b>':sideName(S.own[id])}`:'').filter(Boolean).join(' · ');
  modal(`<h2>L'assemblée d'Athènes</h2><p>Eurycléidès et Mikion mènent la cité ; le peuple vote la guerre, mais chaque défaite fait parler le parti de la paix.</p><h3>Objectif</h3><p class="sub">${key}</p><p class="sub">Prenez Corinthe et Chalcis pour gagner tout de suite. En 205, la paix de Phoinikè termine la guerre. Perdre Athènes, c'est perdre la guerre.</p><h3>La Macédoine</h3><p class="sub">Trésor ${Math.round(S.gold.mac||0)} or · ${N.filter(n=>!n.col&&S.own[n.id]==='mac').length} villes · ${S.armies.filter(a=>a.side==='mac'&&!a.g&&!a.dead).reduce((s,a)=>s+a.units.length,0)} régiments en campagne.</p><div class="row" style="justify-content:flex-end"><button class="go" id="mClose" type="button">Fermer</button></div>`);$('mClose').onclick=closeModal}
const ATH_EVENTS=[
  {w:3,f:()=>EVENTS[0].f()},{w:3,f:()=>EVENTS[1].f()},
  {w:2,f:()=>{const g=40+Math.round(Math.random()*40);S.gold.car+=g;evCard('Les mines du Laurion',`Les filons d'argent du Laurion rendent bien : +${g} or.`)}},
  {w:2,f:()=>{const g=30+Math.round(Math.random()*30);S.gold.car+=g;evCard('Le Pirée',`Les marchands affluent au Pirée malgré la guerre : +${g} or de taxes.`)}},
  {w:1,f:()=>{for(const a of S.armies)if(a.side==='car'&&a.mor!=null)a.mor=Math.min(100,a.mor+6);evCard('Les Panathénées',"La procession monte à l'Acropole ; la cité retrouve sa fierté (moral +6).")}},
  {w:1,f:()=>{if(S.peace)return EVENTS[0].f();const g=Math.min(S.gold.car,20+Math.round(Math.random()*30));S.gold.car-=g;evCard('Les pillards macédoniens',`Des cavaliers de Philippe ravagent les campagnes de l'Attique : −${g} or.`)}}];
const ATH_PH=[[" Prendre Rome. Vous perdez si Carthage tombe."," Prendre Corinthe et Chalcis, les entraves de la Grèce. Vous perdez si Athènes tombe."],["écu violet","écu vert"],["Alliance : ils rejoignent Carthage avec","Alliance : ils rejoignent Athènes avec"],[" Les tributaires (soumis par les Barcides) paient"," Les tributaires de Carthage (soumis par les Barcides) paient"],["quand une armée punique est proche et tant que vous gardez leurs otages","quand une armée punique est proche et tant que Carthage garde leurs otages"]];

/* ---------- 9 ter. LES PEUPLES ALLIÉS EN 218 : la paix d'abord, la guerre à la date historique (ou plus tôt) ---------- */
// Le joueur ('car') joue Macédoine, Syracuse ou Athènes dès le printemps 218 ; Carthage ('pun') suit Hannibal sous l'IA.
// S.peace={foe,d} : tant qu'elle dure, pas de guerre avec l'ennemi à venir ; elle prend fin à la date historique, ou quand le joueur déclare la guerre (fenêtre Politique).
const P218={
  mac:{n:'218 : la guerre des Alliés',foe:'rom',d:3*360+120,gold:420,
    t:"Philippe V a dix-sept ans et mène la guerre des Alliés contre la Ligue étolienne, avec les Achéens d'Aratos. En Italie, Hannibal descend des Alpes. La paix de Naupacte (217) vous laisse les mains libres ; en 215, vous pourrez vous allier à Hannibal et attaquer Rome en Illyrie, ou le faire plus tôt.",
    war:"Déclarer la guerre à Rome (alliance avec Hannibal)",wt:"Rome deviendra votre ennemie : Laevinus gardera l'Adriatique et les ports illyriens."},
  syr:{n:'218 : Hiéron II, ami de Rome',foe:'rom',d:4*360,gold:450,
    t:"Le vieux roi Hiéron II gouverne Syracuse depuis cinquante ans, fidèle allié de Rome ; Archimède construit ses machines. Hiéron mourra en 215 ; en 214, Syracuse rompra avec Rome. Préparez la cité, ou rompez plus tôt.",
    war:"Rompre avec Rome (alliance avec Carthage)",wt:"Marcellus et Appius Claudius débarqueront en Sicile contre vous."},
  ath:{n:'218 : Athènes neutre',foe:'mac',d:3330,gold:300,
    t:"Athènes reste à l'écart des guerres de Philippe V et des Étoliens ; le Pirée commerce avec tous. En 209, la cité rejoindra Rome, les Étoliens et Attale contre la Macédoine. Préparez l'Attique, ou entrez en guerre plus tôt.",
    war:"Déclarer la guerre à Philippe V",wt:"La Macédoine deviendra votre ennemie ; les Étoliens seront vos alliés."}};
// unités d'origine (Carthage) remplacées par celles du peuple joué
const P218_UT={mac:{inf:'phalange',cav:'thessal',sk:'peltaste'},syr:{inf:'athoplites',cav:'hippeis',sk:'athpelt'},ath:{inf:'athoplites',cav:'hippeis',sk:'athpelt'},mas:{inf:'athoplites',cav:'hippeis',sk:'athpelt'}};
function p218Units(a,k){const M=P218_UT[k];if(!M)return;const ok=new Set(Object.values(POOL_CAR).flat());for(const u of a.units){if(ok.has(u.t)||!UT[u.t])continue;const K=UT[u.t].k;const t=K==='cav'||/cav/.test(u.t)?M.cav:K==='skirm'?M.sk:M.inf;u.t=t;u.men=UT[t].men}}
function startPeo218(k,df){newGame();S.diff=DIFF[df]?df:'normal';try{tradeInit();genInit()}catch(e){console.error(e)}
  scenSetup=true;try{peo218Setup(k)}finally{scenSetup=false}
  S.started=false;S.paused=true;save();afterLoad();closeModal();const P=P218[k];
  modal(`<h2>${P.n}</h2><p>${P.t}</p><p class="sub">La guerre commence d'elle-même à la date historique ; la fenêtre Politique permet de la déclarer plus tôt. Les batailles se jouent aux couleurs de votre peuple.</p><div class="row"><button class="go" id="mGo" type="button">Commencer</button><button id="mHelp" type="button">Comment jouer</button></div>`);
  $('mGo').onclick=()=>{closeModal();const h=S.armies.find(a=>a.side==='car'&&!a.g)||S.armies[0];centerOn(h.x,h.y,1.2)};$('mHelp').onclick=openHelp}
function peo218Setup(k){const P=P218[k];
  peoStatic(k);
  S.peo=k;S.gold.pun=Math.max(300,S.gold.car||0);S.gold.car=P.gold;S.gi=S.gi||{};if(S.gi.mac==null)S.gi.mac=0;
  // Carthage passe à l'IA ('pun') ; Hannibal garde son armée
  for(const n of N)if(S.own[n.id]==='car')S.own[n.id]='pun';
  for(const a of S.armies)if(a.side==='car')a.side='pun';for(const f of S.fleets||[])if(f.side==='car')f.side='pun';
  for(const r of S.trade||[])if(r.side==='car')r.side='pun';for(const g of S.gens||[])if(g.side==='car')g.side='pun';
  for(const id in S.q)if(S.q[id].side==='car')S.q[id].side='pun';
  S.fac.pun={car:k==='syr'?0:30,rom:-100,st:'guerre_rom',cd:0,fid:60};
  for(const f in S.fac){const F=S.fac[f];if(f==='pun')continue;if(/^(tribut|pacte|allie)_car$/.test(F.st||''))F.st='neutre'}
  // le peuple joué : ses villes et ses garnisons
  for(const n of N)if(S.own[n.id]===k)S.own[n.id]='car';for(const a of S.armies)if(a.side===k){a.side='car';p218Units(a,k)}delete S.fac[k];
  if(k==='mac'){
    // guerre des Alliés : les Étoliens contre Philippe, les Achéens avec lui
    if(S.fac.eto){S.fac.eto.st='guerre_car';S.fac.eto.car=-60}if(S.fac.ach){S.fac.ach.st='pacte_car';S.fac.ach.car=60}
    scenArmy('car','pella',[['phalange',4],['hypasp',1],['peltaste',2],['cretois',1],['compagnons',1],['thessal',1]],'Philippe V');
    scenArmy('car','corinthus',[['phalange',1],['peltaste',1],['thessal',1]],'Taurion');
    S.trade=(S.trade||[]).filter(r=>r.side!=='car');for(const [a,b] of [['thessalonica','demetrias'],['thessalonica','corinthus']]){const r=mkRoute('car',a,b);if(r)S.trade.push(r)}}
  else if(k==='syr'){
    scenArmy('car','syracusae',[['athoplites',3],['thureo',1],['cretois',1],['hippeis',1]],'Hiéron II');
    S.trade=(S.trade||[]).filter(r=>r.side!=='car');for(const [a,b] of [['syracusae','catana'],['syracusae','carthago']]){const r=mkRoute('car',a,b);if(r)S.trade.push(r)}}
  else if(k==='ath'){
    for(const a of S.armies)if(a.side==='mac')p218Units(a,'mac');
    if(S.fac.mac){S.fac.mac.st='neutre';S.fac.mac.car=-10}
    scenArmy('car','athenae',[['athoplites',2],['athpelt',1],['scythes',1],['hippeis',1]],'Eurycléidès');S.trade=(S.trade||[]).filter(r=>r.side!=='car')}
  else if(PX[k])pxSetup(k);
  S.log=[];S.peace={foe:P.foe,d:P.d};S.ev=S.ev||{};S.ev.p218=1;S.pol=null;S.mirror=false;
  for(const a of S.armies){if(a.food==null||!isFinite(a.food))a.food=armyFoodMax(a)}
  log(k==='mac'?"Printemps 218 : Philippe V marche contre les Étoliens. Hannibal a quitté Nova Carthago.":k==='syr'?"Printemps 218 : Hiéron II envoie du blé à Rome. Hannibal a quitté Nova Carthago.":k==='ath'?"Printemps 218 : Athènes reste neutre. Hannibal a quitté Nova Carthago.":k==='num'?"Printemps 218 : Gaïa règne à Cirta. Hannibal a quitté Nova Carthago.":k==='per'?"Printemps 218 : Attale Ier et ses Galates soumettent l'Éolide et la Troade. Hannibal a quitté Nova Carthago.":k==='mas'?"Printemps 218 : vos ambassadeurs reviennent de Rome. Hannibal a quitté Nova Carthago et marche vers le Rhône.":"Printemps 218 : les Boïens chassent les colons romains. Hannibal a quitté Nova Carthago.")}
// la guerre éclate : à la date historique ou quand le joueur la déclare
function peoWar(early){if(!S||!S.peace)return;const k=S.peo;S.peace=null;
  if(k==='mac'){scenArmy('rom','brundisium',[['legion',2],['velites',1],['acav',1]],'M. Valerius Laevinus');scenGar('rom',MAC_ILL.filter(id=>NI[id]!=null&&S.own[id]==='rom'),[['legion',1],['velites',1]]);
    S.macWar=1;S.ev.macPhil=1;if(S.fac.pun){S.fac.pun.car=60}
    evCard('Philippe V et Hannibal',early?"Vous avez scellé l'alliance avec Hannibal avant l'heure : Rome vous déclare la guerre et envoie Laevinus garder l'Adriatique.":"Vos ambassadeurs ont rejoint Hannibal en Campanie : le traité est signé. Rome vous déclare la guerre et envoie Laevinus garder l'Adriatique.")}
  else if(k==='syr'){scenArmy('rom','messana',[['legion',4],['velites',1],['rcav',1]],'M. Claudius Marcellus');scenArmy('rom','agrigentum',[['legion',2],['velites',1]],'Ap. Claudius Pulcher');
    scenGar('rom',SYR_KEY.filter(id=>NI[id]!=null&&S.own[id]==='rom'),[['legion',1]]);S.ev.syrRev=1;if(S.fac.pun){S.fac.pun.car=60}
    evCard('Syracuse rompt avec Rome',early?"Syracuse renie l'alliance de Hiéron et s'allie à Carthage. Marcellus débarque en Sicile.":"Hiéron est mort, Hiéronymos assassiné ; Hippocrate et Épicyde tiennent la ville et rompent avec Rome. Marcellus débarque en Sicile ; Archimède arme les remparts.")}
  else if(PX[k])pxWar(k,early);
  else{if(S.fac.mac){S.fac.mac.st='guerre_car';S.fac.mac.car=-100;S.fac.mac.cd=0}S.ev.athWar=1;
    scenArmy('mac','pella',[['phalange',5],['hypasp',2],['peltaste',2],['compagnons',2],['thessal',1],['cretois',1]],'Philippe V');
    scenArmy('mac','chalcis',[['phalange',2],['peltaste',1],['thessal',1]],'Philoclès');
    if(S.fac.eto){S.fac.eto.st='pacte_car';S.fac.eto.car=60}if(S.fac.ach){S.fac.ach.st='neutre';S.fac.ach.car=-25}
    evCard('Athènes contre Philippe V',early?"L'assemblée vote la guerre contre la Macédoine. Les Étoliens s'allient à vous ; Philippe rassemble ses phalanges à Pella.":"Athènes rejoint Rome, les Étoliens et Attale contre la Macédoine. Philippe rassemble ses phalanges à Pella.")}
  for(const a of S.armies){if(a.food==null||!isFinite(a.food))a.food=armyFoodMax(a)}}
// paix : pas de bataille ni de siège entre le joueur et l'ennemi à venir
{const _hoP=hostile;hostile=function(a,b){if(S&&S.peace&&isMac()){const s=[a.side,b.side];if(s.includes('car')&&s.includes(S.peace.foe))return false}return _hoP.apply(this,arguments)}}
{const _chP=cityHostile;cityHostile=function(i,side){const r=_chP.apply(this,arguments);try{if(r&&S&&S.peace&&isMac()){const o=ownerN(i);if(side===S.peace.foe&&o==='car'||side==='car'&&o===S.peace.foe)return false}}catch(e){}return r}}
{const _dP=daily;daily=function(d){const r=_dP.apply(this,arguments);try{if(S&&S.peace&&isMac()&&S.day>=S.peace.d)peoWar(false);
    // paix de Naupacte (été 217) : fin de la guerre des Alliés
    if(S&&isMac()&&S.peo==='mac'&&S.ev&&S.ev.p218&&d>=360+150&&d<2700&&!S.ev.naup&&S.fac.eto&&S.fac.eto.st==='guerre_car'){S.ev.naup=1;S.fac.eto.st='neutre';S.fac.eto.car=-20;evCard('La paix de Naupacte',"Agélaos d'Étolie vous presse de faire la paix : « tournez les yeux vers l'Occident, où se lève un nuage ». La guerre des Alliés est finie.")}}catch(e){console.error(e)}return r}}
// en paix, l'ennemi à venir n'envoie pas d'agents (vos propres agents restent exposés)
{const _agP=agMonthly;agMonthly=function(){if(!(S&&S.peace&&isMac()))return _agP.apply(this,arguments);agInit();for(const ag of S.ag.slice())if(ag.st==='poste'&&ag.m==='vue'&&ownerN(ag.t)!=='car'&&Math.random()<.08)agCaught(ag,N[ag.t])}}
// la fenêtre Politique propose d'ouvrir la guerre plus tôt
{const _opP=openPol;openPol=function(){const r=_opP.apply(this,arguments);try{if(S&&S.peace&&isMac()&&P218[S.peo]){const P=P218[S.peo],C=$('mcard'),rows=C.querySelectorAll('.row'),row=rows[rows.length-1];
    const el=document.createElement('div');el.className='rec';el.innerHTML=`<span><b>${P.war}</b><br><span class="sub">${P.wt} Sinon, la guerre commence en ${cal(P.d).year} av. J.-C.</span></span><button class="go" id="pwGo" type="button">Déclarer</button>`;
    const h2=C.querySelectorAll('h3')[1]||row;if(h2)h2.parentNode.insertBefore(el,h2);else C.appendChild(el);$('pwGo').onclick=()=>{peoWar(true);closeModal()}}}catch(e){console.error(e)}return r}}

/* ---------- 11. MACHINES DE SIÈGE ET DÉFENSE DES VILLES ---------- */
// Complète le bloc SIÈGE du fil Armées (sorties, assaut, lignes, mine, reddition) sans le modifier.
// sg.eng={rams|tow|cat:{t}} : machines prêtes au jour t. Béliers et tours affaiblissent les murs à l'assaut ; les catapultes usent la garnison et pressent le siège.
// Défense : rationner les vivres (siège plus long, moral en baisse), réparer la brèche, sortie de nuit pour brûler les machines.
const ENG={rams:{n:'Béliers',d:4,c:20,w:.88,t:"Des béliers sous leurs tortues contre les portes : à l'assaut, les murs comptent 12 % de moins."},
  tow:{n:'Tours',d:8,c:45,w:.8,min:1,t:"Des tours roulantes plus hautes que les murs : à l'assaut, les murs comptent 20 % de moins. Pas contre une simple bourgade."},
  cat:{n:'Catapultes',d:6,c:30,t:"Pierres et traits sur les remparts : la garnison perd des hommes chaque jour et le siège avance 15 % plus vite."}};
const engOk=(sg,k)=>!!(sg&&sg.eng&&sg.eng[k]&&S.day>=sg.eng[k].t);
function engW(i){const sg=S.siege[N[i].id];let m=1;for(const k of ['rams','tow'])if(engOk(sg,k))m*=ENG[k].w;return m}
const engPay=(a,fn)=>{try{if(typeof mpdWith==='function'&&typeof mpdArmy==='function')return mpdWith(mpdArmy(a),fn)}catch(e){}return fn()};
function buildEng(a,i,k){const sg=S.siege[N[i].id],E=ENG[k];if(!sg||sg.side!==a.side)return false;sg.eng=sg.eng||{};if(sg.eng[k])return false;if(E.min&&N[i].size<E.min)return false;
  const side=a.side;if((S.gold[side]||0)<E.c)return false;
  return engPay(a,()=>{S.gold[side]-=E.c;sg.eng[k]={t:Math.floor(S.day)+lineDays(a,E.d)};if(side==='car')log(`${a.name} fait construire des ${E.n.toLowerCase()} devant ${N[i].n} (${lineDays(a,E.d)} jours, ${E.c} or).`);return true})}
function rationGar(i){const sg=S.siege[N[i].id];if(!sg||sg.rat)return false;sg.rat=1;sg.need=Math.round(sg.need*1.3);
  for(const x of shutIn(i))x.mor=Math.max(5,(x.mor==null?MOR0:x.mor)-10);if(ownerN(i)==='car')log(`On rationne les vivres à ${N[i].n} : la garnison tiendra plus longtemps, mais le moral baisse.`);return true}
function repairWall(i){const sg=S.siege[N[i].id];if(!sg||!sg.breach||sg.rep)return false;sg.rep={t:Math.floor(S.day)+6};if(ownerN(i)==='car')log(`Les habitants de ${N[i].n} murent la brèche (6 jours).`);return true}
function burnEng(a,i){const sg=S.siege[N[i].id];if(!sg||!sg.eng||(sg.burnT&&S.day<sg.burnT))return false;sg.burnT=Math.floor(S.day)+20;
  const K=Object.keys(sg.eng);for(const u of a.units)u.men*=.97;cleanArmy(a);
  if(K.length&&Math.random()<.5){const k=K[Math.floor(Math.random()*K.length)];delete sg.eng[k];log(`${a.side==='car'?a.name:'La garnison de '+N[i].n} sort de nuit et incendie les ${ENG[k].n.toLowerCase()} des assiégeants !`)}
  else if(a.side==='car'||sg.side==='car')log(`La sortie de nuit contre les machines de ${N[i].n} est repoussée.`);return true}
// assaut : les machines abaissent les murs (résolution automatique et bataille 3D)
{const _odE=odds;odds=function(b){const p=_odE.apply(this,arguments);try{if(b&&b.assault!=null){const m=engW(b.assault);if(m<1){const q=Math.min(.999,Math.max(.001,p)),r=q/(1-q)/(m*m);return r/(1+r)}}}catch(e){}return p}}
{const _dvE=dive;dive=function(payload){try{const b=S.cur;if(b&&b.assault!=null&&payload&&payload.b&&payload.b.walls){const m=engW(b.assault);if(m<1){payload.b.walls.k=Math.round(payload.b.walls.k*m*100)/100;payload.b.desc=(payload.b.desc||'')+` Les machines de siège abaissent les murs (×${Math.round(m*100)/100}).`}}}catch(e){}return _dvE.apply(this,arguments)}}
{const _dE=daily;daily=function(d){const r=_dE.apply(this,arguments);try{
  for(const id in S.siege){const sg=S.siege[id],i=NI[id];if(i==null)continue;const o=ownerN(i);
    if(sg.rep&&S.day>=sg.rep.t){delete sg.breach;delete sg.rep;if(o==='car')log(`La brèche de ${N[i].n} est murée.`)}
    if(engOk(sg,'cat')){sg.d=Math.min(sg.need,sg.d+.15);for(const x of shutIn(i)){for(const u of x.units)u.men*=.995;cleanArmy(x)}}
    // l'IA assiégeante construit ses machines ; l'IA assiégée rationne, mure la brèche, brûle les machines
    const B=besiegers(i,sg.side);if(B.length&&sg.side!=='car'&&!(typeof MPRH==='function'&&MPRH(sg.side))&&sg.d>=3&&d%3===0){
      for(const k of N[i].size>=2?['cat','tow','rams']:['rams','cat'])if(!(sg.eng&&sg.eng[k])&&(S.gold[sg.side]||0)>=ENG[k].c+60){buildEng(B[0],i,k);break}}
    if(o!=='car'&&!(typeof MPRH==='function'&&MPRH(o))&&sg.side!==o){const G=shutIn(i);if(!sg.rat&&sg.d>sg.need*.5)rationGar(i);if(sg.breach&&!sg.rep)repairWall(i);
      if(G.length&&sg.eng&&Object.keys(sg.eng).length&&d%5===0&&Math.random()<.15)burnEng(G[0],i)}}}catch(e){console.error(e)}return r}}
// boutons dans le panneau de l'armée
{const _rsE=renderSide;renderSide=function(){const r=_rsE.apply(this,arguments);try{if(!S||!(sel&&sel.a&&!sel.a.dead&&isMine(sel.a)))return r;const a=sel.a,box=$('side')&&$('side').querySelector('.genbox');if(!box||a.at==null||a.legs.length)return r;
  const n=N[a.at],sg=S.siege[n.id];if(!sg||n.col)return r;const B=(id,t,tt,on,dis)=>`<button id="${id}" type="button" class="${on?'on':''}" title="${tt}" ${dis?'disabled':''}>${t}</button>`;let h='';
  if(sg.side===a.side){const st=k=>{const e=sg.eng&&sg.eng[k];return !e?` (${ENG[k].c} or)`:S.day>=e.t?' ✓':` (${Math.max(0,Math.ceil(e.t-S.day))} j)`};
    h=`<p class="sub" style="margin:8px 0 2px">Machines de siège</p><div class="row">${Object.keys(ENG).map(k=>B('aEng_'+k,ENG[k].n+st(k),ENG[k].t+` Construction : ${lineDays(a,ENG[k].d)} jours.`,engOk(sg,k),!!(sg.eng&&sg.eng[k])||(ENG[k].min&&n.size<ENG[k].min)||(S.gold[a.side]||0)<ENG[k].c)).join('')}</div>`}
  else if(insideOf(a)){h=`<p class="sub" style="margin:8px 0 2px">Défense de ${esc(n.n)}</p><div class="row">${B('aRat','Rationner'+(sg.rat?' ✓':''),"Demi-rations : la garnison tient 30 % plus longtemps avant de se rendre, mais le moral baisse (−10).",!!sg.rat,!!sg.rat)}${B('aRep',sg.rep?`Brèche (${Math.max(0,Math.ceil(sg.rep.t-S.day))} j)`:'Murer la brèche',"Les habitants murent la brèche ouverte par la mine (6 jours) : les murs retrouvent toute leur force.",false,!sg.breach||!!sg.rep)}${B('aBurn','Brûler les machines',"Sortie de nuit : une chance sur deux d'incendier une machine des assiégeants ; quelques pertes. Une fois tous les 20 jours.",false,!(sg.eng&&Object.keys(sg.eng).length)||(sg.burnT&&S.day<sg.burnT))}</div>`}
  if(!h)return r;box.insertAdjacentHTML('beforeend',h);
  for(const k of Object.keys(ENG)){const e=$('aEng_'+k);if(e)e.onclick=()=>{buildEng(a,a.at,k);renderAll()}}
  const on=(id,f)=>{const e=$(id);if(e)e.onclick=()=>{f();renderAll()}};on('aRat',()=>rationGar(a.at));on('aRep',()=>repairWall(a.at));on('aBurn',()=>burnEng(a,a.at))}catch(e){console.error(e)}return r}}

/* ---------- 12. NOUVEAUX PEUPLES : NUMIDIE ET GAULOIS CISALPINS (départ 218) ---------- */
