/* ================= BOUCLE ================= */
setTimeout(async()=>{
  GROUND=await groundP;
  buildTerrain();buildScenery();buildMinimap();
  $('loading').textContent='Rassemblement des troupes…';
  try{beelimReady=FIG==='beelim'&&await loadBeelim()}catch(e){console.warn('Modèles Beelim indisponibles, figurines simples utilisées',e);beelimReady=false}
  for(const id in BM)if(!BM[id].nv)delete BM[id];
  setup();resize();updateCamera();if(INTRO)introStart();
  {const sT=$('sTaille'),cO=$('cOmbres'),sF=$('sFig');sT.value=String(SIZE);cO.checked=SHADOWS;sF.value=FIG;
   const apply=()=>{try{localStorage.setItem('bellum.taille',sT.value);localStorage.setItem('bellum.ombres',cO.checked?'1':'0');localStorage.setItem('bellum.figurines',sF.value)}catch(e){}
     const u=new URL(location.href);u.searchParams.delete('taille');history.replaceState(null,'',u.href);location.reload()};
   sT.onchange=apply;cO.onchange=apply;sF.onchange=apply}
  $('loading').remove();
  window.addEventListener('resize',resize);
  let last=performance.now(),hudT=0,mmT=0,fpsN=0,fpsT=0,fpsL=performance.now();
  const fpsEl=document.createElement('div');fpsEl.id='fps';document.body.appendChild(fpsEl);
  function frame(now){
    const raw=Math.min(.05,(now-last)/1000);last=now;
    if(!paused&&started){let t=raw*speed;while(t>0){const s=Math.min(t,1/30);step(s);t-=s}rt+=raw*speed}
    else rt+=raw*.15;
    flagTime.value+=raw;
    keyPan(raw);updateCamera();
    if(waterTex)waterTex.offset.y-=raw*.035;
    updateFigures();if(beelimReady)updateBeelim(paused?0:raw*speed);updateFx();updateParticles(paused?0:raw*speed);updateTags();
    hudT-=raw;if(hudT<=0){hudT=.2;hudTick()}
    mmT-=raw;if(mmT<=0){mmT=.12;drawMinimap()}
    renderer.render(scene,camera);
    fpsN++;fpsT+=now-fpsL;fpsL=now;if(fpsT>=500){const f=Math.round(fpsN*1000/fpsT);fpsN=0;fpsT=0;
      let alive=0;for(const u of units)if(!u.fled)alive+=u.shown;
      fpsEl.textContent=f+' i/s · '+alive.toLocaleString('fr-FR')+' figurines · taille ×'+SIZE+(SHADOWS?'':' · sans ombres');fpsEl.style.color=f>=50?'#cfe8b0':f>=30?'#f0d890':'#f2a08a'}
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
