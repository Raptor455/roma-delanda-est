      if(VIL&&VIL.x>x0-VIL.r-40&&VIL.x<x1+VIL.r+40&&VIL.y>y0-VIL.r-40&&VIL.y<y1+VIL.r+40){
        for(const P of VIL.LN){g.beginPath();g.moveTo(P[0][0],P[0][1]);for(let k=1;k<P.length;k++)g.lineTo(P[k][0],P[k][1]);g.strokeStyle='rgba(96,78,50,.6)';g.lineWidth=5;g.stroke();g.strokeStyle='#c2ad84';g.lineWidth=3.8;g.stroke()}
