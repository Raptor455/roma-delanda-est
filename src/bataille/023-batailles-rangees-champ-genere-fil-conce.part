    function parsIn(x0,y0,x1,y1){const S=new Set();for(let i=Math.floor(x0/256);i<=Math.floor(x1/256);i++)for(let j=Math.floor(y0/256);j<=Math.floor(y1/256);j++){const L=PB.get(fk(i,j));if(L)for(const o of L)if(o.b[0]<x1&&o.b[2]>x0&&o.b[1]<y1&&o.b[3]>y0)S.add(o)}return S}
    function inPar(x,y){const L=PB.get(fk(Math.floor(x/256),Math.floor(y/256)));if(!L)return null;for(const o of L){if(x<o.b[0]||x>o.b[2]||y<o.b[1]||y>o.b[3])continue;const P=o.P;let c=false;for(let i=0,j=3;i<4;j=i++){const [xi,yi]=P[i],[xj,yj]=P[j];if((yi>y)!==(yj>y)&&x<(xj-xi)*(y-yi)/(yj-yi)+xi)c=!c}if(c)return o}return null}
    const nearFarm=(x,y,r)=>FARM.some(q=>Math.hypot(q.x-x,q.y-y)<r)||(VIL&&Math.hypot(VIL.x-x,VIL.y-y)<VIL.r);
    /* grain du sol : motif répété (1 point = 0,5 m) */
    let GRAIN=null;
