          g.fillStyle=rgb(mix(c,[30,50,20],.35));g.beginPath();g.arc(x+r*.3,y+r*.32,r*.32,0,6.283);g.fill()}}}
    function house(g,x,y,w,h,a,S,roof){g.save();g.translate(x,y);g.rotate(a);
      g.fillStyle='rgba(20,14,8,.36)';g.fillRect(-w/2+1.6,-h/2+2,w,h);
      g.fillStyle=roof?'#a8603f':'#b9a27a';g.fillRect(-w/2,-h/2,w,h);g.fillStyle=roof?'#8f4c30':'#a48e68';g.fillRect(-w/2,0,w,h/2);
      if(S>=1){g.strokeStyle='rgba(40,24,12,.8)';g.lineWidth=.4;g.strokeRect(-w/2,-h/2,w,h);g.beginPath();g.moveTo(-w/2,0);g.lineTo(w/2,0);g.stroke();
        if(S>=2&&roof){g.strokeStyle='rgba(60,30,16,.35)';g.lineWidth=.2;g.beginPath();for(let u=-w/2+1;u<w/2;u+=1){g.moveTo(u,-h/2);g.lineTo(u,h/2)}g.stroke()}}
      g.restore()}
    function render(L,ti,tj){const S=LV[L],sz=TS/S,x0=ti*sz,y0=tj*sz,x1=x0+sz,y1=y0+sz,c=document.createElement('canvas');c.width=c.height=TS;const g=c.getContext('2d');
