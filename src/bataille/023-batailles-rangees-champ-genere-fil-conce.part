            g.restore()}}
        else{g.fillStyle=o.kind==='vigne'?'rgb(150,132,92)':'rgb(152,148,96)';g.globalAlpha=.9;g.fill();g.globalAlpha=1;
          if(o.kind==='vigne'&&S>=.5){g.save();g.clip();const ca=Math.cos(o.ang),sa=Math.sin(o.ang),cx=(o.b[0]+o.b[2])/2,cy=(o.b[1]+o.b[3])/2,R=Math.hypot(o.b[2]-o.b[0],o.b[3]-o.b[1])/2+2;
            g.strokeStyle='rgba(62,92,44,.85)';g.lineWidth=1.1;g.setLineDash(S>=1?[1.3,1.1]:[]);g.beginPath();for(let v=-R;v<=R;v+=3.2){g.moveTo(cx+ca*-R-sa*v,cy+sa*-R+ca*v);g.lineTo(cx+ca*R-sa*v,cy+sa*R+ca*v)}g.stroke();g.setLineDash([]);g.restore()}}
        // limite : fossé, haie ou muret
