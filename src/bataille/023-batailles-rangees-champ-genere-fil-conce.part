          else if(big===1){const rd=rivD(x,y);if(rd>1.5&&rd<26&&h<.2)r=2.4+hx(i,j,4)*2.4;else if(h<.0045+ (vnoise(x*.004,y*.004+5)>.62?.03:0))r=3+hx(i,j,4)*3}
          if(!r)continue;const rd=rivD(x,y);if(rd<r*.6||seaAt(x,y)||inMarsh(x*K,y*K))continue;if(roadDist(x,y)<r+3||nearFarm(x,y,26))continue;const p=inPar(x,y);if(p)continue;
