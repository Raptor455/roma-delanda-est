        if(typeof o.kind==='number'){const C=CROPS[o.kind],t=(o.seed%100)/100,col=mix(C[0],C[1],t);g.fillStyle=rgb(DRY?mix(col,[200,178,124],DRY*.3):col);g.globalAlpha=.93;g.fill();g.globalAlpha=1;
          if(S>=1){g.save();g.clip();const ca=Math.cos(o.ang),sa=Math.sin(o.ang),cx=(o.b[0]+o.b[2])/2,cy=(o.b[1]+o.b[3])/2,R=Math.hypot(o.b[2]-o.b[0],o.b[3]-o.b[1])/2+2,st=o.kind===4?1.6:2.4;
