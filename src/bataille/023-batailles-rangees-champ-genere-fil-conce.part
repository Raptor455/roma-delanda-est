        if(o.edge===0&&S>=.5){g.strokeStyle='rgba(58,84,36,.95)';g.lineWidth=2.2;g.setLineDash([2.2,1]);g.stroke();g.setLineDash([]);if(S>=2){g.strokeStyle='rgba(120,150,70,.6)';g.lineWidth=.8;g.setLineDash([1,2.2]);g.stroke();g.setLineDash([])}}
        else if(o.edge===1&&S>=.5){g.strokeStyle='rgba(70,60,44,.8)';g.lineWidth=1.3;g.stroke();g.strokeStyle='rgba(200,192,170,.9)';g.lineWidth=.7;g.setLineDash([1.6,.5]);g.stroke();g.setLineDash([])}
        else{g.strokeStyle='rgba(80,62,34,.5)';g.lineWidth=S>=1?.6:1/S;g.stroke()}}
