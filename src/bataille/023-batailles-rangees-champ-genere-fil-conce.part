      for(let i=0;i<256*256;i++){const v=r(),dk=v<.5;im.data[i*4]=dk?40:250;im.data[i*4+1]=dk?44:240;im.data[i*4+2]=dk?20:200;im.data[i*4+3]=Math.abs(v-.5)*2*38}
      g.putImageData(im,0,0);GRAIN=c}
    /* une tuile : 512 points, S points par mètre */
    const TS=512,LV=[.0625,.125,.25,.5,1,2,4,8],CACHE=new Map();let tick=0,ready=false;
