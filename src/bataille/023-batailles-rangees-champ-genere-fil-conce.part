      return c}
    function prep(){if(ready)return;buildBase();buildGrain();buildParcels();ready=true}
    /* dessin : niveau choisi d'après le zoom, tuiles rendues peu à peu (le fond doux sert d'attente) */
    function draw(g,M,DPR,s2){prep();tick++;
      const need=s2*DPR*K;let L=LV.length-1;for(let i=0;i<LV.length;i++)if(LV[i]>=need*.7){L=i;break}
      const S=LV[L],sz=TS/S,W=g.canvas.width/DPR,H=g.canvas.height/DPR,det=M[0]*M[3]-M[1]*M[2],inv=(sx,sy)=>{const x=sx-M[4],y=sy-M[5];return [(M[3]*x-M[2]*y)/det/K,(-M[1]*x+M[0]*y)/det/K]};
      let a=1e9,b=1e9,c=-1e9,d=-1e9;for(const [sx,sy] of [[0,0],[W,0],[W,H],[0,H]]){const [x,y]=inv(sx,sy);a=Math.min(a,x);b=Math.min(b,y);c=Math.max(c,x);d=Math.max(d,y)}
      a=Math.max(a,MX0);b=Math.max(b,MY0);c=Math.min(c,MX1);d=Math.min(d,MY1);
      g.save();g.setTransform(M[0]*DPR*K,M[1]*DPR*K,M[2]*DPR*K,M[3]*DPR*K,M[4]*DPR,M[5]*DPR);g.imageSmoothingEnabled=true;g.imageSmoothingQuality='high';
      g.fillStyle='#6f7648';g.fillRect(MX0-20000,MY0-20000,40000+MX1-MX0,40000+MY1-MY0);
      // le fond doux ne sert que là où une tuile manque encore
      let miss=!(c>a&&d>b);if(!miss)for(let ti=Math.floor(a/sz);ti<=Math.floor(c/sz)&&!miss;ti++)for(let tj=Math.floor(b/sz);tj<=Math.floor(d/sz);tj++)if(!CACHE.has(L+'/'+ti+'/'+tj)){miss=true;break}
      if(miss)g.drawImage(BASE,MX0-GS/2,MY0-GS/2,GNX*GS,GNY*GS);
      g.imageSmoothingQuality='low';window.__solNet=1;
      if(c>a&&d>b){let made=0;const t0=performance.now(),cxm=(a+c)/2,cym=(b+d)/2,todo=[];
        for(let ti=Math.floor(a/sz);ti<=Math.floor(c/sz);ti++)for(let tj=Math.floor(b/sz);tj<=Math.floor(d/sz);tj++){const key=L+'/'+ti+'/'+tj;let t=CACHE.get(key);
          if(t){t.u=tick;g.drawImage(t.c,ti*sz,tj*sz,sz+.5/S,sz+.5/S)}
          else{ // en attendant : la tuile du niveau au-dessous si elle existe
            for(let l=L-1;l>=0;l--){const z=TS/LV[l],p=CACHE.get(l+'/'+Math.floor(ti*sz/z)+'/'+Math.floor(tj*sz/z));if(p){p.u=tick;const px=Math.floor(ti*sz/z)*z,py=Math.floor(tj*sz/z)*z;g.save();g.beginPath();g.rect(ti*sz,tj*sz,sz,sz);g.clip();g.drawImage(p.c,px,py,z,z);g.restore();break}}
            todo.push([Math.hypot((ti+.5)*sz-cxm,(tj+.5)*sz-cym),ti,tj,key])}}
        todo.sort((p,q)=>p[0]-q[0]);
        for(const [,ti,tj,key] of todo){if(made&&performance.now()-t0>(window.__solBudget||10))break;const t={c:render(L,ti,tj),u:tick};CACHE.set(key,t);g.drawImage(t.c,ti*sz,tj*sz,sz+.5/S,sz+.5/S);made++}
        if(CACHE.size>90){const A=[...CACHE.entries()].sort((p,q)=>p[1].u-q[1].u);for(let i=0;i<A.length-70;i++)CACHE.delete(A[i][0])}
        SOL.pending=todo.length-made}
      g.restore()}
    return {draw,prep,inFo,PAR,FARM,CACHE,pending:0,get VIL(){return VIL}}})();
  const P2=window.Path2D;let CNT=null,RIVP=null,REEDS=null,info=null;
  function smooth(p,P){const n=p.length;P.moveTo(p[0][0],p[0][1]);for(let i=1;i<n-1;i++){const mx=(p[i][0]+p[i+1][0])/2,my=(p[i][1]+p[i+1][1])/2;P.quadraticCurveTo(p[i][0],p[i][1],mx,my)}P.lineTo(p[n-1][0],p[n-1][1])}
  function build(){
    // courbes de niveau (carrés marchants sur une grille suréchantillonnée ×2)
    // à partir du relief lissé (grille de 8 m de la bataille, un point sur trois) : courbes douces
    const sub=3,NX=Math.floor((GNX-1)/sub)+1,NY=Math.floor((GNY-1)/sub)+1,V=new Float32Array(NX*NY);let lo=1e9,hi=-1e9;
    for(let j=0;j<NY;j++)for(let i=0;i<NX;i++){const v=HG[j*sub*GNX+i*sub];V[j*NX+i]=v;lo=Math.min(lo,v);hi=Math.max(hi,v)}
    const rng=hi-lo,I=rng<40?2:rng<120?5:rng<500?10:20,thin=new P2(),thick=new P2(),st=GS*sub;
    for(let lv=Math.ceil(lo/I)*I;lv<=hi;lv+=I){const P=(Math.round(lv/I)%5===0)?thick:thin;
      for(let j=0;j<NY-1;j++)for(let i=0;i<NX-1;i++){const a=V[j*NX+i],b=V[j*NX+i+1],c=V[(j+1)*NX+i+1],d=V[(j+1)*NX+i];
        const idx=(a>lv?8:0)|(b>lv?4:0)|(c>lv?2:0)|(d>lv?1:0);if(idx===0||idx===15)continue;
        const X=x=>(GX0+x*st)*K,Y=y=>(GY0+y*st)*K,e=[[X(i+(lv-a)/(b-a)),Y(j)],[X(i+1),Y(j+(lv-b)/(c-b))],[X(i+(lv-d)/(c-d)),Y(j+1)],[X(i),Y(j+(lv-a)/(d-a))]];
        const segs={1:[[3,2]],2:[[2,1]],3:[[3,1]],4:[[0,1]],5:[[3,0],[2,1]],6:[[0,2]],7:[[3,0]],8:[[3,0]],9:[[0,2]],10:[[0,1],[3,2]],11:[[0,1]],12:[[3,1]],13:[[2,1]],14:[[3,2]]}[idx];
        for(const [p,q] of segs){P.moveTo(e[p][0],e[p][1]);P.lineTo(e[q][0],e[q][1])}}}
    CNT={thin,thick,I};
    RIVP=RIVS.map(R=>{const P=new P2();smooth(R.p,P);return P});
    // roseaux des marais
    REEDS=[];let s=1;const rnd=()=>(s=(s*16807)%2147483647)/2147483647;
    for(const M of MARSH){const A=(M.b[2]-M.b[0])*(M.b[3]-M.b[1]);for(let k=0;k<A/(900*K*K);k++){const x=M.b[0]+rnd()*(M.b[2]-M.b[0]),y=M.b[1]+rnd()*(M.b[3]-M.b[1]);if(inMarsh(x,y))REEDS.push([x,y])}}
  }
  const INKC='rgba(42,32,22,.9)',WATER='#86a7ab';
  const _sol=window.__sol2d;
  window.__sol2d=function(g,M,DPR,s2){
    try{_sol&&_sol.apply(this,arguments)}catch(e){}
    if(!CNT)build();if(!fixed&&units&&units.length&&!started)fixDeploy();
    if(SOL)try{SOL.draw(g,M,DPR,s2)}catch(e){window.__solNet=0;if(!window.__solErr){window.__solErr=e;console.warn('sol net',e)}}
    const px=1/s2; // 1 pixel écran en unités du monde
    g.save();g.setTransform(M[0]*DPR,M[1]*DPR,M[2]*DPR,M[3]*DPR,M[4]*DPR,M[5]*DPR);g.lineCap='round';g.lineJoin='round';
    // relief
    g.strokeStyle=SOL?'rgba(70,46,20,.2)':'rgba(96,64,30,.5)';g.lineWidth=px*1;g.stroke(CNT.thin);g.strokeStyle=SOL?'rgba(70,46,20,.34)':'rgba(88,56,24,.72)';g.lineWidth=px*1.6;g.stroke(CNT.thick);
    // marais
    for(const Mh of MARSH){g.beginPath();smooth(Mh.P.concat([Mh.P[0]]),g);g.closePath();g.fillStyle='rgba(96,128,108,.42)';g.fill();g.setLineDash([px*4,px*3]);g.strokeStyle='rgba(40,62,50,.6)';g.lineWidth=px;g.stroke();g.setLineDash([])}
    if(s2>.15){g.strokeStyle='rgba(38,58,46,.75)';g.lineWidth=px*.9;const z=px*5;g.beginPath();for(const [x,y] of REEDS){g.moveTo(x-z,y);g.lineTo(x+z,y);g.moveTo(x,y);g.lineTo(x-z*.5,y-z);g.moveTo(x,y);g.lineTo(x,y-z*1.2);g.moveTo(x,y);g.lineTo(x+z*.5,y-z)}g.stroke()}
    // fleuves : berge sombre, eau, reflet au milieu
    RIVS.forEach((R,i)=>{const P=RIVP[i];g.strokeStyle='rgba(190,180,138,.8)';g.lineWidth=R.hw*2+7*K;g.stroke(P);
      g.strokeStyle=INKC;g.lineWidth=R.hw*2+px*3;g.stroke(P);g.strokeStyle=WATER;g.lineWidth=R.hw*2;g.stroke(P);
      g.strokeStyle='rgba(255,255,255,.22)';g.lineWidth=Math.max(px,R.hw*.25);g.setLineDash([px*14,px*18]);g.stroke(P);g.setLineDash([])});
    // gués et ponts
    for(const c of CROSS){g.save();g.translate(c.x,c.y);g.rotate(c.a);const L=c.hw+7*K,w=c.w;
      if(c.k==='gue'){g.fillStyle='rgba(222,206,158,.88)';g.beginPath();g.ellipse(0,0,w/2,L,0,0,6.283);g.fill();g.setLineDash([px*3,px*3]);g.strokeStyle='rgba(70,52,28,.75)';g.lineWidth=px*1.2;g.stroke();g.setLineDash([]);
        g.fillStyle='rgba(90,74,48,.55)';for(let k=0;k<14;k++){const a=(k*2.399)%6.283,r=Math.sqrt((k+.5)/14);g.beginPath();g.arc(Math.cos(a)*r*w*.42,Math.sin(a)*r*L*.85,px*1.6,0,6.283);g.fill()}}
      else{g.fillStyle='#d8c497';g.strokeStyle=INKC;g.lineWidth=px*1.5;
        if(c.k==='pont'){g.fillRect(-w/2,-L,w,L*2);g.strokeRect(-w/2,-L,w,L*2);g.lineWidth=px*.7;g.beginPath();for(let y=-L+w*.4;y<L;y+=Math.max(w*.35,px*3)){g.moveTo(-w/2,y);g.lineTo(w/2,y)}g.stroke()}
        else{g.fillRect(-w/2,-L,w,L*.45);g.strokeRect(-w/2,-L,w,L*.45);g.fillRect(-w/2,L*.55,w,L*.45);g.strokeRect(-w/2,L*.55,w,L*.45);
          g.strokeStyle='#a8332b';g.lineWidth=px*3;const z=Math.max(w,px*10)*.6;g.beginPath();g.moveTo(-z,-z);g.lineTo(z,z);g.moveTo(z,-z);g.lineTo(-z,z);g.stroke()}}
      g.restore()}
    g.restore();
    // noms (en pixels écran)
    g.save();g.setTransform(DPR,0,0,DPR,0,0);g.textAlign='center';g.textBaseline='middle';g.lineJoin='round';
    const W=g.canvas.width/DPR,Hs=g.canvas.height/DPR,S=(x,y)=>[M[0]*x+M[2]*y+M[4],M[1]*x+M[3]*y+M[5]];
    const lab=(t,x,y,sz,col,ang)=>{g.save();g.translate(x,y);if(ang)g.rotate(ang);g.font=`italic ${sz}px Marcellus, Georgia, serif`;g.lineWidth=3.5;g.strokeStyle='rgba(232,222,190,.85)';g.strokeText(t,0,0);g.fillStyle=col;g.fillText(t,0,0);g.restore()};
    for(const R of RIVS){let best=null,bd=1e18;for(let i=2;i<R.p.length-2;i+=3){const [sx,sy]=S(R.p[i][0],R.p[i][1]);if(sx<60||sy<60||sx>W-60||sy>Hs-60)continue;const d=Math.hypot(sx-W*.3,sy-Hs*.3);if(d<bd){bd=d;best=i}}
      if(best!=null){const [ax,ay]=S(...R.p[best-2]),[bx,by]=S(...R.p[best+2]),[sx,sy]=S(...R.p[best]);let a=Math.atan2(by-ay,bx-ax);if(a>Math.PI/2)a-=Math.PI;if(a<-Math.PI/2)a+=Math.PI;
        const n=R.n.charAt(0).toUpperCase()+R.n.slice(1);lab(n,sx-Math.sin(a)*(R.hw*s2+14),sy+Math.cos(a)*(R.hw*s2+14),15,'#2c4a52',a)}}
    if(s2>.08)for(const c of CROSS){const [sx,sy]=S(c.x,c.y);if(sx<0||sy<0||sx>W||sy>Hs)continue;const nx=-c.uy,ny=c.ux,o=(c.hw+40*K)*s2,[ox,oy]=[M[0]*nx+M[2]*ny,M[1]*nx+M[3]*ny],l=Math.hypot(ox,oy)||1;
      lab(c.k==='gue'?'gué':c.k==='pont'?'pont':'pont coupé',sx+ox/l*o,sy+oy/l*o,12,c.k==='coupe'?'#7a1e18':'#2a2016',0)}
    if(s2>.08&&CNT.I){}
    g.restore()};
  window.__rangees={water,wet,crossAt,inMarsh,hAt,route,CROSS,RIVS,MARSH};
})();
/* ================= FIN BATAILLES RANGÉES : champ ================= */
