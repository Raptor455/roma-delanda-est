        const cw=30+R(1)*16,ch=22+R(2)*10;g.fillStyle='rgba(186,166,126,.95)';g.beginPath();g.moveTo(-cw/2,-ch/2);g.lineTo(cw/2+R(3)*4,-ch/2+R(4)*3);g.lineTo(cw/2,ch/2);g.lineTo(-cw/2-R(5)*3,ch/2+R(6)*3);g.closePath();g.fill();
        if(S>=.5){g.strokeStyle='rgba(90,78,58,.9)';g.lineWidth=1;g.stroke();g.strokeStyle='rgba(214,204,180,.9)';g.lineWidth=.5;g.stroke()}
        g.restore();const ca=Math.cos(f.a),sa=Math.sin(f.a),W=(u,v)=>[f.x+u*ca-v*sa,f.y+u*sa+v*ca];
