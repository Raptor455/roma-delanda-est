      {const cs=S>=.5?7.5:S>=.2?15:30,big=cs/7.5;for(let i=Math.floor((x0-12)/cs);i<=Math.floor((x1+12)/cs);i++)for(let j=Math.floor((y0-12)/cs);j<=Math.floor((y1+12)/cs);j++){
          const h=hx(i,j,1),x=(i+.15+hx(i,j,2)*.7)*cs,y=(j+.15+hx(i,j,3)*.7)*cs;if(x<MX0||y<MY0||x>MX1||y>MY1)continue;
          const fo=inFo(x,y);let r=0,kind='f';
