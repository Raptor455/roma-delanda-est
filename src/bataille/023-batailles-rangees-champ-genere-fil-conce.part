/* ================= BATAILLES RANGÉES : champ généré (fil « Concevoir les terrains de bataille rangée ») =================
   Lit CT.rg envoyé par la campagne (bloc BATAILLES RANGÉES de campagne.html) :
   - fleuves au vrai tracé, infranchissables hors des gués et des ponts (un pont coupé ne passe pas) ; les ordres font le détour par le passage le plus court ;
   - gué : lent, et l'on s'y défend mal ; marais : très lent, pas de charge, éléphants enlisés ;
   - relief réel en courbes de niveau ; frapper vers le bas est plus fort, vers le haut plus faible ;
   - une unité en déroute peut se jeter à l'eau : elle y perd des hommes (noyés).
   Inséré avant BOUCLE (après BATAILLE 2D et les autres blocs) ; dessin par le crochet window.__sol2d. */
(()=>{
  const RG=CT&&CT.rg;if(!RG||!RG.v)return;
  const K=G,BK=200*K;
  /* --- relief : le sol peint (s'il n'y a pas d'image de la campagne) suit l'altitude réelle --- */
  {let lo=1e9;for(const v of RG.dem.h)if(v>-5)lo=Math.min(lo,v);
    try{for(let j=0;j<GNY;j++)for(let i=0;i<GNX;i++)HG[j*GNX+i]=hAt0(GX0+i*GS,GY0+j*GS)-lo+2;
      // lissage (flou en boîte, 3 passes) : pas de facettes de 100 m dans l'ombrage
      const T=new Float32Array(HG.length),r=6;for(let pass=0;pass<3;pass++){
        for(let j=0;j<GNY;j++){let acc=0;const o=j*GNX;for(let i=-r;i<=r;i++)acc+=HG[o+Math.max(0,Math.min(GNX-1,i))];for(let i=0;i<GNX;i++){T[o+i]=acc/(2*r+1);acc+=HG[o+Math.min(GNX-1,i+r+1)]-HG[o+Math.max(0,i-r)]}}
        for(let i=0;i<GNX;i++){let acc=0;for(let j=-r;j<=r;j++)acc+=T[Math.max(0,Math.min(GNY-1,j))*GNX+i];for(let j=0;j<GNY;j++){HG[j*GNX+i]=acc/(2*r+1);acc+=T[Math.min(GNY-1,j+r+1)*GNX+i]-T[Math.max(0,j-r)*GNX+i]}}}}catch(e){}}
  function hAt0(sx,sy){const D=RG.dem,fx=Math.max(0,Math.min(D.nx-1.001,(sx-D.x0)/D.st)),fy=Math.max(0,Math.min(D.ny-1.001,(sy-D.y0)/D.st)),i=fx|0,j=fy|0,u=fx-i,v=fy-j,H=D.h,n=D.nx;
    return H[j*n+i]*(1-u)*(1-v)+H[j*n+i+1]*u*(1-v)+H[(j+1)*n+i]*(1-u)*v+H[(j+1)*n+i+1]*u*v}
  /* --- géométrie, en coordonnées du monde (×G) --- */
  // v2 : largeurs à l'échelle des régiments (petit cours d'eau 20 m, rivière 32 m, grand fleuve 88 m), gués et ponts resserrés
  const HWF=h=>h>=50?h*.8:h*.5;
  const RIVS=RG.riv.map(r=>({n:r.n,hw:HWF(r.hw)*K,p:r.p.map(([x,y])=>[x*K,y*K])}));
  const CROSS=RG.cross.map(c=>({x:c.x*K,y:c.y*K,a:c.a,hw:HWF(c.hw)*K,k:c.k,w:c.w*K*(c.k==='gue'?.6:.75),ux:Math.cos(c.a),uy:Math.sin(c.a)}));
  const MARSH=RG.marsh.map(p=>{const P=p.map(([x,y])=>[x*K,y*K]);let a=1e9,b=1e9,c=-1e9,d=-1e9;for(const [x,y] of P){a=Math.min(a,x);b=Math.min(b,y);c=Math.max(c,x);d=Math.max(d,y)}return {P,b:[a,b,c,d]}});
  const DEM=RG.dem;
  // seaux de 200 m : segments de fleuve proches
  const BUCK=new Map(),bk=(i,j)=>i*100003+j;
  RIVS.forEach((R,ri)=>{for(let s=1;s<R.p.length;s++){const [ax,ay]=R.p[s-1],[bx,by]=R.p[s],m=R.hw+40*K;
    for(let i=Math.floor((Math.min(ax,bx)-m)/BK);i<=Math.floor((Math.max(ax,bx)+m)/BK);i++)for(let j=Math.floor((Math.min(ay,by)-m)/BK);j<=Math.floor((Math.max(ay,by)+m)/BK);j++){const k=bk(i,j);let L=BUCK.get(k);if(!L)BUCK.set(k,L=[]);L.push(ri,s)}}});
  // fleuve le plus proche : distance à l'axe, côté (+1/−1) et normale
  function water(x,y){const L=BUCK.get(bk(Math.floor(x/BK),Math.floor(y/BK)));if(!L)return null;let best=null;
    for(let q=0;q<L.length;q+=2){const R=RIVS[L[q]],s=L[q+1],[ax,ay]=R.p[s-1],[bx,by]=R.p[s],vx=bx-ax,vy=by-ay,l2=vx*vx+vy*vy||1;let t=((x-ax)*vx+(y-ay)*vy)/l2;t=t<0?0:t>1?1:t;
      const px=ax+vx*t,py=ay+vy*t,d=Math.hypot(x-px,y-py);if(!best||d<best.d){const l=Math.sqrt(l2),cr=vx*(y-ay)-vy*(x-ax);best={d,R,hw:R.hw,px,py,nx:-vy/l,ny:vx/l,side:cr>=0?1:-1}}}
    return best}
  function crossAt(x,y,m=0){for(const c of CROSS){if(c.k==='coupe')continue;const dx=x-c.x,dy=y-c.y,al=dx*c.ux+dy*c.uy,pe=-dx*c.uy+dy*c.ux;if(Math.abs(al)<c.w/2+m&&Math.abs(pe)<c.hw+45*K)return c}return null}
  const wet=(x,y)=>{const w=water(x,y);return w&&w.d<w.hw?w:null};
  function inMarsh(x,y){for(const M of MARSH){if(x<M.b[0]||x>M.b[2]||y<M.b[1]||y>M.b[3])continue;let c=false;const P=M.P;for(let i=0,j=P.length-1;i<P.length;j=i++){const [xi,yi]=P[i],[xj,yj]=P[j];if((yi>y)!==(yj>y)&&x<(xj-xi)*(y-yi)/(yj-yi)+xi)c=!c}if(c)return true}return false}
  const hAt=(x,y)=>hAt0(x/K,y/K);
  // le trajet droit coupe-t-il un fleuve ? (hors passages)
  function segHit(ax,ay,bx,by){const L=Math.hypot(bx-ax,by-ay),n=Math.max(1,Math.ceil(L/(BK*.5))),seen=new Set();
    for(let k=0;k<=n;k++){const x=ax+(bx-ax)*k/n,y=ay+(by-ay)*k/n,Q=BUCK.get(bk(Math.floor(x/BK),Math.floor(y/BK)));if(!Q)continue;
      for(let q=0;q<Q.length;q+=2){const key=Q[q]*1e6+Q[q+1];if(seen.has(key))continue;seen.add(key);const R=RIVS[Q[q]],[cx,cy]=R.p[Q[q+1]-1],[dx,dy]=R.p[Q[q+1]];
        const rx=bx-ax,ry=by-ay,sx=dx-cx,sy=dy-cy,den=rx*sy-ry*sx;if(Math.abs(den)<1e-9)continue;const t=((cx-ax)*sy-(cy-ay)*sx)/den,u=((cx-ax)*ry-(cy-ay)*rx)/den;
        if(t>=0&&t<=1&&u>=0&&u<=1)return {R,x:ax+rx*t,y:ay+ry*t}}}
    return null}
  // détour : approche du passage, traversée, sortie sur l'autre rive
  function route(u,tx,ty){
    const c0=crossAt(u.x,u.y);
    if(c0){const nx=-c0.uy,ny=c0.ux,st=Math.sign((tx-c0.x)*nx+(ty-c0.y)*ny)||1,su=Math.sign((u.x-c0.x)*nx+(u.y-c0.y)*ny)||st;
      if(st!==su||wet(u.x,u.y)){const o=c0.hw+30*K;return [[c0.x+nx*st*o,c0.y+ny*st*o]]}}
    const hit=segHit(u.x,u.y,tx,ty);if(!hit)return null;
    let best=null,bd=1e18;for(const c of CROSS){if(c.k==='coupe'||c.hw!==hit.R.hw)continue;const w=water(c.x,c.y);if(!w||w.R!==hit.R)continue;const d=Math.hypot(c.x-u.x,c.y-u.y)+Math.hypot(tx-c.x,ty-c.y);if(d<bd){bd=d;best=c}}
    if(!best)return [];
    const nx=-best.uy,ny=best.ux,su=Math.sign((u.x-best.x)*nx+(u.y-best.y)*ny)||1,o=best.hw+30*K;
    return [[best.x+nx*su*o,best.y+ny*su*o],[best.x-nx*su*o,best.y-ny*su*o]]}
  window.__rgGeo={water,segHit,crossAt,hAt,inMarsh};/*IA-RG*/
  /* --- déplacements --- */
  const _mv=moveUnit;
  moveUnit=function(u,dt){
    const x0=u.x,y0=u.y,o=u.order;
    if(o&&!u.routing){let tx,ty;
      if(o.type==='attack'){if(o.target&&!o.target.dead){tx=o.target.x;ty=o.target.y}}else{tx=o.x;ty=o.y}
      if(tx!=null){
        if(u._rwO!==o||time-(u._rwT||0)>(u._rw&&u._rw.length?4:1.2)){u._rwO=o;u._rwT=time;u._rw=route(u,tx,ty)}
        if(u._rw&&!u._rw.length){ // aucun passage : on attend sur la rive
          const w=water(u.x,u.y),hit=segHit(u.x,u.y,tx,ty);if(hit&&Math.hypot(hit.x-u.x,hit.y-u.y)<w0(u)){u.v=0;u.moving=false;return}}
        else if(u._rw&&u._rw.length){const p=u._rw[0];if(Math.hypot(p[0]-u.x,p[1]-u.y)<18*K){u._rw.shift()}
          if(u._rw.length){const q=u._rw[0];u.order={type:'move',x:q[0],y:q[1],run:o.run,face:null};try{_mv(u,dt)}finally{u.order=o}slow(u,x0,y0);return}}}}
    _mv(u,dt);slow(u,x0,y0)};
  const w0=u=>(u.dd||30)/2+12*K;
  function slow(u,x0,y0){let k=1;if(wet(u.x,u.y))k=.45;else if(inMarsh(u.x,u.y))k=u.T.kind==='eleph'?.25:.42;
    if(k<1){u.x=x0+(u.x-x0)*k;u.y=y0+(u.y-y0)*k}}
  /* --- combat : gué, marais, pente --- */
  let ATT=null;
  {const _m=melee;melee=function(u){const p=ATT;ATT=u;try{return _m.apply(this,arguments)}finally{ATT=p}}}
  {const _h=hurt;hurt=function(e,cas){let k=1;
    if(e&&!e.dead){if(wet(e.x,e.y))k*=1.3;else if(inMarsh(e.x,e.y))k*=1.15;
      if(ATT&&ATT.side!==e.side){const dh=hAt(ATT.x,ATT.y)-hAt(e.x,e.y);k*=1+Math.max(-.12,Math.min(.18,dh/180))}}
    return _h.call(this,e,cas*k)}}
  /* --- après chaque pas : l'eau arrête (sauf déroute : on s'y noie), le marais casse la charge --- */
  let fixed=false;
  // déploiement : chaque armée se range sur une seule rive, celle de son centre ; les régiments posés dans l'eau ou de l'autre côté reviennent vers le centre
  function fixDeploy(){if(!units||!units.length)return;fixed=true;
    for(const s of [0,1]){const L=units.filter(u=>u.side===s&&!u.dead&&!u.pend);if(!L.length)continue;
      let cx=L.reduce((a,u)=>a+u.x,0)/L.length,cy=L.reduce((a,u)=>a+u.y,0)/L.length;const dir=s===0?1:-1;
      for(let k=0;k<300&&wet(cx,cy);k++)cy+=dir*10*K;
      for(const u of L){if(crossAt(u.x,u.y))continue;if(!wet(u.x,u.y)&&!segHit(u.x,u.y,cx,cy))continue;
        const dx=cx-u.x,dy=cy-u.y,l=Math.hypot(dx,dy)||1;let x=u.x,y=u.y;
        for(let t=0;t<l;t+=15*K){x=u.x+dx/l*t;y=u.y+dy/l*t;if(!wet(x,y)&&!segHit(x,y,cx,cy))break}
        const m=(u.dd||20)*.6+(Math.random()*30)*K;u.x=x+dx/l*m;u.y=y+dy/l*m;u.order=null}}}
  {const _st=step;step=function(dt){
    if(!fixed)fixDeploy();
    const L=units.filter(u=>!u.dead&&!u.pend);for(const u of L){u._px=u.x;u._py=u.y}
    const r=_st.apply(this,arguments);
    for(const u of L){if(u.dead)continue;
      if(inMarsh(u.x,u.y))u.chargeT=0;
      const w=wet(u.x,u.y);if(!w||crossAt(u.x,u.y))continue;
      if(u.routing){u.x=u._px+(u.x-u._px)*.4;u.y=u._py+(u.y-u._py)*.4;hurt(u,u.T.men*.012*dt/effK(u));continue}
      if(!wet(u._px,u._py)||crossAt(u._px,u._py)){u.x=u._px;u.y=u._py;u.v=0}
      else{const o=w.hw+4*K,s=w.side;u.x=w.px+w.nx*s*o;u.y=w.py+w.ny*s*o}}
    return r}}
  /* --- dessin : relief, marais, fleuves, gués, ponts --- */
  /* --- SOL NET (v2, 11 nov.) : le sol n'est plus l'image de la campagne agrandie. Il est redessiné à l'échelle des régiments,
     en tuiles nettes à tous les zooms : parcelles de 40 à 130 m avec sillons, haies et murets, arbres un par un, chemins, fermes, cailloux.
     Les bois, champs, routes et fermes viennent toujours de l'endroit de la campagne (CT) ; seule leur finesse change.
     Tout est en mètres du champ (avant ×G). Les cartes de villes (bloc VILLES) gardent leur propre sol. --- */
  const NET=!window.__villes&&!!document.createElement('canvas').getContext;
  const SOL=(()=>{
    if(!NET)return null;
    const hs=(a,b)=>hash(a|0,b|0),SEEDX=Math.round((CT.f?CT.f.cx:0)*7)%9973,SEEDY=Math.round((CT.f?CT.f.cy:0)*7)%9973;
    const hx=(a,b,k)=>hs(a*3+SEEDX+k*101,b*3+SEEDY-k*57);
    const mix=(a,b,t)=>[a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t],rgb=c=>`rgb(${c[0]|0},${c[1]|0},${c[2]|0})`;
    const MX0=GX0,MY0=GY0,MX1=GX0+(GNX-1)*GS,MY1=GY0+(GNY-1)*GS,DRY=CT.dry||0;
    // bois : seaux de 300 m
    const FB=new Map(),fk=(i,j)=>i*4099+j;
    for(const f of FORESTS)for(let i=Math.floor((f.x-f.r)/300);i<=Math.floor((f.x+f.r)/300);i++)for(let j=Math.floor((f.y-f.r)/300);j<=Math.floor((f.y+f.r)/300);j++){const k=fk(i,j);let L=FB.get(k);if(!L)FB.set(k,L=[]);L.push(f)}
    function inFo(x,y){const L=FB.get(fk(Math.floor(x/300),Math.floor(y/300)));if(!L)return 0;let b=0;for(const f of L){const d=Math.hypot(x-f.x,y-f.y);if(d<f.r)b=Math.max(b,1-d/f.r)}return b}
    const rivD=(x,y)=>{const w=water(x*K,y*K);return w?(w.d-w.hw)/K:1e9}; // distance à la berge (m), négative dans l'eau
    const seaAt=(x,y)=>RIVER0>-1000&&SEA&&x<riverX(y)+30;
    /* couleur de fond : une image douce (8 m par point) : teinte du pays, sécheresse, ombrage du relief, vert près de l'eau */
    let BASE=null;
    function buildBase(){const c=document.createElement('canvas');c.width=GNX;c.height=GNY;const g=c.getContext('2d'),im=g.createImageData(GNX,GNY),d=im.data;
      const A=[118,128,70],B=[158,150,88],DR=[196,172,118],GRN=[96,122,60],MT=[136,126,100],FL=[84,104,58],WET=[92,124,70];
      for(let j=0;j<GNY;j++)for(let i=0;i<GNX;i++){const x=GX0+i*GS,y=GY0+j*GS,n1=fbm(x*.0021+SEEDX,y*.0021),n2=fbm(x*.006+40,y*.006+SEEDY),n3=vnoise(x*.03,y*.03);
        let c=mix(A,B,n1);if(n2>.55)c=mix(c,DR,Math.min(1,(n2-.55)*2.4)*.7);if(n2<.42)c=mix(c,GRN,Math.min(1,(.42-n2)*3)*.75);
        if(DRY)c=mix(c,DR,DRY*.6);const mt=mtn(x,y);if(mt>0)c=mix(c,MT,mt*.55);
        const fo=inFo(x,y);if(fo>0)c=mix(c,FL,Math.min(1,fo*3)*.7);
        const rd=rivD(x,y);if(rd<140)c=mix(c,WET,(1-Math.max(0,rd)/140)*.55);
        const o=j*GNX+i,i0=Math.max(1,Math.min(GNX-2,i)),j0=Math.max(1,Math.min(GNY-2,j)),q=j0*GNX+i0,sx=(HG[q+1]-HG[q-1])/(2*GS),sy=(HG[q+GNX]-HG[q-GNX])/(2*GS);
        let sh=(1+(-sx*.62+sy*.5)*2.2)*(.96+n3*.08);sh=Math.max(.62,Math.min(1.3,sh));
        if(seaAt(x,y)){c=[112,150,160];sh=1}
        d[o*4]=Math.min(255,c[0]*sh);d[o*4+1]=Math.min(255,c[1]*sh);d[o*4+2]=Math.min(255,c[2]*sh);d[o*4+3]=255}
      g.putImageData(im,0,0);BASE=c}
    /* parcelles : les grands champs de la carte découpés en lanières, plus un petit terroir autour de chaque ferme */
    const PAR=[],FARM=[],PB=new Map();
    const CROPS=[[[203,180,100],[188,164,88]],[[190,170,96],[176,156,84]],[[150,160,82],[136,148,72]],[[128,146,70],[116,134,62]],[[150,122,84],[138,110,74]],[[170,150,104],[158,138,94]]];
    function addPar(P,kind,ang,seed){let a=1e9,b=1e9,c=-1e9,d=-1e9,cx=0,cy=0;for(const [x,y] of P){a=Math.min(a,x);b=Math.min(b,y);c=Math.max(c,x);d=Math.max(d,y);cx+=x/P.length;cy+=y/P.length}
      if(VIL&&Math.hypot(VIL.x-cx,VIL.y-cy)<VIL.r+8)return;
      if(cx<MX0||cy<MY0||cx>MX1||cy>MY1||rivD(cx,cy)<12||inMarsh(cx*K,cy*K)||inFo(cx,cy)>.25||mtn(cx,cy)>.5||seaAt(cx,cy))return;
      for(const [x,y] of P)if(rivD(x,y)<4)return;
      const o={P,kind,ang,seed,b:[a,b,c,d],edge:seed%5};PAR.push(o);
      for(let i=Math.floor(a/256);i<=Math.floor(c/256);i++)for(let j=Math.floor(b/256);j<=Math.floor(d/256);j++){const k=fk(i,j);let L=PB.get(k);if(!L)PB.set(k,L=[]);L.push(o)}}
    function split(x0,y0,x1,y1,T,rot,sd,dep){const w=x1-x0,h=y1-y0,R=k=>hx(sd,dep,k);
      const maxL=70+R(1)*70,maxW=34+R(2)*46;
      if((Math.max(w,h)<=maxL&&Math.min(w,h)<=maxW)||dep>9){
        if(R(3)<.13)return; // friche : rien
        const m=1.2+R(4)*1.6,j=k=>(R(k)-.5)*Math.min(w,h)*.07,P=[[x0+m+j(5),y0+m+j(6)],[x1-m+j(7),y0+m+j(8)],[x1-m+j(9),y1-m+j(10)],[x0+m+j(11),y1-m+j(12)]].map(T);
        const r=R(13),kind=r<.34?0:r<.5?1:r<.66?2:r<.78?3:r<.9?4:r<.95?'vigne':'olive';
        addPar(P,kind,rot+(w>=h?0:Math.PI/2),(sd*31+dep*7+((x0+y0)|0))>>>0);return}
      const t=.36+R(14)*.28;
      if(w/maxL>h/maxW){const xm=x0+w*t;split(x0,y0,xm,y1,T,rot,sd*2+1,dep+1);split(xm,y0,x1,y1,T,rot,sd*2+2,dep+1)}
      else{const ym=y0+h*t;split(x0,y0,x1,ym,T,rot,sd*2+1,dep+1);split(x0,ym,x1,y1,T,rot,sd*2+2,dep+1)}}
    function buildParcels(){buildVillage();
      FIELDS.forEach((f,i)=>{const c=Math.cos(f.a),s=Math.sin(f.a),T=([x,y])=>[f.x+x*c-y*s,f.y+x*s+y*c];split(-f.w/2,-f.h/2,f.w/2,f.h/2,T,f.a,1000+i*97,0)});
      (CT.houses||[]).forEach((h,i)=>{const a=hx(i,7,1)*6.283,c=Math.cos(a),s=Math.sin(a),x=h[0],y=h[1];
        if(x<MX0+60||y<MY0+60||x>MX1-60||y>MY1-60||rivD(x,y)<30||inMarsh(x*K,y*K)||seaAt(x,y))return;
        if(FARM.some(q=>Math.hypot(q.x-x,q.y-y)<70))return;
        FARM.push({x,y,a,i});const T=([u,v])=>[x+u*c-v*s,y+u*s+v*c],w=150+hx(i,7,2)*130,hh=110+hx(i,7,3)*110;
        split(-w/2,26,w/2,26+hh,T,a,5000+i*53,0);if(hx(i,7,4)<.7)split(-w/2,-26-hh*.7,w/2,-26,T,a,7000+i*53,0)})}
    // village voisin (quand la ville n'a pas sa carte du bloc VILLES) : rues de terre, maisons le long, terroir autour
    let VIL=null;
    function buildVillage(){const t=CT.town;if(!t||t.x<MX0+150||t.y<MY0+150||t.x>MX1-150||t.y>MY1-150)return;
      let hc=0;const sz=t.size||0,n=12+sz*16,R=k=>hx(71,k,9),a0=R(1)*3.14,H=[],LN=[],Rv=55+sz*38;
      const ns=2+Math.min(2,sz);for(let k=0;k<ns;k++){const a=a0+k*(3.14/ns)+(R(10+k)-.5)*.5,L=Rv*(.8+R(20+k)*.5),bend=(R(30+k)-.5)*.5,P=[];
        for(let q=-1;q<=1.001;q+=.25){const d=q*L,aa=a+bend*q;P.push([t.x+Math.cos(aa)*d,t.y+Math.sin(aa)*d])}LN.push(P);
        for(let q=1;q<P.length;q++){const [ax,ay]=P[q-1],[bx,by]=P[q],an=Math.atan2(by-ay,bx-ax),l=Math.hypot(bx-ax,by-ay);
          for(let u=4;u<l-3;u+=11+R(H.length+40)*6)for(const sd of [-1,1]){hc++;if(H.length>=n*1.6||R(hc+90)<.22)continue;const w=7+R(H.length+140)*5,h=5+R(H.length+190)*3,off=4.2+h/2+R(H.length+240)*2.5,
