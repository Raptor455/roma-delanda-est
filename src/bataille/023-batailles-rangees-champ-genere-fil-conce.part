        if(S>=.5)for(const o of parsIn(x0-6,y0-6,x1+6,y1+6)){if(o.kind!=='olive')continue;const ca=Math.cos(o.ang),sa=Math.sin(o.ang),cx=(o.b[0]+o.b[2])/2,cy=(o.b[1]+o.b[3])/2,R=Math.hypot(o.b[2]-o.b[0],o.b[3]-o.b[1])/2;
