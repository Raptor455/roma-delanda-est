        const ri=ROADS.indexOf(P),kd=CT.roads[ri]?CT.roads[ri].k:'route',w=kd==='via'?6.5:kd==='route'?5:kd==='piste'?3.6:2.8;
        g.beginPath();g.moveTo(P[0][0],P[0][1]);for(let k=1;k<P.length-1;k++){const mx=(P[k][0]+P[k+1][0])/2,my=(P[k][1]+P[k+1][1])/2;g.quadraticCurveTo(P[k][0],P[k][1],mx,my)}g.lineTo(P[P.length-1][0],P[P.length-1][1]);
        g.strokeStyle='rgba(84,64,36,.75)';g.lineWidth=Math.max(w+1.4,2/S);g.stroke();g.strokeStyle=kd==='via'?'#cfc4a8':'#c6b086';g.lineWidth=Math.max(w,1.2/S);g.stroke();
        if(S>=1){if(kd==='via'){g.strokeStyle='rgba(110,100,80,.55)';g.lineWidth=.3;g.setLineDash([1.6,.5]);g.stroke();g.setLineDash([])}else{g.strokeStyle='rgba(120,96,60,.4)';g.lineWidth=.5;g.setLineDash([3,5]);g.lineDashOffset=1;g.stroke();g.setLineDash([])}}}
      // fermes : cour, bâtiments, meules
