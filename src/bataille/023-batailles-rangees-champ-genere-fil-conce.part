      // touffes d'herbe, broussailles et cailloux (tirés de l'endroit)
      if(S>=1){const cs=12;for(let i=Math.floor(x0/cs)-1;i<=Math.floor(x1/cs)+1;i++)for(let j=Math.floor(y0/cs)-1;j<=Math.floor(y1/cs)+1;j++){const h=hx(i,j,21);if(h>.62)continue;
          const x=(i+hx(i,j,22))*cs,y=(j+hx(i,j,23))*cs;if(x<MX0||y<MY0||x>MX1||y>MY1||rivD(x,y)<1||seaAt(x,y))continue;const mt=mtn(x,y),p=inPar(x,y);if(p&&p.kind!==undefined)continue;
          if(h<.08+mt*.3+DRY*.1){const r=.5+hx(i,j,24)*1.1;g.fillStyle='rgba(60,50,34,.35)';g.beginPath();g.ellipse(x+.3,y+.4,r*1.2,r*.9,h*40,0,6.283);g.fill();g.fillStyle=h<.04?'#b3aa94':'#9f957c';g.beginPath();g.ellipse(x,y,r*1.15,r*.8,h*40,0,6.283);g.fill()}
          else if(h<.3){const r=1+hx(i,j,25)*1.4;g.fillStyle='rgba(30,40,16,.25)';g.beginPath();g.arc(x+.4,y+.5,r,0,6.283);g.fill();g.fillStyle=h<.2?'#5f7a3a':'#788a48';g.beginPath();g.arc(x,y,r,0,6.283);g.fill();g.beginPath();g.arc(x+r*.8,y+r*.3,r*.7,0,6.283);g.fill()}
          else{g.strokeStyle=h<.46?'rgba(70,92,40,.55)':'rgba(190,178,110,.5)';g.lineWidth=.22;g.beginPath();for(let k=0;k<4;k++){const ux=x+(hx(i,j,30+k)-.5)*5,uy=y+(hx(i,j,40+k)-.5)*5;g.moveTo(ux-.5,uy);g.lineTo(ux-.2,uy-1.1);g.moveTo(ux+.1,uy);g.lineTo(ux+.2,uy-1.3);g.moveTo(ux+.6,uy);g.lineTo(ux+.9,uy-1)}g.stroke()}}}
