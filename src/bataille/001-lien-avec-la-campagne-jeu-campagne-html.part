/* ===== Lien avec la campagne (jeu/campagne.html) : armées reçues dans l'adresse #c=…, résultat renvoyé par #r=… ===== */
const CAMP_URL=/bataille\.html$/i.test(location.pathname)?'./':'campagne.html';
let CAMP=null;
try{if(location.hash.startsWith('#c=')){CAMP=JSON.parse(decodeURIComponent(location.hash.slice(3)));if(!CAMP||!CAMP.b||!CAMP.st)CAMP=null}}catch(e){CAMP=null}
/*PAL*/const PALS={car:{flag:'#5d3592',blk:'#6b3f9f',str:'#e3c46c',stk:'#26133b',foot:0x7a4ab6,mini:'#9b63e0',plume:0xe8e0cc,css:'#7d4fb8',lt:'#cbb1ee',pl:'violets',n:'Carthage',adj:'violet',emb:'tanit'},
  rom:{flag:'#a8332b',blk:'#ab342b',str:'#efdcaa',stk:'#3c0e0a',foot:0xc0392b,mini:'#e04a3c',plume:0x231612,css:'#bf3b31',lt:'#f1a097',pl:'rouges',n:'Rome',adj:'rouge',emb:'spqr'},
  mac:{flag:'#8a5e14',blk:'#a87a22',str:'#f0dca0',stk:'#3a2808',foot:0xc8962e,mini:'#e0b040',plume:0xe8e0cc,css:'#c8962e',lt:'#f0d080',pl:'dorés',n:'Macédoine',adj:'or',emb:'sun'},
  syr:{flag:'#2f5a8a',blk:'#35659a',str:'#e8dcb0',stk:'#0e2238',foot:0x3f7ac0,mini:'#5a9ae0',plume:0xe8e0cc,css:'#3f7ac0',lt:'#a8c8f0',pl:'bleus',n:'Syracuse',adj:'bleu',emb:'sun'},num:{flag:'#8a5a28',blk:'#9a6a32',str:'#f0e0b8',stk:'#2e1d0c',foot:0xb07a3a,mini:'#d89a50',plume:0xe8e0cc,css:'#b07a3a',lt:'#ecc890',pl:'ocre',n:'Numidie',adj:'ocre',emb:'sun'},mae:{flag:'#5a5a5a',blk:'#6a6a6a',str:'#e0d8c8',stk:'#1a1a1a',foot:0x7a7a72,mini:'#a0a098',plume:0xe8e0cc,css:'#7a7a72',lt:'#d0d0c8',pl:'gris',n:'Masaesyles',adj:'gris',emb:'sun'},ins:{flag:'#22685c',blk:'#2a7a6c',str:'#e8dcb0',stk:'#0c2420',foot:0x2f8a7a,mini:'#4ac0aa',plume:0xe8e0cc,css:'#2f8a7a',lt:'#a8e0d4',pl:'turquoise',n:'Gaulois cisalpins',adj:'turquoise',emb:'sun'},per:{flag:'#343e86',blk:'#3c4896',str:'#e8dcb0',stk:'#10142e',foot:0x4a56a8,mini:'#6a7ae0',plume:0xe8e0cc,css:'#4a56a8',lt:'#b0b8f0',pl:'indigo',n:'Pergame',adj:'indigo',emb:'sun'},mas:{flag:'#24508a',blk:'#2c5d9e',str:'#f2ecdc',stk:'#0c1c34',foot:0x2c5d9e,mini:'#5a8ee0',plume:0xf2ecdc,css:'#2c5d9e',lt:'#b8d0f0',pl:'bleu et blanc',n:'Massalia',adj:'bleu',emb:'sun'},ath:{flag:'#4f6b3a',blk:'#5a7a42',str:'#e8dcb0',stk:'#1e2a14',foot:0x6f9a4a,mini:'#8cc060',plume:0xe8e0cc,css:'#6f9a4a',lt:'#c8e0a8',pl:'verts',n:'Athènes',adj:'vert',emb:'sun'}};
const PK=(CAMP&&CAMP.b&&Array.isArray(CAMP.b.pk))?CAMP.b.pk:['car','rom'],PAL=PK.map((k,i)=>PALS[k]||palX(CAMP&&CAMP.b&&CAMP.b.pkx&&CAMP.b.pkx[i])||PALS[i?'rom':'car']);/*PALX*/
function palX(o){if(!o||!Array.isArray(o.c))return null;const [r,g,b]=o.c,h=v=>v.toString(16).padStart(2,'0'),hx=(f,a)=>'#'+[r,g,b].map(v=>h(Math.max(0,Math.min(255,Math.round(a?v+(255-v)*f:v*f))))).join(''),num=f=>parseInt(hx(f).slice(1),16);
  const mx=Math.max(r,g,b),mn=Math.min(r,g,b);let adj='gris';if(mx-mn>30){const H=(mx===r?((g-b)/(mx-mn)+6)%6:mx===g?(b-r)/(mx-mn)+2:(r-g)/(mx-mn)+4)*60;adj=H<20||H>=330?'rouge':H<45?(mx<150?'brun':'orange'):H<70?'jaune':H<160?'vert':H<200?'turquoise':H<255?'bleu':H<290?'violet':'pourpre'}
  return {flag:hx(.75),blk:hx(.85),str:'#e8dcb0',stk:hx(.3),foot:num(1),mini:hx(.35,1),plume:0xe8e0cc,css:hx(1),lt:hx(.6,1),pl:adj,n:o.n||'Ennemi',adj,emb:'sun'}}
try{document.documentElement.style.setProperty('--punic',PAL[0].css);document.documentElement.style.setProperty('--roma',PAL[1].css);
  if(PK[0]!=='car'||PK[1]!=='rom'){const st=document.createElement('style');st.textContent=`.cp{color:${PAL[0].lt}!important}.cr{color:${PAL[1].lt}!important}.ui-uc svg{color:${PAL[0].lt}!important}`;document.head.appendChild(st);const sb=document.querySelector('#selBody p');if(sb)sb.textContent='Aucune unité. Cliquez sur un de vos régiments '+PAL[0].pl+'.'}}catch(e){}
if(CAMP){
  const card=document.querySelector('#start .card'),ps=card.querySelectorAll('p');
  card.querySelector('h2').textContent=CAMP.b.title;
  {const br=document.querySelector('.brand');if(br){br.querySelector('h1').textContent=CAMP.b.title.split(',')[0];br.querySelector('span').textContent='Campagne · '+CAMP.b.title.split(',').slice(1).join(',').trim()}document.title=CAMP.b.title}
  ps[0].textContent=CAMP.b.desc+" Vous commandez "+PAL[0].n+" ("+PAL[0].adj+"), l'adversaire ("+PAL[1].n+") est en "+PAL[1].adj+".";{const a=$('fP'),b=$('fR');if(a)a.textContent=PAL[0].n;if(b)b.textContent=PAL[1].n}
  ps[1].textContent="Placez vos troupes pendant que le temps est arrêté, puis lancez la bataille. Quand une armée est en déroute, le résultat et les pertes repartent dans la campagne.";
  $('bCamp').hidden=true;$('bAgain').textContent='Retour à la campagne';
}else $('bCamp').onclick=()=>{location.href=CAMP_URL};
$('bPeuples').onclick=()=>{const u=new URL(location.href);u.searchParams.set('revue','peuples');location.href=u.href};
$('bRevue').onclick=()=>{const u=new URL(location.href);u.searchParams.set('revue','1');location.href=u.href};
if(REVUE_P){const h=document.querySelector('#start h2');if(h)h.textContent='Revue des peuples';const ps=document.querySelectorAll('#start .card > p');if(ps[0])ps[0].textContent='Quatre armées à venir, une ligne chacune, de l\'arrière vers l\'avant : Rome (hastats, princes, triaires, vélites, alliés, cavaleries), la Macédoine (phalange, hypaspistes, peltastes, Crétois, Compagnons, Thessaliens), Sparte (Spartiates, périèques, Skirites, hilotes, cavalerie) et Athènes (hoplites, thuréophores, archers scythes, peltastes, cavaliers). Carthage leur fait face.';if(ps[1])ps[1].remove()}
else if(REVUE){const h=document.querySelector('#start h2');if(h)h.textContent='Revue des troupes';const ps=document.querySelectorAll('#start .card > p');if(ps[0])ps[0].textContent='Carthage aligne ses sept unités classiques, puis dix-sept unités d\'atelier qui montrent chaque casque, cimier, armure, bouclier, arme et arme de jet. Rome attend en face. Approchez la caméra pour voir les figurines, puis lancez la bataille si vous voulez les voir se battre.';if(ps[1])ps[1].remove()}

