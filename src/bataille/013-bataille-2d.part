    const pickFor=(u,R,freeOnly)=>{let b=null,bs=1e9;for(const e of foes){const d=Math.hypot(e.x-u.x,e.y-u.y);if(d>R)continue;const l=load.get(e)||0;if(freeOnly&&l>0)continue;const sc=d+38*l;if(sc<bs){bs=sc;b=e}}return b};
