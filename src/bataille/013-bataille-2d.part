  function formBox(){let box=document.getElementById('formBtns');if(box)return box;const sel=document.getElementById('sel');if(!sel)return null;
    box=document.createElement('div');box.id='formBtns';
    box.innerHTML='<div class="fl">Formation</div><div class="fg">'+FORMS.map(f=>`<button type="button" data-f="${f[0]}" title="${f[2]}">${formIcon(f[0])}<span>${f[1]}</span></button>`).join('')+'</div>'+'<div class="fh fa" style="color:#e8c77e"></div><div class="fh">Clic : régiment entier · Alt+clic : un seul carré</div>';
    box.addEventListener('click',e=>{const b=e.target.closest('button[data-f]');if(b)applyForm(b.dataset.f)});
    const btns=sel.querySelector('.btns');if(btns)btns.after(box);else sel.appendChild(box);
    const st=document.createElement('style');st.textContent=`#formBtns{display:none;flex-direction:column;gap:4px;margin-top:2px}#formBtns.on{display:flex}
#formBtns .fh{font-size:11px;color:var(--muted,#b9a98a);opacity:.85;margin-top:1px}
#formBtns button.act{background:#d6b878;color:#1c140c;border-color:#f0dca8}
#formBtns .fa:empty{display:none}
#formBtns .fl{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted,#b9a98a)}
#formBtns .fg{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
#formBtns button{display:flex;align-items:center;gap:4px;padding:3px 5px;font-size:12px;line-height:1.1;min-width:0;white-space:nowrap}
#formBtns button svg{flex:none}#formBtns button span{overflow:hidden;text-overflow:ellipsis}
