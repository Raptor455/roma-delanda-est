  function depBar(){let b=document.getElementById('depBar');if(b)return b;b=document.createElement('div');b.id='depBar';b.className='hud';
    b.innerHTML=`<div><b>Déploiement</b> · placez vos régiments dans la zone claire : clic droit pour les poser, glissez-les à la souris, ou tracez une ligne au clic droit. Le temps est arrêté.</div><button type="button" class="go" id="bDepGo">Au combat !</button>`;
    (document.getElementById('app')||document.body).appendChild(b);b.querySelector('#bDepGo').onclick=()=>{endDep();begin()};
    for(const k of ['pointerdown','wheel'])b.addEventListener(k,e=>e.stopPropagation());
    const st=document.createElement('style');st.textContent=`#depBar{position:absolute;left:50%;transform:translateX(-50%);top:84px;z-index:7;display:flex;gap:14px;align-items:center;max-width:min(760px,calc(100% - 32px));
  padding:9px 12px 9px 16px;background:rgba(28,20,12,.94);border:1px solid rgba(214,184,120,.55);border-radius:6px;color:#efe3c6;font:13px/1.4 Georgia,serif;box-shadow:0 6px 22px rgba(0,0,0,.45)}
#depBar b{color:#e8c77e;font-weight:normal;letter-spacing:.06em;text-transform:uppercase;font-size:12px}#depBar button{flex:none;white-space:nowrap}
@media (max-width:760px){#depBar{top:auto;bottom:12px;flex-direction:column;align-items:stretch}}`;document.head.appendChild(st);return b}
  function startDep(){if(started||!ISCAMP())return;DZ=zoneOf();DEP=true;paused=true;$('start').hidden=true;depBar().hidden=false;updatePauseBtn();renderSel()}
  function endDep(){DEP=false;GRAB=null;const b=document.getElementById('depBar');if(b)b.hidden=true}
  // la zone de départ, sous les régiments
  function drawZone(){if(!DEP||!DZ)return;const {n,mid,gap,back}=DZ,t={x:-n.y,y:n.x},L=(W+H)*2,P=PAL[0];
    const pt=(d,s)=>scr(mid.x+n.x*d+t.x*s,mid.y+n.y*d+t.y*s),m=[scr(BX0()-20,BY0()-20),scr(BX1()+20,BY0()-20),scr(BX1()+20,BY1()+20),scr(BX0()-20,BY1()+20)];
    g2.save();g2.beginPath();m.forEach((p,i)=>i?g2.lineTo(p[0],p[1]):g2.moveTo(p[0],p[1]));g2.closePath();g2.clip();
    const a=pt(gap,-L),b=pt(gap,L),c=pt(back,L),d=pt(back,-L);
