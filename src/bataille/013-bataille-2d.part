    for(const sg of [-1,1])for(let de=-d/2+26;de<d/2-KBK+6;de+=17)for(const o of [15,34])tents.push({la:sg*(w/2-o),de:de+(o>20?8:0),a:sg>0?0:Math.PI});
    for(let la=-w/2+16;la<=w/2-16;la+=17)for(const o of [16,36,58]){if(Math.abs(la)<34&&o>30)continue;if(Math.abs(la)>w/2-70&&o<50)continue;if(Math.abs(la)<KST/2+2)continue;tents.push({la,de:d/2-o,a:Math.PI/2})}
    for(const sg of [-1,1]){for(let i=0;i<9;i++)sup.push({la:sg*(w/2-22-(i%3)*11),de:d/2-16-Math.floor(i/3)*11,k:i%4});sup.push({la:sg*(w/2-62),de:d/2-22,k:9})}
    fires.push({la:0,de:d/2-78},{la:-w/4,de:d/2-76},{la:w/4,de:d/2-76},{la:-(w/2-48),de:-d/2+20},{la:w/2-48,de:-d/2+20});
    for(let i=0;i<46;i++){const a=tents[Math.floor(r()*tents.length)],b=r()<.3?fires[Math.floor(r()*fires.length)]:tents[Math.floor(r()*tents.length)];men.push({a:{la:a.la+(r()-.5)*8,de:a.de+7},b:{la:b.la+(r()-.5)*14,de:b.de+(r()-.5)*14},T:7+r()*12,ph:r()*20,sit:r()<.2})}
    return {side,c,n,t,w,d,cols,rows,sp,slot,L,F,st:KST,gw:KGW,gate:L(0,-d/2),out:L(0,-d/2-34),q:[],N,tents,fires,sup,men,loot:0,looted:false,seed:r()*100}}
  function campFill(k){const P=units.filter(u=>u.side===k.side&&!u.dead&&!u.pend),m=new Map();for(const u of P){const id=rkey(u);if(!m.has(id))m.set(id,[]);m.get(id).push(u)}
    // les régiments qui vont le plus loin sortent les premiers : on les range près de la porte
    const far=g=>{const q=cen(g);return Math.hypot(q.x-k.gate.x,q.y-k.gate.y)},regs=[...m.values()].sort((a,b)=>far(b)-far(a));let i=0;k.q=[];
    for(const g of regs){for(const u of g){u._plan={x:u.x,y:u.y,a:u.ang};const s=k.slot(i++);u.x=s.x;u.y=s.y;u._kl=s.la;u._kd=s.de;u.ang=Math.atan2(-k.n.y,-k.n.x);u._sq=null;u._lx=null;u.dirty=true;u.order=null;u.preview=null;u.v=0;u._wait=true;u._ex=null;u._forming=false;u._pendO=null;k.q.push(u)}}
    k.filled=true;k.N=i;k.fl=[];
