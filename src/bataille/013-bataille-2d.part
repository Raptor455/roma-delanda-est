  // ordre de chute des cases : les rangs de derrière d'abord, le premier rang tient jusqu'au bout
  function fallOrder(u){if(u._ord&&u._ord.length===gridOf(u).N)return u._ord;const {C,R}=gridOf(u),Rn=srand(u.id*17+3),o=[];
    for(let r=R-1;r>=0;r--){const row=[];for(let c=0;c<C;c++)row.push(r*C+c);row.sort(()=>Rn()-.5);o.push(...row)}return u._ord=o}
  function drawUnit(u){
    const [px,py]=scr(u.x,u.y);if(px<-160||py<-160||px>SW+160||py>SH+160){u._sq=null;return}
    updSquares(u);
    const {C,R,N}=gridOf(u),k=u.T.kind,P=PAL[u.side],E=PAL[1-u.side],sel=selected.has(u),hov=u===hover,fr=frac(u),CR=cracksOf(u),ord=fallOrder(u);
    const z=Math.max(5,u.w/C*s2*.92)*(k==='skirm'&&N>1?.78:1);
    // cases encore debout ; celle qui va tomber porte les fissures les plus profondes
    const nA=Math.max(0,Math.ceil(fr*N-1e-6)),local=1-(fr*N-(nA-1)),gen=(1-fr)*.5;
    const gone=new Set(ord.slice(0,N-nA)),next=ord[N-nA];
