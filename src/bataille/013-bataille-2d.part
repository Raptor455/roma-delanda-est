  function depTick(){if(!DEP)return;if(started){endDep();return}let any=false;
    const L=[];for(const u of units){if(u.side!==0||u.dead||u.pend||!u.order)continue;const o=u.order;
      if(o.type==='move'){L.push([u,o.x,o.y,o.face]);any=true}else{u.order=null;u.preview=null}}
