/* ================= BATAILLE 2D ================= */
// Vue de carte façon atlas : sol peint (image de la campagne quand elle est envoyée), régiments en carrés symboliques
// (X infanterie, diagonale cavalerie, trois ronds tirailleurs), étendards des généraux. La simulation ne change pas :
// seules la caméra, le rendu et la conversion écran ↔ terrain sont remplacés.
const V3D=false; /* la vue 3D est retirée (12 nov.) : les batailles sont en 2D */
if(!V3D){
  const cv2=document.createElement('canvas');cv2.id='map2d';cv2.style.cssText='position:absolute;inset:0;width:100%;height:100%;pointer-events:none;display:block';
  host.appendChild(cv2);const g2=cv2.getContext('2d');
  renderer.domElement.style.display='none';
  {const st=document.createElement('style');st.textContent='#fps{display:none}';document.head.appendChild(st)}
  const TAN=Math.tan(21*Math.PI/180);
  let SW=1,SH=1,DPR=1,s2=1,M=[1,0,0,1,0,0];
  // repère écran : haut de l'écran = direction (-sin yaw, -cos yaw) du terrain, comme la caméra 3D vue d'en haut
  function view(){
    SW=host.clientWidth||innerWidth;SH=host.clientHeight||innerHeight;DPR=Math.min(2,devicePixelRatio||1);
    if(cv2.width!==Math.round(SW*DPR)||cv2.height!==Math.round(SH*DPR)){cv2.width=Math.round(SW*DPR);cv2.height=Math.round(SH*DPR)}
    s2=SH/(2*cam.dist*TAN);
    const cy=Math.cos(cam.yaw),sy=Math.sin(cam.yaw),Rx=cy,Ry=-sy,Fx=-sy,Fy=-cy;
    const a=s2*Rx,b=-s2*Fx,c=s2*Ry,d=-s2*Fy;
    M=[a,b,c,d,SW/2-(a*cam.tx+c*cam.ty),SH/2-(b*cam.tx+d*cam.ty)];
  }
  const scr=(x,y)=>[M[0]*x+M[2]*y+M[4],M[1]*x+M[3]*y+M[5]];
  function unscr(px,py){const det=M[0]*M[3]-M[1]*M[2],X=px-M[4],Y=py-M[5];return {x:(M[3]*X-M[2]*Y)/det,y:(-M[1]*X+M[0]*Y)/det}}
  // conversions utilisées par la sélection, les ordres, la minicarte et les étiquettes
  /* champ étendu (campagne, hors assaut et pvp) : on joue sur tout le terrain dessiné, plus seulement sur le rectangle de la minicarte */
  const EXT=()=>!!(CAMP&&CAMP.b)&&!CAMP.pvp&&!(window.__villes&&window.__villes.MODE==='assaut');
  const BX0=()=>EXT()?(RIVER0>0?RIVER+20:-1100):RIVER+20,BX1=()=>EXT()?4300:W-20,BY0=()=>EXT()?-1100:20,BY1=()=>EXT()?3100:H-20;
  const CLX=x=>Math.max(BX0(),Math.min(BX1(),x)),CLY=y=>Math.max(BY0(),Math.min(BY1(),y));
  clampMap=function(u){u.x=Math.max(BX0()-20+u.w/3,Math.min(BX1(),u.x));if(!u.routing)u.y=CLY(u.y)};
  updateCamera=function(){
    cam.tx=Math.max(BX0()-320,Math.min(BX1()+520,cam.tx));cam.ty=Math.max(BY0()-520,Math.min(BY1()+520,cam.ty));
    cam.dist=Math.max(60,Math.min(3800*G,cam.dist));strat=1;view();
  };
  groundAtNdc=function(nx,ny){return unscr((nx+1)/2*SW,(1-ny)/2*SH)};
  groundAt=function(cx,cy){const r=host.getBoundingClientRect();return unscr(cx-r.left,cy-r.top)};
  toScreen=function(sx,sy,off){const [x,y]=scr(sx,sy);return {x,y:y-(off?Math.min(26,off*s2*.6+8):0),ok:true}};
  panScreen=function(dx,dy){const p=unscr(SW/2-dx,SH/2-dy);cam.tx=p.x;cam.ty=p.y};
  resize=function(){view()};

  /* -- sol : image de la carte de campagne si elle arrive, sinon terrain peint d'après le relief -- */
  let GBG=null,GBOX=null;
  const PAPER=(()=>{const c=document.createElement('canvas');c.width=c.height=128;const g=c.getContext('2d');
    g.strokeStyle='rgba(40,30,15,.07)';g.lineWidth=1;for(let i=-128;i<256;i+=4){g.beginPath();g.moveTo(i,0);g.lineTo(i+128,128);g.stroke()}
    const im=g.getImageData(0,0,128,128);for(let i=0;i<im.data.length;i+=4){const n=(Math.random()-.5)*26;im.data[i]+=n;im.data[i+1]+=n;im.data[i+2]+=n;im.data[i+3]=Math.max(im.data[i+3],Math.random()*18)}
    g.putImageData(im,0,0);return c})();
  function buildGround(){
    const X0=-1200,Y0=-1200,X1=W0+1200,Y1=H0+1200,K=5,nx=Math.round((X1-X0)/K),ny=Math.round((Y1-Y0)/K);
    const c=document.createElement('canvas');c.width=nx;c.height=ny;const g=c.getContext('2d'),img=g.createImageData(nx,ny),col=new THREE.Color();
    for(let j=0;j<ny;j++)for(let i=0;i<nx;i++){
      const sx=X0+i*K,sy=Y0+j*K,h=heightM(sx,sy);
      const hx=(heightM(sx+8,sy)-heightM(sx-8,sy))/16,hz=(heightM(sx,sy+8)-heightM(sx,sy-8))/16,nyv=1/Math.hypot(hx,hz,1);
      terrainColor(sx,sy,h,nyv,col);
      if(sx<riverX(sy)+30&&RIVER0>-1000)col.setHex(0x4f7c86);
      const sh=1+(-hx*.6+hz*.5)*1.2,o=(j*nx+i)*4;
      img.data[o]=Math.min(255,col.r*255*sh);img.data[o+1]=Math.min(255,col.g*255*sh);img.data[o+2]=Math.min(255,col.b*255*sh);img.data[o+3]=255;
    }
    g.putImageData(img,0,0);
    // forêts en bouquets d'arbres, comme sur une carte d'état-major
    let seed=7;const rnd=()=>(seed=(seed*16807)%2147483647)/2147483647;
    for(const f of FORESTSg){const fx=f.x/G,fy=f.y/G,r=f.r/G,n=Math.min(900,Math.round(r*r/90));
      for(let i=0;i<n;i++){const a=rnd()*6.283,d=Math.sqrt(rnd())*r,x=(fx+Math.cos(a)*d-X0)/K,y=(fy+Math.sin(a)*d-Y0)/K,rr=(2.2+rnd()*2.2)/K*4;
        g.fillStyle='rgba(20,32,14,.35)';g.beginPath();g.arc(x+1,y+1.2,rr,0,6.283);g.fill();
        g.fillStyle=`rgb(${40+rnd()*20|0},${62+rnd()*24|0},${30+rnd()*14|0})`;g.beginPath();g.arc(x,y,rr,0,6.283);g.fill()}}
    GBG=c;GBOX=[X0,Y0,K];
  }
  let GM=null; // repère image de la carte de campagne → terrain
  function groundFromCampaign(){
    if(!GROUND||!CT||!CT.f)return;const f=CT.f,[x0,y0,sz]=GROUND.box,iw=GROUND.img.width,ih=GROUND.img.height;
    // terrain (sx,sy en m, carte d'origine) → image : u=(cx-x0+((sx-1700)ex0+(sy-1000)ey0)/1000)/sz*iw
    const A=f.ex[0]/1000/sz*iw,B=f.ey[0]/1000/sz*iw,C=f.ex[1]/1000/sz*ih,D=f.ey[1]/1000/sz*ih;
    const E=(f.cx-x0-(1700*f.ex[0]+1000*f.ey[0])/1000)/sz*iw,F=(f.cy-y0-(1700*f.ex[1]+1000*f.ey[1])/1000)/sz*ih;
    // inverse (image → terrain), puis ×G pour le monde de jeu
    const det=A*D-B*C;GM=[D/det*G,-C/det*G,-B/det*G,A/det*G,(B*F-D*E)/det*G,(C*E-A*F)/det*G];
  }
  function drawGround(){
    g2.fillStyle='#8a9a5c';g2.fillRect(0,0,SW,SH);
    g2.save();g2.setTransform(M[0]*DPR,M[1]*DPR,M[2]*DPR,M[3]*DPR,M[4]*DPR,M[5]*DPR);
    g2.imageSmoothingEnabled=true;g2.imageSmoothingQuality='high';
    if(GBG){g2.save();g2.translate(GBOX[0]*G,GBOX[1]*G);g2.scale(GBOX[2]*G,GBOX[2]*G);g2.drawImage(GBG,0,0);g2.restore()}
    if(GM){g2.save();g2.transform(GM[0],GM[1],GM[2],GM[3],GM[4],GM[5]);g2.drawImage(GROUND.img,0,0);g2.restore()}
    g2.restore();
    g2.save();g2.scale(DPR,DPR);
    g2.fillStyle=g2.createPattern(PAPER,'repeat');g2.globalAlpha=.9;g2.fillRect(0,0,SW,SH);g2.globalAlpha=1;
    const vg=g2.createRadialGradient(SW/2,SH/2,Math.min(SW,SH)*.35,SW/2,SH/2,Math.max(SW,SH)*.75);vg.addColorStop(0,'rgba(30,22,10,0)');vg.addColorStop(1,'rgba(30,22,10,.35)');
    g2.fillStyle=vg;g2.fillRect(0,0,SW,SH);g2.restore();
  }

  /* -- régiments -- */
  const INK='#1d150c';
  function shade(hex,k){const n=parseInt(hex.slice(1),16),f=v=>Math.max(0,Math.min(255,Math.round(v*k)));return `rgb(${f(n>>16)},${f(n>>8&255)},${f(n&255)})`}
  function unitAngle(u){const fx=Math.cos(u.ang),fy=Math.sin(u.ang);return Math.atan2(M[1]*fx+M[3]*fy,M[0]*fx+M[2]*fy)}
  // ---- régiments : 5 petits carrés qui se fissurent avec les pertes, se brisent un à un ----
  const NSQ=5;
  function srand(seed){let s=(seed*9301+49297)%233280||1;return ()=>(s=(s*16807)%2147483647)/2147483647}
  // fissures de chaque carré (coordonnées du carré unité -0,5..0,5), tirées une fois par régiment
  function cracksOf(u){const N=gridOf(u).N;if(u._cr&&u._cr.length===N)return u._cr;const R=srand(u.id*31+7),C=[];
    for(let k=0;k<N;k++){const L=[];for(let c=0;c<6;c++){const side=Math.floor(R()*4),t=R()-.5,p=[side===0?-.5:side===1?.5:t,side===2?-.5:side===3?.5:t],pts=[p];
        let x=p[0],y=p[1];const tx=(R()-.5)*.5,ty=(R()-.5)*.5;for(let s=1;s<=3;s++){x+=(tx-x)*.45+(R()-.5)*.18;y+=(ty-y)*.45+(R()-.5)*.18;pts.push([x,y])}L.push(pts)}
      const fo=[0,1,2,3].sort(()=>R()-.5),fs=[0,1,2,3].map(()=>.3+R()*.2),fe=[0,1,2,3].map(()=>.35+R()*.5);
      C.push({L,chip:fo[0],fo,fs,fe})}
    return u._cr=C}
  // particules : éclats, poussière de mêlée, impacts de tir
  const FXP=[];let fxT=0;
  function fx(type,x,y,o){if(FXP.length>500)FXP.shift();FXP.push(Object.assign({type,x,y,t:0,life:1,vx:0,vy:0,r:1,rot:0,vr:0},o))}
  function stepFx(dt){for(let i=FXP.length-1;i>=0;i--){const p=FXP[i];p.t+=dt;if(p.t>=p.life){FXP.splice(i,1);continue}p.x+=p.vx*dt;p.y+=p.vy*dt;p.vx*=1-dt*2;p.vy*=1-dt*2;p.rot+=p.vr*dt}}
  function drawFx(under){for(const p of FXP){if((p.type==='dust')!==under)continue;const [sx,sy]=scr(p.x,p.y),k=p.t/p.life;if(sx<-60||sy<-60||sx>SW+60||sy>SH+60)continue;
    if(p.type==='dust'){const r=Math.max(2,(p.r+k*p.r*1.2)*s2);g2.fillStyle=`rgba(${p.c||'120,98,70'},${(1-k)*(p.a||.32)})`;g2.beginPath();g2.arc(sx,sy,r,0,6.283);g2.fill()}
    else if(p.type==='shard'){const z=p.r*(1-k*.4);g2.save();g2.translate(sx,sy);g2.rotate(p.rot);g2.globalAlpha=1-k;g2.fillStyle=p.c;g2.beginPath();g2.moveTo(-z,-z*.6);g2.lineTo(z,-z*.2);g2.lineTo(-z*.2,z);g2.closePath();g2.fill();g2.strokeStyle=INK;g2.lineWidth=1;g2.stroke();g2.restore()}
    else if(p.type==='spark'){g2.strokeStyle=`rgba(255,${210+40*Math.random()|0},150,${1-k})`;g2.lineWidth=1.6;g2.beginPath();const l=4+6*(1-k);g2.moveTo(sx,sy);g2.lineTo(sx+Math.cos(p.rot)*l,sy+Math.sin(p.rot)*l);g2.stroke()}}}
  function symbol(k,x0,y0,z,P){const m=z*.2;g2.lineWidth=Math.max(1.2,z/9);g2.strokeStyle=INK;g2.beginPath();
    if(k==='inf'){g2.moveTo(x0+m,y0+m);g2.lineTo(x0+z-m,y0+z-m);g2.moveTo(x0+z-m,y0+m);g2.lineTo(x0+m,y0+z-m);g2.stroke()}
    else if(k==='cav'||k==='lcav'){g2.moveTo(x0+z,y0);g2.lineTo(x0,y0+z);g2.stroke();if(k==='lcav'){g2.beginPath();g2.arc(x0+z*.7,y0+z*.7,z*.1,0,6.283);g2.fillStyle=INK;g2.fill()}}
    else if(k==='skirm'){g2.fillStyle=INK;for(const [a,b] of [[.32,.36],[.68,.36],[.5,.68]]){g2.beginPath();g2.arc(x0+z*a,y0+z*b,z*.1,0,6.283);g2.fill()}}
    else if(k==='eleph'){g2.moveTo(x0+m,y0+m);g2.lineTo(x0+z-m,y0+z-m);g2.moveTo(x0+z-m,y0+m);g2.lineTo(x0+m,y0+z-m);g2.stroke();g2.beginPath();g2.arc(x0+z/2,y0+z/2,z*.2,0,6.283);g2.fillStyle=P.str;g2.fill();g2.stroke()}}
  function sym2(k,x0,y0,z,col){const m=z*.04;g2.lineWidth=Math.max(.8,z*.06);g2.strokeStyle=col;g2.lineCap='round';g2.beginPath();
    if(k==='inf'||k==='eleph'){g2.moveTo(x0+m,y0+m);g2.lineTo(x0+z-m,y0+z-m);g2.moveTo(x0+z-m,y0+m);g2.lineTo(x0+m,y0+z-m);g2.stroke();
      if(k==='eleph'){g2.beginPath();g2.arc(x0+z/2,y0+z/2,z*.2,0,6.283);g2.stroke()}}
    else if(k==='cav'||k==='lcav'){g2.moveTo(x0+z-m,y0+m);g2.lineTo(x0+m,y0+z-m);g2.stroke();if(k==='lcav'){g2.beginPath();g2.arc(x0+z*.7,y0+z*.7,z*.09,0,6.283);g2.fillStyle=col;g2.fill()}}
    else{g2.fillStyle=col;for(const [a,b] of [[.3,.33],[.7,.33],[.5,.7]]){g2.beginPath();g2.arc(x0+z*a,y0+z*b,z*.11,0,6.283);g2.fill()}}
    g2.lineCap='butt'}
  let SMEAR=[];
  function drawSmears(){for(const [x,y,a,z,r] of SMEAR){const w=z*(.8+.12*Math.sin(rt*7+r*20)),h=z*(.36+.08*Math.sin(rt*5.3+r*13));g2.save();g2.translate(x,y);g2.rotate(a);
      const g=g2.createRadialGradient(0,0,0,0,0,w);g.addColorStop(0,'rgba(156,128,92,.7)');g.addColorStop(.5,'rgba(146,118,84,.36)');g.addColorStop(1,'rgba(140,112,80,0)');
      g2.fillStyle=g;g2.scale(h/w,1);g2.beginPath();g2.arc(0,0,w,0,6.283);g2.fill();
      // quelques traits clairs : le choc soulève la poussière
      g2.restore()}
    SMEAR=[]}
  // ---- armes qui s'affrontent au contact : épées, lances, haches selon l'équipement de chaque régiment ----
  let CLASH=[];
  function weaponOf(u){if(u._wp)return u._wp;let w='epee';try{const g=gearOf(u);w=g.arm==='lance'||g.arm==='sarisse'||g.arm==='xyston'?'lance':g.arm==='hache'?'hache':'epee'}catch(e){}if(u.T.kind==='eleph')w='lance';return u._wp=w}
  function drawWeapon(w,L,P){ // arme couchée le long de +x, poignée à l'origine
    g2.lineCap='round';
    if(w==='lance'){g2.strokeStyle=INK;g2.lineWidth=3.2;g2.beginPath();g2.moveTo(-L*.35,0);g2.lineTo(L*.95,0);g2.stroke();
      g2.strokeStyle='#8a6440';g2.lineWidth=1.8;g2.stroke();
      g2.fillStyle='#d9dde0';g2.strokeStyle=INK;g2.lineWidth=1;g2.beginPath();g2.moveTo(L*1.25,0);g2.lineTo(L*.92,-L*.07);g2.lineTo(L*.92,L*.07);g2.closePath();g2.fill();g2.stroke()}
    else if(w==='hache'){g2.strokeStyle=INK;g2.lineWidth=3;g2.beginPath();g2.moveTo(-L*.1,0);g2.lineTo(L*.85,0);g2.stroke();g2.strokeStyle='#8a6440';g2.lineWidth=1.6;g2.stroke();
      g2.fillStyle='#cfd3d6';g2.strokeStyle=INK;g2.lineWidth=1;g2.beginPath();g2.moveTo(L*.62,0);g2.lineTo(L*.86,-L*.28);g2.quadraticCurveTo(L*.98,-L*.1,L*.92,L*.05);g2.closePath();g2.fill();g2.stroke()}
    else{g2.fillStyle='#e2e6e8';g2.strokeStyle=INK;g2.lineWidth=1.1;g2.beginPath();g2.moveTo(L*.12,-L*.055);g2.lineTo(L*.9,-L*.04);g2.lineTo(L*1.02,0);g2.lineTo(L*.9,L*.04);g2.lineTo(L*.12,L*.055);g2.closePath();g2.fill();g2.stroke();
      g2.strokeStyle='rgba(120,128,134,.9)';g2.lineWidth=.8;g2.beginPath();g2.moveTo(L*.16,0);g2.lineTo(L*.86,0);g2.stroke();
      g2.fillStyle=P.str;g2.strokeStyle=INK;g2.lineWidth=1;g2.fillRect(L*.08,-L*.16,L*.07,L*.32);g2.strokeRect(L*.08,-L*.16,L*.07,L*.32);
      g2.fillStyle='#5a3a22';g2.fillRect(-L*.12,-L*.035,L*.2,L*.07)}
    g2.lineCap='butt'}
  function drawClashes(){
    for(const [u,e] of CLASH){if(u.dead||e.dead)continue;
      const [ax,ay]=scr(u.x,u.y),[bx,by]=scr(e.x,e.y);let dx=bx-ax,dy=by-ay;const dl=Math.hypot(dx,dy)||1;dx/=dl;dy/=dl;
      const L=Math.max(11,Math.min(22,Math.min(u.w,e.w)/(u.reg!=null?1:NSQ)*s2*.9)),n=Math.max(1,Math.min(4,Math.round(Math.min(u.w,e.w)*s2/34))),wa=weaponOf(u),wb=weaponOf(e);
      const [mx,my]=scr((u.x+e.x)/2,(u.y+e.y)/2),span=Math.min(u.w,e.w)*s2*.85;
      for(let i=0;i<n;i++){const h=Math.sin(u.id*12.9+e.id*7.3+i*4.1)*43758.5,hr=h-Math.floor(h),o=(n>1?(i/(n-1)-.5)*span:0)+(hr-.5)*span*.12,dep=(hr-.5)*L*.5,cx=mx-dy*o+dx*dep,cy=my+dx*o+dy*dep;
        // cycle : on arme, on frappe, les fers se croisent, on recule
        const t=rt*(1.3+hr*.9)+hr*9+i*1.7+u.id*.37,f=t-Math.floor(t);
        const st=f<.45?f/.45:f<.6?1-(f-.45)/.15*1.6:Math.min(1,-.6+(f-.6)/.4*1.6);   // 1 = armé, ≈-0.6 = coup porté
        for(const [w,sgn,P] of [[wa,1,PAL[u.side]],[wb,-1,PAL[e.side]]]){
          const base=Math.atan2(dy*sgn,dx*sgn); // vers l'adversaire
          g2.save();
          if(w==='lance'){const th=(1-st)*L*.35;g2.translate(cx-dx*sgn*(L*1.05-th)+(-dy)*sgn*L*.08,cy-dy*sgn*(L*1.05-th)+dx*sgn*L*.08);g2.rotate(base+sgn*.12*st)}
          else{const sw=st*1.05*sgn;g2.translate(cx-dx*sgn*L*.78+(-dy)*sgn*L*.3,cy-dy*sgn*L*.78+dx*sgn*L*.3);g2.rotate(base-sw)}
          drawWeapon(w,L,P);g2.restore()}
        // éclat de métal quand les fers se touchent
        if(f>.5&&f<.62){const k=1-Math.abs(f-.56)/.06;g2.fillStyle=`rgba(255,250,235,${.85*k})`;g2.beginPath();g2.arc(cx,cy,2+2*k,0,6.283);g2.fill()}}}
  }
  // ---- régiment en bloc serré : 5 files de front, plusieurs rangs (infanterie 3, phalange 4, cavalerie 2) ----
  function gridOf(u){if(u._gd)return u._gd;if(u.reg!=null)return u._gd={C:1,R:1,N:1};const k=u.T.kind;let C=5,R=k==='inf'?(u.T.d>=30?4:3):k==='eleph'?1:2;if(k==='eleph')C=3;return u._gd={C,R,N:C*R}}
  // place d'une case, en mètres dans le repère du régiment (+x = front, y = largeur) ; rang 0 = premier rang
  function sqTarget(u,t){const {C,R}=gridOf(u),m=u.w/C,sk=u.T.kind==='skirm',col=t%C,row=Math.floor(t/C);
    return [((R-1)/2-row)*m*(sk?1.3:1),(col-(C-1)/2+(sk&&row%2?.5:0))*m*(sk?1.12:1)]}
  const scrAng=a=>{const fx=Math.cos(a),fy=Math.sin(a);return Math.atan2(M[1]*fx+M[3]*fy,M[0]*fx+M[2]*fy)};
  let FDT=0;
  // chaque case suit sa place avec son propre retard et une petite dérive au hasard ; en mêlée le premier rang
  // avance, recule, se mêle à celui de l'ennemi, et les rangs de derrière poussent
  function updSquares(u){
    const dt=FDT,{C,R,N}=gridOf(u);if(!u._sq)u._sq=[];const c=Math.cos(u.ang),s=Math.sin(u.ang),m=u.w/C,fight=u.contacts.length>0;
    if(u._lx==null){u._lx=u.x;u._ly=u.y}let dux=(u.x-u._lx)*.8,duy=(u.y-u._ly)*.8;u._lx=u.x;u._ly=u.y;if(Math.abs(dux)+Math.abs(duy)>u.w){dux=0;duy=0}
    for(let t=0;t<N;t++){let [lx,ly]=sqTarget(u,t);const row=Math.floor(t/C),q=u._sq[t]||(u._sq[t]={x:NaN,y:0,a:u.ang,r:Math.random(),gx:0,gy:0,nx:0,ny:0,nt:0,sp:1});
      q.nt-=dt;if(q.nt<=0){const front=fight&&row===0,amp=front?.2:fight?.1:u.moving?.09:.035;
        q.gx=(Math.random()-.5)*2*m*amp+(front?m*(N>1?.15+Math.random()*.35:.04+Math.random()*.16):0);q.gy=(Math.random()-.5)*2*m*amp*.5;
        q.nt=front?.25+Math.random()*.6:.6+Math.random()*1.4;q.sp=u.moving?.6+Math.random()*.8:1}
      const kn=1-Math.exp(-dt*(fight&&row===0?5:1.6));q.nx+=(q.gx-q.nx)*kn;q.ny+=(q.gy-q.ny)*kn;lx+=q.nx;ly+=q.ny;
      if(fight)lx+=N>1?(row===0?m*.25:m*.12):m*.1;                                          // les rangs se serrent vers l'ennemi
      if(u.routing&&N>1){const k2=Math.min(3,u.routeT||0),h=Math.sin(t*12.9+u.id*7.7)*43758.5,hr=h-Math.floor(h);lx+=(hr-.5)*m*1.6*k2;ly+=(Math.cos(t*3.1+u.id)*.5)*m*1.2*k2}
      const tx=u.x+lx*c-ly*s,ty=u.y+lx*s+ly*c;
