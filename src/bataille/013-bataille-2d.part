  {const _rs2=renderSel;renderSel=function(){const r=_rs2.apply(this,arguments);try{const b=formBox();if(b){const m=mine(),k=formOf(m);b.classList.toggle('on',m.length>=2);for(const x of b.querySelectorAll('button[data-f]')){const on=x.dataset.f===k;x.classList.toggle('act',on);x.setAttribute('aria-pressed',on?'true':'false')}const h=b.querySelector('.fa');if(h)h.textContent=k?'Formation gardée à chaque ordre de marche. Recliquez le bouton pour la libérer.':''}}catch(e){}return r}}
