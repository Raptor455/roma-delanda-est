  // effets sur le terrain, après chaque pas de simulation
  {const _sp5=step;step=function(dt){const held=[];for(const u of units)if(u._st==='hold'&&!u.dead&&!u.routing&&u.contacts.length&&!(u.order&&u.order.type==='move'))held.push([u,u.x,u.y]);
