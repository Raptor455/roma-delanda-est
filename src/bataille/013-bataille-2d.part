  /* -- ORDRES DE COMBAT : tenir, pousser, se replier en ordre (u._st = 'hold' | 'push' | 'back'). Le joueur les donne au régiment
        choisi (ou à un carré, Alt+clic). Tenir : immobile, ne poursuit pas, encaisse mieux. Pousser : avance au contact et fait reculer
        l'ennemi (sauf s'il tient), frappe plus fort, prend plus de coups. Repli : recule face à l'ennemi qui suit (Cannes). -- */
  const STS=[['hold','Tenir','Tenir la position : le régiment ne bouge plus, ne poursuit pas et ne se laisse pas repousser. Il encaisse nettement mieux, mais ne va pas chercher l\'ennemi.'],
    ['push','Pousser','Pousser : le régiment avance au corps à corps et fait reculer l\'ennemi. Il frappe plus fort mais prend plus de pertes.'],
    ['back','Repli','Se replier en ordre : le régiment recule lentement face à l\'ennemi, qui le suit. Peu de pertes des deux côtés, mais le moral s\'use.']];
