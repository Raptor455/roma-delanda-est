  function stIcon(k){const p=k==='hold'?'<rect x="3" y="3" width="8" height="8" rx="1.5" fill="currentColor"/>':k==='push'?'<path d="M7 1.5 12 8H9v4.5H5V8H2z" fill="currentColor"/>':'<path d="M7 12.5 2 6h3V1.5h4V6h3z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>';return '<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">'+p+'</svg>'}
  function stBox(){let box=document.getElementById('stBtns');if(box)return box;const sel=document.getElementById('sel');if(!sel)return null;
    box=document.createElement('div');box.id='stBtns';
    box.innerHTML='<div class="fl">Ordre de combat</div><div class="fg">'+STS.map(f=>`<button type="button" data-s="${f[0]}" title="${f[2]}">${stIcon(f[0])}<span>${f[1]}</span></button>`).join('')+'</div><div class="fh fa" style="color:#e8c77e"></div>';
    box.addEventListener('click',e=>{const b=e.target.closest('button[data-s]');if(b)applyStance(b.dataset.s)});
    const fb=document.getElementById('formBtns'),btns=sel.querySelector('.btns');if(fb)fb.before(box);else if(btns)btns.after(box);else sel.appendChild(box);
    const st=document.createElement('style');st.textContent=`#stBtns{display:none;flex-direction:column;gap:4px;margin-top:2px}#stBtns.on{display:flex}
#stBtns .fl{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted,#b9a98a)}#stBtns .fh{font-size:11px}#stBtns .fa:empty{display:none}
