  {const _db7=drawBanners;drawBanners=function(){const r=_db7.apply(this,arguments);const m=MSG2;if(m){const a=(performance.now()-m.t)/1000;if(a>7)MSG2=null;else{g2.save();g2.globalAlpha=a<.4?a/.4:a>6?7-a:1;g2.font='bold 18px Georgia,serif';g2.textAlign='center';g2.textBaseline='middle';const tw=g2.measureText(m.tx).width+40,x=SW/2,y=SH*.27;
        g2.fillStyle='rgba(24,16,10,.9)';g2.fillRect(x-tw/2,y-20,tw,40);g2.strokeStyle=m.own?'#c0503c':'#c9a45a';g2.lineWidth=1.5;g2.strokeRect(x-tw/2,y-20,tw,40);g2.fillStyle=m.own?'#f3b0a0':'#f1e2b8';g2.fillText(m.tx,x,y);g2.restore()}}return r}}
  window.__pilote={get fin(){return FIN},stance:k=>applyStance(k),regMode:a=>regMode(a||mine()),relieve,scr:u=>toScreen(u.x,u.y,2),sel:()=>[...selected],get step(){return step},get kamp(){return KAMP},kdbg:()=>{let r=[ISCAMP(),!!CAMP.pvp,!!CAMP.b.walls,!!(window.__villes&&window.__villes.MODE),CAMPS_ON()];try{campsInit();r.push(!!KAMP,!!campGeom(0),!!campGeom(1))}catch(e){r.push(String(e))}return r},dep:{start:()=>startDep(),get on(){return DEP},get zone(){return DZ},end:()=>endDep()},fiche:u=>fiche(u),par:()=>PAR(),om:(x,y)=>orderMove({x,y}),oa:t=>orderAttack(t),st:ST,get alt(){return ALT},set alt(v){ALT=v}};
  /* -- effectifs affichés à l'échelle de la campagne (fil Armées, v149) : la simulation garde l'ancienne échelle,
        la campagne envoie men/ms et b.ms=1 ; on remultiplie seulement ce que l'on montre (fiche, cartes, barre, bilan). -- */
  const MSON=()=>!!(CAMP&&CAMP.b&&CAMP.b.ms);
  const msOf=u=>u&&u._ms||1;
  {const _dc=deployCamp;deployCamp=function(){const r=_dc.apply(this,arguments);try{if(MSON())for(const u of units){if(u.ci==null)continue;const c=(u.side===0?CAMP.b.p:CAMP.b.e||[])[u.ci];u._ms=c&&+c.ms||1}}catch(e){}return r}}
  const nf=x=>Math.round(x).toLocaleString('fr-FR');
  function fixSel(){if(!MSON())return;const a=[...selected].filter(u=>!u.dead),b=$('selBody');if(!b||!a.length)return;
    const rows=b.querySelectorAll('.row');for(const row of rows){const sp=row.querySelectorAll('span');if(sp.length<2||sp[0].textContent!=='Effectif')continue;
      if(a.length===1){const u=a[0],k=msOf(u);sp[1].textContent=`${nf(Math.ceil(u.men)*k)} / ${nf(u.T.men*k)} ${u.T.kind==='eleph'?'éléphants':'hommes'}`}
      else sp[1].textContent=nf(a.reduce((s,u)=>s+(u.T.kind==='eleph'?0:u.men*msOf(u)),0))+' hommes'}}
  {const _rs3=renderSel;renderSel=function(){const r=_rs3.apply(this,arguments);try{fixSel()}catch(e){}return r}}
  function fixTop(){if(!MSON())return;const sum=s=>units.filter(u=>u.side===s&&!u.dead&&!u.routing).reduce((a,u)=>a+(u.T.kind==='eleph'?u.men*40:u.men)*msOf(u),0);
    const a=$('fP'),b=$('fR');if(a&&/\d/.test(a.textContent))a.textContent=PAL[0].n+' '+nf(sum(0));if(b&&/\d/.test(b.textContent))b.textContent=nf(sum(1))+' '+PAL[1].n}
  {const _ce=checkEnd;checkEnd=function(){const was=ended,r=_ce.apply(this,arguments);try{if(!was&&ended&&MSON()){const S=$('endS');if(S&&!S.dataset.bilan){const sp=S.children;
      const loss=s=>units.filter(u=>u.side===s&&u.T.kind!=='eleph').reduce((a,u)=>a+(u.fled?0:(u.T.men-u.men)*msOf(u)),0);
      if(sp[4])sp[4].textContent=nf(loss(0));if(sp[7])sp[7].textContent=nf(loss(1))}}}catch(e){}return r}}
  // étiquettes : seulement pour les carrés choisis ou survolés (les fissures montrent déjà l'usure)
  {const _ut=updateTags;updateTags=function(){const r=_ut.apply(this,arguments);const many=selected.size>1;for(const u of units)if(u.tag&&!u.tag.hidden&&!(u===hover||(selected.has(u)&&(!many||u.rk===0))))u.tag.hidden=true;return r}}
  // cartes d'unités : une carte par régiment (total de ses carrés) ; un clic choisit tous ses carrés encore debout
  // (posé au premier dessin : l'interface « Bronze » enveloppe hudTick plus tard, et ses cartes doivent être corrigées après elle)
  let cardsHooked=false;function hookCards(){if(cardsHooked)return;cardsHooked=true;
    try{selected.clear=function(){SELCLR=true;return Set.prototype.clear.call(this)}}catch(e){}
    {const _stx=step;step=function(dt){const d=ISCAMP()?dt*SLOWK:dt,r=_stx.call(this,d);try{campTick(d,dt)}catch(e){console.warn('camps',e)}return r}}
    {const _rsx=renderSel;renderSel=function(){try{expandSel()}catch(e){}return _rsx.apply(this,arguments)}}
    {const _sh=shoot;shoot=function(u,dt){if(!u.T.ranged||u.routing||u.contacts.length)return;if(u.cd-dt>0){u.cd-=dt;return}return _sh.apply(this,arguments)}}
const _ht=hudTick;hudTick=function(){const r=_ht.apply(this,arguments);try{fixTop()}catch(e){}try{const bar=document.getElementById('uiCards');if(bar){
      if(!bar._sq){bar._sq=1;bar.addEventListener('click',e=>{const d=e.target.closest('.ui-uc');bar._was=!!(d&&d._u&&regOf(d._u).filter(v=>!v.dead&&!v.routing).every(v=>selected.has(v)))},true);bar.addEventListener('click',e=>{const d=e.target.closest('.ui-uc');if(!d)return;const u=d._u;if(!u)return;
          const g=regOf(u).filter(v=>!v.dead&&!v.routing),on=e.shiftKey||e.ctrlKey;if(!on)selected.clear();
          const all=bar._was;for(const v of g){if(on&&all)selected.delete(v);else selected.add(v)}renderSel()});
        bar.addEventListener('dblclick',e=>{const d=e.target.closest('.ui-uc');if(!d||!d._u)return;const g=regOf(d._u).filter(v=>!v.dead);if(g.length){cam.tx=g.reduce((a,v)=>a+v.x,0)/g.length;cam.ty=g.reduce((a,v)=>a+v.y,0)/g.length}})}
      const seen=new Set();
      for(const d of bar.querySelectorAll('.ui-uc')){const t=d.title;
        if(!d._u){const u=units.find(x=>x.side===0&&x.reg===x.id&&(x.label+' · '+x.T.name)===t&&!seen.has(x.id))||units.find(x=>x.side===0&&(x.label+' · '+x.T.name)===t&&!seen.has(x.reg));d._u=u||null}
        const u=d._u;if(!u||seen.has(u.reg!=null?u.reg:u.id)){d.style.display='none';continue}seen.add(u.reg!=null?u.reg:u.id);d.style.display='';
        const g=regOf(u),alive=g.filter(v=>!v.dead),men=alive.reduce((a,v)=>a+v.men,0),b=d.querySelector('b');if(b)b.textContent=Math.ceil(men*msOf(u)).toLocaleString('fr-FR');
        const gi=d.querySelectorAll('.g i');if(gi[0])gi[0].style.width=Math.min(100,men/(u.T.men*NSPL)*100)+'%';
        if(gi[1]&&alive.length){const m=alive.reduce((a,v)=>a+Math.max(0,v.morale/v.T.morale),0)/alive.length;gi[1].style.width=m*100+'%';gi[1].style.background=m>.5?'#9fd18c':m>.25?'#e0883c':'#d24a3a'}
        d.classList.toggle('on',g.some(v=>selected.has(v)));d.classList.toggle('dead',!alive.length);d.classList.toggle('rout',alive.length>0&&alive.every(v=>v.routing));
        d.classList.toggle('fight',g.some(v=>!v.dead&&!v.routing&&v.contacts.length));
        const n=alive.length;d.title=t.split(' · carrés')[0]+(n<NSPL?` · carrés : ${n}/${NSPL}`:'')}}}catch(e){}return r}}
  renderer.render=function(){hookCards();draw2d()};
  // hors campagne, la vue de départ montre tout le front
  let zoomed=false;const _su=setup;setup=function(){const r=_su.apply(this,arguments);if(!INTRO&&!zoomed){zoomed=true;cam.dist*=.85}return r};
  // le sol se prépare au premier affichage (après l'arrivée éventuelle de l'image de la campagne)
  const _bt=buildTerrain;buildTerrain=function(){_bt();try{if(GROUND)groundFromCampaign();if(!GM)buildGround()}catch(e){console.warn('sol 2D',e);buildGround()}};
}
