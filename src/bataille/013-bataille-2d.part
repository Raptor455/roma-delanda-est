    const near=(u,L,R)=>{let b=null,bd=R;for(const e of L){const d=Math.hypot(e.x-u.x,e.y-u.y);if(d<bd){bd=d;b=e}}return b};
    for(const u of units){if(u.side!==0||u.dead||u.pend||u.routing||u._wait||u._ex||u._wd||u._st==='hold'||u._st==='back')continue;
      if(u._rp&&!u.contacts.length&&Math.hypot(u.x-u._rp.x,u.y-u._rp.y)>260){u.order={type:'move',x:u._rp.x,y:u._rp.y,face:u._rp.a,run:false};u._rpT=time+12;u._rp=null;continue} // trop loin : on revient à sa place
