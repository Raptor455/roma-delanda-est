#apercu .ag{font-size:13px;opacity:.9;margin:2px 0 5px}#apercu .at{font-size:15px;font-variant-numeric:tabular-nums}#apercu .ak{display:flex;flex-wrap:wrap;gap:4px 10px;font-size:12.5px;opacity:.92;margin-top:4px}
#apVolet{position:absolute;left:20px;top:92px;width:292px;max-height:calc(100% - 432px);min-height:120px;overflow:auto;z-index:8;background:rgba(28,22,16,.95);border:1px solid rgba(214,184,120,.5);border-radius:8px;padding:8px 10px;color:var(--ink,#efe6d2);box-shadow:0 6px 18px rgba(0,0,0,.4)}
