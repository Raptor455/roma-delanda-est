      q.x+=dux;q.y+=duy;const ox=q.x,oy=q.y,kf=1-Math.exp(-dt*(2.2+q.r*1.6)*q.sp);q.x+=(tx-q.x)*kf;q.y+=(ty-q.y)*kf;
      const vx=q.x-ox+dux,vy=q.y-oy+duy,sp=dt>0?Math.hypot(vx,vy)/dt:0;let want=u.ang;
      if(sp>1.5&&!fight){const d=angDiff(Math.atan2(vy,vx),u.ang);if(Math.abs(d)<1.6)want+=d*.4*Math.min(1,sp/8)}
      if(fight)want+=q.ny/m*.3;
