    const hit=u._hit!=null?Math.max(0,1-(rt-u._hit)/.3):0,fight=u.contacts.length>0,shot=u.shotT!=null&&rt-u.shotT<.5?1-(rt-u.shotT)/.5:0;
    const x0=-z/2,y0=-z/2,lw=Math.max(1,Math.min(2,z/12));
    // pièce de jeu : cadre sombre épais, plaque colorée bombée (claire au centre), symbole gravé dans un ton plus foncé
    const b=Math.max(1.3,z*.13),pz=z-2*b,tint=shade(P.blk,.38);
    const grads={};const grad=c=>{const key=Math.round(c*20);return grads[key]||(grads[key]=(()=>{const g=g2.createRadialGradient(-z*.1,-z*.12,z*.04,0,0,z*.66);
      g.addColorStop(0,shade(P.blk,1.42-c*.4));g.addColorStop(.5,shade(P.blk,1.05-c*.3));g.addColorStop(1,shade(P.blk,.52-c*.15));return g})())};
    const shX=Math.max(1.5,z*.1),shY=Math.max(2,z*.13);
    for(let t=R*C-1;t>=0;t--){if(gone.has(t))continue;const q=u._sq[t];if(!q)continue;const row=Math.floor(t/C),col=t%C;
      let [sx,sy]=scr(q.x,q.y);const a=scrAng(q.a);
      if(shot&&row===0){const r=z*.12*shot*Math.sin(t+1);sx-=Math.cos(a)*r;sy-=Math.sin(a)*r}
      const hk=hit&&row===0&&Math.abs(col-(u._hk||0))<=1?hit:0;
      if(hk){sx+=(Math.random()-.5)*z*.18*hk;sy+=(Math.random()-.5)*z*.18*hk}
      const c=t===next?Math.max(gen,local):gen,cr=CR[t];
      g2.save();g2.translate(sx,sy);g2.rotate(a);if(u.routing)g2.globalAlpha=.55+.25*Math.sin(rt*9+t);
      // morceaux arrachés : un coin à 30 %, puis 50, 68 et 85 % d'usure ; chaque coin part en éclats quand il cède
      const nf=c>.85?4:c>.68?3:c>.5?2:c>.3?1:0,gonec=new Set(cr.fo.slice(0,nf)),pts=[[x0,y0],[x0+z,y0],[x0+z,y0+z],[x0,y0+z]];
      if(q.nf==null)q.nf=nf;if(nf>q.nf){for(let j=q.nf;j<nf;j++)for(let i=0;i<5;i++){const an=Math.random()*6.283,sp=(25+Math.random()*45)/s2;fx('shard',q.x+(Math.random()-.5)*u.w*.6,q.y+(Math.random()-.5)*u.w*.6,{vx:Math.cos(an)*sp,vy:Math.sin(an)*sp,life:.7+Math.random()*.5,r:Math.max(1.4,z*.13)*(.6+Math.random()*.7),c:i%2?'#16110c':P.blk,rot:an,vr:(Math.random()-.5)*14})}q.nf=nf}
      const shape=()=>{g2.beginPath();pts.forEach((p,i)=>{if(gonec.has(i)){const k=cr.fs[i]*z,e=cr.fe[i],n=pts[(i+1)%4],pv=pts[(i+3)%4];
          // coupe en dents : le bord arraché n'est pas droit
          g2.lineTo(p[0]+(pv[0]-p[0])/z*k,p[1]+(pv[1]-p[1])/z*k);
          const mx=p[0]+((pv[0]-p[0])+(n[0]-p[0]))/z*k*.5*e+((pv[0]-p[0])+(n[0]-p[0]))/z*k*.2,my=p[1]+((pv[1]-p[1])+(n[1]-p[1]))/z*k*.5*e+((pv[1]-p[1])+(n[1]-p[1]))/z*k*.2;g2.lineTo(mx,my);
          g2.lineTo(p[0]+(n[0]-p[0])/z*k*(.7+e*.4),p[1]+(n[1]-p[1])/z*k*(.7+e*.4))}else g2.lineTo(p[0],p[1])});g2.closePath()};
      // ombre portée (vers le bas à droite de l'écran), puis cadre
      {const ca=Math.cos(-a),sa=Math.sin(-a);g2.save();g2.translate(shX*ca-shY*sa,shX*sa+shY*ca);shape();g2.fillStyle='rgba(12,8,3,.42)';g2.fill();g2.restore()}
      shape();g2.fillStyle='#16110c';g2.fill();
      g2.save();g2.clip();
      // plaque
      g2.beginPath();g2.rect(x0+b,y0+b,pz,pz);g2.fillStyle=grad(c);g2.fill();
      // ombre intérieure en haut à gauche, reflet en bas à droite : la plaque semble enfoncée dans le cadre
      g2.lineWidth=Math.max(.8,b*.55);g2.strokeStyle='rgba(0,0,0,.35)';g2.beginPath();g2.moveTo(x0+b,y0+z-b);g2.lineTo(x0+b,y0+b);g2.lineTo(x0+z-b,y0+b);g2.stroke();
      g2.strokeStyle=shade(P.lt||P.blk,.95).replace('rgb','rgba').replace(')',',.45)');g2.beginPath();g2.moveTo(x0+z-b,y0+b);g2.lineTo(x0+z-b,y0+z-b);g2.lineTo(x0+b,y0+z-b);g2.stroke();
      if(hk){g2.fillStyle=`rgba(255,90,50,${.5*hk})`;g2.fillRect(x0,y0,z,z)}
      sym2(k,x0+b,y0+b,pz,tint);
      if(c>.05){const nc=Math.ceil(c*cr.L.length*1.4);
        for(let i=0;i<Math.min(nc,cr.L.length);i++){const L=cr.L[i],deep=Math.min(1,c*1.6);g2.beginPath();g2.moveTo(L[0][0]*z,L[0][1]*z);const mm=1+Math.ceil(deep*(L.length-1));for(let j=1;j<mm&&j<L.length;j++)g2.lineTo(L[j][0]*z,L[j][1]*z);
          g2.lineJoin='round';g2.lineWidth=Math.max(1.8,z*.06*(.6+deep*.7));g2.strokeStyle='rgba(255,236,200,.32)';g2.stroke();g2.lineWidth=Math.max(1.1,z*.034*(.6+deep*.9));g2.strokeStyle='rgba(10,6,2,.97)';g2.stroke()}
        // la plaque s'assombrit avec l'usure
        g2.fillStyle=`rgba(20,10,4,${c*.28})`;g2.fillRect(x0,y0,z,z)}
      g2.restore();
      // arête claire très fine autour du cadre
      shape();g2.lineWidth=.7;g2.strokeStyle='rgba(255,245,220,.18)';g2.stroke();
      if(sel||hov){g2.lineWidth=sel?2:1;g2.strokeStyle=sel?'#fff2c0':'rgba(255,250,230,.7)';g2.strokeRect(x0-2.5,y0-2.5,z+5,z+5)}
      g2.restore();
      // mêlée : traînée de poussière sur le bord qui touche l'ennemi (dessinée après tous les régiments)
