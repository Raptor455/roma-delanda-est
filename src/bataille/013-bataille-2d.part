  /* -- fiche d'unité : un clic gauche sur un carré, ami ou ennemi, montre le régiment : aperçu de l'atelier, équipement, statistiques -- */
  const esc2=t=>String(t==null?'':t).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]);
