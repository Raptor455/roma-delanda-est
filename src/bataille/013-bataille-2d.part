#stBtns button{display:flex;align-items:center;gap:4px;padding:3px 5px;font-size:12px;line-height:1.1;min-width:0;white-space:nowrap}
#stBtns button svg{flex:none}#stBtns button span{overflow:hidden;text-overflow:ellipsis}
