    for(const k of ['pointerdown','wheel'])b.addEventListener(k,e=>e.stopPropagation());
    const st=document.createElement('style');st.textContent=`#fiche{position:absolute;right:max(12px,env(safe-area-inset-right,0px));top:92px;width:268px;max-height:calc(100% - 330px);overflow:auto;z-index:6;padding:10px 12px;
  background:rgba(28,20,12,.94);border:1px solid rgba(214,184,120,.45);border-radius:6px;color:#efe3c6;font:13px/1.35 Georgia,serif;box-shadow:0 6px 22px rgba(0,0,0,.45)}
#fiche .fh{display:flex;gap:10px;align-items:flex-start}#fiche .pv{flex:none;width:92px;height:92px;border-radius:6px;background:rgba(0,0,0,.25);overflow:hidden}
#fiche .pv svg{width:100%;height:100%;display:block}#fiche .pv.sym{display:flex;align-items:center;justify-content:center;font-size:40px}
#fiche h4{margin:0 0 2px;font-size:15px;font-weight:normal;line-height:1.2}#fiche .sd{font-size:11px;letter-spacing:.06em;text-transform:uppercase}
#fiche .fx{position:absolute;right:6px;top:4px;background:none;border:0;color:#d6b878;font-size:18px;cursor:pointer;padding:2px 6px}
#fiche .gr{display:grid;grid-template-columns:1fr auto;gap:1px 10px;margin-top:8px}#fiche .gr span:nth-child(even){text-align:right;font-variant-numeric:tabular-nums}
#fiche .tt{margin-top:9px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#b9a98a;border-top:1px solid rgba(214,184,120,.2);padding-top:6px}
#fiche .bar{height:5px;background:rgba(255,255,255,.12);border-radius:3px;margin-top:3px}#fiche .bar i{display:block;height:100%;border-radius:3px}
@media (max-width:760px){#fiche{top:auto;bottom:12px;left:12px;right:12px;width:auto;max-height:45%}}`;document.head.appendChild(st);return b}
  function hideFiche(){FU=null;const b=document.getElementById('fiche');if(b)b.hidden=true}
  function payOf(u){try{const h=regOf(u)[0];if(!CAMP||!CAMP.b||h.ci==null)return null;return (h.side===0?CAMP.b.p:CAMP.b.e)[h.ci]||null}catch(e){return null}}
