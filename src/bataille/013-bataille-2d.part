    const {n,mid,gap,back}=DZ,d=(x-mid.x)*n.x+(y-mid.y)*n.y;if(d<gap){x+=n.x*(gap-d);y+=n.y*(gap-d)}else if(d>back){x-=n.x*(d-back);y-=n.y*(d-back)}
    return{x:CLX((x)),y:CLY((y))}}
  function place(u,x,y,a){const q=clampZ(x,y);u.x=q.x;u.y=q.y;if(a!=null)u.ang=a;u._sq=null;u._lx=null;u.dirty=true;u.order=null;u.preview=null;u.v=0}
  // un régiment reste d'un bloc : on le décale tout entier pour qu'il rentre dans la zone (sans écraser ses rangs sur la limite)
  function placeAll(L){if(!DZ){for(const [u,x,y,a] of L)place(u,x,y,a);return}const {n,mid,gap,back}=DZ,G=new Map();
    for(const e of L){const k=rkey(e[0]);if(!G.has(k))G.set(k,[]);G.get(k).push(e)}
    for(const g of G.values()){let lo=0,hi=0;for(const [u,x,y] of g){const d=(x-mid.x)*n.x+(y-mid.y)*n.y;lo=Math.max(lo,gap+SQ/2-d);hi=Math.max(hi,d-back)}
