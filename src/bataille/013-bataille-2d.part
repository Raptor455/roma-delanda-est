    if(nA<u._nA){for(let j=nA;j<u._nA;j++){const q=u._sq[ord[N-1-j]];if(!q)continue;
        for(let i=0;i<8;i++){const an=Math.random()*6.283,sp=(40+Math.random()*60)/s2;fx('shard',q.x,q.y,{vx:Math.cos(an)*sp,vy:Math.sin(an)*sp,life:.8+Math.random()*.6,r:Math.max(1.6,z*.17)*(.6+Math.random()*.8),c:P.blk,rot:an,vr:(Math.random()-.5)*12})}
        fx('dust',q.x,q.y,{life:1.2,r:u.w/C*.5,a:.28})}}
    u._nA=nA;
    // touché : quelques cases du premier rang clignotent, pas tout le bloc
