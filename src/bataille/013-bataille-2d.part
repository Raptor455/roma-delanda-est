    g2.setLineDash([10,7]);g2.lineWidth=2.5;g2.strokeStyle=P.lt||'#d6b878';g2.beginPath();g2.moveTo(a[0],a[1]);g2.lineTo(b[0],b[1]);g2.stroke();
    g2.setLineDash([]);g2.globalAlpha=.25;g2.strokeStyle='#000';g2.beginPath();g2.moveTo(d[0],d[1]);g2.lineTo(c[0],c[1]);g2.stroke();g2.restore()}
  {const _do=drawOrders;drawOrders=function(){try{depTick();drawZone()}catch(e){console.warn('déploiement',e)}return _do.apply(this,arguments)}}
  // glisser un régiment (ou la sélection) à la souris pendant le déploiement
  try{host.addEventListener('pointerdown',e=>{GRAB=null;if(!DEP||e.button!==0||e.shiftKey||e.ctrlKey)return;const p=groundAt(e.clientX,e.clientY),u=pick(p,e.clientX,e.clientY);
      if(!p||!u||u.side!==0||u.dead||u.pend)return;let L=selected.has(u)?mine():null;
      if(!L||!L.length){selected.clear();ALT=!!e.altKey;for(const v of (e.altKey?[u]:regOf(u)))if(okSel(v))selected.add(v);renderSel();L=mine()}
      GRAB={sx:e.clientX,sy:e.clientY,p0:p,L,o:L.map(v=>[v.x,v.y]),moved:false}},true);
    host.addEventListener('pointermove',e=>{if(!GRAB)return;if(!GRAB.moved&&Math.hypot(e.clientX-GRAB.sx,e.clientY-GRAB.sy)<6)return;const p=groundAt(e.clientX,e.clientY);if(!p)return;
      GRAB.moved=true;e.stopPropagation();const dx=p.x-GRAB.p0.x,dy=p.y-GRAB.p0.y;placeAll(GRAB.L.map((v,i)=>[v,GRAB.o[i][0]+dx,GRAB.o[i][1]+dy,null]))},true);
    host.addEventListener('pointerup',e=>{if(!GRAB)return;const g=GRAB;GRAB=null;if(g.moved){settle();if(drag){drag.moved=true;drag.mode=null}}},true)}catch(e){console.warn('déploiement',e)}
  // accueil des batailles de campagne : sans les réglages de test, et « Déployer mes troupes » d'abord
  function campStart(){if(!ISCAMP())return;try{
    for(const id of ['taille','bRevue','bPeuples','bCamp','bPrep'])(function(el){if(el)el.style.display='none'})($(id));
    for(const p of document.querySelectorAll('#start p'))if(/Modèles Beelim/.test(p.textContent))p.style.display='none';
    if(!document.getElementById('campStartCss')){const st=document.createElement('style');st.id='campStartCss';st.textContent='#start{z-index:30}#start .card{max-height:calc(100% - 8px);overflow:auto;max-width:560px}';document.head.appendChild(st)}
    const go=$('bGo');if(go&&!go._dep){go._dep=1;go.textContent='Déployer mes troupes';}}catch(e){console.warn(e)}}
  document.addEventListener('click',e=>{if(!e.target.closest||!e.target.closest('#bGo')||!ISCAMP()||started||DEP)return;e.stopImmediatePropagation();e.preventDefault();startDep()},true);
  // en campagne, la vue de départ est plus proche (carrés d'environ 25 px) et centrée sur votre armée
  function campView(){if(!ISCAMP())return;const P=units.filter(u=>u.side===0&&!u.dead&&!u.pend),E=units.filter(u=>u.side===1&&!u.dead&&!u.pend);if(!P.length)return;
    const pc=cen(P),ec=E.length?cen(E):pc,d=Math.hypot(ec.x-pc.x,ec.y-pc.y)||1,k=-45;cam.tx=pc.x+(ec.x-pc.x)/d*k;cam.ty=pc.y+(ec.y-pc.y)/d*k;cam.dist=640*Math.sqrt(G)}
  {const _su2=setup;setup=function(){const r=_su2.apply(this,arguments);endDep();DZ=null;campStart();try{campView()}catch(e){}return r}}
  /* -- v218+ : batailles de campagne plus lentes (SLOWK) et CAMPS. Chaque armée attend dans son camp fortifié, derrière sa ligne ;
        le déploiement fixe les places (carrés translucides) ; au lancement les carrés sortent UN PAR UN, en file, par la grande porte
        et vont se ranger. L'ennemi fait de même, puis son IA reprend la main. Un camp laissé sans défenseur peut être pillé :
        provisions perdues (res.pille pour la campagne), moral de l'armée qui s'effondre. -- */
  const SLOWK=1,KSP=19,KFL=50,KBK=120,KFR=38,LOOT_T=12;let KAMP=null;
  const BANC=/[?&]banc=1/.test(location.search); // banc d'essai (outils/banc) : pas de camps, la bataille commence rangée
  const CAMPS_ON=()=>!BANC&&ISCAMP()&&!CAMP.pvp&&!CAMP.b.walls&&!(window.__villes&&window.__villes.MODE==='assaut')&&!REVUE&&!REVUE_P;
  const krnd=s=>{let a=s>>>0;return()=>{a=(a+0x6D2B79F5)|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}};
  function campGeom(side){const P=units.filter(u=>u.side===side&&!u.dead&&!u.pend),E=units.filter(u=>u.side!==side&&!u.dead&&!u.pend);if(!P.length||!E.length)return null;
    const pc=cen(P),ec=cen(E),dd=Math.hypot(pc.x-ec.x,pc.y-ec.y)||1,n={x:(pc.x-ec.x)/dd,y:(pc.y-ec.y)/dd},t={x:-n.y,y:n.x},N=P.length,sp=KSP;
    // les carrés attendent sur la place d'armes, de part et d'autre de la grande rue ; tentes sur les flancs et au fond
    const F=N>160?3:N>60?2:1,KST=Math.max(F,2)*20+14,KGW=Math.max(28,Math.ceil(KST/2)+1); // au moins une file par côté de la grande rue
    const half=Math.max(4,Math.ceil(Math.sqrt(N*2.4)/2)),cols=half*2,rows=Math.ceil(N/cols),w=cols*sp+KST+2*KFL+16,d=KFR+rows*sp+KBK;
    const mx=Math.max(...P.map(u=>(u.x-pc.x)*n.x+(u.y-pc.y)*n.y)),R=Math.hypot(w,d)/2+30;
    // une ville sur le champ (bataille devant les murs) : le camp se pose à côté, jamais dedans, et sa sortie ne traverse pas l'enceinte
    const V=window.__villes,bad=(x,y)=>{const RG=window.__rangees;try{if(RG&&((RG.wet&&RG.wet(x,y))||(RG.inMarsh&&RG.inMarsh(x,y))))return true}catch(e){}if(!V||!V.P||!V.W2P)return false;try{const q=V.W2P(x,y),o=V.dbgPt(q[0],q[1]);return !!(V.inCity(q[0],q[1])||o.town||o.water||o.wall)}catch(e){return false}};
    const mk=(la,de)=>{const q={x:pc.x+n.x*de+t.x*la,y:pc.y+n.y*de+t.y*la};q.x=Math.max(BX0()+R,Math.min(BX1()-R,q.x));q.y=Math.max(BY0()+R,Math.min(BY1()-R,q.y));return q};
    const cost=q=>{let b=0;for(let i=-3;i<=3;i++)for(let j=-3;j<=3;j++)if(bad(q.x+t.x*i*(w/2+30)/3+n.x*j*(d/2+30)/3,q.y+t.y*i*(w/2+30)/3+n.y*j*(d/2+30)/3))b+=4;
      const gx=q.x-n.x*(d/2+14),gy=q.y-n.y*(d/2+14);/* le chemin de la porte à l'armée, sondé tous les 25 m : un camp de l'autre côté d'un fleuve ou d'un marais bloquait toute l'armée sur la rive */
      {const ns=Math.max(10,Math.ceil(Math.hypot(pc.x-gx,pc.y-gy)/25));let cut=0;for(let i=1;i<=ns;i++)if(bad(gx+(pc.x-gx)*i/ns,gy+(pc.y-gy)*i/ns))cut++;if(cut)b+=60+cut}
      for(const u of P){const dx=u.x-q.x,dy=u.y-q.y;if(Math.abs(dx*t.x+dy*t.y)<w/2+40&&Math.abs(dx*n.x+dy*n.y)<d/2+60)b+=.5}return b};
    const D0=EXT()?6000:mx+170+d/2;let c=mk(0,D0),best=cost(c);
    if(best)for(const de of (EXT()?[D0,mx+900,mx+500,mx+170+d/2]:[D0,D0*.6,mx*.3,0]))for(const la of [0,-260,260,-520,520,-800,800,-1100,1100,-1400,1400]){if(!la&&de<D0)continue;const q=mk(la,de);const v=cost(q)+Math.abs(la)/2000+(D0-de)/4000;if(v<best-1e-9){best=v;c=q}if(best<1)break}
