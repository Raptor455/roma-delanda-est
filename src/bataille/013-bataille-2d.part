    // mêlée : poussière, et paires de régiments au contact pour les armes qui s'affrontent (une fois par paire)
    if(fight)for(const e of u.contacts){if(e.id<u.id)continue;const mx=(u.x+e.x)/2,my=(u.y+e.y)/2;
      if(Math.random()<.15)fx('dust',mx+(Math.random()-.5)*u.w*.8,my+(Math.random()-.5)*u.w*.3,{life:1.4+Math.random(),r:6+Math.random()*6,vx:(Math.random()-.5)*6,vy:(Math.random()-.5)*6,c:'110,86,58',a:.15});
      CLASH.push([u,e])}
    if(u.moving&&(k==='cav'||k==='lcav'||k==='eleph')&&Math.random()<.15)fx('dust',u.x-Math.cos(u.ang)*u.dd*.8+(Math.random()-.5)*u.w*.5,u.y-Math.sin(u.ang)*u.dd*.8+(Math.random()-.5)*u.w*.5,{life:1.2,r:5,c:'150,128,92',a:.14});
  }
  function drawOrders(){
    for(const u of units){
      if(u.dead)continue;
      if(u.preview){const p=u.preview,[px,py]=scr(p.x,p.y),fx=Math.cos(p.face),fy=Math.sin(p.face),a=Math.atan2(M[1]*fx+M[3]*fy,M[0]*fx+M[2]*fy);
        g2.save();g2.translate(px,py);g2.rotate(a);g2.setLineDash([5,4]);g2.lineWidth=1.6;g2.strokeStyle='rgba(255,242,192,.9)';const rw=Math.max(14,p.w*s2),rd=Math.max(10,p.d*s2);g2.strokeRect(-rd/2,-rw/2,rd,rw);g2.restore()}
      if(u.side!==0||!selected.has(u)||!u.order)continue;
      const o=u.order,att=o.type==='attack',tx=att?o.target.x:o.x,ty=att?o.target.y:o.y,[ax,ay]=scr(u.x,u.y),[bx,by]=scr(tx,ty);
      g2.save();g2.setLineDash(att?[]:[7,5]);g2.lineWidth=2;g2.strokeStyle=att?'rgba(232,90,70,.9)':'rgba(255,242,192,.85)';
      g2.beginPath();g2.moveTo(ax,ay);g2.lineTo(bx,by);g2.stroke();g2.setLineDash([]);
      const an=Math.atan2(by-ay,bx-ax);g2.beginPath();g2.moveTo(bx,by);g2.lineTo(bx-10*Math.cos(an-.45),by-10*Math.sin(an-.45));g2.lineTo(bx-10*Math.cos(an+.45),by-10*Math.sin(an+.45));g2.closePath();g2.fillStyle=g2.strokeStyle;g2.fill();g2.restore();
    }
  }
  // volées : chaque tir part en l'air en cloche (flèches haut, javelots tendus), avec sa traînée et son ombre au sol
  function drawProjs(){
    const f=Math.max(.9,Math.min(2.2,s2*1.1));
    for(const p of projs){const ty=p.k||'fleche',R=srand(Math.floor(p.seed*1e6)),k=Math.min(1,p.t/p.dur);
      const [ax,ay]=scr(p.x0,p.y0),[bx,by]=scr(p.tx,p.ty),L=Math.hypot(bx-ax,by-ay);
      const H=Math.max(18,Math.min(260,L*(ty==='fleche'?.55:ty==='pierre'?.35:.28))),n=ty==='javelot'?6:ty==='pierre'?8:9,sp=Math.max(6,Math.min(40,8*s2));
      const at=(kk,ox,oy)=>[ax+(bx-ax)*kk+ox,ay+(by-ay)*kk+oy-H*4*kk*(1-kk)];
      for(let i=0;i<n;i++){const ox=(R()-.5)*sp*2,oy=(R()-.5)*sp,dk=(R()-.5)*.08,kk=Math.max(0,Math.min(1,k+dk));
        // ombre au sol
        g2.fillStyle='rgba(20,14,8,.16)';g2.beginPath();g2.ellipse(ax+(bx-ax)*kk+ox,ay+(by-ay)*kk+oy,1.8*f,1.1*f,0,0,6.283);g2.fill();
        const [qx,qy]=at(kk,ox,oy),[px,py]=at(Math.max(0,kk-.03),ox,oy),an=Math.atan2(qy-py,qx-px);
        // traînée
        const [tx0,ty0]=at(Math.max(0,kk-.14),ox,oy);g2.strokeStyle='rgba(250,244,225,.28)';g2.lineWidth=1;g2.beginPath();g2.moveTo(tx0,ty0);g2.quadraticCurveTo(px,py,qx,qy);g2.stroke();
        g2.save();g2.translate(qx,qy);g2.rotate(an);g2.scale(f,f);
        if(ty==='pierre'){g2.fillStyle='#3a3026';g2.beginPath();g2.arc(0,0,1.7,0,6.283);g2.fill()}
        else{const l=ty==='javelot'?12:8;g2.strokeStyle=ty==='javelot'?'#4a3420':'#2a2016';g2.lineWidth=ty==='javelot'?1.6:1.1;g2.beginPath();g2.moveTo(-l,0);g2.lineTo(0,0);g2.stroke();
          g2.fillStyle='#d4d8dc';g2.strokeStyle='#2a2016';g2.lineWidth=.5;g2.beginPath();g2.moveTo(3,0);g2.lineTo(-1,-1.6);g2.lineTo(-1,1.6);g2.closePath();g2.fill();g2.stroke();
          if(ty==='fleche'){g2.strokeStyle='#efe4c8';g2.lineWidth=1.1;g2.beginPath();g2.moveTo(-l,0);g2.lineTo(-l-2.5,-2.2);g2.moveTo(-l+1.5,0);g2.lineTo(-l-1,-2.2);g2.moveTo(-l,0);g2.lineTo(-l-2.5,2.2);g2.moveTo(-l+1.5,0);g2.lineTo(-l-1,2.2);g2.stroke()}}
        g2.restore()}
      // départ : petit nuage au-dessus du régiment qui tire
      if(p.t<.08&&!p._puff){p._puff=1;fx('dust',p.x0,p.y0,{life:.6,r:3,c:'200,190,160',a:.18})}}
  }
  // type de projectile selon l'arme de jet du régiment
  function projKind(u){const g=typeof gearOf==='function'?gearOf(u):{},j=g&&g.jet;return j==='arc'?'fleche':j==='fronde'||u.type==='sling'?'pierre':j==='javelots'||j==='soliferrum'||j==='pilum'?'javelot':u.T.kind==='lcav'?'javelot':'fleche'}
  {const _sh=shoot;shoot=function(u,dt){const n=projs.length,r=_sh.apply(this,arguments);for(let i=n;i<projs.length;i++)projs[i].k=projKind(u);return r}}
  {const _lp=landProj;landProj=function(p){const r=_lp.apply(this,arguments);for(let i=0;i<2;i++)fx('dust',p.tx+(Math.random()-.5)*14,p.ty+(Math.random()-.5)*10,{life:.7,r:3,c:'130,110,80',a:.25});return r}}
  // étendards des généraux : hampe, bannière aux couleurs du camp, nom dans un cartouche
  function drawBanners(){
    const L=(window.__echelle&&window.__echelle.corps)||[[],[]];
    for(const s of [0,1])for(const o of L[s]){const u=o.gu;if(!u||u.dead||u.pend)continue;
      const [px,py]=scr(u.x,u.y),P=PAL[s],bw=30,bh=36,top=py-62;
      g2.save();g2.globalAlpha=u.routing?.5:1;
      g2.strokeStyle=INK;g2.lineWidth=2.5;g2.beginPath();g2.moveTo(px,py);g2.lineTo(px,top-6);g2.stroke();
      g2.beginPath();g2.moveTo(px-bw/2-4,top);g2.lineTo(px+bw/2+4,top);g2.stroke();
      g2.beginPath();g2.moveTo(px-bw/2,top);g2.lineTo(px+bw/2,top);g2.lineTo(px+bw/2,top+bh);g2.lineTo(px,top+bh+8);g2.lineTo(px-bw/2,top+bh);g2.closePath();
      g2.fillStyle=P.flag;g2.fill();g2.lineWidth=2;g2.strokeStyle=P.str;g2.stroke();
      g2.fillStyle=P.str;g2.font='bold 15px Georgia,serif';g2.textAlign='center';g2.textBaseline='middle';g2.fillText(o.chef?'★':'✦',px,top+bh/2);
      // le nom du général est déjà affiché par l'étiquette du corps
      g2.restore()}
  }
  function draw2d(){
    view();g2.setTransform(1,0,0,1,0,0);(window.__solNet?0:drawGround());try{window.__sol2d&&window.__sol2d(g2,M,DPR,s2)}catch(e){}
    g2.save();g2.scale(DPR,DPR);
    drawOrders();
    const order=units.filter(u=>!u.dead&&!u.pend).sort((a,b)=>(a.routing?0:1)-(b.routing?0:1));
    {const d=Math.min(.1,Math.max(0,rt-fxT));fxT=rt;FDT=d;stepFx(d)}
    for(const u of units){if(u.reg==null||!u.dead||u.pend||u._shat||!u._sq||!u._sq[0])continue;u._shat=1;const q=u._sq[0],z=Math.max(5,u.w*s2*.92);
      for(let i=0;i<10;i++){const an=Math.random()*6.283,sp=(40+Math.random()*60)/s2;fx('shard',q.x,q.y,{vx:Math.cos(an)*sp,vy:Math.sin(an)*sp,life:.8+Math.random()*.6,r:Math.max(1.6,z*.18)*(.6+Math.random()*.8),c:PAL[u.side].blk,rot:an,vr:(Math.random()-.5)*12})}
      fx('dust',q.x,q.y,{life:1.2,r:u.w*.5,a:.28})}
    drawFx(true);CLASH=[];SMEAR=[];for(const u of order)drawUnit(u);drawSmears();
    drawFx(false);
    drawProjs();drawBanners();
    g2.restore();
  }
  /* -- carrés indépendants : chaque régiment se partage en 10 carrés (1/10 des hommes chacun) que l'on sélectionne
        et déplace un à un. C'est au joueur (et à l'IA) d'échelonner ses rangs pour relever les carrés qui faiblissent.
        Le régiment reste un tout pour la campagne (pertes additionnées), les cartes d'unités et les corps. -- */
  const NSPL=10,SQ=16; // 10 carrés par régiment (5 de front sur 2 rangs au déploiement) // tous les carrés ont la même taille (m)
  const T5=new Map();const tOf=T=>{let t=T5.get(T);if(!t){t=Object.assign({},T,{men:T.men/NSPL,w:SQ,d:SQ});T5.set(T,t);T5.set(t,t)}return t};
  const KIDS=new Map(); // id du régiment → ses carrés (le premier est l'unité d'origine)
  const regOf=u=>KIDS.get(u.reg!=null?u.reg:u.id)||[u];
  window.__carres={regOf,get regs(){return KIDS}};
  function splitAll(){
    if(units._split)return;units._split=true;KIDS.clear();
    const list=units.slice();
    for(const u of list){if(u.reg!=null)continue;
      const T0=u.T,men=u.men,w5=SQ,c=Math.cos(u.ang),s=Math.sin(u.ang),px=-s,py=c,leg=u.leg;
      const ai=u.side===1&&T0.kind==='inf';                  // l'IA garde son second rang en relève
      const COLS=[0,-1,1,-2,2],slots=[...COLS.map(c=>[c,0]),...COLS.map(c=>[c,-1])];
      const T1=tOf(T0),grp=[];
