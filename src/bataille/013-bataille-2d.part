  function zoneOf(){const P=units.filter(u=>u.side===0&&!u.dead&&!u.pend),E=units.filter(u=>u.side===1&&!u.dead&&!u.pend);if(!P.length||!E.length)return null;
    const pc=cen(P),ec=cen(E),dx=pc.x-ec.x,dy=pc.y-ec.y,dist=Math.hypot(dx,dy)||1,n={x:dx/dist,y:dy/dist},mid={x:(pc.x+ec.x)/2,y:(pc.y+ec.y)/2};
    const pr=P.map(u=>(u.x-mid.x)*n.x+(u.y-mid.y)*n.y),mn=Math.min(...pr),mx=Math.max(...pr);
