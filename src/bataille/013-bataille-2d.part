  function campsInit(){if(KAMP||!CAMPS_ON())return;const a=campGeom(0),b=campGeom(1);if(!a||!b)return;KAMP={s:[a,b],t:0,freeE:false,lastE:0,lastP:0,msg:null};campFill(b);
    // le résultat renvoyé à la campagne dit quel camp a été pillé (provisions perdues)
    if(!window.__campGF){window.__campGF=1;const _g=window.__echelleGF;window.__echelleGF=function(){let o={};try{if(_g)o=_g.apply(this,arguments)||{}}catch(e){}if(KAMP)o.pille={p:!!KAMP.s[0].looted,e:!!KAMP.s[1].looted};return o}}}
  function campsLaunch(){if(!CAMPS_ON())return;campsInit();if(!KAMP)return;if(!KAMP.s[0].filled)campFill(KAMP.s[0]);for(const k of KAMP.s)for(const f of k.fl)f.t=KAMP.t+.4;KAMP.go=true}
  const planOrd=u=>({type:'move',x:u._plan.x,y:u._plan.y,face:u._plan.a,run:false});
  // sortie : le carré gagne la grande rue, la descend en file, passe la porte
  function exitPath(u,k,fo){const p=[];p.push(k.L(fo,u._kd));p.push(k.L(fo,-k.d/2-30));return {p,i:0}}
  function campOut(u){u._wait=false;u._ex=null;u._exp=null;u.dirty=true;u.v=u.T.speed;if(u.side===0){u.order=u._pendO||planOrd(u);u._pendO=null}else{u._forming=true;u.order=planOrd(u)}}
  function inCamp(k,x,y,m){const dx=x-k.c.x,dy=y-k.c.y;return Math.abs(dx*k.t.x+dy*k.t.y)<k.w/2+(m||0)&&Math.abs(dx*k.n.x+dy*k.n.y)<k.d/2+(m||0)}
  // raw = temps réel (× bouton de vitesse) pour la sortie en file ; dt = temps de simulation
  function campTick(dt,raw){if(!KAMP||!KAMP.go)return;KAMP.t+=dt;
    for(const k of KAMP.s){
      // le joueur garde la main : un ordre donné à un carré encore au camp le fait passer en tête de file
      if(k.side===0)for(let j=0;j<k.q.length;j++){const u=k.q[j];if(u.order){u._pendO=u.order;u.order=null;if(j){k.q.splice(j,1);k.q.unshift(u)}}}
      // chaque file lâche un carré dès que le précédent a pris 21 m d'avance, à la vitesse de marche de celui qui sort
      for(let j=k.q.length-1;j>=0;j--)if(k.q[j].dead||!k.q[j]._wait)k.q.splice(j,1);
      for(const fl of k.fl){if(KAMP.t<fl.t||!k.q.length)continue;const j=k.q.findIndex(u=>(u._kl<0?-1:1)===fl.sg);if(j<0)continue;const u=k.q.splice(j,1)[0];
        const fo=fl.fo;u._wait=false;u._ex=exitPath(u,k,fo);u._exp=fl.last&&fl.last._ex?fl.last:null;fl.last=u;fl.t=KAMP.t+21/Math.max(6,u.T.speed);if(k.side===1)KAMP.lastE=KAMP.t;else KAMP.lastP=KAMP.t}
      for(const u of units){if(u.side!==k.side||u.dead||u.pend)continue;
        if((u._wait||u._ex)&&(u.routing||u.contacts.length)){const i=k.q.indexOf(u);if(i>=0)k.q.splice(i,1);u._wait=false;u._ex=null;u._forming=false;if(k.side===1)KAMP.freeE=true;continue}
        if(u._wait){if(k.side===1)u.order=null;u.v=0;continue}
        if(!u._ex)continue;
        if(u.order){if(k.side===0)u._pendO=u.order;u.order=null}
        let st=u.T.speed*dt;const e=u._ex,pr=u._exp;
        if(pr&&pr._ex&&!pr.dead){const gap=Math.hypot(pr.x-u.x,pr.y-u.y)-19.5;if(e.i>0||Math.abs((pr.x-u.x)*k.t.x+(pr.y-u.y)*k.t.y)<12)st=Math.min(st,Math.max(0,gap))}
        while(st>0&&e.i<e.p.length){const q=e.p[e.i],dx=q.x-u.x,dy=q.y-u.y,L=Math.hypot(dx,dy);if(L<=st){u.x=q.x;u.y=q.y;st-=L;e.i++}else{u.x+=dx/L*st;u.y+=dy/L*st;u.ang=Math.atan2(dy,dx);st=0}}
        u.moving=true;u.dirty=true;if(e.i>=e.p.length)campOut(u)}}
    const kp=KAMP.s[0],ke=KAMP.s[1];let formingE=0;
    if(!KAMP.freeE){for(const u of units){if(u.side!==1||u.dead||u.pend||u.routing)continue;
        if(u._wait||u._ex){formingE++;continue}
        if(u.contacts.length||u.underFire>0){KAMP.freeE=true;break}
        if(u._forming){if(Math.hypot(u.x-u._plan.x,u.y-u._plan.y)>8){u.order=planOrd(u);formingE++}else if(u.order&&u.order.type==='attack')u.order=null}}
      // l'ennemi attend que les deux armées soient sorties (plus 12 s) : personne ne tombe sur une armée en file
      if(!KAMP.freeE&&!ke.q.length&&(!formingE||KAMP.t>KAMP.lastE+(EXT()?200:45))&&!kp.q.length&&KAMP.t>KAMP.lastP+(EXT()?90:12))KAMP.freeE=true}
    if(KAMP.freeE)for(const u of units)if(u.side===1&&u._forming)u._forming=false;
    // pillage : des ennemis dans le camp, plus un seul défenseur à portée
    for(const k of KAMP.s){if(k.looted)continue;let foes=0,def=0;
      for(const u of units){if(u.dead||u.pend||u.routing)continue;if(u.side===k.side){if(inCamp(k,u.x,u.y,45))def++}else if(inCamp(k,u.x,u.y,-4))foes++}
      if(foes&&!def){k.loot+=dt*Math.min(1,.4+foes*.12)/LOOT_T;if(k.loot>=1)campLoot(k)}else if(k.loot>0)k.loot=Math.max(0,k.loot-dt/(LOOT_T*2))}}
  function campLoot(k){k.looted=true;k.loot=1;k.lt=performance.now();
    for(const u of units){if(u.dead||u.pend||u.routing)continue;if(u.side===k.side){u.morale-=22;if(u.morale<=0)try{rout(u)}catch(e){}}}
    KAMP.msg={t:performance.now(),own:k.side===0,tx:k.side===0?'Votre camp est pillé ! Vos provisions sont perdues, l\'armée vacille.':'Le camp de '+PAL[k.side].n+' est pillé ! Ses provisions sont à vous, son armée vacille.'}}
  // ---- dessin ----
  function drawCamps(){if(!KAMP)return;const T=performance.now()/1000;
    for(const k of KAMP.s){const P=PAL[k.side],{w,d}=k,KST=k.st,KGW=k.gw,pt=(la,de)=>{const q=k.L(la,de);return scr(q.x,q.y)},z=s2,burnt=k.looted;
      const poly=(a,close)=>{g2.beginPath();a.forEach((q,i)=>i?g2.lineTo(q[0],q[1]):g2.moveTo(q[0],q[1]));if(close)g2.closePath()};
      const box=(la,de,hl,hd)=>[pt(la-hl,de-hd),pt(la+hl,de-hd),pt(la+hl,de+hd),pt(la-hl,de+hd)];
      const A=pt(-w/2,-d/2),B=pt(w/2,-d/2),C=pt(w/2,d/2),D=pt(-w/2,d/2),g1=pt(-KGW,-d/2),g2p=pt(KGW,-d/2);
      g2.save();g2.lineJoin='round';g2.lineCap='round';
      // fossé, sol battu, grande rue, place du chef
      poly(box(0,0,w/2+9,d/2+9),1);g2.fillStyle='rgba(54,40,24,.55)';g2.fill();
      poly([A,B,C,D],1);g2.fillStyle=burnt?'rgba(96,80,58,.92)':'rgba(158,132,92,.92)';g2.fill();
      poly(box(0,(-KBK+14)/2-12,KST/2-3,(d-KBK+14)/2+12),1);g2.fillStyle='rgba(196,172,128,.55)';g2.fill();
      poly(box(0,d/2-KBK+14,w/2-KFL-4,7),1);g2.fill();
      // tentes
      const tw=6.2,tl=7.6;for(let i=0;i<k.tents.length;i++){const tn=k.tents[i],hor=Math.abs(Math.cos(tn.a))>.5,bx=box(tn.la,tn.de,hor?tl:tw,hor?tw:tl);
        if(burnt&&(i*7+3)%5<3){poly(bx,1);g2.fillStyle='rgba(38,30,24,.75)';g2.fill();continue}
        const sh=box(tn.la+2,tn.de+2,hor?tl:tw,hor?tw:tl);poly(sh,1);g2.fillStyle='rgba(30,22,12,.3)';g2.fill();
        poly(bx,1);g2.fillStyle=(i%3)?'#e9dcbd':'#dccba6';g2.fill();g2.lineWidth=Math.max(.7,.9*z);g2.strokeStyle='rgba(60,44,26,.75)';g2.stroke();
        const r1=hor?pt(tn.la-tl,tn.de):pt(tn.la,tn.de-tl),r2=hor?pt(tn.la+tl,tn.de):pt(tn.la,tn.de+tl);g2.beginPath();g2.moveTo(r1[0],r1[1]);g2.lineTo(r2[0],r2[1]);g2.strokeStyle='rgba(90,66,40,.8)';g2.stroke()}
      // tente du chef, aux couleurs du camp, et son enseigne qui flotte
      {const de=d/2-KBK+44,bx=box(0,de,17,13);poly(box(2.5,de+2.5,17,13),1);g2.fillStyle='rgba(30,22,12,.35)';g2.fill();poly(bx,1);g2.fillStyle=burnt?'#3a2c22':shade(P.blk,1.15);g2.fill();g2.lineWidth=Math.max(1,1.4*z);g2.strokeStyle='#2a1c10';g2.stroke();
        const a=pt(-17,de),b=pt(17,de),m=pt(0,de-13),m2=pt(0,de+13);g2.beginPath();g2.moveTo(a[0],a[1]);g2.lineTo(b[0],b[1]);g2.moveTo(m[0],m[1]);g2.lineTo(m2[0],m2[1]);g2.strokeStyle=P.lt||'#e6cf96';g2.lineWidth=Math.max(.8,1*z);g2.stroke();
        if(!burnt){const f=pt(0,de),h=Math.max(12,20*z);g2.beginPath();g2.moveTo(f[0],f[1]);g2.lineTo(f[0],f[1]-h);g2.strokeStyle='#2a1c10';g2.lineWidth=Math.max(1.2,1.5*z);g2.stroke();
          const fw=h*.75,fh=h*.42,wv=Math.sin(T*3+k.seed)*fh*.18;g2.beginPath();g2.moveTo(f[0],f[1]-h);g2.quadraticCurveTo(f[0]+fw*.5,f[1]-h+wv,f[0]+fw,f[1]-h+fh*.2-wv);g2.lineTo(f[0]+fw,f[1]-h+fh-wv);g2.quadraticCurveTo(f[0]+fw*.5,f[1]-h+fh+wv,f[0],f[1]-h+fh);g2.closePath();g2.fillStyle=P.blk;g2.fill();g2.strokeStyle=P.lt||'#e6cf96';g2.lineWidth=1;g2.stroke()}}
      // provisions : sacs, jarres, caisses, chariots (perdues si le camp est pillé)
      for(const s of k.sup){const q=pt(s.la,s.de),r=Math.max(1.6,3.6*z);
        if(burnt){g2.beginPath();g2.arc(q[0],q[1],r*.8,0,6.3);g2.fillStyle='rgba(30,24,20,.7)';g2.fill();continue}
        if(s.k===9){poly(box(s.la,s.de,9,5.5),1);g2.fillStyle='#8a6638';g2.fill();g2.lineWidth=Math.max(.7,1*z);g2.strokeStyle='#33220f';g2.stroke();for(const sx of [-6,6])for(const sy of [-6.5,6.5]){const c=pt(s.la+sx,s.de+sy);g2.beginPath();g2.arc(c[0],c[1],Math.max(1.2,2.2*z),0,6.3);g2.fillStyle='#33220f';g2.fill()}continue}
        if(s.k===1){poly(box(s.la,s.de,4,4),1);g2.fillStyle='#9b7440';g2.fill();g2.lineWidth=Math.max(.6,.8*z);g2.strokeStyle='#33220f';g2.stroke();continue}
        g2.beginPath();g2.arc(q[0],q[1],r,0,6.3);g2.fillStyle=s.k===2?'#b5673c':s.k===3?'#c9b17c':'#d8c79a';g2.fill();g2.lineWidth=Math.max(.6,.8*z);g2.strokeStyle='#3a2814';g2.stroke()}
      // palissade : talus, pieux, tours d'angle, grande porte à deux tours
      const wall=()=>{g2.beginPath();g2.moveTo(g1[0],g1[1]);g2.lineTo(A[0],A[1]);g2.lineTo(D[0],D[1]);g2.lineTo(C[0],C[1]);g2.lineTo(B[0],B[1]);g2.lineTo(g2p[0],g2p[1])};
      wall();g2.lineWidth=Math.max(3.5,6.5*z);g2.strokeStyle='#2c1e10';g2.stroke();wall();g2.lineWidth=Math.max(2,4*z);g2.strokeStyle=burnt?'#4a3a2a':'#8a6436';g2.stroke();
      wall();g2.lineWidth=Math.max(2,4*z);g2.setLineDash([Math.max(1,1.2*z),Math.max(2,2.6*z)]);g2.strokeStyle=burnt?'#2a2018':'#5c3f1e';g2.stroke();g2.setLineDash([]);
      const tower=(la,de,h)=>{poly(box(la,de,h,h),1);g2.fillStyle=burnt?'#3a2c20':'#7a5830';g2.fill();g2.lineWidth=Math.max(1,1.5*z);g2.strokeStyle='#22160a';g2.stroke();poly(box(la,de,h*.55,h*.55),1);g2.fillStyle=burnt?'#2c2018':'#a37a44';g2.fill()};
      for(const [la,de] of [[-w/2,-d/2],[w/2,-d/2],[w/2,d/2],[-w/2,d/2]])tower(la,de,7);tower(-KGW-6,-d/2,8);tower(KGW+6,-d/2,8);
      // vantaux ouverts vers l'extérieur
      for(const sg of [-1,1]){const a=pt(sg*KGW,-d/2),b=pt(sg*(KGW+7),-d/2-KGW*.8);g2.beginPath();g2.moveTo(a[0],a[1]);g2.lineTo(b[0],b[1]);g2.lineWidth=Math.max(2,3.2*z);g2.strokeStyle='#4a321a';g2.stroke()}
      if(!burnt)for(const sg of [-1,1]){const f=pt(sg*(KGW+6),-d/2),h=Math.max(8,13*z),wv=Math.sin(T*3.4+sg+k.seed)*2;g2.beginPath();g2.moveTo(f[0],f[1]);g2.lineTo(f[0],f[1]-h);g2.strokeStyle='#22160a';g2.lineWidth=1.2;g2.stroke();g2.beginPath();g2.moveTo(f[0],f[1]-h);g2.lineTo(f[0]+h*.7,f[1]-h*.8+wv*.4);g2.lineTo(f[0],f[1]-h*.55);g2.closePath();g2.fillStyle=P.blk;g2.fill()}
      // feux de camp et fumée
      for(let i=0;i<k.fires.length;i++){const f=k.fires[i],q=pt(f.la,f.de),fl=.75+.25*Math.sin(T*11+i*2.1)+.12*Math.sin(T*23+i),r=Math.max(2,3.4*z);
        if(!burnt){const gr=g2.createRadialGradient(q[0],q[1],0,q[0],q[1],r*5);gr.addColorStop(0,'rgba(255,170,60,'+(.34*fl).toFixed(3)+')');gr.addColorStop(1,'rgba(255,150,40,0)');g2.fillStyle=gr;g2.beginPath();g2.arc(q[0],q[1],r*5,0,6.3);g2.fill()}
        g2.beginPath();g2.arc(q[0],q[1],r,0,6.3);g2.fillStyle='#2a1c12';g2.fill();
        if(!burnt){g2.beginPath();g2.arc(q[0],q[1]-r*.2,r*.7*fl,0,6.3);g2.fillStyle='#ff9a2e';g2.fill();g2.beginPath();g2.arc(q[0],q[1]-r*.35,r*.36*fl,0,6.3);g2.fillStyle='#ffe08a';g2.fill()}
        for(let j=0;j<4;j++){const ph=((T*.22+j/4+i*.17)%1),sx=q[0]+Math.sin(T*.8+j*2+i)*r*1.2*ph+r*3*ph,sy=q[1]-r*(1.5+9*ph);g2.beginPath();g2.arc(sx,sy,r*(.7+1.8*ph),0,6.3);g2.fillStyle='rgba(90,84,78,'+(.2*(1-ph)).toFixed(3)+')';g2.fill()}}
      // camp pillé : incendies sur les tentes et les provisions
      if(burnt){for(let i=0;i<k.tents.length;i+=4){const tn=k.tents[i],q=pt(tn.la,tn.de),r=Math.max(2.5,5*z),fl=.7+.3*Math.sin(T*9+i);
          const gr=g2.createRadialGradient(q[0],q[1],0,q[0],q[1],r*4);gr.addColorStop(0,'rgba(255,140,40,'+(.4*fl).toFixed(3)+')');gr.addColorStop(1,'rgba(255,120,30,0)');g2.fillStyle=gr;g2.beginPath();g2.arc(q[0],q[1],r*4,0,6.3);g2.fill();
          g2.beginPath();g2.moveTo(q[0]-r*.7,q[1]+r*.4);g2.quadraticCurveTo(q[0]-r*.2,q[1]-r*1.2*fl,q[0],q[1]-r*1.9*fl);g2.quadraticCurveTo(q[0]+r*.3,q[1]-r*1.1*fl,q[0]+r*.7,q[1]+r*.4);g2.closePath();g2.fillStyle='#ff8a22';g2.fill();
          for(let j=0;j<3;j++){const ph=((T*.18+j/3+i*.13)%1);g2.beginPath();g2.arc(q[0]+r*4*ph,q[1]-r*(2+12*ph),r*(1+2.4*ph),0,6.3);g2.fillStyle='rgba(40,36,34,'+(.28*(1-ph)).toFixed(3)+')';g2.fill()}}}
      // la vie du camp : soldats qui vont et viennent, veilleurs près des feux, sentinelles sur le rempart
      if(!burnt){const wait=k.q.length,nm=Math.round(10+Math.min(36,wait*.4)),rs=Math.max(1.3,1.7*z);
        const man=(la,de,bob)=>{const q=pt(la,de);g2.beginPath();g2.arc(q[0],q[1]+rs*.9,rs*1.15,0,6.3);g2.fillStyle='rgba(20,14,8,.35)';g2.fill();g2.beginPath();g2.arc(q[0],q[1]-(bob||0),rs,0,6.3);g2.fillStyle=P.blk;g2.fill();g2.lineWidth=Math.max(.6,.5*z);g2.strokeStyle='#1c120a';g2.stroke();g2.beginPath();g2.arc(q[0],q[1]-rs*.9-(bob||0),rs*.55,0,6.3);g2.fillStyle='#e2c39a';g2.fill()};
        for(let i=0;i<nm&&i<k.men.length;i++){const m=k.men[i];if(m.sit){const f=k.fires[i%k.fires.length],an=i*1.7;man(f.la+Math.cos(an)*7,f.de+Math.sin(an)*7,0);continue}
          const u=((T+m.ph)%(2*m.T))/m.T,v=u<1?u:2-u,e=Math.min(1,Math.max(0,(v-.12)/.76)),s=e*e*(3-2*e),walking=e>0&&e<1;man(m.a.la+(m.b.la-m.a.la)*s,m.a.de+(m.b.de-m.a.de)*s,walking?Math.abs(Math.sin(T*8+i))*rs*.35:0)}
        const per=2*(w+d),ns=8;for(let i=0;i<ns;i++){let s=((i/ns+.5/ns)*per+Math.sin(T*.35+i*1.9)*16+per)%per,la,de;const m=5;
          if(s<w){la=-w/2+s;de=-d/2+m}else if(s<w+d){la=w/2-m;de=-d/2+(s-w)}else if(s<2*w+d){la=w/2-(s-w-d);de=d/2-m}else{la=-w/2+m;de=d/2-(s-2*w-d)}
          if(de<-d/2+m+1&&Math.abs(la)<KGW+2)la=(la<0?-1:1)*(KGW+3);man(la,de,0)}
        // les gardes de la porte
        for(const sg of [-1,1])man(sg*(KGW-4),-d/2-6,0)}
      // pillage en cours : jauge
      if(k.loot>0&&!k.looted){const q=pt(0,0),bw=Math.max(70,110*z),bh=7;g2.fillStyle='rgba(20,14,8,.8)';g2.fillRect(q[0]-bw/2-2,q[1]-bh/2-2,bw+4,bh+4);g2.fillStyle='#e0902c';g2.fillRect(q[0]-bw/2,q[1]-bh/2,bw*k.loot,bh);
        g2.font='bold 12px Georgia,serif';g2.textAlign='center';g2.textBaseline='bottom';g2.lineWidth=3;g2.strokeStyle='rgba(20,14,8,.85)';g2.strokeText('Pillage du camp…',q[0],q[1]-bh);g2.fillStyle='#ffd9a0';g2.fillText('Pillage du camp…',q[0],q[1]-bh)}
      const L=pt(0,d/2+20);g2.font='13px Georgia,serif';g2.textAlign='center';g2.textBaseline='middle';g2.lineWidth=3;g2.strokeStyle='rgba(20,14,8,.8)';const tx=(burnt?'Camp pillé · ':'Camp · ')+P.n;g2.strokeText(tx,L[0],L[1]);g2.fillStyle=burnt?'#f0a070':'#efe3c6';g2.fillText(tx,L[0],L[1]);
      g2.restore()}
    // annonce du pillage
    const m=KAMP.msg;if(m){const a=(performance.now()-m.t)/1000;if(a>7)KAMP.msg=null;else{g2.save();g2.globalAlpha=a<.4?a/.4:a>6?7-a:1;g2.font='bold 17px Georgia,serif';g2.textAlign='center';g2.textBaseline='middle';const tw2=g2.measureText(m.tx).width+36,x=SW/2,y=SH*.2;
        g2.fillStyle='rgba(24,16,10,.88)';g2.fillRect(x-tw2/2,y-19,tw2,38);g2.strokeStyle=m.own?'#c0503c':'#c9a45a';g2.lineWidth=1.5;g2.strokeRect(x-tw2/2,y-19,tw2,38);g2.fillStyle=m.own?'#f3b0a0':'#f1e2b8';g2.fillText(m.tx,x,y);g2.restore()}}}
  {const _do2=drawOrders;drawOrders=function(){try{drawCamps()}catch(e){console.warn('camps',e)}return _do2.apply(this,arguments)}}
  // pendant le déploiement, vos carrés sont translucides : ce sont les places qu'ils iront prendre en sortant du camp
  {const _du=drawUnit;drawUnit=function(u){if(DEP&&KAMP&&u.side===0&&!u.pend){g2.save();g2.globalAlpha*=.6;try{return _du.apply(this,arguments)}finally{g2.restore()}}return _du.apply(this,arguments)}}
  {const _sd=startDep;startDep=function(){const r=_sd.apply(this,arguments);try{campsInit();const b=document.getElementById('depBar');if(b&&KAMP){const d=b.querySelector('div');if(d&&!d._k){d._k=1;d.innerHTML='<b>Déploiement</b> · vos troupes attendent au camp. Placez leurs places (carrés translucides) dans la zone claire : clic droit, glisser à la souris, tracé de ligne ou formations. Au lancement, elles sortiront une à une par la grande porte pour s\'y ranger. Gardez un œil sur votre camp : un camp sans défenseur peut être pillé.'}}}catch(e){console.warn('camps',e)}return r}}
