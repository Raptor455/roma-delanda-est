    const slot=i=>{const col=i%cols,row=Math.floor(i/cols),la=(col%2?1:-1)*(KST/2+(Math.floor(col/2)+.5)*sp),de=-d/2+KFR+(row+.5)*sp;return Object.assign(L(la,de),{la,de})};
