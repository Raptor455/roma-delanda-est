    const g=regOf(u),h=g[0],al=g.filter(v=>!v.dead),T=h.T,c=payOf(h),X=c&&c.x,P=PAR(),base=(c&&c.t)||h.type,gear=h.gear||(X&&X.gear)||null,k=msOf(h);
    const men=al.reduce((a,v)=>a+v.men,0),tot=T.men*(h.reg!=null?NSPL:1),mor=al.length?al.reduce((a,v)=>a+Math.max(0,v.morale/v.T.morale),0)/al.length:0;
    const svg=P&&P.svg(base,gear),eq=P&&P.gear(base,gear),pal=PAL[h.side];
    const sym={inf:'✕',skirm:'∴',cav:'⟋',lcav:'⟋',eleph:'◆'}[T.kind]||'■';
    const row=(a,v)=>v==null||v===''?'':`<span>${a}</span><span>${v}</span>`,n1=x=>(Math.round(x*100)/100).toLocaleString('fr-FR');
    let s=`<button class="fx" type="button" title="Fermer" aria-label="Fermer">×</button><div class="fh"><div class="pv${svg?'':' sym'}" style="${svg?'':'color:'+pal.lt}">${svg||sym}</div><div>
      <div class="sd" style="color:${pal.lt}">${esc2(pal.n)}</div><h4>${esc2(h.label||T.name)}</h4><div style="color:#b9a98a">${esc2(T.name)}${KIND[T.kind]?' · '+KIND[T.kind]:''}</div></div></div>
      <div class="gr">${row('Effectif',`${Math.ceil(men*k).toLocaleString('fr-FR')} / ${Math.round(tot*k).toLocaleString('fr-FR')}`)}${h.reg!=null?row('Carrés',`${al.filter(v=>!v.routing).length} / ${NSPL}`):''}</div>
      <div class="bar" title="Effectif"><i style="width:${Math.min(100,men/tot*100)}%;background:#d2ae6c"></i></div>
      <div class="bar" title="Moral"><i style="width:${Math.round(mor*100)}%;background:${mor>.5?'#9fd18c':mor>.25?'#e0883c':'#d24a3a'}"></i></div>
      <div class="tt">Statistiques</div><div class="gr">${row('Attaque',n1(T.atk))}${row('Défense',n1(T.def))}${row('Moral',Math.round(T.morale))}${row('Charge',n1(T.charge))}${row('Vitesse',Math.round(T.speed)+' m/s')}
      ${T.ranged?row('Tir',`${Math.round(T.ranged.range)} m · ${n1(T.ranged.dmg)} dégâts`):''}${T.fear?row('Effroi',T.fear):''}
      ${X&&X.weight!=null?row('Poids porté',Math.round(X.weight)+' kg'):''}${X&&X.endurance!=null?row('Endurance',Math.round(X.endurance)):''}${X&&X.missileDef!=null?row('Contre les traits',n1(X.missileDef)):''}
      ${X&&X.pierce!=null?row('Perforation',n1(X.pierce)):''}${X&&X.antiCav!=null?row('Contre la cavalerie',n1(X.antiCav)):''}${X&&X.cohesion!=null?row('Cohésion',Math.round(X.cohesion)):''}</div>`;
    if(eq&&eq.length)s+=`<div class="tt">Équipement</div><div class="gr">${eq.map(([a,v])=>row(esc2(a),esc2(v))).join('')}</div>`;
