    S.style.gridTemplateColumns='auto repeat(4,auto)';S.dataset.bilan='1';
    S.innerHTML=`<span class="h">Armée</span><span class="h">Engagés</span><span class="h">Tués et blessés</span><span class="h">En fuite</span><span class="h">Régiments défaits</span>${row(0,a)}${row(1,b)}`+
      `<span class="h" style="grid-column:1/-1;margin-top:6px">Durée : ${mmss(time)}${FIN&&FIN.gen!=null?' · déroute générale à '+mmss(FIN.t):''}${KAMP&&KAMP.s.some(c=>c.looted)?' · '+KAMP.s.filter(c=>c.looted).map(c=>'camp de '+PAL[c.side].n+' pillé').join(', '):''}</span>`;
    const P=$('endP');if(P&&ISCAMP()&&FIN&&FIN.gen!=null)P.textContent=FIN.gen===1?'L\'armée ennemie a lâché pied et vos troupes l\'ont poursuivie : le champ de bataille est à vous.':'Votre armée a lâché pied. Les survivants se replient.'}
