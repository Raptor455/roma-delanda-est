  {const _rs4=renderSel;renderSel=function(){const r=_rs4.apply(this,arguments);try{formBox();const b=stBox();if(b){const m=mine(),k=stOf(m);b.classList.toggle('on',m.length>=1);for(const x of b.querySelectorAll('button[data-s]')){const on=x.dataset.s===k;x.classList.toggle('act',on);x.setAttribute('aria-pressed',on?'true':'false')}
