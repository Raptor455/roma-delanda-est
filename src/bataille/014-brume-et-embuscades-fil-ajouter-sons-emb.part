/* ================= BRUME ET EMBUSCADES (fil « Ajouter sons, embuscades et bataille à deux ») =================
   On ne voit l'ennemi que s'il est à portée de vue d'un de ses régiments : partout par temps clair, sauf s'il se cache
   dans un bois (vu à 160 m) ; dans la brume, à 280 m (100 m dans un bois). Un régiment caché qui tombe sur l'ennemi
   le prend par surprise (moral −18, charge plus forte). L'IA ne voit que ce que voient ses régiments et embusque
   un ou deux régiments dans les bois de son côté. Météo : CAMP.b.brume (campagne) ou choix sur l'écran de départ.
   Source : /mnt/project-files/futur/brume.js, injecté avant BOUCLE par futur/patch.py. */
let BRUME=!!(CAMP&&CAMP.b&&CAMP.b.brume);
{
  const VIS=[new Set(),new Set()];let visT=-1,visClock=0;
  const sight=e=>{const fo=inForest(e);return (BRUME?(fo?100:280):(fo?160:Infinity))*G};
  // un régiment qui se bat ou qui tire se montre quelques secondes
  function computeVis(){for(const s of [0,1]){const V=VIS[s];V.clear();const mine=units.filter(u=>u.side===s&&!u.dead&&!u.pend);
      for(const e of units){if(e.dead||e.pend)continue;if(e.side===s){V.add(e.id);continue}
        if(e.contacts.length||e.routing||(e._rev||0)>time||(e.shotT!=null&&rt-e.shotT<2)){V.add(e.id);continue}
        const R=sight(e);if(R===Infinity){V.add(e.id);continue}
        for(const u of mine){const r=R+e.w*.4;if(Math.abs(u.x-e.x)<r&&Math.abs(u.y-e.y)<r&&Math.hypot(u.x-e.x,u.y-e.y)<r){V.add(e.id);break}}}}
    visT=time}
  const seenBy=(s,e)=>VIS[s].has(e.id);
  window.__brume={get on(){return BRUME},set on(v){BRUME=!!v;computeVis()},seenBy,computeVis,VIS};
  // le joueur (camp 0) ne voit pas les régiments cachés : on les retire le temps du dessin, de la minicarte, des étiquettes, du choix au clic
  const ghosts=new Map();
  function hide(fn,side){return function(){const h=[];if(visT<0)computeVis();
      for(const u of units)if(u.side!==side&&!u.dead&&!seenBy(side,u)){u.dead=true;h.push(u)}
      try{return fn.apply(this,arguments)}finally{for(const u of h)u.dead=false}}}
  pick=hide(pick,0);drawMinimap=hide(drawMinimap,0);updateTags=(f=>function(){const r=f.apply(this,arguments);if(visT>=0)for(const u of units)if(u.side!==0&&u.tag&&!seenBy(0,u))u.tag.hidden=true;return r})(updateTags);
  {const _rr=renderer.render;renderer.render=function(){
    // fantômes : dernière position connue d'un ennemi perdu de vue (10 s)
    for(const u of units){if(u.side===0||u.dead)continue;if(seenBy(0,u))ghosts.set(u.id,{x:u.x,y:u.y,a:u.ang,w:u.w,d:u.dd||u.T.d,t:time,u});else if(!ghosts.has(u.id))continue}
    const r=hide(_rr,0).apply(this,arguments);try{overlay()}catch(e){}return r}}
  // l'IA (camp 1) ne réagit qu'à ce qu'elle voit
  {const _ai=ai;ai=function(){const r=hide(_ai,1).apply(this,arguments);
    if(!(window.__iaB&&window.__iaB.active)/*IA-BRUME*/&&!units.some(u=>u.side===0&&!u.dead&&!u.routing&&seenBy(1,u))){ // rien en vue : on avance prudemment vers le centre
      for(const u of units)if(u.side===1&&!u.dead&&!u.routing&&!u.amb&&!u.contacts.length&&(!u.order||u.order.type==='move')&&u.y<H*.55)u.order={type:'move',x:u.x,y:Math.min(H*.55,u.y+90*G),face:Math.PI/2}}
    // embuscades de l'IA : tenir le bois tant que l'ennemi n'est pas tout près, puis charger
    for(const u of units){if(u.side!==1||!u.amb||u.dead||u.routing)continue;const near=units.filter(e=>e.side===0&&!e.dead&&!e.routing&&!e.pend);
      const n=near.length?nearest(u,near):null,d=n?Math.hypot(n.x-u.x,n.y-u.y):1e9;
      if(d<(u.T.kind==='cav'||u.T.kind==='lcav'?330:230)*G||u.contacts.length||time>u.ambT){u.amb=false;if(n)u.order={type:'attack',target:n,run:true}}
      else u.order=Math.hypot(u.amb.x-u.x,u.amb.y-u.y)>20*G?{type:'move',x:u.amb.x,y:u.amb.y,face:Math.PI/2}:null}
    return r}}
  // tirs : seulement sur ce qu'on voit
  {const _sh=shoot;shoot=function(u,dt){return hide(_sh,u.side).apply(this,arguments)}}
  // surprise : un régiment caché qui arrive au contact
  {const _st=step;step=function(dt){
    visClock-=dt;if(visClock<=0){visClock=.25;computeVis();for(const u of units)if(!u.dead&&!seenBy(1-u.side,u))u._hidT=time}
    // caché il y a moins de 12 s : il garde l'effet de surprise le temps de franchir la distance
    const was=new Map();for(const u of units)if(!u.dead)was.set(u,{c:u.contacts.length,h:u._hidT!=null&&time-u._hidT<12});
    const r=_st.apply(this,arguments);
    // (deux régiments qui se cherchaient dans la brume ne se surprennent pas : la victime doit avoir été à découvert)
    for(const [u,o] of was){if(u.dead||u.routing||o.c||!u.contacts.length||!o.h||u._surp)continue;
      const vic=u.contacts.filter(e=>!e.dead&&!e.routing&&!(e._hidT!=null&&time-e._hidT<12));if(!vic.length)continue;u._surp=1;u._rev=time+6;
      for(const e of vic){e.morale-=18;if(e.morale<=0)rout(e)}
      if(u.chargeT>0)u.chargeK*=1.25;
      flash(u.side===0?'Embuscade ! Vos troupes surgissent sur l\'ennemi.':'Embuscade ! L\'ennemi surgit '+(inForest(u)?'du bois':'de la brume')+' !',u.side===0?PAL[0].lt:PAL[1].lt)}
    return r}}
  let flT=-99;function flash(txt,col){if(time-flT<8)return;flT=time;try{const d=document.createElement('div');d.textContent=txt;d.setAttribute('role','status');
    d.style.cssText=`position:absolute;left:50%;top:126px;transform:translateX(-50%);z-index:7;padding:8px 18px;border-radius:6px;background:rgba(20,18,14,.9);border:1px solid rgba(214,184,120,.5);color:${col||'#efe6d2'};font-family:var(--display,Georgia);font-size:19px;pointer-events:none;transition:opacity 1s`;
    ($('app')||document.body).appendChild(d);setTimeout(()=>d.style.opacity='0',3800);setTimeout(()=>d.remove(),5000)}catch(e){}
    try{if(window.__son&&__son.ok()){const t=__son.now()+.05;__son.horn(t,[[175,.35],[175,.35],[233,.8]],.2);__son.crowd(t+.2,.2,0,6)}}catch(e){}}
  // l'IA cache un ou deux régiments dans les bois de son côté du champ
  function aiAmbush(){if(window.__pvpNoAI)return;const F=FORESTSg.filter(f=>f.r>60*G&&f.y<H*.45&&f.y>60*G&&f.x>RIVER+80*G&&f.x<W-80*G);if(!F.length)return;
    const cand=units.filter(u=>u.side===1&&!u.dead&&!u.pend&&(u.T.kind==='cav'||u.T.kind==='lcav'||u.T.kind==='inf')).sort((a,b)=>(b.T.kind!=='inf')-(a.T.kind!=='inf'));
    const used=new Set();let n=0;const max=Math.random()<.5?1:2;
    for(const u of cand){if(n>=max)break;let best=null,bd=1e9;for(const f of F){if(used.has(f))continue;const d=Math.hypot(f.x-u.x,f.y-u.y);if(d<bd&&d<1100*G&&Math.abs(f.x-1700*G)>250*G){bd=d;best=f}}
      if(!best)continue;used.add(best);u.amb={x:best.x,y:best.y};u.ambT=240+Math.random()*180;u.order={type:'move',x:best.x,y:best.y,face:Math.PI/2};n++}}
  {const _b=begin;$('bGo').onclick=()=>begin();begin=function(){const was=started;const r=_b.apply(this,arguments);if(!was&&started&&!REVUE&&!REVUE_P){try{aiAmbush()}catch(e){console.warn(e)}computeVis()}return r}}
  // voile de brume : blanc laiteux qui dérive, éclairci autour de vos régiments
  let fogC=null,fogN=null;
  function noiseTex(){const c=document.createElement('canvas');c.width=c.height=256;const g=c.getContext('2d'),im=g.createImageData(256,256);
    for(let j=0;j<256;j++)for(let i=0;i<256;i++){const v=fbm(i/48,j/48),o=(j*256+i)*4;im.data[o]=im.data[o+1]=im.data[o+2]=235;im.data[o+3]=Math.max(0,Math.min(255,(v-.25)*300))}
    g.putImageData(im,0,0);return c}
  function overlay(){const cv=document.getElementById('map2d');if(!cv||cv.style.display==='none')return;const g=cv.getContext('2d'),DPR=cv.width/(cv.clientWidth||1),SW=cv.clientWidth,SH=cv.clientHeight;
    const pxPerM=(()=>{const a=toScreen(cam.tx,cam.ty,0),b=toScreen(cam.tx+100,cam.ty,0);return Math.hypot(b.x-a.x,b.y-a.y)/100})();
    g.save();g.setTransform(DPR,0,0,DPR,0,0);
    // fantômes des ennemis perdus de vue
    for(const [id,o] of ghosts){if(time-o.t>10||o.u.dead||seenBy(0,o.u)){ghosts.delete(id);continue}const p=toScreen(o.x,o.y,0),w=o.w*pxPerM,d=Math.max(8,o.d*pxPerM);
      g.save();g.translate(p.x,p.y);g.globalAlpha=.55*(1-(time-o.t)/10);g.setLineDash([4,4]);g.strokeStyle=PAL[1].lt;g.lineWidth=1.5;
      const fx=Math.cos(o.a),fy=Math.sin(o.a),a2=toScreen(o.x+fx*10,o.y+fy*10,0);g.rotate(Math.atan2(a2.y-p.y,a2.x-p.x));g.strokeRect(-d/2,-w/2,d,w);g.setLineDash([]);
      g.rotate(-Math.atan2(a2.y-p.y,a2.x-p.x));g.fillStyle=PAL[1].lt;g.font='bold 13px Georgia,serif';g.textAlign='center';g.fillText('?',0,4);g.restore()}
    if(BRUME){if(!fogC){fogC=document.createElement('canvas');fogN=noiseTex()}
      const k=.5;if(fogC.width!==Math.round(SW*k)||fogC.height!==Math.round(SH*k)){fogC.width=Math.round(SW*k);fogC.height=Math.round(SH*k)}
      const f=fogC.getContext('2d');f.setTransform(1,0,0,1,0,0);f.globalCompositeOperation='source-over';f.clearRect(0,0,fogC.width,fogC.height);
      f.fillStyle='rgba(222,226,220,.8)';f.fillRect(0,0,fogC.width,fogC.height);
      const sc=Math.max(.6,Math.min(3,pxPerM*2.2)),drift=(rt*6)%256;f.globalAlpha=.55;f.fillStyle=f.createPattern(fogN,'repeat');f.save();f.scale(sc*k,sc*k);f.translate(drift,drift*.4);f.fillRect(-drift-10,-drift,fogC.width/(sc*k)+300,fogC.height/(sc*k)+300);f.restore();f.globalAlpha=1;
      f.globalCompositeOperation='destination-out';const R=280*G*pxPerM*k;
      for(const u of units){if(u.side!==0||u.dead||u.pend)continue;const p=toScreen(u.x,u.y,0),x=p.x*k,y=p.y*k;if(x<-R||y<-R||x>fogC.width+R||y>fogC.height+R)continue;
        const gr=f.createRadialGradient(x,y,R*.25,x,y,R);gr.addColorStop(0,'rgba(0,0,0,.92)');gr.addColorStop(1,'rgba(0,0,0,0)');f.fillStyle=gr;f.beginPath();f.arc(x,y,R,0,6.283);f.fill()}
      g.drawImage(fogC,0,0,SW,SH)}
    g.restore()}
  // choix du temps sur l'écran de départ (hors campagne) ou annonce de la brume (campagne)
  try{const box=$('taille');if(box&&!(CAMP&&CAMP.b)){const lb=document.createElement('label');lb.innerHTML='Temps <select id="sBrume"><option value="0">Clair</option><option value="1">Brume du matin</option></select>';box.appendChild(lb);
      const s=$('sBrume');s.value=BRUME?'1':'0';s.onchange=()=>{BRUME=s.value==='1';computeVis()}}
    else if(BRUME){const ps=document.querySelectorAll('#start .card > p');if(ps[0]){const p=document.createElement('p');p.style.cssText='margin:6px 0;font-size:13px;line-height:1.45';
      p.innerHTML='<b>Brume du matin</b> : on ne voit l\'ennemi qu\'à 280 m de ses régiments (100 m dans les bois). Profitez-en pour surprendre, mais méfiez-vous des bois.';ps[0].after(p)}}}catch(e){}
  try{const st=document.createElement('style');st.textContent='#sBrume{margin-left:4px}';document.head.appendChild(st)}catch(e){}
}
/* ================= FIN BRUME ET EMBUSCADES ================= */
