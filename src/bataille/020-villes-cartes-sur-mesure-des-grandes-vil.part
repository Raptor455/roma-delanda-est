/* ================= VILLES : cartes sur mesure des grandes villes (fil « Concevoir les terrains de bataille ») =================
   Choix de Baptiste (9 nov.) : « les deux selon la situation ».
   - Assaut pendant un siège (CAMP.b.walls) : la ville occupe la moitié du défenseur, son front fait face à l'attaquant.
     Remparts larges où l'on se bat, portes, brèches, échelles, tours qui tirent, rues lentes sans charge, citadelle à tenir (60 s).
     Le champ s'étend pendant l'assaut (la ville dépasse le bord habituel du champ).
   - Bataille près d'une ville (CT.town) : la ville borde le champ, ses murs bloquent le passage (portes fermées).
   Plans en unités d'origine (m, avant ×G), repère local : origine = citadelle, l'attaquant arrive par +y ; agrandis par SC au chargement.
   Un mur = sa face extérieure (ligne du plan) + un rempart de largeur WB vers l'intérieur, où les défenseurs se tiennent.
   Essai hors campagne : bataille.html?ville=carthage (assaut), &mode=murs, &camp=def ; ou #ville-carthage, #ville-carthage-murs, #ville-carthage-def.
   Rendu : window.__sol2d(g2,M,DPR,s2) appelé par la vue 2D juste après le sol (crochet de bat2d.js, posé aussi par patch_villes.py). */
(()=>{if(typeof V3D!=='undefined'&&V3D)return;
const QS=new URLSearchParams(location.search);
// courbe lisse (Catmull-Rom) passant par les points : pour les côtes
function smooth(pts,n){const N=pts.length,out=[],get=i=>pts[Math.max(0,Math.min(N-1,i))];
  for(let i=0;i<N-1;i++){const p0=get(i-1),p1=get(i),p2=get(i+1),p3=get(i+2);for(let k=0;k<n;k++){const t=k/n,t2=t*t,t3=t2*t,f=j=>.5*(2*p1[j]+(-p0[j]+p2[j])*t+(2*p0[j]-5*p1[j]+4*p2[j]-p3[j])*t2+(-p0[j]+3*p1[j]-3*p2[j]+p3[j])*t3);out.push([Math.round(f(0)),Math.round(f(1))])}}
  out.push(pts[N-1]);return out}
const PLANS={
 carthage:(()=>{
  // Repère du plan : origine = sommet de la Byrsa ; +x = nord (vers Mégara), +y = ouest (vers l'isthme, d'où vient l'attaquant) ;
  // donc la mer est en haut, le lac de Tunis en bas à gauche, les ports au sud (à gauche), Mégara à droite.
  // Tracé relevé sur les restitutions de J.-C. Golvin et le plan de Dureau de la Malle (1844) envoyés par Baptiste :
  // triple muraille rectiligne sur l'isthme (portes de Thapsus, Théveste, Utique), mur de mer le long d'une côte presque droite
  // orientée NE, cothon rond collé au mur de mer, port marchand rectangulaire au sud avec son chenal, tophet et quartier
  // artisanal au sud-ouest, agora entre la Byrsa et les ports, collines de Junon, de l'Odéon et de Bordj Djedid au nord, peu bâties,
  // Mégara (champs, vergers, villas) derrière un mur au nord de la ville, dans la grande enceinte.
  const blob=(cx,cy,rx,ry,a,m)=>m.map((k,i)=>{const t=a+i/m.length*6.283;return [Math.round(cx+Math.cos(t)*rx*k),Math.round(cy+Math.sin(t)*ry*k)]});
  const coast=smooth([[-1550,-800],[-1350,-905],[-1000,-925],[-700,-935],[-300,-965],[100,-1010],[600,-1060],[1000,-1150],[1500,-1300],[1900,-1520],[2400,-1800],[2800,-2050],[3100,-2200]],5);
  const seaWall=coast.filter(q=>q[0]<=1500); // le mur de mer s'arrête à la tour de Bordj Djedid
  const south=[[-1250,600],[-1330,250],[-1400,-150],[-1480,-500],[-1550,-800]];
  const north=[[1600,520],[1580,-200],[1500,-1300]];
  const front=[[-1250,600],[900,600],[3100,336]];
  const enclosure=front.concat([[3100,-2200]],coast.filter(q=>q[0]>-1550).reverse(),south.slice().reverse().slice(0,-1));
  const town=[[-1250,600],[1600,520],[1580,-200],[1500,-1300]].concat(seaWall.slice().reverse(),south.slice().reverse().slice(1,-1));
  const mer=[[3300,-2400],[3300,-2300]].concat(coast.slice().reverse(),[[-1800,-760],[-2200,-900],[-2600,-1050],[-2900,-1100],[-2900,-2400]]);
  const lac=smooth([[-1550,2400],[-1500,1400],[-1600,800],[-1700,350],[-1800,-100],[-1950,-450],[-2200,-700],[-2600,-850],[-2900,-900]],4).concat([[-2900,2400]]);
  // fossé devant la triple muraille, interrompu devant les portes
  const ditch=[];{const gx=[-1000,-150,2000,2800];for(let i=0;i<front.length-1;i++){const [ax,ay]=front[i],[bx,by]=front[i+1],L=Math.hypot(bx-ax,by-ay),nx=-(by-ay)/L,ny=(bx-ax)/L;
    const cuts=[0].concat(gx.map(x=>(x-ax)/(bx-ax)).filter(t=>t>0&&t<1).flatMap(t=>[t-32/L,t+32/L]),[1]);
    for(let k=0;k<cuts.length;k+=2){const t0=cuts[k],t1=cuts[k+1],q=t=>[ax+(bx-ax)*t,ay+(by-ay)*t];const a=q(t0),b=q(t1);
      ditch.push([[a[0]+nx*105,a[1]+ny*105],[b[0]+nx*105,b[1]+ny*105],[b[0]+nx*145,b[1]+ny*145],[a[0]+nx*145,a[1]+ny*145]].map(p=>[Math.round(p[0]),Math.round(p[1])]))}}}
  const byrsa=blob(0,0,300,230,.3,[1,.86,1.08,.95,.8,1.04,1.14,.9,1,.84,1.1,.96]);
  return {n:'Carthage',pt:{x:0,y:0,r:130,n:'la Byrsa'},ext:[-2800,-2400,3300,2400],
  inside:enclosure,town,
  water:[
   {k:'mer',n:'Mer',p:mer},{k:'lac',n:'Lac de Tunis',p:lac},
   {k:'port',n:'Cothon',c:[-700,-700,160],isle:[-700,-700,50]},
   {k:'port',p:[[-900,-712],[-845,-712],[-845,-688],[-900,-688]]},
   {k:'port',n:'port marchand',p:[[-1300,-790],[-870,-790],[-870,-500],[-1300,-500]]},
   {k:'port',p:[[-1292,-780],[-1262,-780],[-1232,-935],[-1262,-935]]}],
  walls:[
   {k:'mur',c:16,t:140,wb:52,cas:1,p:front}, // la grande muraille de l'isthme : large, à casemates (Appien : 9 m d'épaisseur, écuries et casernes dedans)
   {k:'palissade',c:5,t:0,p:[[-1235,665],[900,665],[3100,401]]},
   {k:'mur',c:9,t:150,p:south},
   {k:'mur',c:10,t:150,p:seaWall},
   {k:'mur',c:9,t:140,p:north},
   {k:'citadelle',c:12,t:0,closed:1,p:[[-150,-60],[-110,-130],[20,-150],[130,-110],[170,-20],[140,80],[30,130],[-100,110],[-170,30]]}],
  gates:[{w:0,x:-1000,y:600,n:'porte de Thapsus'},{w:0,x:-150,y:600,n:'porte de Théveste'},{w:0,x:2000,y:468,n:"porte d'Utique"},{w:0,x:2800,y:372,n:'porte de la Nécropole'},
         {w:1,x:-1000,y:665,open:1},{w:1,x:-150,y:665,open:1},{w:1,x:2000,y:533,open:1},{w:1,x:2800,y:437,open:1},
         {w:4,x:1590,y:-100,n:'porte de Mégara'},{w:5,x:-35,y:120,n:'porte de la Byrsa'},{w:3,x:-1248,y:-905,open:1,wide:1}],
  breaches:[[0,300,600],[0,-600,600],[0,1150,570]],
  ditch,
  hills:[{x:0,y:0,rx:300,ry:230,n:'BYRSA',p:byrsa},
         {x:600,y:-380,rx:190,ry:130,p:blob(600,-380,190,130,.9,[1,.9,1.1,.85,1,1.12,.9,.95,1.05,.88])},
         {x:1050,y:-80,rx:220,ry:150,p:blob(1050,-80,220,150,.2,[.95,1.1,.9,1.05,.85,1,1.12,.9,.98,1.06])},
         {x:1320,y:-1000,rx:170,ry:120,p:blob(1320,-1000,170,120,.6,[1,.88,1.08,.92,1.04,.86,1.1,.95])}],
  roads:[[[-150,2400],[-150,760],[-150,600],[-130,420],[-90,260],[-35,120]],
         [[-1000,2400],[-1000,760],[-1000,600],[-950,300],[-900,0],[-850,-350],[-800,-520]],
         [[2000,2400],[2000,760],[2000,468],[1800,120],[1590,-100],[1200,-220],[700,-260],[330,-230]],
         [[-1180,-850],[-500,-880],[200,-930],[900,-1060],[1450,-1250]],
         [[-380,-380],[-560,-520],[-700,-535]],
         [[-150,600],[-600,540],[-1200,520]]],
  plaza:[[-380,-330,200,90,'agora'],[-1100,-300,130,100,'tophet']],
  temples:[[-1100,-300,40,26,0],[-1060,-250,14,10,0],[-1140,-340,14,10,0],[-250,-520,42,28,-.1],[640,-400,30,20,.4],[-900,200,34,22,.05]],
  dist:[{k:'grid',p:byrsa.map(([x,y])=>[x*1.12,y*1.12]),ang:.1,bw:[30,36],bh:[60,90],dens:.95},
        {k:'grid',p:[[-1250,600],[1600,600],[1600,250],[-1340,250]],ang:0,bw:[36,42],bh:[100,150],dens:.95},
        {k:'grid',p:[[-1400,250],[-350,250],[-350,-1000],[-1600,-1000]],ang:.15,bw:[34,40],bh:[90,130],dens:.93},
        {k:'grid',p:[[-350,250],[600,250],[600,-1100],[-350,-1100]],ang:-.08,bw:[32,38],bh:[110,160],dens:.96},
        {k:'grid',p:[[600,250],[1600,250],[1600,-1400],[600,-1400]],ang:-.05,bw:[40,48],bh:[120,170],dens:.8,fill:.4},
        {k:'megara',p:[[1600,540],[3100,360],[3100,-2200],[1500,-1320],[1580,-200]],ang:-.12,bw:[140,200],bh:[110,170]}],
  fields:[[-600,1050,600,380,.02],[400,1100,600,400,-.03],[-500,1600,600,500,.05],[500,1700,600,450,.03],[1500,1150,700,420,-.05],[1600,1750,700,450,-.08]],
  labels:[['CARTHAGE',-600,420,22],['MÉGARA',2000,-700,17],['BYRSA',0,-280,13],['Lac de Tunis',-2250,900,16,1],['Mer',900,-1750,18,1],['Cothon',-700,-540,12,1],['port marchand',-1085,-440,11,1],['agora',-380,-280,11,1],['tophet',-1100,-250,11,1],
          ['triple muraille',500,690,11,1],['porte de Thapsus',-1000,640,11,1],['porte de Théveste',-150,640,11,1],["porte d'Utique",2000,510,11,1],['porte de la Nécropole',2800,415,11,1],['colline de Junon',600,-520,10,1],["colline de l'Odéon",1050,-250,10,1],['Bordj Djedid',1320,-1140,10,1]],
  txt:"Assaut de Carthage : la triple muraille barre l'isthme. Passez par la brèche, enfoncez une porte (Thapsus, Théveste, Utique) ou montez aux échelles. Les défenseurs tiennent le rempart : il faut les en déloger, puis prendre la Byrsa et la tenir une minute."}})(),
 rome:(()=>{
  // Repère du plan : origine = le Capitole ; +x = nord, +y = est (le plateau de l'Esquilin, d'où vient l'attaquant, comme Hannibal en 211).
  // Le Tibre et le Janicule sont donc derrière la ville (en haut de l'écran), le Champ de Mars au nord-ouest hors des murs.
  // Tracé relevé sur les plans envoyés par Baptiste (plan de Rome au 1:10 000, plans des IVe s. av. et apr. J.-C.) :
  // enceinte servienne irrégulière qui suit les crêtes (Quirinal, Viminal), l'agger rectiligne et son fossé en travers du plateau
  // de l'Esquilin (le seul côté sans pente : le front), le Cælius, l'Aventin, le Tibre entre l'Aventin et le Capitole.
  // T : coordonnées du plan papier (pixels, 5 m le pixel) → repère du plan (resserré : 2,4 unités le pixel).
  const T=(ix,iy)=>[Math.round(-(iy-570)*2.4),Math.round((ix-650)*2.4)],TT=a=>a.map(q=>T(q[0],q[1]));
  const front=TT([[962,190],[990,258],[1016,312],[1037,362],[1031,425],[1018,480],[1000,535],[983,580]]); // l'agger : porte Colline → porte Esquiline
  const north=TT([[612,620],[620,585],[632,548],[650,520],[680,494],[705,458],[722,420],[745,380],[780,318],[825,272],[870,240],[888,203],[925,188],[962,190]]);
  const south=TT([[983,580],[966,630],[955,680],[964,725],[958,765],[910,776],[860,779],[830,786],[800,802],[780,817],[767,842],[770,873],[757,913],[726,950],[700,962],[662,933],[630,908],[590,900],[553,887],[531,853],[533,817],[563,777],[582,745]]);
  const river=TT([[582,745],[596,700],[600,652],[612,620]]);
  const enclosure=front.concat(south.slice(1),river.slice(1),north.slice(1,-1));
  // le Tibre : axe relevé sur le plan, largeur ~130 m, élargi autour de l'île
  const axe=smooth([[300,-4000],[400,-1500],[430,-40],[445,80],[470,160],[474,230],[452,276],[400,296],[320,306],[280,332],[268,382],[286,442],[322,492],[372,532],[422,568],[472,592],[515,603],[552,613],[575,640],[581,682],[576,722],[556,757],[518,787],[470,822],[430,862],[400,905],[386,962],[381,1022],[386,1180],[430,2600],[520,5000]],4);
  const hw=i=>{const [x,y]=axe[i];return 12.5+Math.max(0,9-Math.hypot(x-540,y-617)/4)};
  const L1=[],L2=[];axe.forEach((q,i)=>{const a=axe[Math.max(0,i-1)],b=axe[Math.min(axe.length-1,i+1)],dx=b[0]-a[0],dy=b[1]-a[1],L=Math.hypot(dx,dy)||1,h=hw(i);L1.push([q[0]-dy/L*h,q[1]+dx/L*h]);L2.push([q[0]+dy/L*h,q[1]-dx/L*h])});
  const tibre=TT(L1.concat(L2.reverse()));
  const ile=TT([[516,619],[528,612],[548,614],[564,622],[566,630],[552,634],[532,631],[519,626]]);
  const pont=TT([[560,702],[598,698],[598,707],[560,711]]); // pont Sublicius, en bois, sous le Forum Boarium
  // fossé de l'agger (30 m de large) devant le front, interrompu devant les portes
  const gF=TT([[972,215],[1033,410],[990,560]]),ditch=[];
  {const N=front.length,nrm=front.map((q,i)=>{const a=front[Math.max(0,i-1)],b=front[Math.min(N-1,i+1)],L=Math.hypot(b[0]-a[0],b[1]-a[1]);let nx=-(b[1]-a[1])/L,ny=(b[0]-a[0])/L;return ny<0?[-nx,-ny]:[nx,ny]});
   const S=[0];for(let i=1;i<N;i++)S.push(S[i-1]+Math.hypot(front[i][0]-front[i-1][0],front[i][1]-front[i-1][1]));
   const at=s=>{let i=0;while(i<N-2&&S[i+1]<s)i++;const t=(s-S[i])/(S[i+1]-S[i]||1),a=front[i],b=front[i+1],na=nrm[i],nb=nrm[i+1];return [a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t,na[0]+(nb[0]-na[0])*t,na[1]+(nb[1]-na[1])*t]};
   const sg=gF.map(([gx,gy])=>{let best=0,bd=1e9;for(let s=0;s<=S[N-1];s+=2){const q=at(s),d=Math.hypot(q[0]-gx,q[1]-gy);if(d<bd){bd=d;best=s}}return best}).sort((a,b)=>a-b);
   const cuts=[0].concat(sg.flatMap(v=>[v-30,v+30]),[S[N-1]]);
   for(let k=0;k<cuts.length;k+=2){const s0=Math.max(0,cuts[k]),s1=Math.min(S[N-1],cuts[k+1]);if(s1-s0<60)continue;const ss=[s0].concat(S.filter(v=>v>s0&&v<s1),[s1]);
     const pts=ss.map(at),inn=pts.map(q=>[q[0]+q[2]*46,q[1]+q[3]*46]),out=pts.map(q=>[q[0]+q[2]*78,q[1]+q[3]*78]);ditch.push(inn.concat(out.reverse()).map(p=>[Math.round(p[0]),Math.round(p[1])]))}}
  const H=(n,pts)=>{const p=TT(pts),xs=p.map(q=>q[0]),ys=p.map(q=>q[1]),x=(Math.min(...xs)+Math.max(...xs))/2,y=(Math.min(...ys)+Math.max(...ys))/2;return {x,y,rx:(Math.max(...xs)-Math.min(...xs))/2,ry:(Math.max(...ys)-Math.min(...ys))/2,n,p}};
  const P_=(ix,iy)=>T(ix,iy);
  const lab=(t,ix,iy,sz,it)=>{const [x,y]=T(ix,iy);return it?[t,x,y,sz,1]:[t,x,y,sz]};
  const tp=(ix,iy,w,h,a,r)=>{const [x,y]=T(ix,iy);return r?[x,y,w,h,a||0,1]:[x,y,w,h,a||0]};
  const fo=T(703,618),ci=T(703,757);
  return {n:'Rome',pt:{x:0,y:30,r:120,n:'le Capitole'},ext:[-1500,-1200,1800,2800],fx:440,defx:[-10,900],
  inside:enclosure,
  water:[{k:'fleuve',n:'Tibre',p:tibre,holes:[ile,pont],island:ile,bridges:[pont]}],
  walls:[
   {k:'mur',c:15,t:120,wb:48,p:front}, // l'agger : levée de terre large d'une trentaine de mètres, mur de tuf sur sa face
   {k:'mur',c:10,t:150,p:north},
   {k:'mur',c:10,t:150,p:south},
   {k:'mur',c:8,t:160,p:river},
   {k:'citadelle',c:12,t:0,closed:1,p:TT([[634,602],[638,567],[648,542],[664,528],[682,528],[690,546],[678,571],[672,600],[662,622],[644,627]])}],
  gates:[{w:0,...pg(972,215),n:'porte Colline'},{w:0,...pg(1033,410),n:'porte Viminale'},{w:0,...pg(990,560),n:'porte Esquiline'},
         {w:1,...pg(780,318),n:'porte Quirinale'},{w:1,...pg(722,420),n:'porte Salutaire'},{w:1,...pg(680,494),n:'porte Fontinale'},
         {w:2,...pg(958,745),n:'porte Cælimontane'},{w:2,...pg(800,802),n:'porte Capène'},{w:2,...pg(757,913),n:'porte Raudusculane'},{w:2,...pg(590,900),n:'porte Lavernale'},
         {w:3,...pg(588,725),n:'porte Trigémine'},{w:3,...pg(604,640),n:'porte Carmentale'},
         {w:4,...pg(676,585),n:'porte du Capitole'}],
  breaches:[[0,...T(1028,465)],[0,...T(1004,285)],[0,...T(1037,350)]],
  ditch,
  hills:[H('CAPITOLE',[[615,600],[622,560],[640,525],[668,512],[692,530],[686,560],[672,586],[668,615],[646,632],[620,626]]),
         H('PALATIN',[[655,662],[690,632],[731,640],[760,661],[776,700],[762,744],[736,764],[700,746],[668,716],[652,690]]),
         H('AVENTIN',[[545,792],[575,752],[612,742],[652,770],[690,800],[722,830],[748,878],[742,921],[702,942],[642,926],[600,902],[560,862]]),
         H('CÆLIUS',[[822,760],[836,722],[880,702],[960,690],[1012,705],[1022,742],[982,770],[920,790],[860,795]]),
         H('ESQUILIN',[[838,595],[862,552],[915,545],[960,520],[1000,500],[1010,560],[990,605],[945,648],[900,640],[862,622]]),
         H('',[[900,470],[948,425],[1000,392],[1028,420],[1018,470],[972,500],[920,510]]),
         H('VIMINAL',[[822,470],[860,402],[910,333],[958,292],[990,302],[976,342],[930,402],[886,462],[846,492]]),
         H('QUIRINAL',[[722,382],[762,332],[820,282],[888,224],[948,193],[984,212],[950,242],[892,292],[842,352],[802,402],[772,442],[737,432]]),
         H('',[[175,340],[220,330],[255,420],[262,550],[252,700],[240,762],[210,742],[190,600],[170,460]]),
         H('',[[720,170],[780,130],[900,100],[960,130],[930,170],[830,195],[760,215]])],
  roads:[TT([[1300,620],[1060,590],[990,560],[930,575],[870,590],[810,605],[768,625],[730,620],[700,605],[676,585]]), // de la porte Esquiline au Capitole (Clivus Suburanus, Voie Sacrée)
         TT([[1800,140],[1300,190],[1060,210],[972,215],[900,262],[835,318],[785,372],[752,428],[728,488],[706,548],[700,600]]), // voie Nomentane, Alta Semita
         TT([[1800,420],[1300,412],[1100,410],[1033,410],[960,445],[880,500],[805,560],[752,598]]), // vicus Patricius
         TT([[800,802],[770,770],[757,720],[760,668],[768,625]]),
         TT([[800,802],[835,860],[870,930],[905,1010],[930,1180]]), // voie Appienne
         TT([[958,745],[1040,760],[1300,800],[1800,860]]),
         TT([[588,725],[610,735],[650,742]])],
  plaza:[[fo[0],fo[1],118,46,'forum',2.0],[...T(612,698),84,52,'forum Boarium',1.75]],
  circus:[ci[0],ci[1],250,58,2.09],
  temples:[tp(670,608,30,20,2.0),tp(712,632,30,20,2.0),tp(724,626,15,15,0,1),tp(733,621,18,12,2.0),tp(700,700,30,20,.5),tp(620,832,40,26,-.4),tp(662,768,28,18,2.09),tp(792,368,36,24,.8),tp(746,415,26,18,.8),tp(542,623,22,14,2.9)],
  dist:[{k:'grid',p:TT([[700,600],[760,520],[850,440],[950,390],[1005,430],[985,505],[910,540],[830,585],[765,615]]),ang:1.0,bw:[28,34],bh:[54,80],dens:.97,jit:.16}, // Subure, Argilète
        {k:'grid',p:TT([[625,560],[690,470],[750,370],[850,262],[950,198],[990,255],[905,325],[825,425],[765,505],[705,575]]),ang:.62,bw:[32,38],bh:[60,90],dens:.9,jit:.2}, // Quirinal, Viminal
        {k:'grid',p:TT([[820,600],[900,560],[1000,470],[1036,380],[1022,500],[990,580],[960,650],[900,665],[840,630]]),ang:.25,bw:[36,44],bh:[80,120],dens:.85,fill:.55,jit:.2}, // Esquilin : jardins derrière l'agger
        {k:'grid',p:TT([[640,650],[700,620],[790,630],[835,690],[862,722],[832,782],[790,800],[740,790],[690,745],[650,700]]),ang:1.25,bw:[30,36],bh:[60,85],dens:.95,jit:.18}, // Vélabre, Palatin, Vélia
        {k:'grid',p:TT([[770,640],[830,600],[900,585],[960,600],[962,660],[955,690],[900,700],[850,712],[800,690]]),ang:.75,bw:[30,36],bh:[56,80],dens:.92,jit:.22}, // Carènes, Oppius
        {k:'grid',p:TT([[840,470],[900,390],[960,300],[1000,290],[1030,330],[1020,400],[960,430],[900,480],[860,500]]),ang:.4,bw:[34,42],bh:[70,100],dens:.85,fill:.6,jit:.2}, // Viminal
        {k:'grid',p:TT([[835,705],[905,690],[962,680],[968,765],[880,780],[830,786]]),ang:-.15,bw:[36,44],bh:[70,110],dens:.8,fill:.6,jit:.25}, // Cælius
        {k:'grid',p:TT([[535,800],[575,755],[640,770],[705,815],[770,860],[760,925],[700,960],[640,915],[560,890]]),ang:-.55,bw:[34,42],bh:[70,100],dens:.85,fill:.65,jit:.25}], // Aventin, la plèbe
  fields:[[...T(470,420),330,280,.05],[...T(518,300),240,200,-.1],[...T(330,175),300,220,.1],
          [-900,1300,480,360,.04],[-350,1350,500,380,-.03],[300,1500,480,360,.05],[900,1400,460,360,-.04],[1400,1350,440,340,.06],
          [-950,1850,520,420,-.05],[-350,1900,520,420,.03],[300,2000,520,420,-.06],[950,1900,500,420,.04],[1450,1850,480,400,-.03],
          [-900,2450,520,420,.05],[-250,2450,520,420,-.04],[400,2500,520,420,.03],[1100,2450,520,420,-.02]],
  labels:[lab('ROME',860,560,22),lab('CAPITOLE',616,560,12),lab('PALATIN',724,690,12),lab('AVENTIN',648,852,12),lab('CÆLIUS',905,735,12),lab('ESQUILIN',935,600,12),lab('VIMINAL',905,385,11),lab('QUIRINAL',830,315,11),
          lab('forum',703,646,11,1),lab('Grand Cirque',703,782,11,1),lab('forum Boarium',612,716,10,1),lab('Tibre',405,575,16,1),lab('île Tibérine',540,600,10,1),lab('pont Sublicius',555,690,10,1),lab('Champ de Mars',470,420,15,1),lab('Janicule',215,545,13,1),
          lab('agger de Servius',1085,300,11,1),lab('porte Colline',1010,212,11,1),lab('porte Viminale',1075,410,11,1),lab('porte Esquiline',1035,560,11,1),lab('porte Capène',818,835,10,1),lab('porte Cælimontane',1000,745,10,1)],
  txt:"Assaut de Rome : l'agger de Servius et son fossé barrent le plateau de l'Esquilin. Passez par la brèche, enfoncez une porte (Colline, Viminale, Esquiline) ou montez aux échelles. Les défenseurs tiennent le rempart : il faut les en déloger, puis prendre le Capitole et le tenir une minute."};
  function pg(ix,iy){const [x,y]=T(ix,iy);return {x,y}}})()
,
 massalia:(()=>{
  // Repère du plan : origine = l'acropole (temple d'Apollon) ; l'attaquant vient du nord-est, par la terre (comme César en 49) :
  // +y = nord-est, +x = nord-ouest. La mer est à droite (ouest et nord-ouest), le Lacydon (le port) à gauche et derrière.
  // Tracé relevé sur le plan envoyé par Baptiste (acropole, agora, théâtre, arsenal, temples d'Apollon et d'Artémis)
  // et sur la vue générale de Massalia aux IIIe-IIe s. av. J.-C. : vieille ville serrée le long du port, loges à navires,
  // grande porte à tours au fond du port, mur de terre qui monte sur les collines, quartier en damier au nord-est, pentes boisées.
  const K=1.4,ux=.7071,uy=-.7071,vx=uy,vy=-ux,O=[442,400];
  const T=(ix,iy)=>{const dx=ix-O[0],dy=iy-O[1];return [Math.round(K*(dx*vx+dy*vy)),Math.round(K*(dx*ux+dy*uy))]},TT=a=>a.map(q=>T(q[0],q[1]));
  const A=(dx,dy)=>Math.atan2(dx*ux+dy*uy,dx*vx+dy*vy); // direction sur le plan papier → angle du repère
  const ip=(x,y,p)=>{let c=false;for(let i=0,j=p.length-1;i<p.length;j=i++){const xi=p[i][0],yi=p[i][1],xj=p[j][0],yj=p[j][1];if((yi>y)!==(yj>y)&&x<(xj-xi)*(y-yi)/(yj-yi)+xi)c=!c}return c};
  const frontI=[[405,90],[460,98],[520,115],[600,148],[660,175],[712,210],[760,250],[800,295],[822,348],[838,408],[846,440]];
  const harbourI=[[846,440],[836,456],[820,482],[802,522],[786,560],[770,565],[764,540],[756,518],[738,500],[716,490],[680,488],[620,490],[600,496],[588,508],[560,496],[530,496],[520,514],[490,512],[468,517],[440,540],[402,546],[380,551],[362,563],[348,551],[330,536],[318,532],[304,560],[296,600],[274,615],[238,630],[192,650],[160,680]];
  const westI=[[160,680],[120,652],[100,612],[100,580],[140,560],[160,540],[186,505],[215,466],[240,450],[260,410],[265,350],[275,300],[268,242],[296,256],[326,270],[356,262],[385,250],[388,200],[380,152],[346,140],[352,110],[376,96],[382,80],[405,90]];
  const front=TT(frontI),harbour=TT(harbourI),west=TT(westI);
  const enclosure=front.concat(harbour.slice(1),west.slice(1,-1));
  const merI=[[-2000,-2000],[470,-2000],[478,-400],[466,-150],[456,0],[446,44],[420,74]].concat(westI.slice().reverse().slice(1),harbourI.slice().reverse().slice(1),
    [[850,445],[862,470],[876,560],[902,610],[942,660],[982,730],[992,780],[972,810],[840,800],[700,782],[620,786],[500,770],[400,822],[290,870],[250,820],[215,745],[180,740],[160,800],[130,830],[80,800],[50,720],[0,686],[-2000,680]]);
  const mer=TT(merI);
  const H=(n,pts)=>{const p=TT(pts),xs=p.map(q=>q[0]),ys=p.map(q=>q[1]),x=(Math.min(...xs)+Math.max(...xs))/2,y=(Math.min(...ys)+Math.max(...ys))/2;return {x,y,rx:(Math.max(...xs)-Math.min(...xs))/2,ry:(Math.max(...ys)-Math.min(...ys))/2,n,p}};
  const lab=(t,ix,iy,sz,it)=>{const [x,y]=T(ix,iy);return it?[t,x,y,sz,1]:[t,x,y,sz]};
  const tp=(ix,iy,w,h,dx,dy,r)=>{const [x,y]=T(ix,iy);return r?[x,y,w,h,0,1]:[x,y,w,h,A(dx,dy)]};
  const pg=(ix,iy)=>{const [x,y]=T(ix,iy);return {x,y}};
  // champs hors les murs, au nord-est : seulement sur la terre ferme, loin du mur
  const fields=[];for(let y=520;y<1900;y+=330)for(let x=-1300;x<1400;x+=360){const fx=x+((y/330|0)%2)*150,w=300+((x*7+y)%5)*14,h=250+((x+y*3)%4)*15,c=[[fx-w/2,y-h/2],[fx+w/2,y-h/2],[fx+w/2,y+h/2],[fx-w/2,y+h/2]];
    if(c.some(q=>ip(q[0],q[1],mer)||ip(q[0],q[1],enclosure))||c.some(q=>front.some(f=>Math.hypot(f[0]-q[0],f[1]-q[1])<170)))continue;fields.push([fx,y,w,h,((x+y)%7-3)*.015])}
  const ag=T(392,500),th=T(296,494),ar=T(655,462);
  return {n:'Massalia',pt:{x:0,y:0,r:110,n:"l'acropole"},ext:[-1500,-1300,1500,2000],fx:-10,
  inside:enclosure,
  water:[{k:'mer',n:'Mer',p:mer}],
  walls:[
   {k:'mur',c:15,t:110,wb:44,p:front}, // le mur de terre, en grand appareil, que César assiégea
   {k:'mur',c:9,t:140,wb:14,p:harbour},       // le mur du port, sur les quais du Lacydon
   {k:'mur',c:9,t:150,wb:16,p:west},          // le mur de mer
   {k:'citadelle',c:12,t:0,closed:1,p:TT([[388,452],[394,414],[406,378],[426,350],[460,342],[492,348],[494,366],[474,396],[458,422],[438,446],[410,460]])}],
  gates:[{w:0,...pg(836,418),n:"porte d'Italie"},{w:0,...pg(600,148),n:"porte d'Aix"},{w:0,...pg(760,250),n:'porte des Carmes'},
         {w:1,...pg(650,489),open:1,wide:1},{w:1,...pg(430,544),open:1,wide:1},{w:1,...pg(250,626),open:1},
         {w:2,...pg(270,282),n:'porte de la mer'},
         {w:3,...pg(452,432),n:"porte de l'acropole"}],
  breaches:[[0,...T(712,210)],[0,...T(822,348)],[0,...T(520,115)]],
  hills:[H('ACROPOLE',[[370,470],[375,400],[400,345],[440,320],[500,325],[526,356],[506,400],[470,440],[430,470],[395,480]]),
         H('',[[218,470],[250,430],[290,412],[322,430],[322,470],[290,500],[250,500]]),
         H('',[[598,232],[640,200],[702,214],[732,260],[712,302],[660,312],[615,286]])],
  roads:[TT([[1300,330],[1000,400],[880,418],[836,418],[790,428],[720,436],[620,440],[540,446],[490,462],[452,432]]),
         TT([[1100,-500],[800,-150],[650,80],[600,148],[570,210],[535,270],[505,318]]),
         TT([[1300,-80],[1000,120],[800,215],[760,250],[700,290],[620,330],[520,360]]),
         TT([[452,432],[420,470],[392,500],[330,505],[270,470],[215,466]])],
  plaza:[[ag[0],ag[1],70,48,'agora',A(1,-.2)]],
  blds:[[th[0],th[1],52,52,A(-.3,1)+Math.PI/2,'theatre'],[ar[0],ar[1],150,34,A(1,0),'neoria']],
  temples:[tp(685,258,40,22,30,35),tp(560,470,22,14,1,0),tp(330,470,20,13,1,.3),tp(740,320,24,16,1,1),tp(240,600,18,12,1,-.4)],
  dist:[{k:'grid',p:TT([[110,600],[180,520],[230,460],[300,420],[360,440],[380,470],[430,476],[470,446],[520,420],[600,418],[700,418],[800,408],[832,444],[800,520],[770,565],[740,500],[600,490],[470,514],[400,546],[330,536],[300,600],[240,632],[160,676]]),ang:A(1,-.15),bw:[28,34],bh:[48,66],dens:.97,jit:.2}, // vieille ville, le long du port
        {k:'grid',p:TT([[268,250],[380,160],[420,110],[500,118],[560,160],[520,250],[480,320],[400,330],[340,380],[268,400]]),ang:A(1,.5),bw:[30,36],bh:[50,72],dens:.88,jit:.2}, // pentes nord-ouest
        {k:'grid',p:TT([[560,165],[650,170],[720,215],[795,292],[822,360],[760,385],[700,335],[620,305],[570,250]]),ang:A(.79,.62),bw:[30,34],bh:[56,64],dens:.92,fill:.8}, // quartier neuf en damier
        {k:'grid',p:TT([[515,330],[600,312],[700,332],[780,392],[800,410],[700,420],[600,420],[520,420],[505,380]]),ang:A(1,.3),bw:[32,40],bh:[56,84],dens:.85,fill:.6,jit:.22}, // jardins et villas sur les pentes
        {k:'grid',p:TT([[100,580],[160,540],[215,466],[250,432],[265,350],[275,300],[330,330],[340,400],[300,452],[240,470],[180,520],[110,600]]),ang:A(1,-1),bw:[28,34],bh:[46,66],dens:.9,jit:.22}],
  fields,
  labels:[lab('MASSALIA',600,400,22),lab('ACROPOLE',440,300,13),lab('Lacydon',650,640,17,1),lab('Mer',170,250,18,1),lab('agora',392,530,11,1),lab('théâtre',290,530,10,1),lab('loges à navires',655,500,10,1),
          lab("temple d'Artémis",690,290,10,1),lab('butte des Carmes',660,195,10,1),lab('butte Saint-Laurent',265,415,10,1),lab("porte d'Italie",880,400,11,1),lab("porte d'Aix",630,110,11,1),lab('porte des Carmes',800,225,10,1)],
  txt:"Assaut de Massalia : le mur de terre barre les collines au nord-est, la mer et le Lacydon gardent le reste. Passez par la brèche, enfoncez une porte (Italie, Aix, Carmes) ou montez aux échelles. Les défenseurs tiennent le rempart : il faut les en déloger, puis prendre l'acropole et la tenir une minute."}})()
,
 novacarthago:(()=>{
  // Repère du plan : origine = l'arx d'Hasdrubal (colline du Molinete) ; +x = nord (la lagune), +y = est (l'isthme, d'où vient l'attaquant,
  // comme Scipion en 209). La mer et le port sont au sud (à gauche), le chenal et son pont à l'ouest (derrière).
  // Tracé relevé sur la restitution de Carthago Nova (Ier s.) et la vue VirTimePlace envoyées par Baptiste, ramené à la ville barcide
  // (pas d'amphithéâtre ni de théâtre, qui sont romains) : presqu'île entre la lagune et le port, cinq collines (Esculape, Aletes,
  // Vulcain, Saturne, l'arx d'Hasdrubal), un seul front de terre sur l'isthme, à l'est.
  const K=1.6,O=[330,95],T=(ix,iy)=>[Math.round(-(iy-O[1])*K),Math.round((ix-O[0])*K)],TT=a=>a.map(q=>T(q[0],q[1]));
  const A=(dx,dy)=>Math.atan2(dx,-dy);
  const frontI=[[505,50],[530,72],[548,98],[566,128],[580,160],[592,196],[598,236],[600,276]];
  const southI=[[600,276],[590,300],[560,332],[522,368],[482,400],[442,424],[410,434],[380,430],[342,416],[300,396],[262,380],[222,352],[182,322],[142,300],[112,282],[95,265]];
  const westI=[[95,265],[98,240],[100,205],[110,190]];
  const northI=[[110,190],[126,184],[160,174],[184,150],[204,112],[226,100],[260,86],[300,76],[330,74],[350,62],[380,46],[420,40],[462,38],[505,50]];
  const front=TT(frontI),south=TT(southI),west=TT(westI),north=TT(northI);
  const enclosure=front.concat(south.slice(1),west.slice(1),north.slice(1,-1));
  const lagune=TT([[110,190]].concat(northI.slice(1),smooth([[505,50],[560,62],[640,96],[700,108],[760,102],[830,84],[890,40],[930,-30],[925,-110],[880,-185],[780,-240],[640,-268],[500,-262],[360,-248],[240,-212],[130,-160],[60,-90],[24,-10],[28,80],[44,140],[60,172]],4),[[62,215],[100,215],[100,205]]));
  const mer=TT([[100,214],[98,240],[95,265]].concat(southI.slice().reverse().slice(1),smooth([[600,276],[640,270],[700,276],[780,290],[860,312],[960,340],[1100,380],[1250,410],[1400,430]],4),[[1400,1300],[-800,1300]],smooth([[-800,330],[-500,345],[-250,340],[-80,330],[10,324],[44,312],[60,290],[64,262]],4),[[62,240],[62,214]])); // la mer rejoint la lagune par le chenal, sous le pont
  const pont=TT([[56,236],[102,236],[102,246],[56,246]]);
  const H=(n,pts)=>{const p=TT(pts),xs=p.map(q=>q[0]),ys=p.map(q=>q[1]),x=(Math.min(...xs)+Math.max(...xs))/2,y=(Math.min(...ys)+Math.max(...ys))/2;return {x,y,rx:(Math.max(...xs)-Math.min(...xs))/2,ry:(Math.max(...ys)-Math.min(...ys))/2,n,p}};
  const lab=(t,ix,iy,sz,it)=>{const [x,y]=T(ix,iy);return it?[t,x,y,sz,1]:[t,x,y,sz]};
  const tp=(ix,iy,w,h,dx,dy)=>{const [x,y]=T(ix,iy);return [x,y,w,h,A(dx,dy)]};
  const pg=(ix,iy)=>{const [x,y]=T(ix,iy);return {x,y}};
  const ag=T(236,246),nv=T(196,322),ip=(x,y,p)=>{let c=false;for(let i=0,j=p.length-1;i<p.length;j=i++){const xi=p[i][0],yi=p[i][1],xj=p[j][0],yj=p[j][1];if((yi>y)!==(yj>y)&&x<(xj-xi)*(y-yi)/(yj-yi)+xi)c=!c}return c};
  const fields=[];for(let y=700;y<1700;y+=300)for(let x=-900;x<700;x+=330){const w=280,h=230,c=[[x-w/2,y-h/2],[x+w/2,y-h/2],[x+w/2,y+h/2],[x-w/2,y+h/2]];
    if(c.some(q=>ip(q[0],q[1],mer)||ip(q[0],q[1],lagune)||ip(q[0],q[1],enclosure))||c.some(q=>front.some(f=>Math.hypot(f[0]-q[0],f[1]-q[1])<180)))continue;fields.push([x,y,w,h,((x+y)%5-2)*.02])}
  return {n:'Nova Carthago',pt:{x:0,y:0,r:100,n:"l'arx d'Hasdrubal"},ext:[-1300,-950,700,1700],fx:-160,defx:[-420,180],
  inside:enclosure,
  water:[{k:'mer',n:'Mer',p:mer,holes:[pont],bridges:[pont]},{k:'lac',n:'Lagune',p:lagune}], // le chenal entre la mer et la lagune, sous le pont
  walls:[
   {k:'mur',c:15,t:100,wb:44,p:front}, // le mur de l'isthme, le seul côté par la terre
   {k:'mur',c:9,t:140,wb:14,p:south},  // le mur du port
   {k:'mur',c:8,t:120,wb:14,p:west},   // sur le chenal
   {k:'mur',c:7,t:150,wb:14,p:north},  // le mur de la lagune, bas : Scipion le prit à marée basse
   {k:'citadelle',c:12,t:0,closed:1,p:TT([[294,104],[302,90],[318,82],[338,80],[356,78],[364,90],[358,104],[340,112],[318,114],[302,112]])}],
  gates:[{w:0,...pg(586,176),n:"porte de l'isthme"},{w:1,...pg(300,396),open:1,wide:1},{w:1,...pg(200,336),open:1},{w:2,...pg(99,241),n:'porte du pont'},{w:3,...pg(204,112),n:'porte de la lagune'},
         {w:4,...pg(330,112),n:"porte de l'arx"}],
  breaches:[[0,...T(556,112)],[0,...T(597,226)],[0,...T(538,84)]],
  hills:[H('ARX',[[278,106],[292,84],[328,74],[356,66],[374,82],[366,108],[336,122],[300,120]]),
         H('',[[420,56],[468,46],[506,56],[520,82],[496,106],[452,106],[426,86]]),
         H('',[[518,120],[560,120],[584,160],[572,196],[540,192],[520,160]]),
         H('',[[538,232],[580,226],[594,266],[570,292],[540,282]]),
         H('',[[398,302],[440,272],[500,262],[540,292],[540,342],[500,382],[450,412],[410,402],[394,352]])],
  roads:[TT([[1400,170],[900,174],[700,176],[586,176],[520,196],[450,190],[400,150],[360,118],[330,112]]),
         TT([[99,241],[180,236],[260,226],[340,212],[420,200],[520,196]]),
         TT([[300,396],[300,330],[290,260],[300,180],[300,130]]),
         TT([[99,241],[20,242],[-200,250]])],
  plaza:[[ag[0],ag[1],92,52,'agora',A(1,-.55)]],
  blds:[[nv[0],nv[1],130,30,A(1,.72),'neoria']],
  temples:[tp(468,332,40,24,1,-.55),tp(462,74,26,16,1,0),tp(552,158,26,16,0,1),tp(566,258,26,16,1,.3),tp(250,240,26,16,1,-.55)],
  dist:[{k:'grid',p:TT([[112,200],[200,142],[262,108],[292,124],[378,120],[420,110],[506,112],[520,160],[522,232],[470,262],[400,292],[392,352],[330,392],[262,378],[172,322],[112,282]]),ang:A(1,-.55),bw:[28,34],bh:[56,76],dens:.96,jit:.1},
        {k:'grid',p:TT([[500,108],[562,118],[592,190],[598,262],[542,302],[522,232]]),ang:A(1,.2),bw:[34,42],bh:[60,90],dens:.75,fill:.5,jit:.2},
        {k:'grid',p:TT([[392,300],[440,270],[500,262],[542,296],[540,342],[500,382],[446,416],[404,404],[390,352]]),ang:A(1,-.3),bw:[34,40],bh:[56,84],dens:.75,fill:.45,jit:.22}],
  fields,
  labels:[lab('NOVA CARTHAGO',360,235,22),lab('ARX',330,140,12),lab("palais d'Hasdrubal",330,60,10,1),lab("colline d'Esculape",470,360,10,1),lab("colline d'Aletes",465,32,10,1),lab('colline de Vulcain',540,130,10,1),lab('colline de Saturne',560,300,10,1),
          lab('Lagune',400,-90,18,1),lab('Mer',300,560,18,1),lab('port',230,420,13,1),lab('agora',236,276,11,1),lab('loges à navires',196,346,10,1),lab("porte de l'isthme",640,176,11,1),lab('isthme',760,190,13,1),lab('pont',78,226,10,1)],
  txt:"Assaut de Nova Carthago : la ville tient une presqu'île entre la lagune et la mer ; seul l'isthme, à l'est, y mène par la terre. Passez par la brèche, enfoncez la porte de l'isthme ou montez aux échelles. Les défenseurs tiennent le rempart : il faut les en déloger, puis prendre l'arx d'Hasdrubal et la tenir une minute."}})()
,
 sagonte:(()=>{
  // Repère du plan : origine = la citadelle (place d'Armas, au bout est de la crête) ; l'attaquant vient de l'ouest, comme Hannibal en 219
  // (Tite-Live : l'angle du mur qui regarde une vallée plus plate) : +y = ouest, +x = sud. Le Palancia coule au nord (à gauche).
  // Tracé relevé sur le plan de Sagonte (A. Romaní) envoyé par Baptiste : l'oppidum ibère tient toute la crête du Castillo,
  // longue d'un kilomètre ; les pentes sont raides partout sauf au bout ouest, où se fait l'assaut.
  const K=1.6,O=[910,820],T=(ix,iy)=>[Math.round(K*(iy-O[1])),Math.round(K*(O[0]-ix))],TT=a=>a.map(q=>T(q[0],q[1]));
  const A=(dx,dy)=>Math.atan2(-dx,dy);
  const ip=(x,y,p)=>{let c=false;for(let i=0,j=p.length-1;i<p.length;j=i++){const xi=p[i][0],yi=p[i][1],xj=p[j][0],yj=p[j][1];if((yi>y)!==(yj>y)&&x<(xj-xi)*(y-yi)/(yj-yi)+xi)c=!c}return c};
  const frontI=[[446,768],[424,734],[392,712],[352,706],[325,722],[340,756],[372,786],[400,822],[436,832]];
  const southI=[[436,832],[476,846],[520,872],[574,884],[640,882],[706,888],[770,896],[826,884],[890,898],[956,888],[1012,868],[1030,826]];
  const northI=[[1030,826],[998,786],[958,766],[910,740],[882,708],[850,712],[822,730],[800,742],[760,722],[712,735],[690,780],[664,792],[606,798],[548,794],[492,786],[446,768]];
  const front=TT(frontI),south=TT(southI),north=TT(northI),enclosure=front.concat(south.slice(1),north.slice(1,-1));
  // le Palancia : lit de galets, eau au milieu
  const axe=smooth([[-300,420],[0,380],[80,330],[150,250],[300,150],[500,112],[700,108],[790,118],[900,168],[1050,230],[1200,272],[1400,340],[1700,420]],4);
  const band=(h)=>{const L1=[],L2=[];axe.forEach((q,i)=>{const a=axe[Math.max(0,i-1)],b=axe[Math.min(axe.length-1,i+1)],dx=b[0]-a[0],dy=b[1]-a[1],L=Math.hypot(dx,dy)||1;L1.push([q[0]-dy/L*h,q[1]+dx/L*h]);L2.push([q[0]+dy/L*h,q[1]-dx/L*h])});return TT(L1.concat(L2.reverse()))};
  const riv=band(8);
  const H=(n,pts)=>{const p=TT(pts),xs=p.map(q=>q[0]),ys=p.map(q=>q[1]),x=(Math.min(...xs)+Math.max(...xs))/2,y=(Math.min(...ys)+Math.max(...ys))/2;return {x,y,rx:(Math.max(...xs)-Math.min(...xs))/2,ry:(Math.max(...ys)-Math.min(...ys))/2,n,p}};
  const lab=(t,ix,iy,sz,it)=>{const [x,y]=T(ix,iy);return it?[t,x,y,sz,1]:[t,x,y,sz]};
  const tp=(ix,iy,w,h,dx,dy)=>{const [x,y]=T(ix,iy);return [x,y,w,h,A(dx,dy)]};
  const pg=(ix,iy)=>{const [x,y]=T(ix,iy);return {x,y}};
  // le lit de galets du Palancia, large, avec le chenal d'eau qui y serpente
  const bedAxe=smooth([[-6000,1400],[-3000,920],[-300,470],[0,420],[80,380],[200,230],[350,150],[550,110],[700,95],[800,130],[900,200],[1050,260],[1200,300],[1400,350],[1700,420],[4500,1070],[8000,1900]],4);
  const bandOf=(axe,h,wob)=>{const L1=[],L2=[];axe.forEach((q,i)=>{const a=axe[Math.max(0,i-1)],b=axe[Math.min(axe.length-1,i+1)],dx=b[0]-a[0],dy=b[1]-a[1],L=Math.hypot(dx,dy)||1,h1=h*(1+wob*Math.sin(i*1.7)),h2=h*(1+wob*Math.cos(i*1.3));L1.push([q[0]-dy/L*h1,q[1]+dx/L*h1]);L2.push([q[0]+dy/L*h2,q[1]-dx/L*h2])});return TT(L1.concat(L2.reverse()))};
  const lit=bandOf(bedAxe,38,.25),chan=bandOf(bedAxe.map((q,i)=>{const j=Math.min(bedAxe.length-1,i+1),k=Math.max(0,i-1),dx=bedAxe[j][0]-bedAxe[k][0],dy=bedAxe[j][1]-bedAxe[k][1],L=Math.hypot(dx,dy)||1,o=20*Math.sin(i*.45);return [q[0]-dy/L*o,q[1]+dx/L*o]}),7,.2);
  // le massif du Castillo : la crête et ses pentes, laissées aux broussailles, aux rochers et aux terrasses
  const castilloI=[[250,640],[300,560],[400,520],[520,560],[640,630],[760,645],[880,650],[1000,690],[1110,750],[1140,860],[1080,950],[920,990],[700,990],[500,975],[350,930],[270,850],[235,740]];
  return {n:'Sagonte',pt:{x:0,y:0,r:80,n:'la citadelle'},ext:[-1400,-1000,800,2600],fx:-76,defx:[-320,170],
  inside:enclosure,
  water:[{k:'fleuve',n:'Palancia',p:chan}],
  walls:[
   {k:'mur',c:16,t:70,wb:40,p:front},   // le bout ouest de la crête, le seul abordable : tours serrées
   {k:'mur',c:18,t:105,wb:24,p:south},  // en haut de pentes raides
   {k:'mur',c:18,t:105,wb:24,p:north},
   {k:'citadelle',c:12,t:0,closed:1,p:TT([[852,792],[880,764],[922,770],[962,796],[972,838],[940,866],[892,872],[858,850]])}],
  gates:[{w:0,...pg(330,738),n:"porte de l'ouest"},{w:2,...pg(760,722),n:'porte du Palancia'},{w:1,...pg(706,888),n:'porte du sud'},{w:3,...pg(856,822),n:'porte de la citadelle'}],
  breaches:[[0,...T(372,786)],[0,...T(392,712)],[0,...T(400,822)]],
  hills:[H('',[[300,722],[340,690],[420,700],[460,750],[560,770],[680,770],[720,710],[800,715],[880,690],[960,740],[1050,800],[1050,870],[960,910],[820,910],[640,905],[500,895],[420,850],[350,800]]),
         H('',[[600,800],[700,792],[760,770],[830,760],[900,780],[920,840],[860,870],[760,880],[640,870]]),
         H('',[[180,600],[260,560],[340,600],[360,680],[300,700],[220,690]])],
  roads:[TT([[-400,700],[100,720],[250,735],[330,738],[400,770],[470,812],[560,836],[660,842],[760,838],[856,822]]),
         TT([[760,722],[740,640],[700,520],[680,300],[700,108]]),
         TT([[-300,520],[200,540],[600,560],[1000,560],[1400,620],[1700,700]])],
  plaza:[],
  temples:[tp(600,840,28,18,1,.05),tp(800,820,22,14,1,0),tp(500,820,20,13,1,.2)],
  dist:[{k:'grid',p:TT([[330,722],[400,716],[450,772],[560,796],[690,786],[714,738],[790,744],[850,716],[880,712],[900,744],[900,880],[830,886],[700,890],[560,886],[470,848],[400,820],[345,760]]),ang:A(1,.05),bw:[30,38],bh:[44,62],dens:.97,jit:.25}],
  fields:[],country:{ang:A(1,.1),tombs:380,farms:.12,mix:{ble:.22,orge:.1,jachere:.08,vigne:.22,olive:.3,pre:.08},wild:[TT(castilloI),lit],beds:[lit],
    relief:[H('',castilloI),H('',[[560,700],[700,690],[860,690],[980,730],[1060,800],[1050,890],[900,930],[700,930],[560,910],[420,860],[380,790],[440,720]])]},
  labels:[lab('SAGONTE',640,836,20),lab('Palancia',600,90,15,1),lab('citadelle',915,775,11,1),lab("porte de l'ouest",280,742,11,1),lab('crête du Castillo',600,985,11,1),lab("temple d'Artémis",600,862,10,1)],
  txt:"Assaut de Sagonte : l'oppidum tient une crête longue et raide ; seul son bout ouest se laisse approcher. Passez par la brèche, enfoncez la porte de l'ouest ou montez aux échelles. Les défenseurs tiennent le rempart : il faut les en déloger, puis prendre la citadelle et la tenir une minute."}})()
,
 tarente:(()=>{
  // Repère du plan : origine = l'acropole, à la pointe de la presqu'île ; l'attaquant vient de la terre, au sud-est (comme Hannibal en 212,
  // par la porte Témenide) : +y = vers le mur de terre. La Mare Grande est à gauche, la Mare Piccolo à droite, le chenal en haut.
  // Tracé relevé sur le plan de Taras envoyé par Baptiste (M. Todaro) : acropole étroite à la pointe, ville en damier le long
  // des voies Plateia et Batheia, puis la grande nécropole dans les murs (jardins, fours de potiers), mur de terre en travers de l'isthme.
  const K=1,O=[290,265],T=(ix,iy)=>[Math.round(K*(ix-O[0])),Math.round(K*(iy-O[1]))],TT=a=>a.map(q=>T(q[0],q[1]));
  const A=(dx,dy)=>Math.atan2(dy,dx);
  const ip=(x,y,p)=>{let c=false;for(let i=0,j=p.length-1;i<p.length;j=i++){const xi=p[i][0],yi=p[i][1],xj=p[j][0],yj=p[j][1];if((yi>y)!==(yj>y)&&x<(xj-xi)*(y-yi)/(yj-yi)+xi)c=!c}return c};
  const frontI=[[60,1075],[110,1122],[150,1170],[205,1225],[260,1290],[330,1370],[410,1450],[490,1420],[560,1390],[640,1356],[700,1330],[790,1292],[880,1255]];
  const eastI=[[880,1255],[862,1200],[822,1112],[790,1070],[740,1030],[690,990],[640,950],[600,910],[570,868],[546,820],[532,770],[522,720],[512,668],[494,620],[472,570],[450,520],[422,472],[392,432],[360,406],[330,396],[306,392],[312,330],[322,262],[334,200],[332,150],[302,128]];
  const westI=[[302,128],[264,140],[258,200],[256,250],[258,300],[262,345],[262,392],[258,420],[255,470],[250,520],[240,570],[230,620],[215,680],[200,740],[180,800],[160,860],[140,920],[110,980],[80,1040],[60,1075]];
  const front=TT(frontI),east=TT(eastI),west=TT(westI),enclosure=front.concat(east.slice(1),west.slice(1,-1));
  const nord=TT([[-200,-6000],[250,-300],[380,60],[420,40],[500,72],[600,92],[750,104],[924,112],[1500,120],[2400,180],[2480,-6000]]);
  const sud=TT([[-6000,1040],[-800,1120],[0,1135]].concat(frontI,[[924,1240],[1200,1290],[1500,1300],[2300,1260],[2600,1000],[2660,600],[2520,300],[2440,160],[2460,-6000],[7000,-6000],[7000,8000],[-6000,8000]])); // la Mare Piccolo se referme à l'est
  const mer=TT([[-6000,-6000],[7000,-6000],[7000,8000],[-6000,8000]]);
  const H=(n,pts)=>{const p=TT(pts),xs=p.map(q=>q[0]),ys=p.map(q=>q[1]),x=(Math.min(...xs)+Math.max(...xs))/2,y=(Math.min(...ys)+Math.max(...ys))/2;return {x,y,rx:(Math.max(...xs)-Math.min(...xs))/2,ry:(Math.max(...ys)-Math.min(...ys))/2,n,p}};
  const lab=(t,ix,iy,sz,it)=>{const [x,y]=T(ix,iy);return it?[t,x,y,sz,1]:[t,x,y,sz]};
  const tp=(ix,iy,w,h,dx,dy)=>{const [x,y]=T(ix,iy);return [x,y,w,h,A(dx,dy)]};
  const pg=(ix,iy)=>{const [x,y]=T(ix,iy);return {x,y}};
  const fields=[];for(let y=1100;y<2800;y+=280)for(let x=-800;x<1150;x+=300){const w=250,h=210,c=[[x-w/2,y-h/2],[x+w/2,y-h/2],[x+w/2,y+h/2],[x-w/2,y+h/2]];
    if(c.some(q=>!ip(q[0],q[1],sud)||ip(q[0],q[1],enclosure))||c.some(q=>front.some(f=>Math.hypot(f[0]-q[0],f[1]-q[1])<170)))continue;fields.push([x,y,w,h,((x+y*3)%7-3)*.02])}
  const ag=T(292,512),t1=T(295,578),t2=T(482,662),va=A(.38,.92);
  return {n:'Tarente',pt:{x:0,y:0,r:70,n:"l'acropole"},ext:[-1000,-560,1250,2900],fx:180,defx:[-180,540],
  inside:enclosure,town:TT([[258,392],[306,392],[330,396],[360,406],[392,432],[422,472],[450,520],[472,570],[494,620],[512,668],[522,720],[430,722],[330,745],[230,730],[215,680],[230,620],[240,570],[250,520],[255,470]]),
  water:[{k:'mer',n:'Mer',p:mer,holes:[enclosure,nord,sud],landHoles:1}],
  walls:[
   {k:'mur',c:15,t:110,wb:44,p:front}, // le mur de terre, en travers de l'isthme
   {k:'mur',c:9,t:150,wb:14,p:east},   // sur la Mare Piccolo, le port
   {k:'mur',c:9,t:150,wb:14,p:west},   // sur la Mare Grande
   {k:'citadelle',c:12,t:0,closed:1,p:TT([[270,168],[298,148],[322,166],[318,240],[310,318],[300,382],[272,384],[266,300],[264,222]])}],
  gates:[{w:0,...pg(640,1356),n:'porte Témenide'},{w:0,...pg(205,1225),n:'porte de Métaponte'},{w:0,...pg(790,1292),n:'porte de Brindes'},
         {w:1,...pg(512,668),open:1,wide:1},{w:1,...pg(422,472),open:1},{w:3,...pg(285,383),n:"porte de l'acropole"}],
  breaches:[[0,...T(410,1450)],[0,...T(110,1122)],[0,...T(720,1322)]],
  hills:[H('',[[262,170],[300,140],[326,170],[318,280],[304,380],[268,382],[262,280]])],
  roads:[TT([[720,2000],[690,1500],[640,1356],[600,1250],[540,1100],[480,940],[420,780],[370,620],[330,480],[300,420],[285,383]]),
         TT([[-100,1700],[100,1400],[205,1225],[230,1060],[250,900],[268,760]]),
         TT([[1100,1700],[900,1400],[790,1292],[700,1100],[600,900],[530,770]])],
  plaza:[[ag[0],ag[1],62,44,'agora',va]],
  blds:[[t1[0],t1[1],34,34,A(1,0)+Math.PI/2,'theatre'],[t2[0],t2[1],30,30,A(0,-1)+Math.PI/2,'theatre'],[...T(432,530),70,16,va,'neoria']],
  temples:[tp(312,428,40,18,1,0),tp(330,512,18,12,1,.5),tp(380,600,20,13,1,.2),tp(377,742,22,14,1,.4),tp(490,692,20,13,1,0),tp(222,688,18,12,1,0),tp(230,1018,22,30,.4,1),tp(652,1030,18,12,1,0)],
  dist:[{k:'grid',p:TT([[258,392],[306,392],[330,396],[360,406],[392,432],[422,472],[450,520],[472,570],[494,620],[512,668],[522,720],[430,722],[330,745],[230,730],[215,680],[230,620],[240,570],[250,520],[255,470]]),ang:va,bw:[30,36],bh:[34,44],dens:.98}, // la ville, en damier
        {k:'grid',any:1,p:TT([[230,730],[330,745],[430,722],[524,712],[540,800],[580,890],[660,960],[780,1060],[860,1200],[780,1280],[640,1340],[420,1420],[260,1270],[100,1100],[160,880],[200,780]]),ang:va,bw:[40,60],bh:[50,80],dens:.22,fill:.45,jit:.35}], // la nécropole et ses jardins
  fields:[],country:{ang:A(0,1),tombs:420,farms:.14,mix:{ble:.3,orge:.12,jachere:.1,vigne:.14,olive:.26,pre:.08}},
  labels:[lab('TARENTE',390,640,20),lab('ACROPOLE',220,260,12),lab('Mare Grande',60,600,17,1),lab('Mare Piccolo',720,700,17,1),lab('nécropole',480,1150,13,1),lab('agora',292,480,10,1),lab('porte Témenide',660,1400,11,1),lab('porte de Métaponte',170,1260,10,1),lab('porte de Brindes',830,1330,10,1)],
  txt:"Assaut de Tarente : la ville tient une presqu'île entre la Mare Grande et la Mare Piccolo ; le mur de terre barre l'isthme, derrière lui la grande nécropole. Passez par la brèche, enfoncez une porte (Témenide, Métaponte, Brindes) ou montez aux échelles, puis prenez l'acropole, à la pointe, et tenez-la une minute."}})()
,
 syracuse:(()=>{
  // Repère du plan : origine = Ortygie, l'île-citadelle ; l'attaquant vient du nord, par le plateau des Épipoles (comme Marcellus,
  // qui entra par l'Hexapyle en 212) : +y = nord. Le Grand Port est à gauche, la mer à droite, Ortygie en bas à gauche.
  // Tracé relevé sur les plans de Syracuse envoyés par Baptiste (« Veterum Syracusarum typus », plan de Le Bas, plan anglais) :
  // Ortygie reliée à la ville par une chaussée, Achradine serrée le long de la mer, Tyché et Néapolis au-dessus, le plateau
  // des Épipoles qui monte jusqu'au fort d'Euryale ; le mur de Denys suit le bord nord du plateau.
  const K=1.4,O=[360,690],T=(ix,iy)=>[Math.round(-(iy-O[1])*K),Math.round((ix-O[0])*K)],TT=a=>a.map(q=>T(q[0],q[1]));
  const A=(dx,dy)=>Math.atan2(dx,-dy);
  const ip=(x,y,p)=>{let c=false;for(let i=0,j=p.length-1;i<p.length;j=i++){const xi=p[i][0],yi=p[i][1],xj=p[j][0],yj=p[j][1];if((yi>y)!==(yj>y)&&x<(xj-xi)*(y-yi)/(yj-yi)+xi)c=!c}return c};
  const frontI=[[1020,50],[1012,120],[1010,200],[1005,300],[995,380],[978,440],[968,500],[975,560],[962,620],[992,668]];
  const seaI=[[992,668],[995,720],[985,780],[960,820],[920,860],[870,890],[800,902],[720,900],[660,872],[600,842],[560,800],[540,760],[510,725],[480,690],[462,672]];
  const ortI=[[462,672],[452,680],[420,705],[380,725],[330,738],[285,735],[262,712],[300,690],[345,668],[395,650],[430,640],[452,640],[470,630]];
  const westI=[[470,630],[490,600],[510,570],[540,520],[560,480],[590,430],[610,380],[650,330],[720,290],[780,250],[840,230],[900,200],[960,120],[990,60],[1020,50]];
  const front=TT(frontI),sea=TT(seaI),ort=TT(ortI),west=TT(westI);
  const enclosure=front.concat(sea.slice(1),ort.slice(1),west.slice(1,-1));
  const terre=TT([[-4000,-4000],[5000,-4000],[5000,780],[1300,780],[1250,792],[1200,762],[1150,722],[1100,702],[1050,690]].concat(frontI.slice().reverse(),westI.slice().reverse().slice(1),
    [[490,600],[470,560],[455,500],[440,450],[420,420],[350,440],[280,470],[200,500],[100,480],[60,520],[90,600],[130,640],[200,700],[150,760],[60,800],[0,850],[-4000,900]]));
  const mer=TT([[-4000,-4000],[5000,-4000],[5000,5000],[-4000,5000]]);
  const H=(n,pts)=>{const p=TT(pts),xs=p.map(q=>q[0]),ys=p.map(q=>q[1]),x=(Math.min(...xs)+Math.max(...xs))/2,y=(Math.min(...ys)+Math.max(...ys))/2;return {x,y,rx:(Math.max(...xs)-Math.min(...xs))/2,ry:(Math.max(...ys)-Math.min(...ys))/2,n,p}};
  const lab=(t,ix,iy,sz,it)=>{const [x,y]=T(ix,iy);return it?[t,x,y,sz,1]:[t,x,y,sz]};
  const tp=(ix,iy,w,h,dx,dy)=>{const [x,y]=T(ix,iy);return [x,y,w,h,A(dx,dy)]};
  const pg=(ix,iy)=>{const [x,y]=T(ix,iy);return {x,y}};
  // champs hors les murs, en damier sans chevauchement, sur la terre ferme et loin des remparts
  const fields=[];for(let y=-680;y<2300;y+=290)for(let x=-880;x<1550;x+=310){const hs=Math.abs(Math.sin(x*12.9898+y*78.233))*43758.5%1,fx=x+((y+680)/290%2)*120+(hs-.5)*40,w=210+hs*80|0,h=190+(1-hs)*60|0,c=[[fx-w/2,y-h/2],[fx+w/2,y-h/2],[fx+w/2,y+h/2],[fx-w/2,y+h/2],[fx,y]];
    if(c.some(q=>!ip(q[0],q[1],terre)||ip(q[0],q[1],enclosure))||c.some(q=>enclosure.some(f=>Math.hypot(f[0]-q[0],f[1]-q[1])<190)))continue;fields.push([fx,y+(hs-.5)*30,w,h,(hs-.5)*.22])}
  const ag=T(735,650),th=T(585,545);
  return {n:'Syracuse',pt:{x:0,y:0,r:70,n:'Ortygie'},ext:[-900,-700,1500,2250],fx:464,defx:[0,910],
  inside:enclosure,
  water:[{k:'mer',n:'Mer',p:mer,holes:[enclosure,terre],landHoles:1}],
  walls:[
   {k:'mur',c:15,t:100,wb:44,p:front}, // le mur de Denys au bord nord des Épipoles, avec l'Hexapyle
   {k:'mur',c:12,t:100,wb:28,p:sea},   // le mur de mer d'Achradine (celui des machines d'Archimède)
   {k:'mur',c:10,t:100,wb:22,p:ort},    // Ortygie, sur la mer
   {k:'mur',c:14,t:105,wb:30,p:west},  // le bord sud du plateau et Néapolis, au-dessus de la plaine de l'Anapos
   {k:'citadelle',c:12,t:0,closed:1,p:TT([[270,712],[302,694],[346,674],[394,656],[428,648],[446,656],[444,676],[418,698],[378,718],[330,730],[288,728]])}],
  gates:[{w:0,...pg(995,385),n:'Hexapyle'},{w:0,...pg(970,530),n:'porte de Trogile'},{w:3,...pg(600,405),n:"porte de l'Anapos"},{w:1,...pg(800,902),open:1},{w:4,...pg(445,664),n:"porte d'Ortygie"}],
  breaches:[[0,...T(975,590)],[0,...T(1006,280)],[0,...T(1012,150)]],
  hills:[H('',[[640,330],[720,290],[840,230],[960,120],[1015,55],[1005,300],[985,420],[900,420],[800,400],[700,390]]),
         H('',[[995,40],[1030,35],[1040,70],[1015,95],[995,80]])],
  roads:[TT([[1400,380],[1150,384],[995,385],[900,450],[800,520],[700,600],[600,640],[520,650],[470,652],[445,664]]),
         TT([[1300,560],[1100,540],[970,530],[880,600],[800,680],[740,720]]),
         TT([[600,405],[520,380],[430,350],[330,320],[200,260],[60,200]]),
         TT([[600,405],[640,470],[700,560],[735,650],[760,760],[800,902]])],
  plaza:[[ag[0],ag[1],110,70,'agora',A(1,-.2)],[...T(560,600),150,20,'',A(1,-.5)]],
  blds:[[th[0],th[1],56,56,A(-1,0)+Math.PI/2,'theatre'],[...T(240,690),70,18,A(1,-.4),'neoria']],
  temples:[tp(330,320,40,24,1,0),tp(800,780,26,16,1,0),tp(870,520,22,14,1,0),tp(700,450,22,14,1,0),tp(1012,62,30,22,1,0)],
  dist:[{k:'grid',p:TT([[470,632],[520,600],[640,610],[760,620],[900,640],[962,622],[992,668],[995,720],[985,780],[960,820],[920,860],[870,890],[800,902],[720,900],[660,872],[600,842],[560,800],[540,760],[510,725],[480,690]]),ang:A(1,.08),bw:[28,34],bh:[50,68],dens:.97,jit:.12}, // Achradine
        {k:'grid',p:TT([[600,610],[620,520],[680,440],[760,400],[880,400],[968,440],[968,500],[975,560],[962,620],[900,640],[760,620]]),ang:A(1,-.35),bw:[30,36],bh:[56,76],dens:.93,jit:.15}, // Tyché
        {k:'grid',p:TT([[490,600],[540,520],[560,480],[600,410],[640,430],[620,520],[600,610],[520,600]]),ang:A(1,.6),bw:[32,40],bh:[56,80],dens:.85,fill:.6,jit:.2}, // Néapolis
        {k:'grid',p:TT([[650,335],[720,292],[840,232],[900,202],[960,122],[992,65],[1015,60],[1008,200],[1000,300],[985,400],[880,398],[760,398],[680,420]]),ang:A(1,-.6),bw:[44,60],bh:[60,90],dens:.5,fill:.25,jit:.3}], // les Épipoles, peu bâties
  fields:[],country:{ang:A(1,0),tombs:420,farms:.16},
  labels:[lab('SYRACUSE',800,560,22),lab('ORTYGIE',350,760,12),lab('ACHRADINE',760,800,13),lab('TYCHÉ',820,480,12),lab('NÉAPOLIS',560,460,11),lab('ÉPIPOLES',880,300,13),lab('fort Euryale',1010,30,11,1),
          lab('Grand Port',260,580,17,1),lab('Mer',800,980,18,1),lab('port Lakkios',500,740,10,1),lab('Hexapyle',1050,385,11,1),lab('porte de Trogile',1020,520,10,1),lab('Olympiéion',330,350,10,1),lab("autel de Hiéron",560,618,9,1)],
  txt:"Assaut de Syracuse : le mur de Denys court au bord des Épipoles, jusqu'au fort d'Euryale ; Achradine se serre le long de la mer, Ortygie tient l'île. Passez par la brèche, enfoncez l'Hexapyle ou la porte de Trogile, ou montez aux échelles, puis prenez Ortygie et tenez-la une minute."}})()
,
 athenes:(()=>{
  // Repère du plan : origine = l'Acropole ; l'attaquant vient du nord-ouest, par le Céramique et le Dipylon
  // (comme Philippe V en 200, qui attaqua le Dipylon) : +y = nord-ouest. L'Ilissos coule derrière, au sud-est.
  // Tracé relevé sur les plans d'Athènes envoyés par Baptiste (plan des dèmes et des portes, « Das alte Athen » de Brockhaus,
  // plan de Tardieu pour le Voyage d'Anacharsis) : mur de Thémistocle presque rond, Acropole au milieu, Agora au nord-ouest de l'Acropole,
  // Aréopage, Pnyx, colline des Nymphes et Mouseion à l'ouest et au sud-ouest, Olympiéion au sud-est, l'Ilissos et le stade dehors.
  const K=1.4,ux=-.672,uy=-.741,vx=uy,vy=-ux,O=[442,452];
  const T=(ix,iy)=>{const dx=ix-O[0],dy=iy-O[1];return [Math.round(K*(dx*vx+dy*vy)),Math.round(K*(dx*ux+dy*uy))]},TT=a=>a.map(q=>T(q[0],q[1]));
  const A=(dx,dy)=>Math.atan2(dx*ux+dy*uy,dx*vx+dy*vy);
  const ip=(x,y,p)=>{let c=false;for(let i=0,j=p.length-1;i<p.length;j=i++){const xi=p[i][0],yi=p[i][1],xj=p[j][0],yj=p[j][1];if((yi>y)!==(yj>y)&&x<(xj-xi)*(y-yi)/(yj-yi)+xi)c=!c}return c};
  const frontI=[[125,400],[112,368],[92,342],[86,318],[104,288],[100,246],[138,202],[178,163],[222,135],[268,112],[296,108],[302,74],[380,60],[440,46]];
  const eastI=[[440,46],[520,56],[570,90],[628,140],[664,190],[684,244],[670,272],[665,302],[676,334],[686,400],[690,452],[686,500],[712,545],[714,575],[680,602],[640,634],[598,652],[548,660],[540,670]];
  const southI=[[540,670],[518,662],[470,668],[385,656],[318,658],[265,655],[226,592],[240,540],[236,494],[200,490],[160,470],[136,432],[125,400]];
  const front=TT(frontI),east=TT(eastI),south=TT(southI),enclosure=front.concat(east.slice(1),south.slice(1,-1));
  const band=(pts,h)=>{const axe=smooth(pts,4),L1=[],L2=[];axe.forEach((q,i)=>{const a=axe[Math.max(0,i-1)],b=axe[Math.min(axe.length-1,i+1)],dx=b[0]-a[0],dy=b[1]-a[1],L=Math.hypot(dx,dy)||1;L1.push([q[0]-dy/L*h,q[1]+dx/L*h]);L2.push([q[0]+dy/L*h,q[1]-dx/L*h])});return TT(L1.concat(L2.reverse()))};
  const ilissos=band([[-2600,5600],[-900,2900],[380,900],[470,760],[560,714],[640,690],[700,634],[760,578],[800,566],[860,552],[920,536],[1000,502],[1150,450],[1300,420],[3000,80],[6000,-520]],6);
  const eridan=band([[652,122],[700,110],[790,98],[870,86],[1000,70],[1150,40],[1300,20],[3000,-240],[6000,-700]],4);
  const H=(n,pts)=>{const p=TT(pts),xs=p.map(q=>q[0]),ys=p.map(q=>q[1]),x=(Math.min(...xs)+Math.max(...xs))/2,y=(Math.min(...ys)+Math.max(...ys))/2;return {x,y,rx:(Math.max(...xs)-Math.min(...xs))/2,ry:(Math.max(...ys)-Math.min(...ys))/2,n,p}};
  const lab=(t,ix,iy,sz,it)=>{const [x,y]=T(ix,iy);return it?[t,x,y,sz,1]:[t,x,y,sz]};
  const tp=(ix,iy,w,h,dx,dy,r)=>{const [x,y]=T(ix,iy);return r?[x,y,w,h,0,1]:[x,y,w,h,A(dx,dy)]};
  const pg=(ix,iy)=>{const [x,y]=T(ix,iy);return {x,y}};
  const stade=T(938,606),ag=T(352,300),th=T(490,508);
  const nogo=[...ilissos,...eridan];
  // champs et oliveraies hors les murs, en damier irrégulier, loin des remparts, hors des rivières et du stade
  const fields=[];for(let y=-820;y<1700;y+=290)for(let x=-920;x<850;x+=310){const hs=Math.abs(Math.sin(x*12.9898+y*78.233))*43758.5%1,fx=x+((y+820)/290%2)*120+(hs-.5)*40,w=210+hs*80|0,h=190+(1-hs)*60|0,c=[[fx-w/2,y-h/2],[fx+w/2,y-h/2],[fx+w/2,y+h/2],[fx-w/2,y+h/2],[fx,y]];
    if(c.some(q=>ip(q[0],q[1],enclosure)||ip(q[0],q[1],ilissos)||ip(q[0],q[1],eridan)||Math.hypot(q[0]-stade[0],q[1]-stade[1])<150)||c.some(q=>enclosure.some(f=>Math.hypot(f[0]-q[0],f[1]-q[1])<190)))continue;
    if(ilissos.some(f=>f[0]>fx-w/2-30&&f[0]<fx+w/2+30&&f[1]>y-h/2-30&&f[1]<y+h/2+30))continue;fields.push([fx,y+(hs-.5)*30,w,h,(hs-.5)*.22])}
  return {n:'Athènes',pt:{x:0,y:0,r:80,n:"l'Acropole"},ext:[-950,-850,850,1700],fx:-30,defx:[-380,280],
  inside:enclosure,
  water:[{k:'fleuve',n:'Ilissos',p:ilissos},{k:'fleuve',n:'Éridan',p:eridan}],
  walls:[
   {k:'mur',c:15,t:100,wb:40,p:front},  // le mur de Thémistocle face au Céramique, avec le Dipylon et la porte Sacrée
   {k:'mur',c:13,t:105,wb:28,p:east},   // le mur du nord et de l'est (porte d'Acharnes, porte de Diocharès)
   {k:'mur',c:13,t:105,wb:28,p:south},  // le mur du sud, sur les collines (porte Itonienne, porte du Pirée)
   {k:'citadelle',c:12,t:0,closed:1,p:TT([[378,447],[392,432],[420,428],[440,420],[468,424],[492,438],[508,455],[498,470],[460,477],[420,482],[388,472]])}],
  gates:[{w:0,...pg(178,163),n:'Dipylon'},{w:0,...pg(138,202),n:'porte Sacrée'},{w:1,...pg(500,52),n:"porte d'Acharnes"},{w:1,...pg(668,288),n:'porte de Diocharès'},
         {w:2,...pg(520,662),n:'porte Itonienne'},{w:2,...pg(212,491),n:'porte du Pirée'},{w:3,...pg(380,446),n:'Propylées'}],
  breaches:[[0,...T(100,246)],[0,...T(268,112)],[0,...T(380,60)]],
  hills:[H('ACROPOLE',[[362,452],[378,424],[420,412],[470,410],[506,428],[522,460],[506,486],[460,494],[410,496],[374,482]]),
         H('',[[274,412],[300,398],[338,404],[350,420],[332,436],[290,436]]),
         H('',[[166,456],[190,440],[216,452],[214,478],[186,484],[166,470]]),
         H('',[[100,356],[150,346],[190,372],[184,404],[136,410],[110,390]]),
         H('',[[200,575],[255,560],[310,590],[332,632],[292,652],[230,642],[206,612]])],
  roads:[TT([[-100,-60],[60,60],[178,163],[240,214],[300,262],[340,300],[372,350],[392,400],[386,440]]),
         TT([[470,-150],[482,0],[500,52],[486,150],[462,250],[436,330],[424,390]]),
         TT([[-100,560],[100,520],[212,491],[262,470],[330,452],[372,448]]),
         TT([[1000,300],[800,294],[668,288],[600,330],[530,380],[500,412]]),
         TT([[530,760],[520,662],[512,600],[496,530]]),
         TT([[30,0],[138,202],[200,250],[260,290]])],
  plaza:[[ag[0],ag[1],120,96,'agora',A(1,-.1)]],
  blds:[[th[0],th[1],54,54,A(0,1)+Math.PI/2,'theatre']],
  temples:[tp(272,296,30,14,1,0),tp(452,452,44,20,1,0),tp(474,436,20,13,1,0),tp(672,560,80,36,1,0),tp(522,497,22,22,0,0,1),tp(318,412,18,12,1,0)],
  dist:[{k:'grid',p:TT([[150,215],[180,172],[225,145],[290,118],[300,200],[302,262],[262,282],[200,300],[140,300],[118,262]]),ang:A(1,.6),bw:[28,34],bh:[50,70],dens:.95,jit:.2}, // Céramique intérieur
        {k:'grid',p:TT([[300,76],[440,52],[520,62],[570,95],[605,140],[560,200],[470,240],[400,250],[310,262],[300,200]]),ang:A(1,.1),bw:[30,36],bh:[54,74],dens:.93,jit:.22}, // Skambonides
        {k:'grid',p:TT([[605,140],[640,160],[668,205],[672,280],[668,330],[682,420],[600,432],[540,410],[520,370],[470,250],[560,200]]),ang:A(.2,1),bw:[30,38],bh:[56,80],dens:.88,fill:.75,jit:.22}, // Diomeia
        {k:'grid',p:TT([[118,300],[200,300],[262,290],[300,340],[284,396],[262,440],[220,446],[170,432],[132,400],[108,350]]),ang:A(1,-.3),bw:[28,34],bh:[46,66],dens:.95,jit:.25}, // Mélité
        {k:'grid',p:TT([[372,322],[460,258],[520,300],[540,380],[524,420],[476,412],[400,412],[368,384]]),ang:A(1,.05),bw:[28,34],bh:[48,66],dens:.97,jit:.18}, // au pied de l'Acropole
        {k:'grid',p:TT([[520,470],[560,432],[684,424],[688,500],[710,545],[700,580],[640,630],[590,650],[550,640],[522,560]]),ang:A(1,-.5),bw:[30,36],bh:[52,72],dens:.92,jit:.22}, // Limnai
        {k:'grid',p:TT([[220,494],[262,474],[332,458],[372,492],[432,502],[500,522],[530,600],[545,656],[470,662],[380,652],[320,624],[268,562],[240,520]]),ang:A(1,.35),bw:[30,38],bh:[52,76],dens:.9,fill:.75,jit:.25}], // Kollytos et Koilè
  fields:[],country:{ang:A(-1,1),relief:[H('',[[820,20],[870,-10],[930,10],[950,70],[920,120],[860,130],[825,90]]),H('',[[110,600],[180,640],[230,700],[200,760],[130,770],[80,720],[70,650]])],
    wild:[TT([[800,10],[870,-25],[945,0],[970,70],[930,135],[860,145],[812,95]]),TT([[100,590],[185,630],[240,700],[210,770],[125,782],[68,725],[60,650]])],tombs:520,farms:.12,mix:{ble:.22,orge:.12,jachere:.12,vigne:.18,olive:.3,pre:.06}},
  labels:[lab('ATHÈNES',580,360,22),lab('CÉRAMIQUE',225,215,12),lab('SKAMBONIDES',430,130,12),lab('MÉLITÉ',190,350,12),lab('DIOMEIA',615,250,12),lab('LIMNAI',600,560,12),lab('KOLLYTOS',400,600,11),lab('KOILÈ',255,545,11),
          lab('Aréopage',312,394,10,1),lab('Pnyx',190,500,10,1),lab('colline des Nymphes',140,428,10,1),lab('Mouseion',270,680,10,1),lab('théâtre de Dionysos',492,540,9,1),lab('Héphaïstéion',272,280,9,1),lab('Olympiéion',672,595,10,1),
          lab('Dipylon',150,140,11,1),lab('porte Sacrée',100,195,10,1),lab("porte d'Acharnes",500,28,10,1),lab('porte de Diocharès',730,290,10,1),lab('porte du Pirée',170,520,10,1),lab('porte Itonienne',520,700,10,1),lab('Ilissos',830,585,15,1),lab('Éridan',860,72,13,1)],
  txt:"Assaut d'Athènes : le mur de Thémistocle enferme la ville, l'Acropole se dresse au milieu. Comme Philippe V en 200, attaquez par le Céramique : passez la brèche, enfoncez le Dipylon ou la porte Sacrée, ou montez aux échelles, puis prenez l'Acropole et tenez-la une minute."}})()

};
