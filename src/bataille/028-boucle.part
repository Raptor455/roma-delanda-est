/* ================= BOUCLE ================= */
setTimeout(async()=>{
  GROUND=await groundP;
  buildTerrain();buildScenery();buildMinimap();
  $('loading').textContent='Rassemblement des troupes…';
  for(const id in BM)if(!BM[id].nv)delete BM[id];
  setup();resize();updateCamera();if(INTRO)introStart();
  $('loading').remove();
  window.addEventListener('resize',resize);
  let last=performance.now(),hudT=0,mmT=0;
  function frame(now){
    const raw=Math.min(.05,(now-last)/1000);last=now;
    if(!paused&&started){let t=raw*speed;while(t>0){const s=Math.min(t,1/30);step(s);t-=s}rt+=raw*speed}
    else rt+=raw*.15;
    flagTime.value+=raw;
    keyPan(raw);updateCamera();
    updateTags(); /* l'ancienne vue 3D n'est plus animée : figurines, effets et particules ne tournent plus */
    hudT-=raw;if(hudT<=0){hudT=.2;hudTick()}
    mmT-=raw;if(mmT<=0){mmT=.12;drawMinimap()}
    renderer.render(scene,camera);
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
