/* ================= MINICARTE ================= */
const mm=$('mm'),mg=mm.getContext('2d');let mmBg=null;
function buildMinimap(){
  mmBg=document.createElement('canvas');mmBg.width=480;mmBg.height=300;const g=mmBg.getContext('2d'),img=g.createImageData(480,300),c=new THREE.Color();
  for(let j=0;j<300;j++)for(let i=0;i<480;i++){
    const sx=i/480*W,sy=j/300*H,h=height(sx,sy);
    const nx=(height(sx+8*G,sy)-height(sx-8*G,sy))/(16*G),nz=(height(sx,sy+8*G)-height(sx,sy-8*G))/(16*G),ny=1/Math.hypot(nx,nz,1);
    terrainColor(sx/G,sy/G,h,ny,c);
    const shade=1+(-nx*.55+nz*.5)*.9,o=(j*480+i)*4;
    if(sx/G<riverX(sy/G)+30){c.setHex(0x3e6b78)}
    else if(inForestXY(sx,sy))c.lerp(cTmp.setHex(0x2f4a24),.6);
    img.data[o]=Math.min(255,c.r*255*shade);img.data[o+1]=Math.min(255,c.g*255*shade);img.data[o+2]=Math.min(255,c.b*255*shade);img.data[o+3]=255;
  }
  g.putImageData(img,0,0);
}
const inForestXY=(x,y)=>FORESTSg.some(f=>Math.hypot(x-f.x,y-f.y)<f.r);
function drawMinimap(){
  const kx=480/W,ky=300/H;
  mg.drawImage(mmBg,0,0);
  for(const u of units){
    if(u.dead)continue;
    mg.save();mg.translate(u.x*kx,u.y*ky);mg.rotate(u.ang);
    mg.globalAlpha=u.routing?.45:1;mg.fillStyle=PAL[u.side].mini;
    mg.fillRect(-u.dd*kx/2,-u.w*ky/2,Math.max(3,u.dd*kx),Math.max(4,u.w*ky));
    if(selected.has(u)){mg.strokeStyle='#fff2c0';mg.lineWidth=2;mg.strokeRect(-u.dd*kx/2-1,-u.w*ky/2-1,Math.max(3,u.dd*kx)+2,Math.max(4,u.w*ky)+2)}
    mg.restore();
  }
  const P=[[-1,1],[1,1],[1,-1],[-1,-1]].map(([x,y])=>groundAtNdc(x,y));
  mg.strokeStyle='rgba(255,244,200,.9)';mg.lineWidth=2;mg.beginPath();
  let first=true;
  for(const p of P){if(!p)continue;const x=Math.max(0,Math.min(480,p.x*kx)),y=Math.max(0,Math.min(300,p.y*ky));if(first){mg.moveTo(x,y);first=false}else mg.lineTo(x,y)}
  mg.closePath();mg.stroke();
}
let mmDrag=false;
const mmGo=e=>{const r=mm.getBoundingClientRect();cam.tx=(e.clientX-r.left)/r.width*W;cam.ty=(e.clientY-r.top)/r.height*H};
mm.addEventListener('pointerdown',e=>{mmDrag=true;mm.setPointerCapture(e.pointerId);mmGo(e)});
mm.addEventListener('pointermove',e=>{if(mmDrag)mmGo(e)});
mm.addEventListener('pointerup',()=>{mmDrag=false});mm.addEventListener('pointercancel',()=>{mmDrag=false});

