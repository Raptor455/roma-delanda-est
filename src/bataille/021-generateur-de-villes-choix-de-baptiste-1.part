    if(S.split>1&&sz>=2){const a=ang0+rr(.3,1.2),nx=Math.cos(a),ny=Math.sin(a),c=nx*pl[0]+ny*pl[1];const A=clipHalf(inside,nx,ny,c),B=clipHalf(inside,-nx,-ny,-c);
