    const bridges=[];for(const rd of roads)for(let i=0;i<rd.length-1;i++)for(let j=0;j<axe.length-1;j++){const a=rd[i],b=rd[i+1],c=axe[j],d=axe[j+1],den=(b[0]-a[0])*(d[1]-c[1])-(b[1]-a[1])*(d[0]-c[0]);if(Math.abs(den)<1e-9)continue;
      const t=((c[0]-a[0])*(d[1]-c[1])-(c[1]-a[1])*(d[0]-c[0]))/den,u=((c[0]-a[0])*(b[1]-a[1])-(c[1]-a[1])*(b[0]-a[0]))/den;if(t<0||t>1||u<0||u>1)continue;
      const x=a[0]+(b[0]-a[0])*t,y=a[1]+(b[1]-a[1])*t,L=Math.hypot(b[0]-a[0],b[1]-a[1]),ux=(b[0]-a[0])/L,uy=(b[1]-a[1])/L,h=hw+10,w=7;bridges.push([[x-ux*h-uy*w,y-uy*h+ux*w],[x+ux*h-uy*w,y+uy*h+ux*w],[x+ux*h+uy*w,y+uy*h-ux*w],[x-ux*h+uy*w,y-uy*h-ux*w]].map(q=>q.map(Math.round)))}
