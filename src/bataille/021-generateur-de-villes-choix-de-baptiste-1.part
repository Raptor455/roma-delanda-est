  for(const f of P.fields){f[0]=s(f[0]);f[1]=s(f[1]);f[2]=s(f[2]);f[3]=s(f[3])}
  if(P.country){const C0=P.country;if(C0.wild)C0.wild=C0.wild.map(poly);if(C0.beds)C0.beds=C0.beds.map(poly);if(C0.relief)for(const h of C0.relief){h.x=s(h.x);h.y=s(h.y);h.rx=s(h.rx);h.ry=s(h.ry);if(h.p)h.p=poly(h.p)}if(C0.tombs)C0.tombs*=SC}
  for(const l of P.labels){l[1]=s(l[1]);l[2]=s(l[2])}
