  const dEdge=(x,y)=>{let m=1e9;for(let i=0;i<enc.length;i++){const a=enc[i],b=enc[(i+1)%enc.length],vx=b[0]-a[0],vy=b[1]-a[1],L=vx*vx+vy*vy||1,t=Math.max(0,Math.min(1,((x-a[0])*vx+(y-a[1])*vy)/L));m=Math.min(m,Math.hypot(a[0]+vx*t-x,a[1]+vy*t-y))}return inPoly(x,y,enc)?m:-m};
