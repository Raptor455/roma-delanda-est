const GDESC={gre:'la cité grecque',pun:'la ville punique',ita:'la ville italique',ibe:"l'oppidum ibère",cel:"l'oppidum",num:'la ville numide'};
function genPlan(k){if(k in GENC)return GENC[k];let e=GENT[k];if(typeof e==='string')e=GENT[e];if(!Array.isArray(e)||!e[1])return GENC[k]=null;
  try{return GENC[k]=genBuild(k,e)}catch(err){console.warn('villes: générateur',k,err);return GENC[k]=null}}
function genBuild(k,e){const [cu,sz,port,seaS,rv,name]=e,S=GSTY[cu]||GSTY.ita,r=genRng(k),rr=(a,b)=>a+r()*(b-a),TAU=2*Math.PI;
  const R0=[0,230,320,420][sz]*rr(.9,1.1);
  // la mer : 16 secteurs depuis l'est, sens horaire (repère de la campagne : x vers l'est, y vers le sud), 0 à 4 = de plus en plus proche
  const sea=seaS?seaS.split('').map(Number):new Array(16).fill(0);
  // l'attaquant arrive par le côté le plus terrestre ; il devient le +y du plan
  let best=0,bs=-1e9;for(let i=0;i<16;i++){let s=0;for(let j=-4;j<=4;j++)s-=sea[(i+j+16)%16]*(5-Math.abs(j));s+=r()*.5;if(s>bs){bs=s;best=i}}
  const a0=best/16*TAU,toCamp=phi=>phi-Math.PI/2+a0;
  const wAt=phi=>{let t=toCamp(phi)/TAU*16;t=((t%16)+16)%16;const i=Math.floor(t),f=t-i;let w=sea[i]*(1-f)+sea[(i+1)%16]*f;const dd=Math.abs(Math.atan2(Math.sin(phi-Math.PI/2),Math.cos(phi-Math.PI/2)));if(dd<.95)w*=Math.max(0,(dd-.55)/.4);return w};
  const coastRaw=phi=>{const w=wAt(phi);return w<.3?R0*12:R0*(1.0+(4-w)*.6)};
  const NA=96,cr=[];for(let i=0;i<NA;i++)cr.push(Math.log(coastRaw(i/NA*TAU)));
  const crS=cr.map((_,i)=>{let s=0,n=0;for(let j=-3;j<=3;j++){s+=cr[(i+j+NA)%NA];n++}return Math.exp(s/n)});
  const coast=phi=>{let t=((phi%TAU)+TAU)%TAU/TAU*NA;const i=Math.floor(t)%NA,f=t-Math.floor(t);return crS[i]*(1-f)+crS[(i+1)%NA]*f};
  const coastal=sea.some(v=>v>0)&&crS.some(v=>v<R0*4);
  // le site : perché (crête allongée) ou en plaine ; une enceinte qui suit le terrain, jamais un cercle
  const hill=r()<(coastal?S.hill*.5:S.hill);
