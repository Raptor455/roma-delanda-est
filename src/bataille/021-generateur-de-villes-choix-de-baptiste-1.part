const SC=1.5; // les cartes de ville, agrandies (les maisons et les murs gardent leur taille)
function scalePlan(P0){const s=v=>v*SC,pt=p=>[p[0]*SC,p[1]*SC],poly=p=>p.map(pt),P=JSON.parse(JSON.stringify(P0));
  P.pt.x=s(P.pt.x);P.pt.y=s(P.pt.y);P.pt.r=P.pt.r*1.25;P.ext=P.ext.map(s);P.inside=poly(P.inside);if(P.town)P.town=poly(P.town);
  for(const w of P.water){if(w.c){w.c=[s(w.c[0]),s(w.c[1]),s(w.c[2])];if(w.isle)w.isle=[s(w.isle[0]),s(w.isle[1]),w.isle[2]*1.2]}else w.p=poly(w.p);if(w.holes)w.holes=w.holes.map(poly);if(w.island)w.island=poly(w.island);if(w.bridges)w.bridges=w.bridges.map(poly)}
  if(P.fx)P.fx=s(P.fx);if(P.defx)P.defx=P.defx.map(s);if(P.blds)for(const b of P.blds){b[0]=s(b[0]);b[1]=s(b[1]);b[2]=s(b[2]);b[3]=s(b[3])}if(P.circus){const c=P.circus;c[0]=s(c[0]);c[1]=s(c[1]);c[2]=s(c[2]);c[3]=s(c[3])}
  for(const w of P.walls)w.p=w.k==='citadelle'?w.p.map(q=>[q[0]*1.25,q[1]*1.25]):poly(w.p);
  for(const q of P.gates){const cg=P0.walls[q.w]&&P0.walls[q.w].k==='citadelle';if(P0.n==='Carthage'){q.x=s(q.x);q.y=q.w===4?q.y*1.25:s(q.y)}else{q.x*=cg?1.25:SC;q.y*=cg?1.25:SC}}
  P.breaches=P.breaches.map(b=>[b[0],s(b[1]),s(b[2])]);if(P.ditch)P.ditch=P.ditch.map(poly);
  for(const h of P.hills){h.x=s(h.x);h.y=s(h.y);h.rx=s(h.rx);h.ry=s(h.ry);if(h.p)h.p=poly(h.p)}
  P.roads=P.roads.map(r=>r.map((q,i)=>i===r.length-1&&r===P.roads[0]?[q[0]*1.25,q[1]*1.25]:pt(q)));
  for(const q of P.plaza){q[0]=s(q[0]);q[1]=s(q[1]);q[2]=s(q[2]);q[3]=s(q[3])}
  for(const q of (P.temples||[])){q[0]=s(q[0]);q[1]=s(q[1])}
