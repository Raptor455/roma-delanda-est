  const temples=[],nT=Math.round(rr(S.tmp[0],S.tmp[1]+.99))+sz-1;for(let t=0;t<400&&temples.length<nT;t++){const x=rr(X0,X1),y=rr(Y0,Y1);if(!insideS(x,y,60)||Math.hypot(x,y)<rc*1.25/1.5*1.5+40||plaza.some(p=>Math.hypot(p[0]-x,p[1]-y)<90)||temples.some(q=>Math.hypot(q[0]-x,q[1]-y)<110))continue;
