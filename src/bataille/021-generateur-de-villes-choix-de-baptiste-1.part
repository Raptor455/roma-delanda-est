  let st=cls.findIndex((c,i)=>c!==cls[(i-1+cls.length)%cls.length]&&c!=='f'&&cls[(i-1+cls.length)%cls.length]!=='f');if(st<0)st=cls.findIndex((c,i)=>c!==cls[(i-1+cls.length)%cls.length]);if(st<0)st=0;
  const runs=[];for(let n=0;n<cls.length;n++){const i=(st+n)%cls.length,c=cls[i];if(!runs.length||runs[runs.length-1].c!==c)runs.push({c,p:[enc[i]]});runs[runs.length-1].p.push(enc[(i+1)%enc.length])}
  runs.sort((a,b)=>(a.c==='f'?0:1)-(b.c==='f'?0:1));if(runs.filter(q=>q.c==='f').length>1){const f=runs.filter(q=>q.c==='f');f.sort((a,b)=>b.p.length-a.p.length);for(const q of f.slice(1))q.c='l';runs.sort((a,b)=>(a.c==='f'?0:1)-(b.c==='f'?0:1))}
