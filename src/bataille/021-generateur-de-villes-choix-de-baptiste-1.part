    const d0=Math.max(...inside.map(q=>(q[0]-cen[0])*nx+(q[1]-cen[1])*ny))+80,pm=r()*TAU,axe=[];for(let t=-14;t<=14;t+=.5){const off=d0+28*Math.sin(t*1.3+pm);axe.push([cen[0]+nx*off+dx*t*R0,cen[1]+ny*off+dy*t*R0])}
