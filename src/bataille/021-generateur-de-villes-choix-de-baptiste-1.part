  let pl=[cg[0]*1.25/1.5+(fg.x-cg[0]*1.25/1.5)*.5,cg[1]*1.25/1.5+(fg.y-cg[1]*1.25/1.5)*.5];
  const insideS=(x,y,m)=>{if(!inPoly(x,y,inside))return false;for(let i=0;i<inside.length;i++){const a=inside[i],b=inside[(i+1)%inside.length],vx=b[0]-a[0],vy=b[1]-a[1],L=vx*vx+vy*vy||1,t=Math.max(0,Math.min(1,((x-a[0])*vx+(y-a[1])*vy)/L));if(Math.hypot(a[0]+vx*t-x,a[1]+vy*t-y)<m)return false}return true};
  const plaza=[];const PS=[0,[56,40],[78,54],[100,68]][sz];if(S.pl&&insideS(pl[0],pl[1],90))plaza.push([Math.round(pl[0]),Math.round(pl[1]),PS[0],PS[1],S.pl,ang0]);
