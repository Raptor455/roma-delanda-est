    else if(L>150){const q=along(w.p,rr(.35,.65));gates.push({w:wi,x:Math.round(q[0]),y:Math.round(q[1]),n:gname(q[0],q[1])})}});
  const cg=citP.reduce((b,q)=>q[1]>b[1]?q:b,citP[0]);gates.push({w:walls.length-1,x:cg[0],y:cg[1],n:'porte de '+S.cit.replace(/^l'|^la /,m=>m==="l'"?"l'":'la ')});
