  const shapeR=phi=>{const c=Math.cos(phi-psi),s=Math.sin(phi-psi);const am=hill?1:1.5;return R0/Math.sqrt(asp)/Math.sqrt(c*c/(asp*asp)+s*s)*(1+am*(.09*Math.sin(2*phi+ph[0])+.07*Math.sin(3*phi+ph[1])+.05*Math.sin(5*phi+ph[2])))};
