    const b=blockOf(ax,ay,bx,by,u.side,isAI(u));if(!b){u._cl=0;continue}
    const s=b.s,canClimb=MODE==='assaut'&&u.side===ATTS&&!u.routing&&(u.T.kind==='inf'||u.T.kind==='skirm');
    if(b.gate&&b.gate.kind==='porte'&&MODE==='assaut'&&u.side===ATTS&&u.T.kind!=='skirm'&&!u.routing){b.gate.hp-=dt*(u.T.kind==='eleph'?3:1);u._bat=time;b.gate.bat=time;
      if(b.gate.hp<=0)breakGate(b.gate)}
    else if(canClimb){const ix=ax+(bx-ax)*b.t,iy=ay+(by-ay)*b.t,d=Math.min(12,s.WB*.4||12),lx=ix+s.inx*d,ly=iy+s.iny*d;
      // sous le tir des défenseurs du rempart : on monte moins vite et on perd des hommes (sauf à couvert d'une tour de siège)
      const twr=SIEGE.find(e=>e.k==='tow'&&e.st==='dock'&&Math.hypot(e.fx-lx,e.fy-ly)<55),CK=twr?.45:CLIMBK,k=twr?0:Math.min(3,defNear(lx,ly,36));u._twr=twr||null;u._ck=CK;
      u._cl=(u._clS===s?u._cl||0:0)+dt/(1+.35*k);u._clS=s;u._clT=time;u._clK=k;
      if(k){hurt(u,1.1*k*dt/(u.T.def||1));u.underFire=1;u.morale-=.05*k*dt;if(u.morale<=0&&!u.routing)rout(u)}
      // en haut de l'échelle : des défenseurs au pied de l'échelle la repoussent, sinon le carré prend pied sur le rempart
      if(u._cl>=s.c*CK){if(!twr&&defNear(lx,ly,20)&&Math.random()<.6){u._cl=s.c*CK*.45;u.morale-=.25;hurt(u,3/(u.T.def||1));if(u.morale<=0&&!u.routing)rout(u);
          if(time-lastRep>6){lastRep=time;say(u.side===0?'Vos échelles sont repoussées !':"Les défenseurs repoussent l'échelle !",u.side===0?'#f1a097':'#cbb1ee')}}
        else{u._cl=0;const [fx,fy]=P2F(lx,ly);u.x=fx*G;u.y=fy*G;if(!u._said){u._said=1;if(u.side===0)say('Vos hommes prennent pied sur le rempart !','#cbb1ee');else say("L'ennemi monte sur le rempart !",'#f1a097')}}continue}}
    u.x=pv[0];u.y=pv[1];u.v=0}
  if(MODE==='assaut'&&started&&!ended){towers(dt);capture(dt);siege(dt)}
  return r}}
// défenseurs sur le rempart : les créneaux les protègent ; dans la citadelle un peu ; assaillants sur les échelles : plus exposés
if(MODE==='assaut'){const _h=hurt;hurt=function(e,cas){if(!OFF&&e&&!e.dead){const [x,y]=W2P(e.x,e.y);
  if(e.side===DEFS&&onRampart(x,y))cas/=KW;else if(e.side===DEFS&&inCit(x,y))cas/=Math.sqrt(KW);
  if(e._clT!=null&&time-e._clT<.3)cas*=1.5}return _h.call(this,e,cas)}}
// IA qui défend : les carrés libres les plus proches vont au pied des échelles
if(MODE==='assaut'&&DEFS===1){const _ai=ai;ai=function(){const r=_ai.apply(this,arguments);if(OFF)return r;try{
  const D=units.filter(u=>u.side===1&&!u.dead&&!u.pend&&!u.routing&&!u.contacts.length&&(u.T.kind==='inf'||u.T.kind==='skirm')),used=new Set();
  for(const a of units){if(a.side!==0||a.dead||a._clT==null||time-a._clT>.5||!a._clS)continue;const s=a._clS,[ux,uy]=W2P(a.x,a.y),vx=s.bx-s.ax,vy=s.by-s.ay,t=Math.max(0,Math.min(1,((ux-s.ax)*vx+(uy-s.ay)*vy)/(s.L*s.L))),lx=s.ax+vx*t+s.inx*Math.min(12,s.WB*.4||12),ly=s.ay+vy*t+s.iny*Math.min(12,s.WB*.4||12);
    if(defNear(lx,ly,20)>=2)continue;let best=null,bd=260;for(const d of D){if(used.has(d))continue;const [dx,dy]=W2P(d.x,d.y),dd=Math.hypot(dx-lx,dy-ly);if(dd<bd){bd=dd;best=d}}
    if(best){used.add(best);const [fx,fy]=P2F(lx,ly);best.order={type:'move',x:fx*G,y:fy*G,face:null,run:true}}}}catch(e){}return r}}
/* ---- engins de siège sur le champ ---- */
// tours roulantes (accostent le mur : on y monte vite et à couvert), béliers sous tortue (enfoncent une porte),
// catapultes en batterie (pierres sur le rempart). Les défenseurs proches et les tours du mur les incendient.
const SIEGE=[],STONES=[];
function breakGate(g){if(g.broken)return;g.broken=true;say((g.n?'La '+g.n:'La porte')+' cède !',ATTS===0?'#cbb1ee':'#f1a097')}
function buildSiege(){SIEGE.length=0;STONES.length=0;if(MODE!=='assaut'||!(ENGS.tow||ENGS.rams||ENGS.cat))return;
  const fw=P.walls.findIndex(w=>w.k==='mur'&&Math.max(...w.p.map(q=>q[1]))===FY),FS=SEG.filter(s=>s.wi===fw);if(!FS.length)return;
  const A=units.filter(u=>u.side===ATTS&&!u.dead&&!u.pend).map(u=>W2P(u.x,u.y)),x0=A.length?Math.min(...A.map(q=>q[0])):-600,x1=A.length?Math.max(...A.map(q=>q[0])):600;
  // points du front : sur la face du mur, loin des portes et des brèches
  const pts=[];for(const s of FS)for(let d=40;d<s.L-40;d+=20){const t=d/s.L,x=s.ax+(s.bx-s.ax)*t,y=s.ay+(s.by-s.ay)*t;if(!s.gaps.some(g=>Math.hypot(g.x-x,g.y-y)<g.half+70))pts.push({s,x,y})}
  for(let i=pts.length-1;i>=0;i--){const q=pts[i];if(inWater(q.x-q.s.inx*440,q.y-q.s.iny*440)||inWater(q.x-q.s.inx*200,q.y-q.s.iny*200))pts.splice(i,1)} // pas d'engin qui partirait de la mer
  const near=xx=>pts.reduce((b,q)=>!b||Math.abs(q.x-xx)<Math.abs(b.x-xx)?q:b,null);
  const mk=(k,q,off,dock,hp)=>{const s=q.s,ix=s.inx,iy=s.iny,e={k,s,ix,iy,fx:q.x,fy:q.y,tx:q.x-ix*dock,ty:q.y-iy*dock,x:q.x-ix*off,y:q.y-iy*off,hp,hp0:hp,st:k==='cat'?'dock':'move',dk:1,cd:2+Math.random()*3,said:0,id:SIEGE.length};SIEGE.push(e);return e};
  // sur un front étroit (isthme), on répartit les engins sur la longueur du front plutôt que sur la ligne des assaillants
  const px0=pts.length?Math.min(...pts.map(q=>q.x)):x0,px1=pts.length?Math.max(...pts.map(q=>q.x)):x1,lo=Math.max(x0,px0),hi=Math.min(x1,px1),[a0,a1]=hi-lo>200?[lo,hi]:[px0,px1];
  if(ENGS.tow)for(const f of [.2,.5,.8]){const q=near(a0+(a1-a0)*f);if(q&&!SIEGE.some(e=>Math.hypot(e.fx-q.x,e.fy-q.y)<150))mk('tow',q,380,20,120)}
  if(ENGS.rams){const gs=GAPS.filter(g=>g.kind==='porte'&&g.s.wi===fw&&g.x>x0-200&&g.x<x1+200).sort((a,b)=>Math.abs(a.x-(x0+x1)/2)-Math.abs(b.x-(x0+x1)/2)).slice(0,2);
    for(const g of gs){const e=mk('rams',{s:g.s,x:g.x,y:g.y},330,17,70);e.gate=g}}
  if(ENGS.cat)for(const f of [.3,.5,.7]){const q=near(a0+(a1-a0)*f);if(q&&!SIEGE.some(e=>e.k==='cat'&&Math.hypot(e.fx-q.x,e.fy-q.y)<90))mk('cat',q,430,430,30)}}
function siege(dt){
  for(const e of SIEGE){if(e.st==='dead')continue;
    if(e.st==='move'){const dx=e.tx-e.x,dy=e.ty-e.y,d=Math.hypot(dx,dy),sp=(e.k==='tow'?4.5:7)*(ditchAt(e.x,e.y)?.5:1)*dt;
      if(d<=sp){e.x=e.tx;e.y=e.ty;e.st=e.dk?'dock':'idle';if(!e.dk||e.k==='cat'){if(e.k==='cat'&&e.dk)e.cd=Math.min(e.cd,2)}
        else if(e.k==='tow')say(ATTS===0?'Une tour de siège accoste le mur !':"Une tour ennemie accoste le mur !",ATTS===0?'#cbb1ee':'#f1a097');
        else say(ATTS===0?`Le bélier frappe la ${e.gate.n||'porte'}`:`Le bélier ennemi frappe la ${e.gate.n||'porte'}`,ATTS===0?'#cbb1ee':'#f1a097')}
      else{e.x+=dx/d*sp;e.y+=dy/d*sp;e.ha=Math.atan2(dy,dx)}}
    else if(e.st==='idle'){}
    else if(e.k==='rams'&&e.gate&&!e.gate.broken){e.gate.hp-=dt*1.6;e.gate.bat=time;e.hit=time;if(e.gate.hp<=0)breakGate(e.gate)}
    else if(e.k==='cat'){e.cd-=dt;if(e.cd<=0){e.cd=5.5+Math.random()*1.5;
      let best=null,bd=560;const tg=e.tgt&&!e.tgt.dead&&!e.tgt.routing?e.tgt:null;if(tg){const [ux,uy]=W2P(tg.x,tg.y),dd=Math.hypot(ux-e.x,uy-e.y);if(dd<600){best=tg;bd=dd}}
      if(!best)for(const u of units){if(u.side!==DEFS||u.dead||u.pend||u.routing)continue;const [ux,uy]=W2P(u.x,u.y),dd=Math.hypot(ux-e.x,uy-e.y);if(dd<bd&&(onRampart(ux,uy)||dd<300)){bd=dd;best=u}}
      if(best){const [ux,uy]=W2P(best.x,best.y);STONES.push({x0:e.x,y0:e.y,tx:ux+(Math.random()-.5)*14,ty:uy+(Math.random()-.5)*14,e:best,t:0,dur:1.1+bd/500});e.fire=time}}}
    // incendie : défenseurs à portée de torche ou de javelot, flèches enflammées des tours du mur
    let k=0;for(const u of units){if(u.side!==DEFS||u.dead||u.pend||u.routing)continue;const [ux,uy]=W2P(u.x,u.y);if(Math.hypot(ux-e.x,uy-e.y)<42)k++}
    let tw=0;if(e.k==='tow')for(const q of TOWERS)if(Math.hypot(q.x-e.x,q.y-e.y)<150)tw++;
    const dmg=dt*(k*(e.k==='rams'?.35:e.k==='cat'?1.6:1)+tw*.25);if(dmg>0){e.hp-=dmg;e.hurtT=time}
    if(e.hp<=0){e.st='dead';e.burn=time;const n={tow:'Une tour de siège',rams:'Un bélier',cat:'Une catapulte'}[e.k];say(n+(ATTS===0?' brûle !':' ennemie brûle !'),ATTS===0?'#f1a097':'#cbb1ee')}}
  for(let i=STONES.length-1;i>=0;i--){const st=STONES[i];st.t+=dt;if(st.t>=st.dur){STONES.splice(i,1);const e=st.e;if(!e.dead){const [ux,uy]=W2P(e.x,e.y);if(Math.hypot(ux-st.tx,uy-st.ty)<30){hurt(e,9/(e.T.def||1));e.underFire=1.5;e.morale-=.5;if(e.morale<=0&&!e.routing)rout(e)}}}}}
// IA qui attaque : deux carrés montent par chaque tour accostée
if(MODE==='assaut'&&ATTS===1){const _ai2=ai;ai=function(){const r=_ai2.apply(this,arguments);if(OFF)return r;try{
  for(const e of SIEGE){if(e.k!=='tow'||e.st!=='dock')continue;const cand=units.filter(u=>u.side===1&&!u.dead&&!u.pend&&!u.routing&&!u.contacts.length&&u.T.kind==='inf'&&!(u._clT!=null&&time-u._clT<.5)).map(u=>{const [x,y]=W2P(u.x,u.y);return [u,Math.hypot(x-e.fx,y-e.fy)]}).filter(q=>q[1]<520).sort((a,b)=>a[1]-b[1]).slice(0,2);
    for(const [u] of cand){const [fx,fy]=P2F(e.fx+e.ix*20,e.fy+e.iy*20);u.order={type:'move',x:fx*G,y:fy*G,face:null,run:true}}}}catch(err){}return r}}
/* ---- commander les engins (seulement les vôtres : vous attaquez) ---- */
const SSEL=new Set(),ENGT={tow:'Tour de siège',rams:'Bélier',cat:'Catapulte'};
const mineEng=()=>MODE==='assaut'&&ATTS===0&&!(window.__pvp&&window.__pvp.on&&window.__pvp.role==='g');
function engAt(cx,cy){if(!mineEng())return null;let best=null,bd=1e9;for(const e of SIEGE){if(e.st==='dead')continue;const [fx,fy]=P2F(e.x,e.y),s=toScreen(fx*G,fy*G,0),[gx,gy]=P2F(e.x+10,e.y),s1=toScreen(gx*G,gy*G,0),ppm=Math.hypot(s1.x-s.x,s1.y-s.y)/10,r=Math.max(18,(e.k==='tow'?26:e.k==='rams'?22:16)*ppm),d=Math.hypot(s.x-cx,s.y-cy);if(d<r&&d<bd){bd=d;best=e}}return best}
// un ordre : point du plan ; un mur proche = y accoster (tour), une porte proche = la frapper (bélier) ; on ne traverse jamais un mur
function engOrder(e,px,py,tu){if(e.st==='dead')return;e.tgt=null;const DK={tow:20,rams:17,cat:40}[e.k];
  if(inWater(px,py))return;
  // point de mur le plus proche
  let ws=null,wd=1e9,wt=0;for(const s of SEG){if(!s.WB||s.k==='citadelle')continue;const vx=s.bx-s.ax,vy=s.by-s.ay,t=Math.max(0,Math.min(1,((px-s.ax)*vx+(py-s.ay)*vy)/(s.L*s.L))),d=Math.hypot(s.ax+vx*t-px,s.ay+vy*t-py);if(d<wd){wd=d;ws=s;wt=t}}
  let cr=null;for(const s of SEG){if(!s.WB||s.k==='citadelle')continue;const c=cross(e.x,e.y,px,py,s);if(c&&(!cr||c.t<cr.t))cr={t:c.t,s,u:c.u}}
  if(cr){ws=cr.s;wt=cr.u;wd=0}
  const near=ws&&wd<140,wx=ws?ws.ax+(ws.bx-ws.ax)*wt:0,wy=ws?ws.ay+(ws.by-ws.ay)*wt:0;
  if(e.k==='cat'&&tu){e.tgt=tu;const [ux,uy]=W2P(tu.x,tu.y);const d=Math.hypot(ux-e.x,uy-e.y);if(d<520){e.st='dock';e.dk=1;return}px=e.x+(ux-e.x)*(1-480/d);py=e.y+(uy-e.y)*(1-480/d);
    let c2=null;for(const s of SEG){if(!s.WB)continue;const c=cross(e.x,e.y,px,py,s);if(c&&(!c2||c.t<c2.t))c2={t:c.t,s}}if(c2){px=e.x+(px-e.x)*c2.t-c2.s.inx*DK;py=e.y+(py-e.y)*c2.t-c2.s.iny*DK}}
  else if(e.k==='rams'){const g=GAPS.filter(g=>g.kind==='porte'&&!g.broken).map(g=>[g,Math.hypot(g.x-(cr?wx:px),g.y-(cr?wy:py))]).sort((a,b)=>a[1]-b[1])[0];
    if(g&&g[1]<120){const G0=g[0];e.gate=G0;e.s=G0.s;e.ix=G0.s.inx;e.iy=G0.s.iny;e.fx=G0.x;e.fy=G0.y;e.tx=G0.x-e.ix*DK;e.ty=G0.y-e.iy*DK;e.st='move';e.dk=1;return}
    e.gate=null;if(cr||near&&inTown(px,py)){px=wx-ws.inx*DK;py=wy-ws.iny*DK}}
  else if(e.k==='tow'&&(cr||near)){e.s=ws;e.ix=ws.inx;e.iy=ws.iny;e.fx=wx;e.fy=wy;e.tx=wx-e.ix*DK;e.ty=wy-e.iy*DK;e.st='move';e.dk=1;return}
  else if(cr){px=wx-ws.inx*DK;py=wy-ws.iny*DK}
  e.tx=px;e.ty=py;e.st='move';e.dk=e.k==='cat'?1:0}
{const _ck=click;click=function(cx,cy,btn,add){try{if(!OFF&&mineEng()){
    if(btn===0){const e=engAt(cx,cy);if(e){if(!add){selected.clear();SSEL.clear()}SSEL.has(e)&&add?SSEL.delete(e):SSEL.add(e);renderSel();return}if(!add)SSEL.clear()}
    else if(btn===2&&SSEL.size){const p=groundAt(cx,cy);if(p){const [px,py]=W2P(p.x,p.y),tu=pick(p,cx,cy),foe=tu&&tu.side===1?tu:null,arr=[...SSEL].filter(e=>e.st!=='dead');
      const mx=arr.reduce((a,e)=>a+e.x,0)/(arr.length||1),my=arr.reduce((a,e)=>a+e.y,0)/(arr.length||1);
      for(const e of arr){const o=arr.length>1&&!foe?[e.x-mx,e.y-my]:[0,0],k=Math.min(1,160/(Math.hypot(o[0],o[1])||1));engOrder(e,px+o[0]*k,py+o[1]*k,foe)}
      if(!selected.size)return}}}}catch(err){console.warn('villes (ordres)',err)}return _ck.apply(this,arguments)}}
// sélection au cadre
host.addEventListener('pointerup',ev=>{try{if(OFF||!mineEng()||!drag||drag.mode!=='box'||drag.btn!==0)return;const r=host.getBoundingClientRect(),x0=Math.min(drag.sx,ev.clientX),x1=Math.max(drag.sx,ev.clientX),y0=Math.min(drag.sy,ev.clientY),y1=Math.max(drag.sy,ev.clientY);
  if(!drag.add)SSEL.clear();for(const e of SIEGE){if(e.st==='dead')continue;const [fx,fy]=P2F(e.x,e.y),q=toScreen(fx*G,fy*G,0),sx=q.x+r.left,sy=q.y+r.top;if(sx>=x0&&sx<=x1&&sy>=y0&&sy<=y1)SSEL.add(e)}}catch(err){}},true);
addEventListener('keydown',ev=>{if(ev.key==='Escape')SSEL.clear()});
try{const b=document.getElementById('bNone');if(b)b.addEventListener('click',()=>{SSEL.clear();renderSel()})}catch(e){}
{const _h=halt;halt=function(){for(const e of SSEL)if(e.st==='move'){e.st='idle';e.tx=e.x;e.ty=e.y;e.dk=e.k==='cat'?1:0;if(e.k==='cat')e.st='dock'}return _h.apply(this,arguments)}}
// fiche dans le panneau de sélection
const ENGST=e=>e.st==='dead'?'Détruite':e.st==='move'?(e.dk&&e.k==='tow'?'Roule vers le mur':e.dk&&e.k==='rams'?'Roule vers la '+((e.gate&&e.gate.n)||'porte'):'En route'):e.st==='dock'?(e.k==='tow'?'Accostée : on y monte':e.k==='rams'?(e.gate&&!e.gate.broken?'Frappe la '+(e.gate.n||'porte'):'Porte enfoncée'):(e.tgt&&!e.tgt.dead?'Tire sur '+(e.tgt.label||'la cible'):'En batterie')):'À l\'arrêt';
{const _rs=renderSel;renderSel=function(){const r=_rs.apply(this,arguments);try{for(const e of SSEL)if(e.st==='dead')SSEL.delete(e);if(!SSEL.size)return r;const b=document.getElementById('selBody');if(!b)return r;
  const arr=[...SSEL],h=arr.map(e=>{const f=Math.max(0,e.hp/e.hp0);return `<div class="row"><span>${arr.length>1?ENGT[e.k]:'Solidité '+Math.round(f*100)+' %'}</span><span>${ENGST(e)}</span></div><div class="meter"><i style="width:${f*100}%;background:${f>.5?'#d6b878':'#d24a3a'}"></i></div>`}).join('');
  const tip='<div style="color:var(--muted);font-size:12px;line-height:1.35">Clic droit : sur un mur, la tour y accoste ; sur une porte, le bélier la frappe ; sur un ennemi, la catapulte le vise ; ailleurs, l\'engin s\'y rend.</div>';
  const head=selected.size?'':`<h2>${arr.length>1?arr.length+' engins de siège':ENGT[arr[0].k]}</h2>`;b.innerHTML=(selected.size?b.innerHTML:'')+head+h+tip}catch(e){}return r}}
function drawSiege(g2,px){const lw=v=>Math.max(v,v*.35*px);
  for(const e of SIEGE){const a=e.st==='move'&&e.ha!=null&&!e.dk?e.ha:e.st==='idle'&&e.ha!=null?e.ha:Math.atan2(e.iy,e.ix),dead=e.st==='dead';
    if(SSEL.has(e)&&!dead){const r=e.k==='tow'?22:e.k==='rams'?19:13;g2.strokeStyle='#fff2c0';g2.lineWidth=Math.max(2,1.4*px);g2.setLineDash([6,4]);g2.beginPath();g2.arc(e.x,e.y,r,0,6.283);g2.stroke();
      if(e.st==='move'){g2.strokeStyle='rgba(255,242,192,.7)';g2.beginPath();g2.moveTo(e.x,e.y);g2.lineTo(e.tx,e.ty);g2.stroke()}g2.setLineDash([])}g2.save();g2.translate(e.x,e.y);g2.rotate(a);const SZ=e.k==='tow'?1.5:e.k==='rams'?1.3:1.4;g2.scale(SZ,SZ);
    if(e.k==='tow'){// tour roulante : 22 m de profondeur, 20 de large, peaux mouillées sur la face, pont-levis abaissé quand elle accoste
      if(e.st==='dock'&&!dead){g2.fillStyle='rgba(30,20,10,.3)';g2.fillRect(11,-6+3,30,12);g2.fillStyle='#9a7a52';g2.fillRect(11,-6,30,12);g2.strokeStyle='#3a2a18';g2.lineWidth=lw(1);g2.strokeRect(11,-6,30,12);for(let x=15;x<41;x+=4){g2.beginPath();g2.moveTo(x,-6);g2.lineTo(x,6);g2.stroke()}}
      g2.fillStyle='rgba(30,20,10,.38)';g2.fillRect(-11+5,-10+6,22,20);
      for(const [wx,wy] of [[-8,-12],[6,-12],[-8,10],[6,10]]){g2.fillStyle='#2a1e12';g2.fillRect(wx-2.5,wy-1,5,3)}
      g2.fillStyle=dead?'#2b2420':'#6b4c30';g2.fillRect(-11,-10,22,20);g2.strokeStyle='#2a1c10';g2.lineWidth=lw(1.6);g2.strokeRect(-11,-10,22,20);
      if(!dead){g2.strokeStyle='rgba(40,26,14,.55)';g2.lineWidth=lw(.8);for(let y=-7;y<10;y+=3.4){g2.beginPath();g2.moveTo(-11,y);g2.lineTo(11,y);g2.stroke()}
        g2.fillStyle='#8a6a48';g2.fillRect(-7,-6,14,12);g2.strokeStyle='#2a1c10';g2.lineWidth=lw(1);g2.strokeRect(-7,-6,14,12);
        g2.fillStyle='#7b5f45';g2.fillRect(8,-10,3,20); // peaux sur la face
        g2.fillStyle='#3a2a18';for(let y=-9;y<10;y+=4)g2.fillRect(-7,y,2,2)}}
    else if(e.k==='rams'){// bélier sous sa tortue : toit à deux pans, poutre ferrée qui dépasse
      const hit=e.hit&&time-e.hit<.5?Math.sin(time*9)*2.5:0;
      g2.fillStyle='rgba(30,20,10,.35)';g2.fillRect(-12+3,-6+4,24,12);
      if(!dead){g2.fillStyle='#4a3420';g2.fillRect(-4+hit,-1.8,22,3.6);g2.fillStyle='#5c5a55';g2.beginPath();g2.moveTo(18+hit,-3);g2.lineTo(23+hit,0);g2.lineTo(18+hit,3);g2.closePath();g2.fill()}
      g2.fillStyle=dead?'#2b2420':'#7a5c3c';g2.fillRect(-12,-6,24,6);g2.fillStyle=dead?'#231d1a':'#5f462c';g2.fillRect(-12,0,24,6);
      g2.strokeStyle='#2a1c10';g2.lineWidth=lw(1.2);g2.strokeRect(-12,-6,24,12);g2.beginPath();g2.moveTo(-12,0);g2.lineTo(12,0);g2.stroke();
      if(!dead){g2.strokeStyle='rgba(40,26,14,.5)';g2.lineWidth=lw(.7);for(let x=-9;x<12;x+=3.5){g2.beginPath();g2.moveTo(x,-6);g2.lineTo(x,6);g2.stroke()}}}
    else{// catapulte : bâti, roues, bras qui se relève après le tir
      g2.fillStyle='rgba(30,20,10,.32)';g2.fillRect(-7+3,-6+3,14,12);
      for(const [wx,wy] of [[-5,-7.5],[4,-7.5],[-5,6],[4,6]]){g2.fillStyle='#2a1e12';g2.fillRect(wx-2,wy,4,1.6)}
      g2.fillStyle=dead?'#2b2420':'#7a5c3c';g2.fillRect(-7,-6,14,12);g2.strokeStyle='#2a1c10';g2.lineWidth=lw(1.2);g2.strokeRect(-7,-6,14,12);
      if(!dead){const f=e.fire?Math.min(1,(time-e.fire)/1.2):1,L=-9+18*(1-f);g2.strokeStyle='#4a3420';g2.lineWidth=lw(2.2);g2.beginPath();g2.moveTo(-2,0);g2.lineTo(L,0);g2.stroke();
        g2.fillStyle='#5c5a55';g2.beginPath();g2.arc(L,0,1.8,0,6.283);g2.fill();g2.fillStyle='#3a2a18';g2.fillRect(2,-6,2,12)}}
    g2.restore();
    // feu et fumée
    const hot=dead?Math.max(0,1-(time-e.burn)/25):e.hp<e.hp0*.5?.5:0;
    if(hot>0){const n=e.k==='tow'?9:5;for(let i=0;i<n;i++){const t=time*3+i*1.7,r=(e.k==='tow'?9:5)*(.5+.5*Math.sin(t*1.3+i)),ox=Math.sin(i*2.1+t)*6,oy=Math.cos(i*1.3+t*.8)*6;
      g2.fillStyle=`rgba(${230+Math.sin(t)*20|0},${90+Math.sin(t*1.7)*50|0},30,${.55*hot})`;g2.beginPath();g2.arc(e.x+ox,e.y+oy,r,0,6.283);g2.fill()}}
    if(dead||e.hp<e.hp0*.5){for(let i=0;i<4;i++){const f=((time*.25+i*.25)%1),r=6+f*16;g2.fillStyle=`rgba(50,45,40,${.35*(1-f)})`;g2.beginPath();g2.arc(e.x+f*18,e.y-f*24,r,0,6.283);g2.fill()}}
    // état
    if(!dead&&e.hp<e.hp0){const w=e.k==='tow'?34:22,f=Math.max(0,e.hp/e.hp0),yb=e.y-(e.k==='tow'?26:18);g2.fillStyle='rgba(20,16,10,.7)';g2.fillRect(e.x-w/2,yb,w,Math.max(2.5,1.4*px));g2.fillStyle=f>.5?'#d8b25a':'#d0513f';g2.fillRect(e.x-w/2,yb,w*f,Math.max(2.5,1.4*px))}}
  // pierres en vol : ombre au sol, pierre en cloche
  for(const st of STONES){const f=st.t/st.dur,x=st.x0+(st.tx-st.x0)*f,y=st.y0+(st.ty-st.y0)*f,h=Math.sin(f*Math.PI)*60;g2.fillStyle='rgba(20,15,10,.3)';g2.beginPath();g2.arc(x,y,2.4,0,6.283);g2.fill();g2.fillStyle='#4a4640';g2.beginPath();g2.arc(x-h*.3,y-h,Math.max(2.6,1.2*px),0,6.283);g2.fill()}}
/* ---- tours qui tirent ---- */
const ARW=[];
function towers(dt){for(const q of TOWERS){q.cd-=dt;if(q.cd>0)continue;q.cd=2.6+Math.random()*1.2;
  const [fx,fy]=P2F(q.x,q.y),wx=fx*G,wy=fy*G;let best=null,bd=170*G;
  for(const e of units){if(e.side!==ATTS||e.dead||e.pend||e.routing)continue;const d=Math.hypot(e.x-wx,e.y-wy);if(d<bd){bd=d;best=e}}
  if(!best)continue;const tg=best;ARW.push({x0:q.x,y0:q.y,e:tg,tx:W2P(tg.x,tg.y),t:0,dur:.5+bd/G/400,dmg:6/(tg.T.def||1)*(tg.T.kind==='eleph'?.2:1)})}
  for(let i=ARW.length-1;i>=0;i--){const a=ARW[i];a.t+=dt;if(a.t>=a.dur){ARW.splice(i,1);if(!a.e.dead){hurt(a.e,a.dmg);a.e.underFire=1.5;a.e.morale-=.3;if(a.e.morale<=0&&!a.e.routing)rout(a.e)}}}}
/* ---- citadelle à tenir ---- */
let CAP=0,TAKEN=false;const CAPT=60;
function capture(dt){if(TAKEN)return;const pt=P.pt;let a=0,d=0;
  for(const u of units){if(u.dead||u.pend||u.routing)continue;const [x,y]=W2P(u.x,u.y);if(Math.hypot(x-pt.x,y-pt.y)<pt.r){if(u.side===ATTS)a++;else d++}}
  if(a&&!d)CAP+=dt;else if(d&&!a)CAP=Math.max(0,CAP-dt*.5);
  if(CAP>=CAPT){TAKEN=true;say((pt.n.charAt(0).toUpperCase()+pt.n.slice(1))+' est prise !',ATTS===0?'#cbb1ee':'#f1a097');
    for(const u of units)if(u.side===DEFS&&!u.dead&&!u.routing)rout(u)}}
window.__villes={P,MODE,DEFS,ENGS,SIEGE,SSEL,engOrder,scr:(x,y)=>{const q=toScreen(x,y,0),r=host.getBoundingClientRect();return [q.x+r.left,q.y+r.top]},SEG,GAPS,TOWERS,W2P,P2F,G,get time(){return time},get cap(){return CAP/CAPT},inCity,inTown,onRampart,blockOf,dbgPt:(x,y)=>({town:inTown(x,y),water:inWater(x,y),cit:inCit(x,y),plaza:onPlaza(x,y),wall:nearWall(x,y,8),road:nearRoad(x,y,9),free:free(x,y)})};
{const _su=setup;setup=function(){CAP=0;TAKEN=false;ARW.length=0;STONES.length=0;for(const g of GAPS)if(g.kind==='porte'){g.hp=28;g.broken=false}const r=_su.apply(this,arguments);try{place()}catch(e){console.warn('villes',e)}return r}}
// carte de départ
try{const card=document.querySelector('#start .card'),ps=card&&card.querySelectorAll('p');if(ps&&ps[0]){const p=document.createElement('p');p.className='ville-p';p.style.cssText='margin:6px 0;font-size:13px;line-height:1.45';
  const eng=Object.keys(ENGS).filter(k=>ENGS[k]).map(k=>ENGN[k]);const engTxt=eng.length?` Machines de siège ${DEFS===0?'de l\'ennemi':'à votre disposition'} : ${eng.join(', ')}.`:'';
  p.textContent=(MODE==='assaut'?(DEFS===0?`Vous défendez ${P.n}. Vos premières lignes tiennent le rempart. Si l'ennemi tient ${P.pt.n} une minute, la ville tombe.`:P.txt+(NBR?` ${NBR>1?NBR+' brèches sont ouvertes':'Une brèche est ouverte'} par le siège.`:'')):`Les murs de ${P.n} bordent le champ de bataille : portes fermées, on ne passe pas.`)+(MODE==='assaut'?engTxt:'');ps[0].after(p)}}catch(e){}

