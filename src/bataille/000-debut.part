<meta charset="utf-8">
<title>Bataille de l'Aufide 3D</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@400;500;600&family=Marcellus&display=swap">
<style>
body.intro>:not(#gl){opacity:0!important;pointer-events:none!important}
body>:not(#gl){transition:opacity .5s}
/* Layout: plein écran — la carte en relief remplit tout, le commandement flotte en panneaux de bronze par-dessus */
:root{
  --ground:#9aa38a;
  --panel:rgba(20,18,14,.86);
  --line:rgba(214,184,120,.30);
  --ink:#efe6d2;
  --muted:#b5a98f;
  --gold:#d6b878;
  --punic:#7d4fb8;
  --roma:#bf3b31;
  --display:"Marcellus",Georgia,"Times New Roman",serif;
  --ui:"Barlow Semi Condensed","Arial Narrow",system-ui,sans-serif;
  color-scheme:dark;
}
html,body{height:100%}
body{background:var(--ground);color:var(--ink);font-family:var(--ui);font-size:15px;overflow:hidden;-webkit-user-select:none;user-select:none}
#app{position:relative;height:100%;overflow:hidden}
#gl{position:absolute;inset:0;touch-action:none;cursor:crosshair}
#gl canvas{display:block;width:100%;height:100%}
#vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,rgba(0,0,0,0) 55%,rgba(30,24,12,.35) 100%)}
.hud{position:absolute;background:var(--panel);border:1px solid var(--line);border-radius:6px;backdrop-filter:blur(4px)}
#top{top:max(10px,env(safe-area-inset-top,0px));left:max(12px,env(safe-area-inset-left,0px));right:max(12px,env(safe-area-inset-right,0px));display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;padding:8px 12px}
.brand{display:flex;flex-direction:column;min-width:0}
.brand h1{margin:0;font-family:var(--display);font-weight:400;font-size:20px;letter-spacing:.03em;line-height:1.1}
.brand span{font-size:12px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase}
#forces{flex:1;min-width:220px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;font-variant-numeric:tabular-nums;font-size:13px}
#forces .bar{height:8px;border-radius:4px;background:var(--roma);overflow:hidden;position:relative}
#forces .bar i{position:absolute;inset:0 auto 0 0;background:var(--punic);transition:width .3s}
.cp{color:#cbb1ee}.cr{color:#f1a097}
.ctrl{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
#clock{font-variant-numeric:tabular-nums;color:var(--muted);min-width:44px;text-align:right}
button{font:inherit;font-size:14px;color:var(--ink);background:rgba(214,184,120,.10);border:1px solid var(--line);border-radius:4px;padding:5px 10px;cursor:pointer}
button:hover{background:rgba(214,184,120,.22)}
button:focus-visible{outline:2px solid var(--gold);outline-offset:1px}
button.on{background:var(--gold);color:#1d1a12;border-color:var(--gold)}
#sel{left:max(12px,env(safe-area-inset-left,0px));bottom:max(12px,env(safe-area-inset-bottom,0px));width:min(300px,calc(100% - 24px));padding:10px 12px;display:flex;flex-direction:column;gap:6px}
#sel h2{margin:0;font-family:var(--display);font-weight:400;font-size:17px}
#sel .k{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.row{display:flex;justify-content:space-between;gap:10px;font-variant-numeric:tabular-nums}
.meter{height:6px;border-radius:3px;background:rgba(255,255,255,.1);overflow:hidden}
.meter i{display:block;height:100%;background:var(--gold)}
.btns{display:flex;gap:6px;flex-wrap:wrap;margin-top:2px}
#mmWrap{right:max(12px,env(safe-area-inset-right,0px));bottom:max(12px,env(safe-area-inset-bottom,0px));padding:6px}
#mm{display:block;width:240px;height:150px;border-radius:3px;cursor:pointer}
#help{right:max(12px,env(safe-area-inset-right,0px));bottom:calc(max(12px,env(safe-area-inset-bottom,0px)) + 176px);padding:10px 12px;max-width:300px;font-size:13px;line-height:1.45;color:var(--muted)}
#help b{color:var(--ink);font-weight:600}
#camBtns{right:max(12px,env(safe-area-inset-right,0px));top:96px;padding:6px;display:flex;flex-direction:column;gap:4px}
#camBtns button{width:36px;padding:4px 0}
@media (max-width:760px){#help{display:none}.brand span{display:none}#mm{width:160px;height:100px}#camBtns{top:auto;bottom:calc(max(12px,env(safe-area-inset-bottom,0px)) + 124px)}}
[hidden]{display:none!important}
.overlay{position:absolute;inset:0;display:grid;place-items:center;background:rgba(12,11,8,.40);padding:16px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:22px 24px;max-width:480px;display:flex;flex-direction:column;gap:12px;text-align:left}
.card h2{margin:0;font-family:var(--display);font-weight:400;font-size:28px;text-wrap:balance}
.card p{margin:0;line-height:1.5;color:var(--muted)}
.card .go{align-self:flex-start;font-size:16px;padding:8px 18px;background:var(--gold);color:#1d1a12;border-color:var(--gold)}
.stats{display:grid;grid-template-columns:1fr auto auto;gap:4px 16px;font-variant-numeric:tabular-nums}
.stats .h{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em}
#tags{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.tag{position:absolute;transform:translate(-50%,-100%);display:flex;flex-direction:column;align-items:center;gap:2px}
.tag b{font-weight:600;font-size:12px;background:rgba(20,18,14,.78);color:var(--ink);padding:1px 6px;border-radius:3px;white-space:nowrap}
.tag .bars{width:38px;background:rgba(0,0,0,.55);padding:1px;border-radius:2px;display:flex;flex-direction:column;gap:1px}
.tag .bars i{display:block;height:3px}
#box{position:absolute;border:1px solid rgba(255,244,200,.9);background:rgba(255,244,200,.08);pointer-events:none}
#fps{position:fixed;left:50%;transform:translateX(-50%);bottom:8px;z-index:6;font:12px/1.3 ui-monospace,Consolas,monospace;background:rgba(12,11,8,.62);color:#cfe8b0;padding:3px 7px;border-radius:4px;pointer-events:none}
#taille select{font:inherit;padding:2px 4px}
#loading{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--display);font-size:22px;color:#2a2618;background:var(--ground);z-index:5}
</style>

<div id="app">
  <div id="gl"></div>
  <div id="vignette"></div>
  <div id="tags"></div>
  <div id="box" hidden></div>
  <div id="loading">Préparation du champ de bataille…</div>

  <div id="top" class="hud">
    <div class="brand"><h1>Bataille de l'Aufide</h1><span>Prototype 3D · Carthage contre Rome</span></div>
    <div id="forces">
      <span class="cp" id="fP">Carthage</span>
      <div class="bar"><i id="fBar" style="width:50%"></i></div>
      <span class="cr" id="fR">Rome</span>
    </div>
    <div class="ctrl">
      <span id="clock">00:00</span>
      <button id="bPause" type="button">Lancer</button>
      <button class="spd on" data-s="1" type="button">×1</button>
      <button class="spd" data-s="2" type="button">×2</button>
      <button class="spd" data-s="4" type="button">×4</button>
      <button id="bReset" type="button">Recommencer</button>
      <button id="bKb" type="button" title="Disposition du clavier">AZERTY</button>
      <button id="bHelp" type="button" title="Aide">?</button>
    </div>
  </div>

  <div id="camBtns" class="hud" aria-label="Caméra">
    <button id="cZin" type="button" title="Zoomer">+</button>
    <button id="cZout" type="button" title="Dézoomer">−</button>
    <button id="cRl" type="button" title="Tourner la caméra">⟲</button>
    <button id="cRr" type="button" title="Tourner la caméra">⟳</button>
    <button id="cTac" type="button" title="Vue tactique (V)">▦</button>
  </div>

  <div id="sel" class="hud">
    <div class="k">Sélection</div>
    <div id="selBody"><p style="margin:0;color:var(--muted)">Aucune unité. Cliquez sur un de vos régiments violets.</p></div>
    <div class="btns">
      <button id="bAll" type="button" title="Ctrl+A">Toute l'armée</button>
      <button id="bHalt" type="button" title="Halte (Retour arrière)">Halte</button>
      <button id="bRotL" type="button" title="Pivoter à gauche (R)">↺</button>
      <button id="bRotR" type="button" title="Pivoter à droite (T)">↻</button>
      <button id="bNone" type="button" title="Échap">Désélectionner</button>
    </div>
  </div>

  <div id="mmWrap" class="hud"><canvas id="mm" width="480" height="300"></canvas></div>

  <div id="help" class="hud" hidden>
    <b>Clic gauche</b> : sélectionner (Ctrl ou Maj : ajouter) · <b>double-clic</b> : tout le même type · <b>glisser</b> : cadre<br>
    <b>Clic droit</b> : marcher · <b>double clic droit</b> : courir / charger<br>
    <b>Clic droit glissé</b> : tracer la ligne de front (largeur et direction) · Maj au relâcher : en courant<br>
    <b>Ctrl+1…9</b> : former un groupe · <b>1…9</b> : le rappeler · <b>Ctrl+A</b> : tout · <b>Retour</b> : halte<br>
    <b><span id="kbHelp">ZQSD</span> / flèches</b> : déplacer · <b><span id="kbRot">A / E</span></b> ou <b>clic molette glissé</b> : tourner · <b>bords de l'écran</b> : défiler<br>
    <b>Molette</b> : zoom vers le curseur · <b>F</b> : centrer sur la sélection · <b>V</b> : vue tactique<br>
    <b>R / T</b> : pivoter l'unité · <b>Espace</b> : pause · <b>Échap</b> : désélectionner
  </div>

  <div id="start" class="overlay">
    <div class="card">
      <h2>Aufide, 216 av. J.-C.</h2>
      <p>Vous commandez Carthage, en violet : douze régiments d'infanterie, huit de cavalerie, des frondeurs et deux troupes d'éléphants. Rome aligne seize légions, huit cohortes de vélites et huit régiments de cavalerie.</p>
      <p>Placez vos troupes pendant que le temps est arrêté, puis lancez la bataille. Les mêlées sont longues : c'est la charge, les flancs et le moral qui décident. Tenez le centre, écrasez les cavaleries adverses et prenez les légions à revers.</p>
      <p style="font-size:13px">Commandes au clic droit comme dans Total War : clic pour marcher, double clic pour courir, glisser pour tracer la ligne de front. Le bouton « ? » en haut à droite détaille tout.</p>
      <div id="taille" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:14px">
        <label>Taille des unités <select id="sTaille"><option value="1">×1 (60 hommes)</option><option value="2">×2 (120)</option><option value="3">×3 (180)</option><option value="4">×4 (240)</option><option value="6">×6 (360, test)</option><option value="8">×8 (480, test)</option></select></label>
        <label><input type="checkbox" id="cOmbres"> Ombres</label>
        <label>Figurines <select id="sFig"><option value="bellum">Bellum (construites)</option><option value="beelim">Modèles Beelim</option></select></label>
      </div>
      <button class="go" id="bGo" type="button">Lancer la bataille</button>
      <button id="bPrep" type="button" style="align-self:flex-start">Préparer le déploiement d'abord</button>
      <button id="bCamp" type="button" style="align-self:flex-start">Mode campagne</button>
      <button id="bRevue" type="button" style="align-self:flex-start">Revue des troupes (toutes les unités et équipements)</button>
      <button id="bPeuples" type="button" style="align-self:flex-start">Revue des peuples (Rome, Macédoine, Sparte, Athènes)</button>
      <p style="font-size:12px">Modèles Beelim : Beelim Solutions.</p>
    </div>
  </div>

  <div id="end" class="overlay" hidden>
    <div class="card">
      <h2 id="endT">Victoire</h2>
      <p id="endP"></p>
      <div class="stats" id="endS"></div>
      <button class="go" id="bAgain" type="button">Rejouer</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
<script>
(function(){
/* Taille des unités (test de charge) : ×1 = 60 fantassins par régiment. Réglée sur l'écran d'accueil ou par ?taille=4 dans l'adresse. */
const SIZES=[1,2,3,4,6,8];
let SIZE=1,SHADOWS=true,FIG='bellum';
try{SIZE=+localStorage.getItem('bellum.taille')||1;SHADOWS=localStorage.getItem('bellum.ombres')!=='0';FIG=localStorage.getItem('bellum.figurines')||'bellum'}catch(e){}
{const q=new URLSearchParams(location.search).get('taille');if(q)SIZE=+q||1}try{if(location.hash.startsWith('#c=')){const c=JSON.parse(decodeURIComponent(location.hash.slice(3)));if(c&&c.pvp&&c.pvp.size)SIZE=+c.pvp.size||1}}catch(e){}/*PVP*/
const REVUE=new URLSearchParams(location.search).has('revue'),REVUE_P=new URLSearchParams(location.search).get('revue')==='peuples'; // revue des troupes : toutes les unités et variantes d'équipement en ligne
if(!SIZES.includes(SIZE))SIZE=1;
const SQ=Math.sqrt(SIZE),SK=k=>k==='eleph'?1:SQ;
/* Échelle du monde : la carte grandit avec la taille des unités (×√taille en largeur et en longueur). W0/H0/RIVER0 = carte d'origine, W/H/RIVER = monde de jeu. */
/* Terrain venu de la campagne (#c=… champ t) : forêts, champs, collines, routes, ville et eau de l'endroit exact de la carte */
const CT=(()=>{try{if(location.hash.startsWith('#c=')){const c=JSON.parse(decodeURIComponent(location.hash.slice(3)));if(c&&c.t&&c.t.v)return c.t}}catch(e){}return null})();
const G=SQ,W0=3200,H0=2000,RIVER0=CT?(CT.water?CT.water.x:-4000):210,W=W0*G,H=H0*G,RIVER=Math.max(0,RIVER0)*G,SEA=!!(CT&&CT.water&&CT.water.sea);
const $=id=>document.getElementById(id);
if(!window.THREE){$('loading').textContent="Impossible de charger le moteur 3D. Rechargez la page.";return}
