/* ================= IA : PLAN DE BATAILLE (fil « Améliorer l'IA du jeu », 10 nov., choix de Baptiste « batailles d'abord ») =================
   L'IA (camp 1) commande par régiment, comme le joueur, au lieu de lancer chaque carré sur l'ennemi le plus proche :
   - plan : elle compare les forces qu'elle voit et le terrain (colline, fleuve entre les armées, renforts attendus) et choisit
     d'attaquer ou de tenir sa position ; si l'ennemi ne vient pas, elle finit par marcher sur lui ;
   - ligne : l'infanterie marche en ligne, régiments côte à côte, au pas du plus lent, puis charge le régiment d'en face ;
     chaque régiment garde ses deux rangs et relève ses carrés épuisés ; une réserve suit derrière et bouche les trous,
     fait face à un débordement ou remplace un régiment usé, qui recule ;
   - ailes : la cavalerie attaque la cavalerie ennemie si elle est assez forte, sinon garde le flanc et contre-charge ;
     ailes libres, elle tourne la ligne ennemie et charge dans le dos des régiments engagés, puis poursuit les fuyards ;
     la cavalerie légère esquive la cavalerie lourde et harcèle ;
   - tirailleurs en écran devant la ligne, qui se replient derrière les ailes quand l'ennemi approche, puis tirent des flancs ;
   - éléphants devant le centre, lâchés sur l'infanterie quand elle est à portée.
   - doctrines (12 nov.) : chaque peuple a sa façon de se battre (table DOC : Rome, Carthage, Macédoine, Grecs, Gaulois, Ibères,
     Thraces/Illyriens, Numides), choisie d'après le peuple reçu de la campagne (pk) ou, à défaut, d'après les troupes.
   Bataille 2D seulement (carrés), pas à l'assaut des murs (l'ancienne IA garde les échelles et les tours).
   Ancienne IA : ?ia=ancienne dans l'adresse, ou window.__iaB.on=false. Source : /mnt/project-files/ia/plan.js (ia/patch_bataille.py). */
{
const IB={on:true,active:false,sd:{},cfg:{res:4,trig:100,follow:0,vk:.85,stop:50}};
const newS=()=>({post:null,pt:-99,A:null,f:null,M:null,E:null,lastE:null,roles:new Map(),why:'',t0:-1,tDef:0,contact:-1,hist:[],st:{relief:0,swap:0,commit:0,flank:0,rear:0}});
let S=newS();
try{if(/[?&]ia=ancienne/.test(location.search)||localStorage.getItem('bellum.ia')==='ancienne')IB.on=false}catch(e){}
// ---- doctrines : chaque peuple a sa façon de se battre (12 nov., demande de Baptiste) ----
// res : un régiment d'infanterie sur « res » en réserve (0 = aucune), resMax ; worn : seuil d'usure où la réserve relève ;
// att / def : rapport de forces au-dessus duquel on attaque, en dessous duquel on tient ; eq : que faire à forces égales ;
// terMax : on ne tient rive ou colline que sous ce rapport de forces ; stall : patience (s) avant de marcher sur un ennemi qui ne vient pas ;
// vk : allure de la ligne ; trig : distance de charge ; rush : distance d'où la ligne se rue en courant ; stop : arrêt avant la charge ;
// arc : centre en retrait (<0) ou en avant (>0), en m ; obl : ordre oblique, aile droite en avant, en m ;
// cavK : audace de la cavalerie (<1 = attaque même plus faible) ; hammer : cavalerie lourde massée à droite ; harass : harcèlement ; eleR : portée de charge des éléphants.
const DOC0={n:'',res:4,resMax:4,worn:.35,att:1.3,def:.75,eq:'att',terMax:9,stall:90,wait:true,vk:.85,trig:100,rush:0,stop:50,arc:0,obl:0,cavK:1,hammer:false,harass:false,eleR:280};
const DOC={
  rom:{n:'Rome : trois lignes qui se relèvent, attaque obstinée',res:3,resMax:6,worn:.5,att:1.1,def:.6,terMax:1,cavK:1.2,stall:60},
  car:{n:'Carthage : centre en retrait, ailes fortes, cavalerie qui enveloppe',arc:-45,cavK:.75,eleR:400,att:1.25},
  mac:{n:'Macédoine : la phalange fixe, la cavalerie frappe à droite',res:6,resMax:2,vk:.7,trig:80,obl:55,hammer:true,att:1.2,def:.7},
  gre:{n:'Grecs : une seule ligne d\'hoplites, serrée et lente',res:0,vk:.75,trig:80,def:.8,cavK:1.1,stall:120},
  gau:{n:'Gaulois : charge furieuse d\'emblée, sans réserve',res:0,vk:1.05,trig:200,rush:330,att:1,def:.45,terMax:0,wait:false,cavK:.8,stall:25},
  ibe:{n:'Ibères : assaut rapide, peu de réserve',res:6,resMax:2,vk:.95,trig:150,rush:220,att:1.1,def:.6,terMax:.9,cavK:.85,stall:60},
  bar:{n:'Thraces et Illyriens : ruée depuis les hauteurs',res:0,vk:.95,trig:160,rush:240,att:1.1,def:.65,terMax:1.1,stall:60},
  num:{n:'Numides : harcèlement, on refuse la mêlée',res:0,att:1.5,def:.9,eq:'def',stall:200,harass:true,vk:.8}};
const DOC_PEO={rom:'rom',ven:'rom',car:'car',pun:'car',mac:'mac',sel:'mac',epi:'mac',per:'mac',thr:'bar',bit:'bar',ill:'bar',dar:'bar',gau:'gau',ins:'gau',lig:'gau',
  cel:'ibe',lus:'ibe',ibe:'ibe',bal:'ibe',num:'num',mae:'num',mau:'num',ath:'gre',syr:'gre',ach:'gre',eto:'gre',mas:'gre',cyr:'gre',cre:'gre',rho:'gre',ion:'gre',byz:'gre',spa:'gre'};
const DOC_TYP={gaul:'gau',iber:'ibe',lib:'car',legion:'rom',hastati:'rom',principes:'rom',triarii:'rom',socii:'rom',phalange:'mac',hypasp:'mac',
  spartiates:'gre',perieques:'gre',athoplites:'gre',thureo:'gre'};
// le peuple vient de la campagne (pk) ; inconnu, on le devine aux troupes
function docOf(side,my){let k=IB.force&&IB.force[side];
  if(!k){try{const pk=typeof PK!=='undefined'&&PK[side];k=DOC_PEO[pk]}catch(e){}}
  if(!k){const c={};let tot=0,lc=0;for(const R of my){const m=R.sq.reduce((a,v)=>a+v.men,0);tot+=m;if(R.k==='lcav')lc+=m;if(R.k==='inf'){const d=DOC_TYP[R.grp[0].type];if(d)c[d]=(c[d]||0)+m}}
    k=lc>tot*.4?'num':Object.keys(c).sort((a,b)=>c[b]-c[a])[0]}
  return Object.assign({k:k||''},DOC0,{res:IB.cfg.res,trig:IB.cfg.trig,vk:IB.cfg.vk,stop:IB.cfg.stop},DOC[k]||{})}
const FSPb=17.6,FRKb=19,WR=5*FSPb,GAP=8;
const okv=v=>!v.dead&&!v.routing&&!v.pend;
const free=v=>okv(v)&&!v.contacts.length&&!v._wd&&!v.amb;
const cenOf=a=>{let x=0,y=0;for(const u of a){x+=u.x;y+=u.y}return {x:x/a.length,y:y/a.length}};
const pwv=v=>v.men*(v.T.atk+(v.T.ranged?v.T.ranged.dmg*.5:0))*(1+(v.T.charge-1)*.25)*Math.sqrt(v.T.def)*(.4+.6*Math.max(0,v.morale)/v.T.morale)*(v.T.tough||1);
const KC=k=>k==='cav'||k==='lcav';
const cx=x=>Math.max(RIVER+20,Math.min(W-20,x)),cy=y=>Math.max(20,Math.min(H-20,y));
function gather(side){const C=window.__carres,L=[];if(!C)return L;
  for(const [id,grp] of C.regs){const g0=grp[0];if(!g0||g0.side!==side)continue;const sq=grp.filter(okv);if(!sq.length)continue;
    L.push({id,grp,sq,k:g0.T.kind,c:cenOf(sq),pw:sq.reduce((s,v)=>s+pwv(v),0),eng:sq.some(v=>v.contacts.length),rt:grp.filter(v=>!v.dead&&!v.pend&&v.routing).length})}
  return L}
// ordres : on ne remplace un ordre que s'il change vraiment (le détour par les gués se recalcule à chaque nouvel ordre)
function mv(v,x,y,face,run){x=cx(x);y=cy(y);const o=v.order;if(o&&o.type==='move'&&Math.hypot(o.x-x,o.y-y)<3&&!!o.run===!!run&&(o.face==null||face==null||Math.abs(angDiff(o.face,face))<.08))return;
  v.order={type:'move',x,y,face,run:!!run}}
function atk(v,t,run){const o=v.order;if(o&&o.type==='attack'&&o.target===t){o.run=!!run;return}v.order={type:'attack',target:t,run:!!run}}
// bloc de 5 carrés de front (ou moins), les frais devant ; rang fixé par v._ibRow (0 = front)
function block(R,S,F,run){const fx=Math.cos(F),fy=Math.sin(F),rx=-fy,ry=fx,sq=R.sq.filter(free);if(!sq.length)return;
  const n=sq.length,cols=Math.min(5,n);let front=sq.filter(v=>!v._ibRow);
  if(front.length<cols){const rest=sq.filter(v=>v._ibRow).sort((a,b)=>frac(b)-frac(a));while(front.length<cols&&rest.length){const v=rest.shift();v._ibRow=0;front.push(v)}}
  if(front.length>cols){front.sort((a,b)=>frac(b)-frac(a));for(const v of front.slice(cols))v._ibRow=1;front=front.slice(0,cols)}
  const back=sq.filter(v=>!front.includes(v)),rows=[front];for(let i=0;i<back.length;i+=cols)rows.push(back.slice(i,i+cols));
  rows.forEach((U,r)=>{const m=U.length,P=[];for(let c=0;c<m;c++){const o=(c-(m-1)/2)*FSPb;P.push([S.x+rx*o-fx*r*FRKb,S.y+ry*o-fy*r*FRKb])}
    U.sort((a,b)=>(a.x*rx+a.y*ry)-(b.x*rx+b.y*ry));U.forEach((u,i)=>{u._pf=null;mv(u,P[i][0],P[i][1],F,run)})})}
// mêlée d'un régiment contre un régiment : le front se répartit sur les carrés ennemis, le second rang suit sa file et relève
function follow(u){const p=u._pf;if(!p||p.dead||p.routing)return;const t=p.order&&p.order.type==='attack'&&p.order.target&&!p.contacts.length?p.order.target:null,a=t?Math.atan2(t.y-p.y,t.x-p.x):p.ang;
  mv(u,p.x-Math.cos(a)*FRKb,p.y-Math.sin(a)*FRKb,a,!!(p.order&&p.order.run))}
// mêlée : chaque carré libre prend le carré ennemi le plus proche devant lui, à deux contre un au plus (S.hit compte
// les attaquants de chaque carré ennemi, pour toute l'armée) ; le second rang suit sa file tant que son chef de file n'est pas au contact
function fight(R,T,run){const TG=T.sq.length?T.sq:T.grp.filter(v=>!v.dead&&!v.pend);if(!TG.length)return;const tc=cenOf(TG),gc=R.c;let fx=tc.x-gc.x,fy=tc.y-gc.y;{const l=Math.hypot(fx,fy)||1;fx/=l;fy/=l}
  const rx=-fy,ry=fx,la=u=>(u.x-gc.x)*rx+(u.y-gc.y)*ry,H=S.hit;
  const pool=TG.slice();for(const e of S.enSq)if(!pool.includes(e)&&Math.abs(e.x-gc.x)<190*G&&Math.abs(e.y-gc.y)<190*G)pool.push(e);
  const pick=u=>{let b=null,bd=1e9;for(const e of pool){const h=H.get(e)||0;if(h>=4)continue;const dx=e.x-u.x,dy=e.y-u.y,d=Math.hypot(dx,dy),fw=(dx*fx+dy*fy)/(d||1);
      const sc=d-h*40+(fw<-.3?120:0)-(e.contacts.length?40:0)-(1-frac(e))*60-(e.morale<e.T.morale*.4?40:0)-(TG.includes(e)?10:0);if(sc<bd){bd=sc;b=e}}return b};
  let heads=R.sq.filter(v=>!v._ibRow&&!v._wd);if(!heads.length){heads=[...R.sq].filter(v=>!v._wd).sort((a,b)=>frac(b)-frac(a)).slice(0,5);heads.forEach(v=>v._ibRow=0)}
  for(const u of R.sq){if(u.contacts.length||u._wd||u.amb||u._ibRel)continue;
    if(u._ibRow){if(!u._pf||u._pf.dead||u._pf.routing||u._pf._ibRow){let b=null,bd=1e9;for(const h of heads){const q=Math.abs(la(h)-la(u));if(q<bd){bd=q;b=h}}u._pf=b}
      const p=u._pf;if(p&&(p.dead||p.routing)){u._pf=null;u._ibRow=0}
      else if(p&&!p.contacts.length&&Math.hypot(p.x-u.x,p.y-u.y)<IB.cfg.follow*G){follow(u);continue}}
    const cur=u.order&&u.order.type==='attack'&&u.order.target;
    if(cur&&!cur.dead&&!cur.routing&&!cur.pend&&(H.get(cur)||0)<=4&&Math.hypot(cur.x-u.x,cur.y-u.y)<220*G){u.order.run=!!run||Math.hypot(cur.x-u.x,cur.y-u.y)<90*G;continue}
    if(cur)H.set(cur,Math.max(0,(H.get(cur)||1)-1));
    const e=pick(u);if(!e){follow(u);continue}H.set(e,(H.get(e)||0)+1);atk(u,e,!!run||Math.hypot(e.x-u.x,e.y-u.y)<90*G)}}
// relève dans le régiment : un carré frais monte, le carré épuisé recule (même mécanique que pour le joueur : u._wd)
function relieve(R){for(const v of R.sq)if(v.contacts.length)v._lastE=v.contacts[0];
  for(const v of R.sq)if(v._ibRel){const w=v._ibRel;if(w.dead||w.routing||!w.contacts.length){v._ibRel=null;continue}
    if(v.contacts.length){v._ibRel=null;v._ibRow=0;w._ibRow=1;w._wd=time;w._pf=v;w._row=1;w.order=null;S.st.swap++}}
  if(time<(R.grp._ibR||0))return;const eng=R.sq.filter(v=>v.contacts.length&&!v._wd);
  const weak=eng.filter(v=>(frac(v)<.45||v.morale<v.T.morale*.4)&&!R.sq.some(f=>f._ibRel===v)).sort((a,b)=>frac(a)-frac(b))[0];if(!weak)return;
  const fresh=R.sq.filter(v=>free(v)&&!v._ibRel&&frac(v)>.65&&v.morale>v.T.morale*.6&&Math.hypot(v.x-weak.x,v.y-weak.y)<90).sort((a,b)=>Math.hypot(a.x-weak.x,a.y-weak.y)-Math.hypot(b.x-weak.x,b.y-weak.y))[0];if(!fresh)return;
  fresh._ibRel=weak;fresh._pf=null;atk(fresh,weak.contacts[0],true);R.grp._ibR=time+2.5;S.st.relief++}
// ---- terrain : colline proche, fleuve entre les armées ----
function hillNear(M,E){let best=null,bv=-1e9;const L=[];try{if(HILLg&&HILLg.r>1)L.push(HILLg);for(const q of HILLS||[])L.push({x:q.x*G,y:q.y*G,r:q.r*G})}catch(e){}
  for(const h of L){const dM=Math.hypot(h.x-M.x,h.y-M.y),dE=E?Math.hypot(h.x-E.x,h.y-E.y):1e9;if(dM>520*G||dE<dM*.9)continue;const v=h.r-dM*.6;if(v>bv){bv=v;best=h}}return best}
function riverBetween(M,E){const g=window.__rgGeo;if(!g||!E)return null;try{return g.segHit(M.x,M.y,E.x,E.y)}catch(e){return null}}
// ---- rôles ----
function assign(my,f,M){const rx=-f.y,ry=f.x,lat=R=>(R.c.x-M.x)*rx+(R.c.y-M.y)*ry,D=S.D;
  for(const R of my){if(S.roles.has(R.id))continue;const k=R.k;let ro;
    if(k==='inf')ro=S.t0<0?'line':'res';else if(KC(k))ro=lat(R)<0?'wL':'wR';else if(k==='skirm')ro='scr';else ro='ele';
    S.roles.set(R.id,{ro,pw0:R.pw,st:'',t:null});for(const v of R.grp){v.res=false;if(v._ibRow==null)v._ibRow=v._sr<0?1:0}}
  if(S.t0<0){// réserve : un régiment d'infanterie sur quatre (jusqu'à quatre), pris à intervalles réguliers dans la ligne
    const L=my.filter(R=>R.k==='inf').sort((a,b)=>lat(a)-lat(b)),n=L.length,r=D.res&&n>=D.res?Math.min(D.resMax,Math.round(n/D.res)):0;
    if(r){const st=n/r;for(let j=0;j<r;j++){const R=L[Math.min(n-1,Math.floor(st*j+st/2))];S.roles.get(R.id).ro='res'}}
    // une aile vide reçoit la moitié de l'autre
    const wl=my.filter(R=>S.roles.get(R.id).ro==='wL'),wr=my.filter(R=>S.roles.get(R.id).ro==='wR');
    if(wl.length+wr.length>=2&&(!wl.length||!wr.length)){const A=(wl.length?wl:wr).sort((a,b)=>lat(a)-lat(b)),h=Math.floor(A.length/2);
      (wl.length?A.slice(A.length-h):A.slice(0,h)).forEach(R=>S.roles.get(R.id).ro=wl.length?'wR':'wL')}
    // marteau : la cavalerie lourde se masse à l'aile droite, la légère garde la gauche
    if(D.hammer){const C=my.filter(R=>KC(R.k)).sort((a,b)=>(b.k==='cav')-(a.k==='cav')||b.pw-a.pw),h=Math.max(1,Math.min(C.length-1,Math.ceil(C.length*.7)));
      if(C.length>=2)C.forEach((R,i)=>S.roles.get(R.id).ro=i<h?'wR':'wL')}
    S.t0=time}}
// ---- le plan ----
function tick(side){side=side==null?1:side;
  if(side===1)IB.active=false;
  if(side===1&&!IB.on||typeof MODE!=='undefined'&&MODE==='assaut'||REVUE||REVUE_P||window.__vue3d)return false;
  if(!window.__carres||!window.__carres.regs.size)return false;
  const my=gather(side);if(!my.length)return false;S=IB.sd[side]||(IB.sd[side]=newS());if(side===1)IB.active=true;
  const en=gather(1-side),enF=en.filter(R=>!R.rt||R.sq.length>R.rt);
  S.enSq=[];for(const R of en)for(const v of R.sq)S.enSq.push(v);S.hit=new Map();for(const R of my)for(const v of R.sq){const t=v.contacts[0]||(v.order&&v.order.type==='attack'&&v.order.target);if(t)S.hit.set(t,(S.hit.get(t)||0)+1)}
  const M=cenOf(my.map(R=>R.c));let E=enF.length?cenOf(enF.map(R=>R.c)):S.lastE;
  if(enF.length)S.lastE=E;if(!E)E={x:W-M.x+RIVER*.5,y:H-M.y};
  let fx=E.x-M.x,fy=E.y-M.y;{const l=Math.hypot(fx,fy)||1;fx/=l;fy/=l}
  if(S.f){const a=S.f.x*.85+fx*.15,b=S.f.y*.85+fy*.15,l=Math.hypot(a,b)||1;fx=a/l;fy=b/l}S.f={x:fx,y:fy};
  const f=S.f,rx=-f.y,ry=f.x,F=Math.atan2(f.y,f.x);S.M=M;S.E=E;
  if(!S.D)S.D=docOf(side,my);const D=S.D;
  assign(my,f,M);const role=R=>S.roles.get(R.id);
  const myP=my.reduce((s,R)=>s+R.pw,0),enP=enF.reduce((s,R)=>s+R.pw,0)||0,ratio=enP?myP/enP:1;
  S.enP0=Math.max(S.enP0||0,enP);S.myP0=Math.max(S.myP0||0,myP);
  const anyEng=my.some(R=>R.eng);if(anyEng&&S.contact<0)S.contact=time;if(anyEng)S.lastEng=time;
  // posture : toutes les 8 s
  if(!S.post||time-S.pt>8){
    const RES=(window.__echelle&&window.__echelle.res)||[],pM=RES.some(r=>r.side===side&&!r.done),pE=RES.some(r=>r.side!==side&&!r.done);
    let hill=hillNear(M,enF.length?E:null),riv=enF.length?riverBetween(M,E):null,p,why;
    // le terrain choisi à la première vue de l'ennemi est gardé tant que le combat n'a pas commencé
    if(enF.length&&S.ter===undefined)S.ter=hill||riv?{hill,riv}:null;
    const lineEng=my.some(R=>R.eng&&role(R)&&role(R).ro==='line');
    if(S.ter&&!lineEng&&!hill&&!riv){hill=S.ter.hill;riv=S.ter.riv}
    if(!enF.length){p=hill||riv?'def':'avance';why=hill||riv?'tient sa position sans voir l\'ennemi':'avance prudemment, sans voir l\'ennemi'}
    else if(D.wait&&pM&&ratio<1.5&&!anyEng){p='def';why='attend ses renforts'}
    else if(pE&&ratio>=.8){p='att';why='attaque avant l\'arrivée des renforts ennemis'}
    else if(ratio>=Math.max(D.att,1.15)){p='att';why='plus forte : attaque'}
    else if(ratio>=D.att&&!(hill||riv)){p='att';why='se croit assez forte : attaque'}
    else if(ratio<D.def){p='def';why='plus faible : tient '+(hill?'la colline':riv?'la rive':'sa position')}
    else if((hill||riv)&&ratio<D.terMax+(S.post==='def'?.2:0)){p='def';why='tient '+(hill?'la colline':'la rive')}
    else if(D.eq==='def'){p='def';why='refuse la mêlée et laisse venir'}
    else{p='att';why=hill||riv?'attaque malgré le terrain':'forces égales, terrain plat : attaque'}
    // l'ennemi ne vient pas : au bout d'une minute et demie sans combat, on marche sur lui
    if(p==='def'&&S.post!=='def')S.tDef=time;
    if(p==='def'&&!anyEng&&time-Math.max(S.tDef,S.lastEng??-1e9)>D.stall&&enF.length&&ratio>=.6&&Math.hypot(E.x-M.x,E.y-M.y)>380*G){p='att';why='l\'ennemi ne vient pas : marche sur lui';S.march=time}
    if(p==='def'&&S.march!=null&&(S.lastEng??-1)<S.march&&time-S.march<150&&ratio>=.6){p='att';why='l\'ennemi ne vient pas : marche sur lui'}
    // au contact, on ne change pas d'avis pour un rien
    if(anyEng&&S.post&&p!==S.post&&!(S.post==='att'&&p==='def'&&ratio<.6)&&!(S.post==='def'&&p==='att'&&ratio>=1.3)){p=S.post;why=S.why}
    // poursuite : l'ennemi s'effondre
    if(enF.length&&S.enP0&&enP<S.enP0*.3&&ratio>2)p='att',why='poursuite';
    if(p!==S.post){S.hist.push([Math.round(time),p,why]);if(p==='def'&&S.post==null)S.Adef=hill?{x:hill.x+f.x*Math.min(hill.r*.25,40*G),y:hill.y+f.y*Math.min(hill.r*.25,40*G)}:riv?{x:riv.x-f.x*(riv.R.hw+110*G),y:riv.y-f.y*(riv.R.hw+110*G)}:null}
    S.post=p;S.why=why;S.pt=time;S.hill=hill;S.riv=riv}
  // ---- ligne d'infanterie ----
  const line=my.filter(R=>role(R).ro==='line'),res=my.filter(R=>role(R).ro==='res'||role(R).ro==='worn'),lat=p=>(p.x-M.x)*rx+(p.y-M.y)*ry;
  line.sort((a,b)=>(role(a).ord??lat(a.c))-(role(b).ord??lat(b.c)));line.forEach((R,i)=>{if(role(R).ord==null)role(R).ord=lat(R.c)});
  const n=line.length,Lw=Math.max(1,n)*(WR+GAP);
  if(!S.A){const L0=line.length?line:my;S.A=cenOf(L0.map(R=>R.c))}
  if(S.post==='def'&&S.Adef&&S.contact<0){const d=Math.hypot(S.Adef.x-S.A.x,S.Adef.y-S.A.y),st=Math.min(d,9*.8);if(d>1){S.A={x:S.A.x+(S.Adef.x-S.A.x)/d*st,y:S.A.y+(S.Adef.y-S.A.y)/d*st}}}
  const inM=line.filter(R=>role(R).st==='m').length;
  if(S.post!=='def'&&inM<Math.max(1,n/3)){// la ligne avance au pas du plus lent
    let v=1e9;for(const R of line)for(const s of R.sq)v=Math.min(v,s.T.speed);if(v>1e8)v=12;v*=S.post==='avance'?.5:D.vk;
    // on s'arrête à 70 m du premier régiment ennemi qui fait face (la charge part de là)
    let gap=1e9;for(const R of enF){if(R.k==='skirm')continue;const d=(R.c.x-S.A.x)*f.x+(R.c.y-S.A.y)*f.y;if(d>0&&Math.abs(lat(R.c)-lat(S.A))<Lw/2+250*G)gap=Math.min(gap,d)}
    S.rush=!!(D.rush&&S.post==='att'&&gap<D.rush*G);if(S.rush)v*=RUN*.9;
    const st=Math.max(0,Math.min(v*.8,gap-D.stop*G));S.A={x:S.A.x+f.x*st,y:S.A.y+f.y*st}}
  else S.rush=false;
  const A=S.A;
  // le régiment ennemi d'en face (le plus proche dans un cône devant)
  const facing=(R,rad,cone)=>{let b=null,bd=1e9;for(const T of enF){if(T.k==='skirm'&&rad<200*G)continue;const dx=T.c.x-R.c.x,dy=T.c.y-R.c.y,d=Math.hypot(dx,dy);if(d>rad)continue;
      const along=(dx*f.x+dy*f.y)/(d||1);if(along<cone)continue;const sc=d*(1.4-along)*(T.eng?.85:1);if(sc<bd){bd=sc;b=T}}return b};
  const S0=S;
  line.forEach((R,i)=>{const ro=role(R);relieve(R);
    // forme de la ligne : centre en retrait ou en avant (arc), ordre oblique (obl) ; seulement en marchant à l'ennemi
    const q=n>1?i/(n-1)-.5:0,off=S0.post==='def'?0:(D.arc*(1-4*q*q)+D.obl*q)*G;
    const S={x:A.x+rx*(i-(n-1)/2)*(WR+GAP)+f.x*off,y:A.y+ry*(i-(n-1)/2)*(WR+GAP)+f.y*off};
    if(ro.st==='m'){const T=ro.t&&en.find(x=>x.id===ro.t);if(T&&T.sq.length>T.rt&&T.sq.some(okv)){fight(R,T,Math.hypot(T.c.x-R.c.x,T.c.y-R.c.y)<90*G);return}
      const N2=facing(R,220*G,-.2);if(N2){ro.t=N2.id;fight(R,N2,true);return}ro.st='';ro.t=null}
    const trig=R.eng?999:S0.post==='def'?(S0.contact>=0?120*G:60*G):S0.post==='avance'?90*G:inM>=n/3?260*G:D.trig*G;
    const T=facing(R,trig,R.eng?-1:.25);
    if(T){ro.st='m';ro.t=T.id;fight(R,T,true);return}
    block(R,S,F,S0.rush)});
  // ---- réserve : bouche les trous, fait face aux débordements, remplace les régiments usés ----
  const lineEnds=[A.x-rx*Lw/2,A.y-ry*Lw/2,A.x+rx*Lw/2,A.y+ry*Lw/2];
  const resFree=res.filter(R=>role(R).ro==='res'&&role(R).st!=='m');
  // menace de flanc : un régiment ennemi (pas des tirailleurs) au-delà du bout de la ligne, à moins de 220 m
  for(const T of enF){if(T.k==='skirm')continue;const lt=lat(T.c)-lat(A),ov=Math.abs(lt)-Lw/2;if(ov<0)continue;
    const end=lt<0?{x:lineEnds[0],y:lineEnds[1]}:{x:lineEnds[2],y:lineEnds[3]};if(Math.hypot(T.c.x-end.x,T.c.y-end.y)>220*G)continue;
    if(my.some(R=>role(R).t===T.id&&role(R).st==='m'))continue;
    const c=resFree.filter(R=>role(R).st!=='m').sort((a,b)=>Math.hypot(a.c.x-T.c.x,a.c.y-T.c.y)-Math.hypot(b.c.x-T.c.x,b.c.y-T.c.y))[0];
    if(c){role(c).st='m';role(c).t=T.id;S.st.flank++;resFree.splice(resFree.indexOf(c),1)}}
  // régiment de ligne usé ou en miettes : la réserve prend sa place, il recule
  for(const R of line){const ro=role(R);const worn=R.sq.length<=3||R.pw<ro.pw0*D.worn;if(!worn||!resFree.length)continue;
    const c=resFree.sort((a,b)=>Math.hypot(a.c.x-R.c.x,a.c.y-R.c.y)-Math.hypot(b.c.x-R.c.x,b.c.y-R.c.y)).shift(),rc=role(c);
    rc.ro='line';rc.ord=ro.ord;rc.st=ro.st;rc.t=ro.t;ro.ro='worn';ro.st='';ro.t=null;S.st.commit++;
    for(const v of R.sq)if(!v.contacts.length){v._pf=null}}
  // régiment de ligne détruit : la réserve vient prendre sa place dans l'ordre de la ligne (le trou se referme de lui-même sinon)
  res.forEach((R,j)=>{const ro=role(R);relieve(R);
    if(ro.st==='m'){const T=en.find(x=>x.id===ro.t);if(T&&T.sq.length>T.rt){fight(R,T,true);return}ro.st='';ro.t=null}
    if(R.eng){const T=facing(R,200*G,-1);if(T){ro.st='m';ro.t=T.id;fight(R,T,true);return}}
    const m=res.length,o=(j-(m-1)/2)*(WR+GAP*3),back=ro.ro==='worn'?220*G:FRKb*2+80*G;
    block(R,{x:A.x-f.x*back+rx*o,y:A.y-f.y*back+ry*o},F,false)});
  // ---- ailes de cavalerie ----
  for(const [wk,s] of [['wL',-1],['wR',1]]){const C=my.filter(R=>role(R).ro===wk);if(!C.length)continue;
    const base={x:A.x+rx*s*(Lw/2+WR/2+30*G),y:A.y+ry*s*(Lw/2+WR/2+30*G)};
    const EC=enF.filter(T=>KC(T.k)&&(Math.sign(lat(T.c)-lat(A))===s||Math.hypot(T.c.x-base.x,T.c.y-base.y)<380*G)&&Math.hypot(T.c.x-base.x,T.c.y-base.y)<750*G);
    const cp=C.reduce((a,R)=>a+R.pw,0),ep=EC.reduce((a,T)=>a+T.pw,0),wK=D.cavK*(D.hammer?(s>0?.7:1.3):1),strong=!EC.length||cp>=ep*(S.post==='att'?.75:.9)*wK;
    // proie : régiment d'infanterie ennemi engagé le plus au bout de la ligne, de notre côté
    const prey=enF.filter(T=>!KC(T.k)&&T.eng).sort((a,b)=>s*(lat(b.c)-lat(a.c)))[0];
    const runners=enF.filter(T=>T.rt>0||T.k==='skirm');
    C.forEach((R,k)=>{const ro=role(R),light=R.k==='lcav';
      const slot={x:base.x+rx*s*k*(WR+GAP)-f.x*10*G,y:base.y+ry*s*k*(WR+GAP)-f.y*10*G};
      if(R.eng){const T=facing(R,160*G,-1);if(T){fight(R,T,true);return}}
      // cavalerie légère : elle ne se mesure pas à la cavalerie lourde ; menacée, elle s'écarte (elle est plus rapide)
      if(light&&D.harass&&!R.eng){const ti=enF.filter(T=>!KC(T.k)&&T.k!=='skirm').map(T=>[T,Math.hypot(T.c.x-R.c.x,T.c.y-R.c.y)]).filter(q=>q[1]<95*G).sort((a,b)=>a[1]-b[1])[0];
        if(ti){const dx=R.c.x-ti[0].c.x,dy=R.c.y-ti[0].c.y,l=Math.hypot(dx,dy)||1;block(R,{x:R.c.x+dx/l*150*G,y:R.c.y+dy/l*150*G},Math.atan2(-dy,-dx),true);ro.st='esq';return}}
      if(light){const th=EC.filter(T=>T.k==='cav').map(T=>[T,Math.hypot(T.c.x-R.c.x,T.c.y-R.c.y)]).filter(q=>q[1]<260*G).sort((a,b)=>a[1]-b[1])[0];
        if(th&&th[0].pw>R.pw*.6){const dx=R.c.x-th[0].c.x,dy=R.c.y-th[0].c.y,l=Math.hypot(dx,dy)||1,bx=-f.x*.5+dx/l,by=-f.y*.5+dy/l,bl=Math.hypot(bx,by)||1;
          block(R,{x:R.c.x+bx/bl*200*G,y:R.c.y+by/bl*200*G},Math.atan2(-dy,-dx),true);ro.st='esq';return}}
      const ECr=light?EC.filter(T=>T.k==='lcav'):EC,cpr=C.filter(Q=>(Q.k==='lcav')===light).reduce((a,Q)=>a+Q.pw,0),epr=ECr.reduce((a,T)=>a+T.pw,0),strongr=!ECr.length||cpr>=epr*(S.post==='att'?.75:.9)*wK;
      if(ECr.length){const T=ECr.sort((a,b)=>Math.hypot(a.c.x-R.c.x,a.c.y-R.c.y)-Math.hypot(b.c.x-R.c.x,b.c.y-R.c.y))[0],d=Math.hypot(T.c.x-R.c.x,T.c.y-R.c.y);
        if(strongr){ro.st='m';fight(R,T,d<300*G);return}
        // trop faible : garder le flanc, en retrait, et contre-charger ce qui s'approche de la ligne
        const near=ECr.find(T=>line.some(L=>Math.hypot(T.c.x-L.c.x,T.c.y-L.c.y)<150*G)||Math.hypot(T.c.x-R.c.x,T.c.y-R.c.y)<130*G);
        if(near){ro.st='m';fight(R,near,true);return}
        if(!light){ro.st='garde';block(R,{x:base.x-rx*s*20*G-f.x*90*G+rx*s*k*(WR+GAP),y:base.y-ry*s*20*G-f.y*90*G+ry*s*k*(WR+GAP)},F,false);return}}
      // cavalerie légère libre : tirailleurs ennemis à portée, sinon harcèlement d'un flanc ennemi à portée de javelot
      const shaken=prey&&prey.sq.reduce((a,v)=>a+v.morale/v.T.morale,0)/Math.max(1,prey.sq.length)<.55;
      if(light&&(!prey||D.harass&&!shaken)){const sk=enF.filter(T=>T.k==='skirm'&&Math.hypot(T.c.x-R.c.x,T.c.y-R.c.y)<320*G)[0];if(sk){ro.st='m';fight(R,sk,true);return}
        const tg=enF.filter(T=>T.k==='inf').sort((a,b)=>s*(lat(b.c)-lat(a.c)))[0];
        if(tg&&R.sq.some(v=>v.T.ranged)){const P={x:tg.c.x+rx*s*(WR*.5+100*G),y:tg.c.y+ry*s*(WR*.5+100*G)};ro.st='har';block(R,P,Math.atan2(tg.c.y-P.y,tg.c.x-P.x),false);return}}
      // aile libre : on tourne la ligne ennemie et l'on charge dans le dos d'un régiment engagé
      if(prey){const tsq=prey.sq.length?prey.sq:prey.grp,fa=Math.atan2(tsq.reduce((a,v)=>a+Math.sin(v.ang),0),tsq.reduce((a,v)=>a+Math.cos(v.ang),0)),P={x:prey.c.x-Math.cos(fa)*110*G,y:prey.c.y-Math.sin(fa)*110*G};
        const side={x:prey.c.x+rx*s*170*G,y:prey.c.y+ry*s*170*G},past=s*(lat(R.c)-lat(prey.c))>WR*.8||Math.hypot(R.c.x-P.x,R.c.y-P.y)<160*G;
        if(Math.hypot(R.c.x-P.x,R.c.y-P.y)<90*G||ro.st==='dos'&&R.sq.some(v=>v.order&&v.order.type==='attack')){ro.st='dos';fight(R,prey,true);if(!ro.cnt){ro.cnt=1;S.st.rear=(S.st.rear||0)+1}return}
        ro.st='tour';const Q=past?P:side;block(R,Q,Math.atan2(prey.c.y-Q.y,prey.c.x-Q.x),true);return}
      // fuyards et tirailleurs à portée : la cavalerie les ramasse
      const r=runners.filter(T=>Math.hypot(T.c.x-R.c.x,T.c.y-R.c.y)<(S.post==='def'?220:340)*G).sort((a,b)=>Math.hypot(a.c.x-R.c.x,a.c.y-R.c.y)-Math.hypot(b.c.x-R.c.x,b.c.y-R.c.y))[0];
      if(r){const tg=r.grp.filter(v=>!v.dead&&!v.pend);const t=tg.sort((a,b)=>Math.hypot(a.x-R.c.x,a.y-R.c.y)-Math.hypot(b.x-R.c.x,b.y-R.c.y))[0];
        if(t){for(const v of R.sq)if(free(v))atk(v,t,true);ro.st='chasse';return}}
      ro.st='';block(R,slot,F,false)})}
  // ---- tirailleurs : écran devant, repli derrière les ailes, tir depuis les flancs ----
  const scr=my.filter(R=>role(R).ro==='scr'),ns=scr.length;
  scr.forEach((R,j)=>{const ro=role(R);const o=ns>1?(j/(ns-1)-.5)*Math.max(Lw,ns*WR*.9):0,sd=o<0?-1:1;
    const thr=enF.filter(T=>T.k!=='skirm').map(T=>{let d=1e9;for(const v of T.sq)for(const u of R.sq)d=Math.min(d,Math.hypot(v.x-u.x,v.y-u.y));return [T,d]}).sort((a,b)=>a[1]-b[1])[0];
    const close=thr&&thr[1]<(KC(thr[0].k)?170:120)*G;
    if(close||ro.st==='back'&&inM===0&&thr&&thr[1]<260*G){ro.st='back';block(R,{x:A.x-f.x*75*G+rx*sd*(Lw/2+20*G+Math.abs(o)*.15),y:A.y-f.y*75*G+ry*sd*(Lw/2+20*G+Math.abs(o)*.15)},F,true);return}
    if(inM>0||ro.st==='back'){ro.st='flanc';block(R,{x:A.x+f.x*25*G+rx*sd*(Lw/2+WR*.6+40*G),y:A.y+f.y*25*G+ry*sd*(Lw/2+WR*.6+40*G)},Math.atan2(E.y-A.y,E.x-A.x),false);return}
    ro.st='ecran';block(R,{x:A.x+f.x*95*G+rx*o,y:A.y+f.y*95*G+ry*o},F,false)});
  // ---- éléphants : devant le centre, lâchés sur l'infanterie à portée ----
  const el=my.filter(R=>role(R).ro==='ele');
  el.forEach((R,j)=>{const ro=role(R);if(ro.st==='m'){const T=en.find(x=>x.id===ro.t);if(T&&T.sq.length>T.rt){fight(R,T,true);return}}
    const T=facing(R,S.post==='def'?170*G:D.eleR*G,.2);if(T&&T.k!=='skirm'){ro.st='m';ro.t=T.id;fight(R,T,true);return}
    const o=(j-(el.length-1)/2)*Math.min(260*G,Lw/Math.max(1,el.length));block(R,{x:A.x+f.x*60*G+rx*o,y:A.y+f.y*60*G+ry*o},F,false)});
  return true}
IB.tick=tick;for(const k of ['post','why','hist','st','roles','A','D'])Object.defineProperty(IB,k,{get(){return (IB.sd[1]||{})[k]}});
// nouvelle bataille : on oublie le plan précédent
{const _st=setup;setup=function(){IB.sd={};return _st.apply(this,arguments)}}
window.__iaB=IB;
// choix de l'IA sur l'écran d'accueil (gardé dans le navigateur)
try{const box=document.getElementById('taille');if(box&&!document.getElementById('sIA')){const l=document.createElement('label');
  l.innerHTML='IA ennemie <select id="sIA"><option value="nouvelle">Nouvelle (plan de bataille)</option><option value="ancienne">Ancienne</option></select>';
  box.appendChild(l);const sel=l.querySelector('select');sel.value=IB.on?'nouvelle':'ancienne';
  sel.addEventListener('change',()=>{IB.on=sel.value==='nouvelle';IB.sd={};try{localStorage.setItem('bellum.ia',sel.value)}catch(e){}})}}catch(e){}
}
/* ================= FIN IA PLAN DE BATAILLE ================= */
